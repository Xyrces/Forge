<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>NU1904;NU1903</NoWarn>
    <RootNamespace>Forge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="Forge.UI\**\*.cs" />
    <None Remove="tests/**" />
    <None Remove="tools/**" />
    <None Remove="Forge.UI\**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!--
    The Blazor WASM UI (Forge.UI) lives in a sibling project with
    StaticWebAssetsEnabled=true. The static web assets (app.css,
    app.js, _framework/*) flow into this project through the
    StaticWebAssetsProjectReference + the SDK's
    ResolveStaticWebAssetsTargets target. The explicit Content
    below is a belt-and-braces fallback for SDK versions that
    don't auto-merge: it ensures the wwwroot is copied into the
    publish output even if the StaticWebAssets pipeline skips
    this project (e.g., OutputType=Exe with no Razor entrypoint
    in this project — Razor is in Forge.UI).

    Without this, the dashboard renders an unstyled Blazor SPA
    because /app.css returns 404 from the running Kestrel. The
    Forge.Core project is the only one that runs (Exe); Forge.UI
    is a Sdk.Web library that produces Razor + the Blazor
    bootstrapper. Their static web assets must end up on disk
    next to Forge.Core.dll.
  -->
  <ItemGroup>
    <Content Include="Forge.UI\wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Built-in MAF role prompts: copied next to the app so any
         project without its own agents/ dir still gets real role
         instructions (see Agents/RolePromptRoot.cs). -->
    <Content Include="agents\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="agents\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.12.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.12.0" />
    <PackageReference Include="Microsoft.Agents.AI.DurableTask" Version="1.1.0-preview.260410.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.2" />
    <PackageReference Include="Microsoft.DurableTask.Client.AzureManaged" Version="1.18.0" />
    <PackageReference Include="Microsoft.DurableTask.Worker.AzureManaged" Version="1.18.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <PackageReference Include="Octokit" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Forge.UI\Forge.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Tests" />
  </ItemGroup>

</Project>
