{
  "Db": {
    "Provider": "sqlserver"
  },
  "Bootstrap": {
    "ControllerPrincipal": "forge-k3s-runtime",
    "WorkerPrincipal": "forge-k3s-worker"
  },
  "State": {
    "WriteAuthority": true
  },
  "Budget": {
    "PaidCallsEnabled": false,
    "LimitUsd": 25
  },
  "GitHub": {
    "Owner": "Xyrces",
    "Repo": "Forge"
  },
  "Llm": {
    "DefaultProvider": "openai",
    "Providers": [
      {
        "Name": "openai",
        "Api": "responses",
        "BaseUrl": "https://api.openai.com/v1",
        "DefaultModel": "gpt-6.2-sol"
      }
    ]
  }
}
