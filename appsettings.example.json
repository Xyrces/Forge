{
  "llm": {
    "defaultProvider": "kilo-gateway",
    "providers": [
      {
        "name": "kilo-gateway",
        "baseUrl": "https://api.kilo.ai/api/gateway",
        "apiKey": "KILO_GATEWAY_API_KEY",
        "orgId": "",
        "defaultModel": "minimax/minimax-m3"
      }
    ],
    "roles": {
      "CoreDev":   { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "ClientDev": { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "QA":        { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "Reviewer":  { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "Intake":    { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" }
    },
    "_designArtistRoleNote": "Designer + Artist use RoleAgentRegistry.ByAgentName() (built-in fall-back to CoreDev); they don't live in this Roles map. The Designer / Artist agents run in the Orchestrator process only and look up their provider via the same kilo-gateway as CoreDev.",
    "meshyApiKey": "MESHY_API_KEY",
    "meshyBaseUrl": "https://api.meshy.ai",
    "meshyPollIntervalSeconds": 5,
    "meshyMaxWaitSeconds": 600,
    "meshyMaxConcurrentJobs": 4
  },
  "github": {
    "owner": "Xyrces",
    "repo": "PortHorizon",
    "token": "GITHUB_TOKEN"
  },
  "workspace": {
    "root": "/home/jtn5016/repos/PortHorizon",
    "worktreeRoot": ".portHorizon/worktrees",
    "defaultBranch": "main"
  },
  "projects": {
    "_comment": "DEPRECATED: the appsettings.json `projects[]` array is no longer the source of truth. Project registry lives in the SQLite `project` table. Add projects via the dashboard Projects page or POST /api/projects. This array is ignored at boot — kept here only as a discoverability hint for operators moving from a previous install."
  },
  "spawner": {
    "maxConcurrentSessions": 4,
    "pollIntervalSeconds": 3,
    "staleMinutes": 30
  },
  "orchestrator": {
    "execution": "InProcess",
    "dtsConnectionString": "Endpoint=http://localhost:8080;TaskHub=default;Authentication=None"
  },
  "headroom": {
    "_comment": "P4 Headroom — LLM cost optimization sidecar. See docs/headroom.md.",
    "enabled": false,
    "proxyBaseUrl": "http://127.0.0.1:8787",
    "mode": "token",
    "ccrEnabled": true,
    "budgetUsd": 0,
    "trackUsage": true
  },
  "dashboard": {
    "enabled": true,
    "port": 4097,
    "hostname": "127.0.0.1"
  }
}