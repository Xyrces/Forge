{
  "llm": {
    "defaultProvider": "kilo-gateway",
    "providers": [
      {
        "name": "kilo-gateway",
        "baseUrl": "https://api.kilo.ai/api/gateway",
        "apiKey": "KILO_GATEWAY_API_KEY",
        "orgId": "",
        "defaultModel": "minimax/minimax-m3"
      }
    ],
    "roles": {
      "CoreDev":   { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "ClientDev": { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "QA":        { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "Reviewer":  { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" },
      "Intake":    { "providerName": "kilo-gateway", "model": "minimax/minimax-m3" }
    },
    "_designArtistRoleNote": "Designer + Artist use RoleAgentRegistry.ByAgentName() (built-in fall-back to CoreDev); they don't live in this Roles map. The Designer / Artist agents run in the Orchestrator process only and look up their provider via the same kilo-gateway as CoreDev.",
    "meshyApiKey": "MESHY_API_KEY",
    "meshyBaseUrl": "https://api.meshy.ai",
    "meshyPollIntervalSeconds": 5,
    "meshyMaxWaitSeconds": 600,
    "meshyMaxConcurrentJobs": 4
  },
  "github": {
    "owner": "Xyrces",
    "repo": "PortHorizon",
    "token": "GITHUB_TOKEN"
  },
  "workspace": {
    "root": "/home/jtn5016/repos/PortHorizon",
    "worktreeRoot": ".portHorizon/worktrees",
    "defaultBranch": "main"
  },
  "projects": {
    "_comment": "Forge is project-agnostic: it clones each project's repo into <dataRoot>/projects/<id>/ on first boot. Add a new project by listing it here (one-time seed into SQLite) or via POST /api/projects. Leave the list empty + workspace.root empty for the zero-config single-project default.",
    "projects": [
      {
        "id": "porthorizon",
        "name": "PortHorizon",
        "repoUrl": "https://github.com/Xyrces/PortHorizon.git",
        "defaultBranch": "main",
        "roles": { "coredev": 2, "clientdev": 2, "reviewer": 2, "intake": 1, "designer": 1, "artist": 1, "groomer": 1, "orchestrator": 1 }
      },
      {
        "id": "forge",
        "name": "Forge",
        "repoUrl": "https://github.com/Xyrces/Forge.git",
        "defaultBranch": "main",
        "roles": { "coredev": 2, "clientdev": 1, "reviewer": 2, "intake": 1, "designer": 1, "artist": 1, "groomer": 1, "orchestrator": 1 },
        "_deploymentComment": "Example DeploymentKind.SelfHostedSystemdService for the orchestrator building itself. systemd stops + restarts the unit after the symlink is repointed. See docs/deployment-pipeline.md.",
        "deployment": {
          "kind": "SelfHostedSystemdService",
          "requireBuildCheck": true,
          "buildCommand": "dotnet build -c Release",
          "testCommand": "dotnet test -c Release",
          "serviceName": "forge",
          "publishProject": "Forge.Core.csproj",
          "releasesRoot": "/opt/forge/releases",
          "currentLinkPath": "/opt/forge/current"
        }
      }
    ]
  },
  "spawner": {
    "maxConcurrentSessions": 4,
    "pollIntervalSeconds": 3,
    "staleMinutes": 30
  },
  "orchestrator": {
    "execution": "InProcess",
    "dtsConnectionString": "Endpoint=http://localhost:8080;TaskHub=default;Authentication=None"
  },
  "headroom": {
    "_comment": "P4 Headroom — LLM cost optimization sidecar. See docs/headroom.md.",
    "enabled": false,
    "proxyBaseUrl": "http://127.0.0.1:8787",
    "mode": "token",
    "ccrEnabled": true,
    "budgetUsd": 0,
    "trackUsage": true
  },
  "dashboard": {
    "enabled": true,
    "port": 4097,
    "hostname": "127.0.0.1"
  }
}