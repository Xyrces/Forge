@using Forge.Dashboard.Features.Sprints
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject ILogger<CompletionWaitingList> Logger
@implements IDisposable

<details class="card">
    <summary>Outstanding sprint outcomes@(_page is null ? "" : $" · {_page.Items.Count}{(_page.NextCursor is not null ? "+" : "")} on this page")</summary>
    @if (_loading) { <p role="status">Loading outstanding completions…</p> }
    else if (_error is not null)
    {
        <p class="banner banner--warn" role="alert">@_error</p>
        <button class="btn" @onclick="LoadAsync">Retry loading</button>
    }
    else if (_page is not null)
    {
        @if (_page.Items.Count == 0) { <p class="page-subtitle">No outstanding completion records on this page.</p> }
        @foreach (var item in _page.Items)
        {
            <p>
                <button class="btn" @onclick="() => OnSelect.InvokeAsync(item.SprintId)">@(item.SprintName is { Length: > 0 } name ? $"Review {name}" : "Review sprint outcome")</button>
                <span>@CompletionPresentation.Outcome(item.Outcome) · follow-ups @CompletionPresentation.Processing(item.BookkeepingState) · deployment @CompletionPresentation.Deployment(item.DeploymentStatus)</span>
                @if (item.DeliveryNote is not null) { <span> · @item.DeliveryNote</span> }
            </p>
        }
        @if (_cursor is not null || _page.NextCursor is not null)
        {
            <button class="btn" disabled="@(_cursor is null)" @onclick="FirstAsync">First page</button>
            <button class="btn" disabled="@(_page.NextCursor is null)" @onclick="NextAsync">More outstanding completions</button>
        }
    }
</details>

@code {
    [Parameter] public string? ProjectId { get; set; }
    [Parameter] public DateTime RefreshAt { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    private string? _project, _cursor, _error;
    private DateTime _at;
    private bool _loading;
    private int _generation;
    private CancellationTokenSource? _request;
    private WaitingPage? _page;
    protected override async Task OnParametersSetAsync()
    {
        if (_project == ProjectId && _at == RefreshAt) return;
        if (_project != ProjectId) { _cursor = null; _page = null; }
        _project = ProjectId; _at = RefreshAt;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        _request?.Cancel(); _request?.Dispose(); _request = new();
        var token = _request.Token;
        var generation = ++_generation;
        var project = ProjectId;
        _loading = true; _error = null;
        if (project is null) { _loading = false; _page = null; return; }
        try
        {
            var url = $"/api/completions?projectId={Uri.EscapeDataString(project)}&waitingOnly=true&limit=5";
            if (_cursor is not null) url += "&cursor=" + Uri.EscapeDataString(_cursor);
            var page = await Http.GetFromJsonAsync<WaitingPage>(url, token)
                ?? throw new JsonException("Missing completion overview.");
            if (page.Items is null || page.Items.Any(i => i.ProjectId != project || string.IsNullOrWhiteSpace(i.SprintId)
                || string.IsNullOrWhiteSpace(i.Outcome) || string.IsNullOrWhiteSpace(i.BookkeepingState)))
                throw new JsonException("Invalid completion overview.");
            if (generation == _generation) _page = page;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load outstanding sprint completions");
            if (generation == _generation) _error = "Outstanding completion records are unavailable; this does not mean all work was delivered.";
        }
        finally { if (generation == _generation) _loading = false; }
    }
    private async Task FirstAsync() { _cursor = null; await LoadAsync(); }
    private async Task NextAsync() { _cursor = _page?.NextCursor; await LoadAsync(); }
    public void Dispose() { ++_generation; _request?.Cancel(); _request?.Dispose(); }
    private sealed record WaitingItem(string ProjectId, string SprintId, string Outcome, string BookkeepingState, string? DeploymentStatus, string? DeliveryNote, string? SprintName = null);
    private sealed record WaitingPage(IReadOnlyList<WaitingItem> Items, string? NextCursor);
}
