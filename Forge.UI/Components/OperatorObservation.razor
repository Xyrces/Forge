@using System.Net.Http.Json
@using System.Security.Cryptography
@using System.Text
@inject HttpClient Http
@inject ILogger<OperatorObservation> Logger
@implements IDisposable

<details class="card">
    <summary>Record your observation</summary>
    <p>Record only checks you performed against this deployed version. This saves your observation; it does not run the check.</p>
    <label for="@_inputId">What you checked, what you observed, and any evidence links</label>
    <textarea id="@_inputId" maxlength="4000" disabled="@(_saving || _recorded)" @bind="_observation" @bind:event="oninput"></textarea>
    <button class="btn" disabled="@(!Enabled || _saving || _recorded || string.IsNullOrWhiteSpace(_observation))" @onclick="RecordAsync">
        @(_saving ? "Recording observation…" : "Record this observation")
    </button>
    @if (_error is not null) { <p class="banner banner--warn" role="alert">@_error</p> }
    @if (_notice is not null) { <p role="status">@_notice</p> }
</details>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    [Parameter, EditorRequired] public string SprintId { get; set; } = "";
    [Parameter, EditorRequired] public string PlanHash { get; set; } = "";
    [Parameter, EditorRequired] public string SourceSha { get; set; } = "";
    [Parameter, EditorRequired] public string DeploymentId { get; set; } = "";
    [Parameter, EditorRequired] public string CriterionId { get; set; } = "";
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public EventCallback OnRecorded { get; set; }
    private readonly string _inputId = "operator-observation-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource _lifetime = new();
    private string _observation = "";
    private string? _error, _notice;
    private bool _saving, _recorded;

    private async Task RecordAsync()
    {
        if (!Enabled || _saving || _recorded || string.IsNullOrWhiteSpace(_observation)) return;
        _saving = true;
        _error = null;
        _notice = null;
        // The saved note is the evidence artifact, including any operator-provided
        // links. Hash its exact UTF-8 bytes; do not imply linked files were read.
        var proof = _observation.Trim();
        var proofSha256 = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(proof))).ToLowerInvariant();
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion/operator-evidence?projectId={Uri.EscapeDataString(ProjectId)}",
                new { planHash = PlanHash, criterionId = CriterionId, sourceSha = SourceSha,
                    deploymentId = DeploymentId, proofReference = proof, proofSha256 }, _lifetime.Token);
            response.EnsureSuccessStatusCode();
            if (_lifetime.IsCancellationRequested) return;
            _recorded = true;
            _notice = "Observation recorded for this deployed version.";
            await OnRecorded.InvokeAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not record operator observation for {Sprint}/{Criterion}", SprintId, CriterionId);
            if (!_lifetime.IsCancellationRequested)
                _error = "The observation was not confirmed. Refresh completion evidence before retrying; the deployed version may have changed. Your note has been kept here.";
        }
        finally { _saving = false; }
    }

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
