@using Fluxor.Blazor.Web.ReduxDevTools
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forge</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    <script src="app.js"></script>
    <script src="events.js"></script>
    <script src="intake.js"></script>
    <script type="module">
        // Mermaid for the intake canvas. ESM from CDN; on failure
        // window.forgeMermaid stays undefined and intake.js falls back
        // to rendering the diagram source.
        try {
            const mermaid = (await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')).default;
            mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'strict' });
            window.forgeMermaid = mermaid;
        } catch (err) {
            console.warn('forge: mermaid failed to load', err);
        }
    </script>
    <script src="_content/Fluxor.Blazor.Web.ReduxDevTools/reduxDevTools.js"></script>
</body>
</html>
