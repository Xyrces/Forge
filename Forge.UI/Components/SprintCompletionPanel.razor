@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject ILogger<SprintCompletionPanel> Logger
@implements IDisposable

<section class="card" aria-label="Sprint evidence and delivery">
    <strong>Sprint evidence and delivery</strong>
    <p class="page-subtitle">Terminal task counts do not prove an outcome was delivered.</p>
    @if (_loading)
    {
        <p role="status">Loading completion evidence…</p>
    }
    else if (_error is not null)
    {
        <p class="banner banner--warn" role="alert">@_error</p>
        <button class="btn" @onclick="LoadAsync">Retry loading evidence</button>
    }
    else if (_detail is null)
    {
        <p class="page-subtitle">No completion evidence has been recorded for this sprint yet.</p>
    }
    else
    {
        var receipt = _detail.Receipt;
        <dl>
            <dt>Engineering evidence</dt><dd>@OutcomeLabel(receipt.Outcome)</dd>
            <dt>Follow-up processing</dt><dd>@receipt.BookkeepingState</dd>
            <dt>Deployment</dt><dd>@(receipt.DeploymentStatus ?? (receipt.ReadyForDeployment ? "Awaiting qualified release" : "Not yet qualified for release"))</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(receipt.DeliveryNote))
        {
            <p class="banner banner--info">@receipt.DeliveryNote</p>
        }
        @if (receipt.DeploymentCandidateId is not null)
        {
            <a href="@($"/deployments?project={Uri.EscapeDataString(ProjectId!)}")">View deployment</a>
        }
        @if (receipt.SourceSha is not null)
        {
            <p class="page-subtitle">Qualified source: <code>@receipt.SourceSha</code></p>
        }
        @foreach (var batch in _detail.Batches)
        {
            <div class="card">
                <strong>Follow-up batch · @batch.State</strong>
                @if (!string.IsNullOrWhiteSpace(batch.Error)) { <p>@batch.Error</p> }
                @if (batch.State == "NeedsReview")
                {
                    <p>The previous model request may have finished and incurred a charge. Review its result before explicitly starting another request.</p>
                    <button class="btn" disabled="@_retrying" @onclick="() => RetryAsync(batch.Id)">Retry follow-up processing (may incur a charge)</button>
                }
            </div>
        }
        @if (_actionError is not null) { <p class="banner banner--warn" role="alert">@_actionError</p> }
        @if (_notice is not null) { <p role="status">@_notice</p> }
        <button class="btn" disabled="@(_cursor is null || _retrying)" @onclick="FirstPageAsync">First batch page</button>
        <button class="btn" disabled="@(_detail.NextCursor is null || _retrying)" @onclick="NextPageAsync">Next batch page</button>
    }
</section>

@code {
    [Parameter] public string? ProjectId { get; set; }
    [Parameter] public string? SprintId { get; set; }
    [Parameter] public DateTime RefreshAt { get; set; }
    private string? _identity, _cursor, _error, _actionError, _notice;
    private DateTime _refreshAt;
    private CompletionDetail? _detail;
    private CancellationTokenSource? _request;
    private int _generation;
    private bool _loading, _retrying;

    protected override async Task OnParametersSetAsync()
    {
        var identity = ProjectId + "/" + SprintId;
        if (_identity == identity && _refreshAt == RefreshAt) return;
        if (_identity != identity)
        {
            _identity = identity;
            _cursor = null;
            _detail = null;
            _notice = null;
            _actionError = null;
        }
        _refreshAt = RefreshAt;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _request?.Cancel();
        _request?.Dispose();
        _request = new();
        var token = _request.Token;
        var generation = ++_generation;
        _loading = true;
        _error = null;
        if (ProjectId is null || SprintId is null) { _detail = null; _loading = false; return; }
        var url = $"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion?projectId={Uri.EscapeDataString(ProjectId)}";
        if (_cursor is not null) url += "&cursor=" + Uri.EscapeDataString(_cursor);
        try
        {
            using var response = await Http.GetAsync(url, token);
            CompletionDetail? detail = null;
            if (response.StatusCode != HttpStatusCode.NotFound)
            {
                response.EnsureSuccessStatusCode();
                detail = await response.Content.ReadFromJsonAsync<CompletionDetail>(cancellationToken: token)
                    ?? throw new JsonException("Missing completion evidence.");
                if (detail.Receipt is null || detail.Batches is null || detail.Receipt.ProjectId != ProjectId || detail.Receipt.SprintId != SprintId ||
                    string.IsNullOrWhiteSpace(detail.Receipt.Outcome) || string.IsNullOrWhiteSpace(detail.Receipt.BookkeepingState) ||
                    detail.Batches.Any(b => string.IsNullOrWhiteSpace(b.Id) || string.IsNullOrWhiteSpace(b.State)))
                    throw new JsonException("Completion evidence does not match the selection.");
            }
            if (generation == _generation) _detail = detail;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load sprint completion evidence");
            if (generation == _generation) _error = "Completion evidence is unavailable. No delivery result can be inferred from this load failure.";
        }
        finally { if (generation == _generation) _loading = false; }
    }

    private async Task RetryAsync(string batchId)
    {
        if (_retrying || ProjectId is null || SprintId is null) return;
        var generation = _generation;
        var token = _request?.Token ?? CancellationToken.None;
        _retrying = true;
        _actionError = null;
        _notice = null;
        try
        {
            using var response = await Http.PostAsync($"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion/triage/{Uri.EscapeDataString(batchId)}/retry?projectId={Uri.EscapeDataString(ProjectId)}", null, token);
            response.EnsureSuccessStatusCode();
            if (generation != _generation) return;
            _notice = "Explicit retry queued. A new model request may be charged.";
            await LoadAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not request follow-up processing retry");
            if (generation == _generation) _actionError = "Retry was not confirmed. Reload the evidence before trying again.";
        }
        finally { _retrying = false; }
    }
    private async Task FirstPageAsync() { _cursor = null; await LoadAsync(); }
    private async Task NextPageAsync() { _cursor = _detail?.NextCursor; await LoadAsync(); }
    private static string OutcomeLabel(string outcome) => outcome switch
    {
        "Satisfied" => "Required evidence satisfied",
        "PendingEvidence" => "Awaiting required evidence",
        "Incomplete" => "Incomplete — operator attention needed",
        "LegacyTerminalOnly" => "Legacy terminal counts only — delivery unproven",
        _ => "Unknown evidence state"
    };
    public void Dispose() { ++_generation; _request?.Cancel(); _request?.Dispose(); }
    private sealed record CompletionSummary(string Id, string ProjectId, string SprintId, string Outcome,
        string BookkeepingState, bool ReadyForDeployment, string? SourceSha, string? DeploymentCandidateId,
        string? DeploymentStatus, string? DeliveryNote);
    private sealed record CompletionBatch(string Id, string State, string? Error);
    private sealed record CompletionDetail(CompletionSummary Receipt, IReadOnlyList<CompletionBatch> Batches, string? NextCursor);
}
