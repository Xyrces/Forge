@using Forge.Dashboard.Features.Sprints
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject ILogger<SprintCompletionPanel> Logger
@implements IDisposable

<section class="card sprint-acceptance" aria-label="Sprint evidence and delivery">
    <h2>
        <button type="button" class="sprint-acceptance__toggle" aria-expanded="@(Expanded ? "true" : "false")"
                aria-controls="sprint-acceptance-details" @onclick="() => ExpandedChanged.InvokeAsync(!Expanded)">
            <span>Acceptance and delivery</span>
            <span class="sprint-acceptance__status">
                @if (_error is not null)
                {
                    <span>@(_detail is null ? "Evidence unavailable" : "Update unavailable · showing last result")</span>
                }
                @if (_detail is { } detail)
                {
                    var receipt = detail.Receipt;
                    var observations = detail.Criteria.Where(c => c.EvidenceKind == "OperatorObserved" && c.Blocking && !c.MissedWithException).ToList();
                    <span>@(receipt.AbandonedAt is null ? CompletionPresentation.Outcome(receipt.Outcome) : "Stopped by operator")</span>
                    <span>@DeploymentLabel(receipt)</span>
                    @if (detail.Receipt.CompletionPolicy?.EnvironmentName is { } environment) { <span>Target: @environment</span> }
                    @if (detail.Receipt.DeploymentApprovalRequired) { <span>Human deployment approval required</span> }
                    @if (detail.Receipt.Reconciliation is not null) { <span>Closed with recorded exception</span> }
                    @if (observations.Count > 0)
                    {
                        <span>@observations.Count(c => c.ProofReference is not null) of @observations.Count operator observations recorded</span>
                    }
                    @if (receipt.BookkeepingState == "NeedsReview")
                    {
                        <span>Follow-up review needed</span>
                    }
                }
                else if (_error is null)
                {
                    @if (_activePolicy is { } activePolicy)
                    {
                        <span>@(activePolicy.EnvironmentName is null ? "No deployment required" : $"Target: {activePolicy.EnvironmentName}")</span>
                        <span>@(activePolicy.RequireApproval ? "Human deployment approval required" : "Automatic after required checks")</span>
                    }
                    else { <span>@(_loading ? "Loading evidence…" : "No completion evidence yet")</span> }
                }
            </span>
            <span class="sprint-acceptance__chevron" aria-hidden="true"></span>
        </button>
    </h2>
    <div id="sprint-acceptance-details" class="sprint-acceptance__details" hidden="@(!Expanded)">
    @if (_loading && _detail is null)
    {
        <p role="status">Loading completion evidence…</p>
    }
    else if (_error is not null && _detail is null)
    {
        <p class="banner banner--warn" role="alert">@_error</p>
        <button class="btn" @onclick="LoadAsync">Retry loading evidence</button>
    }
    else if (_detail is null)
    {
        <p class="page-subtitle">No completion evidence has been recorded for this sprint yet.</p>
        @if (_activePolicy is { } policy)
        {
            @if (policy.EnvironmentName is null) { <p>No deployment required. This sprint closes after required engineering verification.</p> }
            else
            {
                <p>This sprint closes when deployment to <strong>@policy.EnvironmentName</strong> passes its required checks.</p>
                <p>@(policy.RequireApproval ? "Explicit gate: human approval before deployment." : "Delivery is automatic after required checks. No human deployment approval gate.")</p>
            }
        }
    }
    else
    {
        var receipt = _detail.Receipt;
        @if (_error is not null)
        {
            <p class="banner banner--warn" role="alert">@_error The last loaded evidence is shown below.</p>
            <button class="btn" @onclick="LoadAsync">Retry loading evidence</button>
        }
        <dl class="delivery-summary">
            <dt>Engineering evidence</dt><dd>@(receipt.AbandonedAt is null ? CompletionPresentation.Outcome(receipt.Outcome) : "Evidence incomplete — outcome stopped")</dd>
            <dt>Follow-up processing</dt><dd>@CompletionPresentation.Processing(receipt.BookkeepingState)</dd>
            <dt>Deployment</dt><dd>@DeploymentLabel(receipt)</dd>
        </dl>
        @if (_detail.Receipt.CompletionPolicy is { } policy)
        {
            @if (policy.EnvironmentName is null) { <p>No deployment required. This sprint closes after required engineering verification.</p> }
            else
            {
                <p>Completion target: <strong>@policy.EnvironmentName</strong>. Deployment checks must pass before this sprint closes.</p>
                <p>@(policy.RequireApproval ? "Explicit gate: human approval before deployment." : "Automatic deployment after required checks. No human deployment approval gate.")</p>
            }
        }
        @if (_detail.Receipt.DeploymentApprovalRequired)
        {
            <div class="banner banner--warn"><p>Human deployment approval is required by this sprint's environment policy.</p>
                @if (!receipt.ReadyForDeployment) { <p>Engineering verification must pass before deployment approval is available.</p> }
                <button class="btn btn--primary" disabled="@(_retrying || _loading || _error is not null || !receipt.ReadyForDeployment)" @onclick="ApproveDeploymentAsync">Approve deployment to @_detail.Receipt.CompletionPolicy?.EnvironmentName</button>
            </div>
        }
        @if (_detail.Receipt.Reconciliation is { } exception)
        {
            <section class="banner banner--warn"><strong>Closed with an explicit exception</strong><p>@exception.Reason</p>
                <p>Recorded by @exception.OperatorIdentity at @exception.RecordedAt.ToLocalTime().ToString("g"). Missed checks remain marked as missed below.</p>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(receipt.DeliveryNote))
        {
            <p class="banner banner--info">@receipt.DeliveryNote</p>
        }
        @if (receipt.DeploymentCandidateId is not null)
        {
            <a href="@($"/deployments?project={Uri.EscapeDataString(ProjectId!)}")">View deployment</a>
        }
        @if (receipt.SourceSha is not null)
        {
            <details class="release-reference"><summary>Qualified source revision</summary><code>@receipt.SourceSha</code></details>
        }
        @if (receipt.AbandonedAt is not null)
        {
            <p class="banner banner--warn">Stopped by operator at @receipt.AbandonedAt.Value.ToLocalTime().ToString("g") — not delivered. @receipt.AbandonmentReason</p>
        }
        else if (receipt.PlanHash is not null && receipt.Outcome is "Incomplete" or "PendingEvidence")
        {
            <details class="card">
                <summary>Stop this incomplete outcome</summary>
                <p>This records an explicit interruption with your reason. It does not mark the work delivered or qualify a release.</p>
                @if (receipt.DeploymentCandidateId is not null && receipt.DeploymentStatus is not ("Deployed" or "DeployFailed" or "BuildFailed" or "Rejected"))
                {
                    <p>Reject an unstarted release on the Deployments page first. If a release is already authorized or running, wait for its safe result before stopping this outcome.</p>
                    <a href="@($"/deployments?project={Uri.EscapeDataString(ProjectId!)}")">Review linked deployment</a>
                }
                else
                {
                    <label for="completion-stop-reason">Reason for stopping</label>
                    <textarea id="completion-stop-reason" maxlength="2000" @bind="_stopReason" @bind:event="oninput"></textarea>
                    <button class="btn btn--danger" disabled="@(_retrying || string.IsNullOrWhiteSpace(_stopReason))" @onclick="StopOutcomeAsync">Stop outcome without marking it delivered</button>
                }
            </details>
        }
        <h3>Approved acceptance criteria</h3>
        @if (_detail.Criteria.Count == 0) { <p>No structured criteria were recorded. Read the original sprint objective above.</p> }
        @foreach (var criterion in _detail.Criteria)
        {
            <section class="acceptance-criterion">
                <h4>@criterion.Text</h4>
                <p class="page-subtitle">@CompletionPresentation.Evidence(criterion.EvidenceKind)</p>
                @if (criterion.MissedWithException) { <p class="banner banner--warn">Missed — recorded in the completion exception. This check was not passed.</p> }
                @if (criterion.EvidenceKind == "ImplementationVerified")
                {
                    <p class="page-subtitle">Merged changes or existing code must have independent verification and review against this requirement at a recorded revision.</p>
                }
                @if (criterion.EvidenceKind == "OperatorObserved")
                {
                    <p>@(criterion.ProofReference is not null ? "Operator observation recorded for this deployed version." : criterion.MissedWithException ? "Observation was not performed." : !criterion.Blocking ? "Optional operator observation. It does not block sprint completion." : receipt.AbandonedAt is not null ? "Not verified; this outcome was stopped." : "Awaiting explicit operator observation of the exact deployed version.")</p>
                    @if (criterion.ProofReference is not null)
                    {
                        <dl><dt>Recorded by</dt><dd>@(criterion.OperatorIdentity ?? "Identity not recorded")</dd>
                        <dt>Evidence reference</dt><dd>@criterion.ProofReference</dd></dl>
                    }
                    else if (!criterion.MissedWithException && receipt.AbandonedAt is null && receipt.ReadyForDeployment && receipt.DeploymentStatus == "Deployed"
                        && receipt.PlanHash is not null && receipt.SourceSha is not null && receipt.DeploymentCandidateId is not null
                        && ProjectId is not null && SprintId is not null)
                    {
                        <OperatorObservation @key="(ProjectId, SprintId, receipt.PlanHash, receipt.SourceSha, receipt.DeploymentCandidateId, criterion.Id)"
                            ProjectId="@ProjectId" SprintId="@SprintId" PlanHash="@receipt.PlanHash"
                            SourceSha="@receipt.SourceSha" DeploymentId="@receipt.DeploymentCandidateId"
                            CriterionId="@criterion.Id" Enabled="@(_error is null && !_loading)" OnRecorded="LoadAsync" />
                    }
                }
            </section>
        }
        @foreach (var batch in _detail.Batches)
        {
            <div class="card">
                <strong>Follow-up batch · @CompletionPresentation.Processing(batch.State)</strong>
                @if (!string.IsNullOrWhiteSpace(batch.Error)) { <p>@batch.Error</p> }
                @if (batch.State == "NeedsReview" && receipt.AbandonedAt is null)
                {
                    <p>The previous model request may have finished and incurred a charge. Review its result before explicitly starting another request.</p>
                    <button class="btn" disabled="@_retrying" @onclick="() => RetryAsync(batch.Id)">Retry follow-up processing (may incur a charge)</button>
                }
            </div>
        }
        @if (_actionError is not null) { <p class="banner banner--warn" role="alert">@_actionError</p> }
        @if (_notice is not null) { <p role="status">@_notice</p> }
        @if (_cursor is not null || _detail.NextCursor is not null)
        {
            <button class="btn" disabled="@(_cursor is null || _retrying)" @onclick="FirstPageAsync">First batch page</button>
            <button class="btn" disabled="@(_detail.NextCursor is null || _retrying)" @onclick="NextPageAsync">Next batch page</button>
        }
    }
    </div>
</section>

@code {
    [Parameter] public string? ProjectId { get; set; }
    [Parameter] public string? SprintId { get; set; }
    [Parameter] public DateTime RefreshAt { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public EventCallback<(string? ProjectId, string? SprintId)> OnLayoutReady { get; set; }
    private string? _identity, _cursor, _error, _actionError, _notice;
    private string _stopReason = "";
    private DateTime _refreshAt;
    private CompletionDetail? _detail;
    private CompletionPolicyDto? _activePolicy;
    private CancellationTokenSource? _request;
    private int _generation;
    private bool _loading, _retrying;
    private bool _layoutReadyNotified;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _layoutReadyNotified) return;
        _layoutReadyNotified = true;
        await OnLayoutReady.InvokeAsync((ProjectId, SprintId));
    }

    protected override async Task OnParametersSetAsync()
    {
        var identity = ProjectId + "/" + SprintId;
        if (_identity == identity && _refreshAt == RefreshAt) return;
        if (_identity != identity)
        {
            _identity = identity;
            _cursor = null;
            _detail = null;
            _notice = null;
            _actionError = null;
            _stopReason = "";
        }
        _refreshAt = RefreshAt;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _request?.Cancel();
        _request?.Dispose();
        _request = new();
        var token = _request.Token;
        var generation = ++_generation;
        _activePolicy = null;
        _loading = true;
        _layoutReadyNotified = false;
        _error = null;
        if (ProjectId is null || SprintId is null) { _detail = null; _loading = false; return; }
        var url = $"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion?projectId={Uri.EscapeDataString(ProjectId)}";
        if (_cursor is not null) url += "&cursor=" + Uri.EscapeDataString(_cursor);
        try
        {
            using var response = await Http.GetAsync(url, token);
            CompletionDetail? detail = null;
            if (response.StatusCode != HttpStatusCode.NotFound)
            {
                response.EnsureSuccessStatusCode();
                detail = await response.Content.ReadFromJsonAsync<CompletionDetail>(cancellationToken: token)
                    ?? throw new JsonException("Missing completion evidence.");
                if (detail.Receipt is null || detail.Batches is null || detail.Criteria is null || detail.Receipt.ProjectId != ProjectId || detail.Receipt.SprintId != SprintId ||
                    string.IsNullOrWhiteSpace(detail.Receipt.Outcome) || string.IsNullOrWhiteSpace(detail.Receipt.BookkeepingState) ||
                    detail.Batches.Any(b => string.IsNullOrWhiteSpace(b.Id) || string.IsNullOrWhiteSpace(b.State)))
                    throw new JsonException("Completion evidence does not match the selection.");
            }
            if (generation == _generation) _detail = detail;
            if (detail is null)
            {
                using var policyResponse = await Http.GetAsync($"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion-policy?projectId={Uri.EscapeDataString(ProjectId)}", token);
                if (policyResponse.StatusCode != HttpStatusCode.NotFound)
                {
                    policyResponse.EnsureSuccessStatusCode();
                    var policy = await policyResponse.Content.ReadFromJsonAsync<CapturedPolicyDto>(cancellationToken: token);
                    if (generation == _generation) _activePolicy = policy?.Policy;
                }
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load sprint completion evidence");
            if (generation == _generation) _error = "Completion evidence is unavailable. No delivery result can be inferred from this load failure.";
        }
        finally { if (generation == _generation) _loading = false; }
    }

    private async Task RetryAsync(string batchId)
    {
        if (_retrying || ProjectId is null || SprintId is null) return;
        var generation = _generation;
        var token = _request?.Token ?? CancellationToken.None;
        _retrying = true;
        _actionError = null;
        _notice = null;
        try
        {
            using var response = await Http.PostAsync($"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion/triage/{Uri.EscapeDataString(batchId)}/retry?projectId={Uri.EscapeDataString(ProjectId)}", null, token);
            response.EnsureSuccessStatusCode();
            if (generation != _generation) return;
            _notice = "Explicit retry queued. A new model request may be charged.";
            await LoadAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not request follow-up processing retry");
            if (generation == _generation) _actionError = "Retry was not confirmed. Reload the evidence before trying again.";
        }
        finally { _retrying = false; }
    }
    private async Task StopOutcomeAsync()
    {
        if (_retrying || ProjectId is null || SprintId is null || _detail?.Receipt.PlanHash is not { } planHash
            || string.IsNullOrWhiteSpace(_stopReason)) return;
        var generation = _generation;
        var token = _request?.Token ?? CancellationToken.None;
        _retrying = true; _actionError = null; _notice = null;
        try
        {
            using var response = await Http.PostAsJsonAsync($"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion/abandon?projectId={Uri.EscapeDataString(ProjectId)}",
                new { planHash, reason = _stopReason.Trim() }, token);
            response.EnsureSuccessStatusCode();
            if (generation != _generation) return;
            _notice = "Explicit interruption recorded. The outcome has not been marked delivered.";
            await LoadAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not record completion interruption");
            if (generation == _generation) _actionError = "Interruption was not confirmed. Reload evidence and check the linked release before trying again.";
        }
        finally { _retrying = false; }
    }
    private async Task ApproveDeploymentAsync()
    {
        if (_retrying || _detail?.Receipt.DeploymentApprovalRequired != true || _detail.Receipt.PlanHash is not { } planHash || ProjectId is null || SprintId is null) return;
        var generation = _generation; var token = _request?.Token ?? CancellationToken.None;
        _retrying = true; _actionError = null; _notice = null;
        try
        {
            using var response = await Http.PostAsJsonAsync($"/api/sprints/{Uri.EscapeDataString(SprintId)}/completion/approve-deployment?projectId={Uri.EscapeDataString(ProjectId)}", new { planHash }, token);
            await Forge.Dashboard.Features.Deployments.EnvironmentPolicyClient.EnsureSuccessAsync(response, token);
            if (generation != _generation) return;
            _notice = "Deployment approval recorded. Delivery will proceed when all required checks pass.";
            await LoadAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { if (generation == _generation) _actionError = ex.Message; }
        finally { if (generation == _generation) _retrying = false; }
    }
    private async Task FirstPageAsync() { _cursor = null; await LoadAsync(); }
    private async Task NextPageAsync() { _cursor = _detail?.NextCursor; await LoadAsync(); }
    public void Dispose() { ++_generation; _request?.Cancel(); _request?.Dispose(); }
    private sealed record CompletionSummary(string Id, string ProjectId, string SprintId, string Outcome,
        string BookkeepingState, bool ReadyForDeployment, string? SourceSha, string? DeploymentCandidateId,
        string? DeploymentStatus, string? DeliveryNote, string? PlanHash, string? SprintName = null,
        string? AbandonmentReason = null, DateTimeOffset? AbandonedAt = null, bool? DeliveryRequired = null, CompletionPolicyDto? CompletionPolicy = null, bool DeploymentApprovalRequired = false, CompletionExceptionDto? Reconciliation = null);
    private sealed record CompletionBatch(string Id, string State, string? Error);
    private static string DeploymentLabel(CompletionSummary receipt) =>
        receipt.DeploymentStatus is not null ? CompletionPresentation.Deployment(receipt.DeploymentStatus)
        : receipt.DeliveryRequired == false ? "No deployment required"
        : receipt.ReadyForDeployment ? "Awaiting qualified release" : "Not yet qualified for release";
    private sealed record CompletionCriterion(string Id, string Text, string EvidenceKind, string? ProofReference, string? OperatorIdentity, bool Blocking = true, bool MissedWithException = false);
    private sealed record CompletionPolicyDto(string? EnvironmentName, bool RequireApproval, string? TargetJson);
    private sealed record CapturedPolicyDto(CompletionPolicyDto? Policy);
    private sealed record CompletionExceptionDto(string Reason, string OperatorIdentity, DateTimeOffset RecordedAt);
    private sealed record CompletionDetail(CompletionSummary Receipt, IReadOnlyList<CompletionBatch> Batches, string? NextCursor, IReadOnlyList<CompletionCriterion> Criteria);
}
