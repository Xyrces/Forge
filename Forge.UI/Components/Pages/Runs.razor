@page "/runs"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@implements IDisposable
@using System.Net.Http.Json
@using Forge.Dashboard.Services
<PageTitle>Agent runs</PageTitle>
<div class="page task-detail">
    <div class="page-header"><h1>Agent runs</h1><button class="btn" @onclick="LoadAsync">Refresh</button></div>
    <p class="meta-text">Recorded agent work. A completed run does not itself establish verification, publication or deployment.</p>
    @if (_loadError is not null) { <p class="banner banner--error" role="alert">Couldn’t refresh runs: @_loadError <button class="btn" @onclick="LoadAsync">Retry</button></p> }
    @if (_data is null && _loadError is null) { <p>Loading…</p> }
    @if (_data is not null)
    {
        <section class="card"><h2>Active · @_data.Active.Count</h2>
            @if (_data.Active.Count == 0) { <p class="meta-text">No agents currently running.</p> }
            <div class="task-run-list">@foreach (var r in _data.Active) { <article><div><a href="@($"/runs/{Uri.EscapeDataString(r.Id)}{ProjectQuery(r.ScopeProjectId)}")">@(r.TaskTitle ?? r.TaskId ?? "Planning run")</a><span>@WorkPresentation.Role(r.Role) · @Elapsed(r)</span></div><p>@(r.Phase ?? "Agent working")</p></article> }</div>
        </section>
        <section class="card"><h2>Recent history</h2><p class="meta-text">Latest 50 retained runs. Earlier runs may have expired under the retention policy.</p>
            <div class="task-run-list">@foreach (var r in _data.Recent) { <article><div><a href="@($"/runs/{Uri.EscapeDataString(r.Id)}{ProjectQuery(r.ScopeProjectId)}")">@(r.TaskTitle ?? r.TaskId ?? "Planning run")</a><strong>@WorkPresentation.RunOutcome(r.Status, r.Role)</strong></div><p class="meta-text">@WorkPresentation.Role(r.Role) · @r.StartedAt.ToLocalTime().ToString("MMM d, HH:mm") · @(r.DurationMs is { } ms ? Fmt(ms) : "Duration not recorded")</p>@if (r.Error is { Length: > 0 }) { <details><summary>Run diagnostic</summary><RecordedMarkdown Text="@r.Error" /></details> }</article> }</div>
            @if (_data.Recent.Count == 0) { <p>No finished runs recorded.</p> }
        </section>
    }
</div>
@code {
    private RunsDto? _data;
    private string? _loadError;
    private System.Threading.Timer? _timer;
    private string? _loadedProject;
    private int _loadGeneration;
    [Parameter][SupplyParameterFromQuery(Name = "project")] public string? Project { get; set; }

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(LoadAsync), null,
            TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    private static string ProjectBadge(string? projectId) => projectId ?? "legacy";
    private static string ProjectQuery(string? projectId) =>
        projectId is null ? "" : $"?project={Uri.EscapeDataString(projectId)}";

    private async Task LoadAsync()
    {
        var project = Project ?? ShellStore.Value.CurrentProjectId;
        var generation = ++_loadGeneration;
        if (_loadedProject != project) { _data = null; _loadedProject = project; }
        try
        {
            // agent_run is per-project workload data: follow the
            // active-project lens (the 5s poll re-reads it). Rows
            // pre-dating the per-project writers live in the primary
            // store and show the "legacy" badge.
            var lens = project is { } pid
                ? $"?projectId={Uri.EscapeDataString(pid)}"
                : string.Empty;
            var data = await Http.GetFromJsonAsync<RunsDto>("/api/agent-runs" + lens);
            if (generation != _loadGeneration || project != (Project ?? ShellStore.Value.CurrentProjectId)) return;
            _data = data;
            _loadError = null;
            StateHasChanged();
        }
        catch (Exception ex) { if (generation == _loadGeneration) { _loadError = ex.Message; StateHasChanged(); } }
    }

    private static string Elapsed(RunViewDto r)
        => Fmt((long)(DateTime.UtcNow - r.StartedAt).TotalMilliseconds);

    private static string Fmt(long ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalSeconds}s";
    }

    public void Dispose() => _timer?.Dispose();

    private sealed record RunsDto(List<RunViewDto> Active, List<RunViewDto> Recent);
    private sealed record RunViewDto(
        string Id, string? TaskId, string Role, string? Model, string Status,
        DateTime StartedAt, DateTime? FinishedAt, long? DurationMs,
        int? MessageCount, int? ToolCallCount, int? TextChars,
        string? Error, bool HasTranscript, string? Phase, bool? ResumedSession,
        string? ProjectId, string? TaskTitle, string? ScopeProjectId);
}
