@page "/runs"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@implements IDisposable
@using System.Net.Http.Json

<PageTitle>Agent runs</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Agent runs</h1>
        <div class="page-header__meta">@(_data is null ? "loading…" : $"{_data.Active.Count} active · {_data.Recent.Count} recent")</div>
        <div class="page-header__actions">
            <button class="btn" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (_data is null && _loadError is not null)
    {
        <div class="banner banner--error">Failed to load agent runs: @_loadError <button class="btn btn--small" @onclick="LoadAsync">Retry</button></div>
    }
    else if (_data is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        @if (_data.Active.Count > 0)
        {
            <div class="run-active-grid">
                @foreach (var r in _data.Active)
                {
                    <div class="run-active-card">
                        <div class="run-active-card__top">
                            <span class="run-active-card__role">
                                <span class="agent-row__dot"></span>
                                <strong>@r.Role</strong>
                                <span class="pill">@ProjectBadge(r.ProjectId)</span>
                            </span>
                            <span class="mono run-active-card__elapsed">@Elapsed(r)</span>
                        </div>
                        <div class="run-active-card__body">
                            @if (r.TaskId is not null)
                            {
                                <a href="@($"/tasks/{r.TaskId}{ProjectQuery(r.ProjectId)}")" class="mono">@r.TaskId</a>
                            }
                            else
                            {
                                <span class="mono">(no task)</span>
                            }
                            <span class="meta-text"> · @r.Model</span>
                            @if (r.ResumedSession == true)
                            {
                                <span class="pill pill--info">resumed</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(r.Phase))
                        {
                            <div class="meta-text">@r.Phase</div>
                        }
                        <div class="mono run-active-card__meta">run @r.Id · started @r.StartedAt.ToLocalTime().ToString("HH:mm:ss")</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="page-subtitle" style="margin-bottom:14px">No agent runs in flight.</div>
        }

        <table class="data-grid">
            <thead>
                <tr>
                    <th>When</th><th>Role</th><th>Task</th><th>Duration</th>
                    <th>Msgs</th><th>Tools</th><th>Status</th><th>Phase</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (_data.Recent.Count == 0)
                {
                    <tr><td colspan="9" class="meta-text">No finished runs yet.</td></tr>
                }
                @foreach (var r in _data.Recent)
                {
                    <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/runs/{r.Id}{ProjectQuery(r.ProjectId)}"))">
                        <td class="mono">@r.StartedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                        <td>
                            @r.Role
                            <span class="pill">@ProjectBadge(r.ProjectId)</span>
                            @if (r.ResumedSession == true)
                            {
                                <span class="pill pill--info">resumed</span>
                            }
                        </td>
                        <td class="mono">@(r.TaskId ?? "—")</td>
                        <td class="mono">@(r.DurationMs is null ? "—" : Fmt(r.DurationMs.Value))</td>
                        <td class="mono">@(r.MessageCount?.ToString() ?? "—")</td>
                        <td class="mono">@(r.ToolCallCount?.ToString() ?? "—")</td>
                        <td>
                            <span class="pill @(r.Status == "succeeded" ? "pill--completed" : r.Status == "failed" ? "pill--failed" : "pill--pending")">@r.Status</span>
                            @if (r.Error is not null)
                            {
                                <span style="font-size:11px;color:var(--on-surface-variant)" title="@r.Error"> ⚠</span>
                            }
                        </td>
                        <td class="meta-text">@(r.Phase ?? "—")</td>
                        <td>@(r.HasTranscript ? "transcript →" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private RunsDto? _data;
    private string? _loadError;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(LoadAsync), null,
            TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    private static string ProjectBadge(string? projectId) => projectId ?? "legacy";
    private static string ProjectQuery(string? projectId) =>
        projectId is null ? "" : $"?project={Uri.EscapeDataString(projectId)}";

    private async Task LoadAsync()
    {
        try
        {
            // agent_run is per-project workload data: follow the
            // active-project lens (the 5s poll re-reads it). Rows
            // pre-dating the per-project writers live in the primary
            // store and show the "legacy" badge.
            var lens = ShellStore.Value.CurrentProjectId is { } pid
                ? $"?projectId={Uri.EscapeDataString(pid)}"
                : string.Empty;
            _data = await Http.GetFromJsonAsync<RunsDto>("/api/agent-runs" + lens);
            _loadError = null;
            StateHasChanged();
        }
        catch (Exception ex) { _loadError = ex.Message; /* keep last good */ }
    }

    private static string Elapsed(RunViewDto r)
        => Fmt((long)(DateTime.UtcNow - r.StartedAt).TotalMilliseconds);

    private static string Fmt(long ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalSeconds}s";
    }

    public void Dispose() => _timer?.Dispose();

    private sealed record RunsDto(List<RunViewDto> Active, List<RunViewDto> Recent);
    private sealed record RunViewDto(
        string Id, string? TaskId, string Role, string? Model, string Status,
        DateTime StartedAt, DateTime? FinishedAt, long? DurationMs,
        int? MessageCount, int? ToolCallCount, int? TextChars,
        string? Error, bool HasTranscript, string? Phase, bool? ResumedSession,
        string? ProjectId);
}
