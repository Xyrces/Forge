@page "/vision"
@inject HttpClient Http
@implements IDisposable

<PageTitle>Vision</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Vision</h1>
        @if (_snapshot is not null)
        {
            <div class="page-header__meta">
                Last revised @(_snapshot.LastModifiedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—") ·
                @_snapshot.Content?.Length.ToString("N0") chars
            </div>
        }
        <div class="page-header__actions">
            <button class="btn" @onclick="RefreshAsync" disabled="@(_refreshing || _editing)">Refresh</button>
            @if (!_editing)
            {
                <button class="btn btn--primary" @onclick="StartEdit">@(_snapshot?.Exists == true ? "Edit" : "Create")</button>
            }
        </div>
    </div>

    @if (_snapshot is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (_editing)
    {
        <div style="display:flex;flex-direction:column;gap:10px">
            <div class="page-subtitle">
                Editing <span class="mono">@_snapshot.Path</span> — saved to the project root and
                injected into every agent prompt as the <span class="mono">vision/master</span> memory key.
            </div>
            <textarea class="mono" style="min-height:55vh;resize:vertical"
                      @bind="_editContent" placeholder="# Master Design&#10;&#10;The north-star design every agent run is anchored to."></textarea>
            <div style="display:flex;gap:8px;align-items:center">
                <button class="btn btn--primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                <button class="btn" @onclick="CancelEdit" disabled="@_saving">Cancel</button>
                @if (_saveError is not null)
                {
                    <span class="text-danger">@_saveError</span>
                }
            </div>
        </div>
    }
    else if (!_snapshot.Exists)
    {
        <div class="page-subtitle">
            No vision file yet. Create one to give every agent run a north-star design anchor —
            its content is injected into prompts as the <span class="mono">vision/master</span> memory key.
        </div>
        <div style="display:flex;gap:8px;align-items:center;margin-top:12px">
            <button class="btn btn--primary" @onclick="StartEdit">Write it now</button>
            <button class="btn" @onclick="RequestDraftAsync" disabled="@_drafting">
                @(_drafting ? "Filing…" : "Draft from codebase")
            </button>
            @if (_draftTaskId is not null)
            {
                <span class="page-subtitle">
                    Task <a href="/tasks/@_draftTaskId" class="mono">@_draftTaskId</a> filed —
                    it goes through grooming, then a sprint, then a PR. This page fills in when it merges.
                </span>
            }
            @if (_draftError is not null)
            {
                <span class="text-danger">@_draftError</span>
            }
        </div>
    }
    else
    {
        <div class="vision-split">
            <aside class="vision-toc">
                <div class="vision-toc__title">Sections</div>
                @foreach (var heading in _headings)
                {
                    <button class="vision-toc__item @(heading == _activeHeading ? "vision-toc__item--active" : "")"
                            @onclick="@(() => ScrollTo(heading))">
                        @heading
                    </button>
                }
            </aside>

            <article class="vision-body">
                @foreach (var block in _blocks)
                {
                    @if (block.Kind == "h1")
                    {
                        <h1 class="vision-h1">@block.Text</h1>
                        <div class="vision-meta mono">forge/MASTER_DESIGN.md · @_snapshot.Content?.Length.ToString("N0") chars · @(_snapshot.LastModifiedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                    }
                    else if (block.Kind == "h2")
                    {
                        <h2 class="vision-h2">@block.Text</h2>
                    }
                    else if (block.Kind == "h3")
                    {
                        <h3 class="vision-h3">@block.Text</h3>
                    }
                    else if (block.Kind == "code")
                    {
                        <pre class="vision-code"><code>@block.Text</code></pre>
                    }
                    else if (block.Kind == "li")
                    {
                        <div class="vision-li">• @block.Text</div>
                    }
                    else
                    {
                        <p class="vision-p">@block.Text</p>
                    }
                }
            </article>
        </div>
    }
</div>

@code {
    private SnapshotDto? _snapshot;
    private List<MarkdownBlock> _blocks = new();
    private List<string> _headings = new();
    private string? _activeHeading;
    private bool _refreshing;
    private bool _editing;
    private bool _saving;
    private string _editContent = "";
    private string? _saveError;
    private bool _drafting;
    private string? _draftTaskId;
    private string? _draftError;

    public sealed record SnapshotDto(bool Exists, string Path, string? Content, DateTime? LastModifiedUtc);

    private sealed record MarkdownBlock(string Kind, string Text);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _snapshot = await Http.GetFromJsonAsync<SnapshotDto>("/api/vision");
            Parse();
        }
        catch { _snapshot = new(false, "", null, null); }
        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        try
        {
            await Http.PostAsync("/api/vision/refresh", null);
            await LoadAsync();
        }
        finally { _refreshing = false; }
    }

    private void StartEdit()
    {
        _editContent = _snapshot?.Content ?? "";
        _saveError = null;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _saveError = null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saveError = null;
        try
        {
            var resp = await Http.PutAsJsonAsync("/api/vision", new { content = _editContent });
            if (!resp.IsSuccessStatusCode)
            {
                _saveError = $"save failed: {(int)resp.StatusCode}";
                return;
            }
            _editing = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _saveError = $"save failed: {ex.Message}";
        }
        finally { _saving = false; }
    }

    private async Task RequestDraftAsync()
    {
        _drafting = true;
        _draftError = null;
        try
        {
            var resp = await Http.PostAsync("/api/vision/draft-request", null);
            if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _draftError = "a vision draft task is already open";
                return;
            }
            if (!resp.IsSuccessStatusCode)
            {
                _draftError = $"request failed: {(int)resp.StatusCode}";
                return;
            }
            var payload = await resp.Content.ReadFromJsonAsync<DraftResponse>();
            _draftTaskId = payload?.TaskId;
        }
        catch (Exception ex)
        {
            _draftError = $"request failed: {ex.Message}";
        }
        finally { _drafting = false; }
    }

    private sealed record DraftResponse(string TaskId, string Status);

    private void Parse()
    {
        _blocks = new();
        _headings = new();
        if (_snapshot?.Content is null) return;

        var lines = _snapshot.Content.Split('\n');
        bool inCode = false;
        var codeBuf = new List<string>();
        foreach (var raw in lines)
        {
            var line = raw.TrimEnd('\r');
            if (line.StartsWith("```"))
            {
                if (inCode)
                {
                    _blocks.Add(new("code", string.Join("\n", codeBuf)));
                    codeBuf.Clear();
                    inCode = false;
                }
                else inCode = true;
                continue;
            }
            if (inCode) { codeBuf.Add(line); continue; }

            if (line.StartsWith("# ")) { var t = line[2..].Trim(); _blocks.Add(new("h1", t)); _headings.Add(t); _activeHeading ??= t; }
            else if (line.StartsWith("## ")) { var t = line[3..].Trim(); _blocks.Add(new("h2", t)); _headings.Add(t); }
            else if (line.StartsWith("### ")) { var t = line[4..].Trim(); _blocks.Add(new("h3", t)); }
            else if (line.StartsWith("- ")) _blocks.Add(new("li", line[2..].Trim()));
            else if (!string.IsNullOrWhiteSpace(line)) _blocks.Add(new("p", line));
        }
    }

    private void ScrollTo(string heading)
    {
        _activeHeading = heading;
        StateHasChanged();
    }

    public void Dispose() { }
}