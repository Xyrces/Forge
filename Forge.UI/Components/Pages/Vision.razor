@page "/vision"
@using Forge.Dashboard.Components.Shared
@using Forge.Dashboard.Services
@inject HttpClient Http
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject IState<AppShellState> ShellStore
@implements IAsyncDisposable

<PageTitle>Vision</PageTitle>
<div class="page vision-workspace">
    <div class="page-header">
        <h1>@ProjectName vision</h1>
        <div class="page-header__actions">
            <button class="btn" @onclick="RefreshAsync" disabled="@(_loading || Busy || _sourceEditing && !_session.MustRefresh)">Refresh</button>
            <button class="btn" @onclick="ShowSource" disabled="@(_map is null || Busy)">Source document</button>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="banner banner--error" role="alert">@_error</div>
    }
    @if (_storageError is not null)
    {
        <div class="banner banner--warning" role="status">@_storageError</div>
    }
    @if (_session.GuidancePending)
    {
        <div class="banner banner--warning" role="alert">The project vision was saved. Agent guidance still needs synchronization. Use Refresh to retry it.</div>
    }
    else if (_session.MustRefresh)
    {
        <div class="banner banner--warning" role="alert">Refresh the source before sending or applying another change.</div>
    }
    @if (_stale)
    {
        <div class="banner banner--warning" role="alert">
            The source changed while this draft was open. Review the retained draft below, then discard it to continue from the latest source.
        </div>
    }
    @if (_loading)
    {
        <p class="page-subtitle" role="status">Loading project vision…</p>
    }
    else if (_projectId is null)
    {
        <p class="page-subtitle">Choose a project in the top bar to open its vision.</p>
    }
    else if (_map is not null)
    {
        @if (_sourceOpen)
        {
            <section class="card vision-source">
                <div class="vision-section-header">
                    <h2>Source document</h2>
                    <button class="btn" @onclick="CloseSource" disabled="@(Busy || _sourceEditing)">Close</button>
                </div>
                <p class="page-subtitle">The repository supplies the initial vision. Saved edits belong to this project in Forge and leave the repository unchanged.</p>
                @if (string.IsNullOrWhiteSpace(_map.Source) && !_sourceEditing)
                {
                    <p class="page-subtitle">Alternatively, ask Forge to analyze the codebase. This creates a backlog task that goes through grooming, a sprint, and review.</p>
                    <button class="btn" @onclick="RequestDraftAsync" disabled="@(Busy || _draftTaskId is not null)">Draft from codebase</button>
                    @if (_draftTaskId is not null)
                    {
                        <p role="status"><a href="@($"/tasks/{Uri.EscapeDataString(_draftTaskId)}?projectId={Uri.EscapeDataString(_projectId!)}")">View the vision draft task</a> · Waiting for grooming.</p>
                    }
                }
                @if (_sourceEditing)
                {
                    <label for="vision-source-text">Markdown</label>
                    <textarea id="vision-source-text" class="vision-source-text mono" maxlength="@VisionUiLimits.MaxSourceCharacters" @bind="_sourceText" @bind:event="oninput" @bind:after="PersistAsync" disabled="@Busy"></textarea>
                    <div class="vision-actions">
                        <button class="btn btn--primary" @onclick="SaveSourceAsync" disabled="@(Busy || _stale || _session.MustRefresh || _session.GuidancePending || _session.Pending.Count > 0 || _sourceRevision != _map.Revision)">Save source</button>
                        <button class="btn" @onclick="CancelSourceAsync" disabled="@Busy">Cancel edit</button>
                        @if (_repositorySource is not null)
                        {
                            <button class="btn" @onclick="LoadRepositorySourceAsync" disabled="@(Busy || _sourceText != _map.Source || _repositorySource.Length > VisionUiLimits.MaxSourceCharacters)">Load repository Markdown</button>
                        }
                    </div>
                    @if (_repositoryChecked && _repositorySource is null)
                    {
                        <p class="page-subtitle">This repository has no vision document to import.</p>
                    }
                    @if (_sourceRevision != _map.Revision && !_session.MustRefresh)
                    {
                        <div class="banner banner--warning">The saved source changed. Your edit is retained above. Compare it with the latest source below and reconcile any differences before replacing it.</div>
                        <details><summary>Latest saved source</summary><pre class="vision-original">@_map.Source</pre></details>
                        <button class="btn" @onclick="UseLatestSourceBaselineAsync" disabled="@Busy">I have reconciled my edit with this version</button>
                    }
                }
                else
                {
                    <div class="vision-actions">
                        <button class="btn" @onclick="EditSource" disabled="@(Busy || _session.Pending.Count > 0 || _map.Source.Length > VisionUiLimits.MaxSourceCharacters)">Edit Markdown</button>
                        <button class="btn" @onclick="CopySourceAsync">Copy Markdown</button>
                    </div>
                    @if (_map.Source.Length > VisionUiLimits.MaxSourceCharacters)
                    {
                        <p class="page-subtitle">This document exceeds the browser editor’s 256 Ki character limit. You can copy its complete source or refine it through the conversation.</p>
                    }
                    <pre class="vision-original">@_map.Source</pre>
                }
            </section>
        }
        <div class="vision-conversation-layout">
            <section class="vision-conversation" aria-label="Project vision conversation">
                <h2>Talk about the vision</h2>
                <p class="page-subtitle">Describe what you have in mind. The editor will find the affected ideas across the project.</p>
                <div class="vision-conversation-feed" role="log" aria-label="Vision conversation">
                    @foreach (var message in _session.Messages)
                    {
                        <div class="chat-msg chat-msg--@message.Role">
                            <div class="chat-msg__role">@(message.Role == "user" ? "You" : "Vision editor")</div>
                            <div class="chat-msg__body md">@((MarkupString)MarkdownRenderer.ToHtml(message.Text))</div>
                        </div>
                    }
                    @if (_sending)
                    {
                        <div class="chat-msg chat-msg--user">
                            <div class="chat-msg__role">You</div>
                            <div class="chat-msg__body">@_sentText</div>
                        </div>
                        <p class="page-subtitle" role="status">Considering your message and the project vision…</p>
                    }
                </div>
                <label for="vision-message">Your message</label>
                <textarea id="vision-message" rows="4" maxlength="16000" @bind="_session.Input" @bind:event="oninput" @bind:after="PersistAsync"
                          placeholder="@(_map.Source.Length == 0 ? "Tell me what this project should be…" : "What would you like to refine?")" disabled="@Busy"></textarea>
                <div class="vision-actions">
                    <button class="btn btn--primary" @onclick="SendAsync" disabled="@(Busy || _stale || _session.MustRefresh || _session.GuidancePending || string.IsNullOrWhiteSpace(_session.Input) || _sourceEditing)">Send</button>
                    @if (_sending)
                    {
                        <button class="btn" @onclick="CancelRequest">Cancel</button>
                    }
                    @if (_session.Pending.Count > 0)
                    {
                        <button class="btn" @onclick="ApplyAsync" disabled="@(Busy || _stale || _session.MustRefresh || _session.GuidancePending)">Apply draft</button>
                        <button class="btn btn--link" @onclick="DiscardAsync" disabled="@Busy">Discard draft</button>
                    }
                </div>
                @if (_status is not null)
                {
                    <p class="page-subtitle" role="status">@_status</p>
                }
            </section>
            <div class="vision-map-and-detail">
                <VisionMindMap Nodes="@VisibleNodes" RootTitle="@ProjectName" Pending="@_session.Pending" SelectedId="@_session.SelectedId"
                               Selected="SelectNodeAsync" @key="_projectId" />
                @if (_session.Pending.Count > 0)
                {
                    <section class="vision-draft" aria-label="Proposed changes">
                        <h2>Proposed changes</h2>
                        @foreach (var edit in _session.Pending)
                        {
                            <details class="vision-change" open>
                                <summary>@EditTitle(edit) <span class="pill">@(edit.Operation == "add" ? "New idea" : "Edit")</span></summary>
                                <div class="vision-comparison">
                                    <div><h3>@(edit.Operation == "add" ? "Under" : edit.Operation == "append" ? "Add to" : "Current wording")</h3><div class="md">@((MarkupString)MarkdownRenderer.ToHtml(CurrentWording(edit)))</div></div>
                                    <div><h3>Proposed wording</h3><div class="md">@((MarkupString)MarkdownRenderer.ToHtml(edit.After))</div></div>
                                </div>
                            </details>
                        }
                    </section>
                }
                @if (SelectedNode is { } node)
                {
                    <section class="vision-node-detail" aria-label="Selected idea">
                        <div class="vision-section-header">
                            <h2>@node.Title</h2>
                            <button class="btn btn--link" @onclick="ClearSelectionAsync">Close details</button>
                        </div>
                        <div class="md">@((MarkupString)MarkdownRenderer.ToHtml(node.Id == "root" ? _map.Source : node.Text))</div>
                    </section>
                }
                @if (_map.Source.Length == 0)
                {
                    <p class="page-subtitle vision-empty">Start with a conversation to grow this project’s vision.</p>
                }
            </div>
        </div>
    }
</div>
