@page "/intake"
@inject HttpClient Http
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@implements IDisposable

<PageTitle>Intake</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Intake</h1>
        <div class="page-header__meta">@(_sessions?.Count ?? 0) sessions</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="StartNewSession">New session</button>
        </div>
    </div>

    @if (_actionError is not null)
    {
        <div class="banner banner--error">
            <span>@_actionError</span>
            <button class="btn btn--link" @onclick="() => _actionError = null">Dismiss</button>
        </div>
    }

    <div class="intake-split">
        <aside class="intake-sessions">
            @if (_sessions is null)
            {
                <div class="page-subtitle">Loading…</div>
            }
            else if (_sessions.Count == 0)
            {
                <div class="page-subtitle">No intake sessions yet.</div>
            }
            else
            {
                @foreach (var s in _sessions)
                {
                    <button class="intake-session @(s.Id == _activeSessionId ? "intake-session--active" : "")"
                            @onclick="@(() => SetActive(s.Id))">
                        <div class="intake-session__title">@s.Title</div>
                        <div class="intake-session__meta mono">@s.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </button>
                }
            }
        </aside>

        <section class="intake-thread">
            @if (_activeSessionId is null)
            {
                <div class="page-subtitle">Pick a session on the left, or start a new one.</div>
            }
            else if (_messages is null)
            {
                <div class="page-subtitle">Loading…</div>
            }
            else
            {
                @foreach (var m in _messages)
                {
                    <div class="chat-msg chat-msg--@m.Role.ToLowerInvariant()">
                        <div class="chat-msg__role mono">@m.Role</div>
                        <div class="chat-msg__body">@m.Content</div>
                        @if (m.ProposedEpicId is not null)
                        {
                            <div class="chat-msg__card">
                                <div class="chat-msg__card-header">Proposed Epic</div>
                                <div class="chat-msg__card-title">@m.ProposedEpicTitle</div>
                                @if (_acceptedEpicIds.Contains(m.Id))
                                {
                                    <span class="pill pill--primary">Accepted</span>
                                }
                                else
                                {
                                    <button class="btn btn--primary" @onclick="@(() => AcceptEpic(m.Id))" disabled="@_accepting">
                                        @(_accepting ? "Accepting…" : "Accept Epic")
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                <div class="intake-input">
                    <input class="intake-input__field" @bind="_draft" placeholder="Type your message..."
                           @onkeydown="@(async e => { if (e.Key == "Enter" && !_sending) await SendMessage(); })" />
                    <button class="btn btn--primary" @onclick="SendMessage" disabled="@_sending">Send</button>
                </div>
            }
        </section>

        <aside class="intake-context">
            <div class="intake-context__tabs">
                <button class="chip @(_activeTab == "spec" ? "chip--active" : "")" @onclick='() => SelectTab("spec")'>Spec Draft</button>
                <button class="chip @(_activeTab == "arch" ? "chip--active" : "")" @onclick='() => SelectTab("arch")'>Architecture</button>
                <button class="chip @(_activeTab == "memory" ? "chip--active" : "")" @onclick='() => SelectTab("memory")'>Memory</button>
            </div>
            <div class="intake-context__body">
                @if (_activeTab == "spec")
                {
                    @if (_activeSessionId is null)
                    {
                        <p class="page-subtitle">Pick a session to see its spec drafts.</p>
                    }
                    else if (_sessionSpecs is null)
                    {
                        <p class="page-subtitle">Loading…</p>
                    }
                    else if (_sessionSpecs.Count == 0)
                    {
                        <p class="page-subtitle">No specs for this session yet — they appear after you accept a proposed epic.</p>
                    }
                    else
                    {
                        @foreach (var spec in _sessionSpecs)
                        {
                            <div class="card" style="margin-bottom:10px">
                                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                                    <strong>@spec.Title</strong>
                                    <span class="pill pill--@spec.Status.ToLowerInvariant()">@spec.Status</span>
                                </div>
                                <div class="mono page-subtitle">@spec.Id · v@spec.CurrentVersion</div>
                                @if (!string.IsNullOrWhiteSpace(spec.Body))
                                {
                                    <pre class="intake-spec-body">@Truncate(spec.Body, 800)</pre>
                                }
                            </div>
                        }
                    }
                }
                else if (_activeTab == "arch")
                {
                    <div style="display:flex;gap:8px;margin-bottom:10px">
                        <button class="btn" @onclick="RebuildGraph" disabled="@_graphLoading">
                            @(_graphLoading ? "Building…" : "Refresh Graph")
                        </button>
                    </div>
                    @if (_graphError is not null)
                    {
                        <div class="banner banner--error"><span>@_graphError</span></div>
                    }
                    @if (_graph is not null)
                    {
                        <p class="page-subtitle">
                            @_graph.FileCount files · @_graph.ImportCount imports · @_graph.ProjectEdgeCount project edges<br />
                            sha @_graph.RepoSha[..Math.Min(8, _graph.RepoSha.Length)] · built @_graph.BuiltAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </p>
                        @if (_graph.Files.Count > 0)
                        {
                            <div class="intake-module-list">
                                @foreach (var mod in _graph.Files.GroupBy(f => f.Module).OrderByDescending(g => g.Count()).Take(20))
                                {
                                    <div class="intake-module">
                                        <span class="mono">@(string.IsNullOrEmpty(mod.Key) ? "(root)" : mod.Key)</span>
                                        <span class="page-subtitle">@mod.Count() files</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (!_graphLoading && _graphError is null)
                    {
                        <p class="page-subtitle">Load the codebase graph for the current project.</p>
                    }
                }
                else
                {
                    @if (_memory is null)
                    {
                        <p class="page-subtitle">Loading…</p>
                    }
                    else if (_memory.Count == 0)
                    {
                        <p class="page-subtitle">No memory entries yet.</p>
                    }
                    else
                    {
                        @foreach (var m in _memory.Take(30))
                        {
                            <div class="intake-memory-row">
                                <span class="mono">@m.Key</span>
                                <span class="page-subtitle">@Truncate(m.Body, 120)</span>
                            </div>
                        }
                    }
                }
            </div>
        </aside>
    </div>
</div>

@code {
    private List<SessionDto>? _sessions;
    private List<MessageDto>? _messages;
    private string? _activeSessionId;
    private string _draft = "";
    private bool _sending;
    private bool _accepting;
    private readonly HashSet<long> _acceptedEpicIds = new();
    private string? _actionError;
    private string _activeTab = "spec";
    private List<SessionSpecDto>? _sessionSpecs;
    private GraphDto? _graph;
    private bool _graphLoading;
    private string? _graphError;
    private List<MemoryDto>? _memory;

    public sealed record SessionDto(string Id, string ProjectId, string Title, DateTime CreatedAt, DateTime UpdatedAt, List<MessageDto>? Messages);
    public sealed record MessageDto(long Id, string Role, string Content, DateTime Timestamp, string? ProposedEpicId, string? ProposedEpicTitle);
    public sealed record SessionSpecDto(string Id, string ProjectId, string Title, string Status, int CurrentVersion, string? Body);
    public sealed record GraphDto(string RepoRoot, string RepoSha, DateTime BuiltAt, int FileCount, int ImportCount, int ProjectEdgeCount, List<GraphFileDto> Files);
    public sealed record GraphFileDto(string Path, string Module, string Language);
    public sealed record MemoryDto(string Key, string Body, DateTime UpdatedAt);

    private void SelectTab(string tab)
    {
        _activeTab = tab;
        _ = tab switch
        {
            "spec" => LoadSessionSpecs(),
            "arch" => LoadGraph(forceRebuild: false),
            "memory" => LoadMemory(),
            _ => Task.CompletedTask,
        };
    }

    private async Task LoadSessionSpecs()
    {
        if (_activeSessionId is null) { _sessionSpecs = null; return; }
        try
        {
            _sessionSpecs = await Http.GetFromJsonAsync<List<SessionSpecDto>>($"/api/intake/sessions/{_activeSessionId}/specs");
        }
        catch { _sessionSpecs = new(); }
        StateHasChanged();
    }

    private async Task<string?> CurrentProjectRoot()
    {
        try
        {
            var id = ShellStore.Value.CurrentProjectId;
            if (id is null) return null;
            var projects = await Http.GetFromJsonAsync<List<ProjectRootDto>>("/api/projects/");
            return projects?.FirstOrDefault(p => string.Equals(p.Id, id, StringComparison.OrdinalIgnoreCase))?.Root;
        }
        catch { return null; }
    }

    private async Task LoadGraph(bool forceRebuild)
    {
        _graphLoading = true;
        _graphError = null;
        StateHasChanged();
        try
        {
            var root = await CurrentProjectRoot();
            if (string.IsNullOrWhiteSpace(root))
            {
                _graphError = "Current project's local path is unknown — cannot build the codebase graph.";
                return;
            }
            var url = forceRebuild
                ? $"/api/codebase-graph/rebuild?repoRoot={Uri.EscapeDataString(root)}"
                : $"/api/codebase-graph?repoRoot={Uri.EscapeDataString(root)}";
            if (forceRebuild)
            {
                var resp = await Http.PostAsync(url, null);
                if (!resp.IsSuccessStatusCode)
                {
                    _graphError = $"Graph build failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
                    return;
                }
                _graph = await Http.GetFromJsonAsync<GraphDto>($"/api/codebase-graph?repoRoot={Uri.EscapeDataString(root)}");
            }
            else
            {
                _graph = await Http.GetFromJsonAsync<GraphDto>(url);
            }
        }
        catch (Exception ex) { _graphError = ex.Message; }
        finally
        {
            _graphLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMemory()
    {
        try
        {
            _memory = await Http.GetFromJsonAsync<List<MemoryDto>>("/api/memory");
        }
        catch { _memory = new(); }
        StateHasChanged();
    }

    private static string Truncate(string s, int max) =>
        string.IsNullOrEmpty(s) || s.Length <= max ? s : s[..max] + "…";

    public sealed record ProjectRootDto(string Id, string Root);

    protected override async Task OnInitializedAsync()
    {
        await ReloadSessions();
    }

    private async Task ReloadSessions()
    {
        try
        {
            _sessions = await Http.GetFromJsonAsync<List<SessionDto>>("/api/intake/sessions");
            if (_sessions is { Count: > 0 } && _activeSessionId is null)
            {
                await SetActive(_sessions[0].Id);
            }
            else
            {
                StateHasChanged();
            }
        }
        catch { _sessions = new(); }
    }

    private async Task SetActive(string id)
    {
        _activeSessionId = id;
        _sessionSpecs = null;
        try
        {
            var resp = await Http.GetFromJsonAsync<SessionDto>($"/api/intake/sessions/{id}");
            _messages = resp?.Messages?.ToList() ?? new();
            if (_activeTab == "spec") await LoadSessionSpecs();
        }
        catch { _messages = new(); }
        StateHasChanged();
    }

    private async Task StartNewSession()
    {
        // The intake session is created for the project selected in
        // the topbar switcher — everything downstream (spec, groomed
        // tasks, dispatch) flows into that project's stores.
        var projectId = ShellStore.Value.CurrentProjectId;
        if (string.IsNullOrEmpty(projectId))
        {
            _actionError = "No project selected in the topbar switcher yet.";
            return;
        }
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/intake/sessions", new { projectId, title = "New session" });
            if (resp.IsSuccessStatusCode)
            {
                _actionError = null;
                var created = await resp.Content.ReadFromJsonAsync<SessionDto>();
                await ReloadSessions();
                // Select the session we just created — ReloadSessions
                // defaults to the first (oldest) one, which strands
                // the operator in a stale thread.
                if (created is not null)
                {
                    await SetActive(created.Id);
                }
            }
            else
            {
                _actionError = $"Create session failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _actionError = ex.Message; }
    }

    private async Task AcceptEpic(long messageId)
    {
        if (_activeSessionId is null) return;
        _accepting = true;
        try
        {
            var resp = await Http.PostAsync(
                $"/api/intake/sessions/{_activeSessionId}/accept-epic/{messageId}", null);
            if (resp.IsSuccessStatusCode)
            {
                _acceptedEpicIds.Add(messageId);
                _actionError = null;
                await LoadSessionSpecs();
            }
            else
            {
                _actionError = $"Accept failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _accepting = false; }
    }

    private async Task SendMessage()
    {
        if (_activeSessionId is null || string.IsNullOrWhiteSpace(_draft)) return;
        _sending = true;
        try
        {
            await Http.PostAsJsonAsync($"/api/intake/sessions/{_activeSessionId}/messages", new { text = _draft });
            _draft = "";
            await SetActive(_activeSessionId);
        }
        catch { }
        finally { _sending = false; }
    }

    private Task RebuildGraph() => LoadGraph(forceRebuild: true);

    public void Dispose() { }
}