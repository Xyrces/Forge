@page "/intake"
@inject HttpClient Http
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@implements IAsyncDisposable

<PageTitle>Intake</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Intake</h1>
        <div class="page-header__meta">@(_sessions?.Count ?? 0) sessions</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="StartNewSession">New session</button>
        </div>
    </div>

    @if (_actionError is not null)
    {
        <div class="banner banner--error">
            <span>@_actionError</span>
            <button class="btn btn--link" @onclick="() => _actionError = null">Dismiss</button>
        </div>
    }

    <div class="intake-split">
        <aside class="intake-sessions">
            @if (_sessions is null)
            {
                <div class="page-subtitle">Loading…</div>
            }
            else if (_sessions.Count == 0)
            {
                <div class="page-subtitle">No intake sessions yet.</div>
            }
            else
            {
                @foreach (var s in _sessions)
                {
                    <button class="intake-session @(s.Id == _activeSessionId ? "intake-session--active" : "")"
                            @onclick="@(() => SetActive(s.Id))">
                        <div class="intake-session__title">
                            @s.Title
                            @switch (SessionProposalState(s))
                            {
                                case "accepted":
                                    <span class="intake-session__badge intake-session__badge--accepted" title="Epic accepted — session complete">✓</span>
                                    break;
                                case "pending":
                                    <span class="intake-session__badge intake-session__badge--pending" title="Epic proposed — awaiting your review">●</span>
                                    break;
                            }
                        </div>
                        <div class="intake-session__meta mono">@s.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </button>
                }
            }
        </aside>

        <section class="intake-thread" id="intake-thread-scroll">
            @if (_activeSessionId is null)
            {
                <div class="page-subtitle">Pick a session on the left, or start a new one.</div>
            }
            else if (_messages is null)
            {
                <div class="page-subtitle">Loading…</div>
            }
            else
            {
                @for (var i = 0; i < _messages.Count; i++)
                {
                    var m = _messages[i];
                    <div class="chat-msg chat-msg--@m.Role.ToLowerInvariant()">
                        <div class="chat-msg__role mono">@m.Role</div>
                        <div class="chat-msg__body md">@((MarkupString)Forge.Dashboard.Services.MarkdownRenderer.ToHtml(m.Content))</div>
                        @if (m.Questions is { Count: > 0 } qs)
                        {
                            @if (IsQuestionCardActive(i))
                            {
                                <div class="question-card">
                                    @for (var qi = 0; qi < qs.Count; qi++)
                                    {
                                        var q = qs[qi];
                                        var qKey = $"{m.Id}:{qi}";
                                        <div class="question-card__q">
                                            <div class="question-card__qhead">
                                                <span class="question-card__header mono">@(q.Header ?? $"Question {qi + 1}")</span>
                                                @if (q.Multiple)
                                                {
                                                    <span class="question-card__multi mono">select all that apply</span>
                                                }
                                            </div>
                                            <div class="question-card__text md">@((MarkupString)Forge.Dashboard.Services.MarkdownRenderer.ToHtml(q.Question))</div>
                                            @if (q.Options.Count > 0)
                                            {
                                                <div class="question-card__options">
                                                    @foreach (var opt in q.Options)
                                                    {
                                                        var (label, desc, recommended) = SplitOption(opt);
                                                        var selected = _answers.TryGetValue(qKey, out var sel) && sel.Contains(label);
                                                        <button class="option-row @(q.Multiple ? "option-row--multi" : "option-row--single") @(selected ? "option-row--selected" : "")"
                                                                @onclick="@(() => ToggleAnswer(qKey, label, q.Multiple))">
                                                            <span class="option-row__mark"></span>
                                                            <span class="option-row__body">
                                                                <span class="option-row__label">
                                                                    @label
                                                                    @if (recommended)
                                                                    {
                                                                        <span class="pill pill--primary">Recommended</span>
                                                                    }
                                                                </span>
                                                                @if (desc is not null)
                                                                {
                                                                    <span class="option-row__desc">@desc</span>
                                                                }
                                                            </span>
                                                        </button>
                                                    }
                                                    @if (_otherOpen.Contains(qKey))
                                                    {
                                                        <input class="option-row__other-input" placeholder="Your answer…"
                                                               value="@GetOther(qKey)"
                                                               @oninput="@(e => SetOther(qKey, e.Value?.ToString()))" />
                                                    }
                                                    else
                                                    {
                                                        <button class="option-row option-row--other" @onclick="@(() => _otherOpen.Add(qKey))">
                                                            <span class="option-row__mark"></span>
                                                            <span class="option-row__body"><span class="option-row__label">Other…</span></span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <input class="option-row__other-input" placeholder="Your answer…"
                                                       value="@GetOther(qKey)"
                                                       @oninput="@(e => SetOther(qKey, e.Value?.ToString()))" />
                                            }
                                        </div>
                                    }
                                    <div class="question-card__actions">
                                        <button class="btn btn--primary" @onclick="@(() => SendAnswers(m, qs))" disabled="@(AnsweredCount(m, qs) == 0 || _sending)">
                                            @(_sending ? "Sending…" : $"Send answers ({AnsweredCount(m, qs)}/{qs.Count})")
                                        </button>
                                        <button class="btn btn--link" @onclick="@(() => DismissQuestionCard(m))">Answer in text instead</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="question-card question-card--done">
                                    @foreach (var q in qs)
                                    {
                                        <div class="question-card__qhead">
                                            <span class="question-card__header mono">@(q.Header ?? "Question")</span>
                                        </div>
                                        <div class="question-card__text md">@((MarkupString)Forge.Dashboard.Services.MarkdownRenderer.ToHtml(q.Question))</div>
                                    }
                                </div>
                            }
                        }
                        @* Epic proposals render as slim audit cards in the thread; the
                           Accept ACTION lives in the sidebar's Proposal panel so the
                           session's completion state is always visible. *@
                        @if (m.ProposedEpicTitle is not null && m.Role.Equals("Assistant", StringComparison.OrdinalIgnoreCase))
                        {
                            var cardForMsg = Proposals.FirstOrDefault(c => c.KeyEquals(NormalizeProposalTitle(m.ProposedEpicTitle!)));
                            <div class="chat-msg__card">
                                <div class="chat-msg__card-header">Proposed Epic</div>
                                <div class="chat-msg__card-title">@m.ProposedEpicTitle</div>
                                @if (cardForMsg?.Accepted == true)
                                {
                                    <span class="pill pill--primary">Accepted</span>
                                }
                                else
                                {
                                    <span class="chat-msg__card-hint">Awaiting review — accept in the sidebar →</span>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_liveActive)
                {
                    <div class="chat-msg chat-msg--assistant chat-msg--live">
                        <div class="chat-msg__role mono">assistant · live</div>
                        @if (_liveTools.Count > 0)
                        {
                            <div class="chat-msg__tools">
                                @foreach (var t in _liveTools)
                                {
                                    <span class="pill pill--primary">⚙ @t</span>
                                }
                            </div>
                        }
                        @if (_liveText.Length == 0)
                        {
                            <div class="typing-dots" aria-label="assistant is thinking"><span></span><span></span><span></span></div>
                        }
                        else
                        {
                            <div class="chat-msg__body md">@((MarkupString)Forge.Dashboard.Services.MarkdownRenderer.ToHtml(_liveText))</div>
                        }
                    </div>
                }
                <div class="intake-input">
                    <input class="intake-input__field" @bind="_draft" placeholder="Type your message..."
                           @onkeydown="@(async e => { if (e.Key == "Enter" && !_sending) await SendMessage(); })" />
                    <button class="btn btn--primary" @onclick="SendMessage" disabled="@_sending">
                        @(_sending ? "Sending…" : "Send")
                    </button>
                </div>
            }
        </section>

        <aside class="intake-context">
            <div class="intake-context__tabs">
                <button class="chip @(_activeTab == "canvas" ? "chip--active" : "")" @onclick='() => SelectTab("canvas")'>Canvas</button>
                <button class="chip @(_activeTab == "spec" ? "chip--active" : "")" @onclick='() => SelectTab("spec")'>Spec Drafts</button>
            </div>
            <div class="intake-context__body">
                @if (_activeTab == "canvas")
                {
                    @if (_activeSessionId is null)
                    {
                        <p class="page-subtitle">Pick a session to see its canvas.</p>
                    }
                    else
                    {
                        @if (Proposals.Count > 0)
                        {
                            <div class="canvas-section">
                                <div class="canvas-section__title">Proposals (@Proposals.Count)</div>
                                @* Every proposed epic gets its own card. Proposals are
                                   SESSION DRAFTS until accepted (operator rule
                                   2026-08-14: no board row before accept) — cards are
                                   keyed by normalized title, refinements supersede in
                                   place, and the epic id only exists once accepted. *@
                                @foreach (var proposal in Proposals)
                                {
                                    <div class="proposal-card">
                                        <div class="proposal-card__title">@proposal.Title</div>
                                        <div class="mono page-subtitle">@(proposal.EpicId ?? "draft — not on the board")</div>
                                        @if (!string.IsNullOrWhiteSpace(proposal.Description))
                                        {
                                            <div class="chat-msg__card-hint md">@((MarkupString)Forge.Dashboard.Services.MarkdownRenderer.ToHtml(Truncate(proposal.Description, 400)))</div>
                                        }
                                        @if (proposal.Accepted && proposal.EpicId is not null)
                                        {
                                            <div class="proposal-card__state">
                                                <span class="pill pill--primary">Accepted · @proposal.EpicId</span>
                                                @{ var spec = SpecForProposal(proposal); }
                                                @if (spec is not null)
                                                {
                                                    <span class="pill pill--@spec.Status.ToLowerInvariant()">@spec.Id · @spec.Status</span>
                                                }
                                            </div>
                                            <div class="chat-msg__card-hint">
                                                On the board — a spec draft was created and product refinement picks it up. No code is dispatched by accepting.
                                            </div>
                                        }
                                        else if (proposal.EpicId is not null && IsEpicClosed(proposal.EpicId))
                                        {
                                            <div class="proposal-card__state">
                                                <span class="pill">Closed · @proposal.EpicId</span>
                                            </div>
                                            <div class="chat-msg__card-hint">
                                                This proposal was closed (superseded or reset) — nothing to accept.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="proposal-card__state">
                                                <span class="pill">Awaiting review</span>
                                            </div>
                                            <div class="chat-msg__card-hint">
                                                Accepting puts the epic on the board: the issue row and a spec draft are created at that moment, then product refinement picks it up. No code is dispatched.
                                            </div>
                                            <button class="btn btn--primary" @onclick="@(() => AcceptEpic(proposal.MessageId))" disabled="@_accepting">
                                                @(_accepting ? "Accepting…" : "Accept Epic")
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <div class="canvas-section">
                            <div class="canvas-section__title">Discussion map</div>
                            @if (CanvasMapSource is null)
                            {
                                <p class="page-subtitle">Proposed epics and their specs map out here as the discussion produces them.</p>
                            }
                            else
                            {
                                <div class="mermaid-target" id="mmd-map"></div>
                            }
                        </div>
                        <div class="canvas-section">
                            <div class="canvas-section__title">Diagrams from the discussion</div>
                            @if (_diagrams.Count == 0)
                            {
                                <p class="page-subtitle">When the intake agent sketches a structure (mermaid diagram) it lands here.</p>
                            }
                            else
                            {
                                @foreach (var d in _diagrams)
                                {
                                    <div class="canvas-diagram">
                                        <div class="canvas-diagram__meta mono">@d.Caption</div>
                                        <div class="mermaid-target" id="@d.ElementId"></div>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    @if (_activeSessionId is null)
                    {
                        <p class="page-subtitle">Pick a session to see its spec drafts.</p>
                    }
                    else if (_sessionSpecs is null)
                    {
                        <p class="page-subtitle">Loading…</p>
                    }
                    else if (_sessionSpecs.Count == 0)
                    {
                        <p class="page-subtitle">No specs for this session yet — they appear after you accept a proposed epic.</p>
                    }
                    else
                    {
                        @foreach (var spec in _sessionSpecs)
                        {
                            <div class="card intake-spec-card">
                                <div class="intake-spec-card__head">
                                    <strong>@spec.Title</strong>
                                    <span class="pill pill--@spec.Status.ToLowerInvariant()">@spec.Status</span>
                                </div>
                                <div class="mono page-subtitle">@spec.Id · v@spec.CurrentVersion</div>
                                @if (!string.IsNullOrWhiteSpace(spec.Body))
                                {
                                    <pre class="intake-spec-body">@Truncate(spec.Body, 800)</pre>
                                }
                            </div>
                        }
                    }
                }
            </div>
        </aside>
    </div>
</div>

@code {
    private List<SessionDto>? _sessions;
    private List<MessageDto>? _messages;
    private string? _activeSessionId;
    private string _draft = "";
    private bool _sending;
    private bool _accepting;
    private string? _actionError;
    private string _activeTab = "canvas";
    private List<SessionSpecDto>? _sessionSpecs;

    // Live-run state: fed by the intake SSE channel (intake.run.delta /
    // .tool / .completed) while the server streams the LLM response.
    private bool _liveActive;
    private string _liveText = "";
    private readonly List<string> _liveTools = new();

    // Canvas diagrams extracted from assistant messages (```mermaid
    // fences), newest first. ElementIds are stable per message so the
    // JS renderer's dataset memo skips unchanged diagrams.
    private readonly List<CanvasDiagram> _diagrams = new();
    private bool _mermaidDirty;
    private string? _canvasMapSource;
    private string? CanvasMapSource => _canvasMapSource;

    private DotNetObjectReference<Intake>? _selfRef;
    private bool _streamSubscribed;

    public sealed record SessionDto(string Id, string ProjectId, string Title, DateTime CreatedAt, DateTime UpdatedAt, List<MessageDto>? Messages);
    public sealed record MessageDto(long Id, string Role, string Content, DateTime Timestamp, string? ProposedEpicId, string? ProposedEpicTitle, List<QuestionDto>? Questions = null, string? ProposedEpicDescription = null);
    /// <summary>Minimal task view for proposal status (closed epics
    /// must not offer Accept). The full task DTO lives on the Tasks
    /// page; only the status is read here.</summary>
    public sealed record TaskDto(string Id, string Status);
    public sealed record QuestionDto(string? Header, string Question, bool Multiple, List<string>? Options)
    {
        public List<string> Options { get; } = Options ?? new();
    }
    public sealed record SessionSpecDto(string Id, string ProjectId, string Title, string Status, int CurrentVersion, string? Body);

    private sealed record CanvasDiagram(string ElementId, string Source, string Caption);

    // Question-card answer state: "messageId:questionIndex" → chosen
    // option labels (multi-select aware) plus per-question "Other"
    // free text. Dismissed cards stop rendering interactively.
    private readonly Dictionary<string, List<string>> _answers = new();
    private readonly Dictionary<string, string> _otherText = new();
    private readonly HashSet<string> _otherOpen = new();
    private readonly HashSet<long> _dismissedQuestionCards = new();

    /// <summary>Split an em-dash encoded option ("Label — description")
    /// into its parts; a leading "(Recommended)" becomes a badge.</summary>
    private static (string Label, string? Description, bool Recommended) SplitOption(string option)
    {
        var s = option.Trim();
        var recommended = s.StartsWith("(Recommended)", StringComparison.OrdinalIgnoreCase);
        if (recommended) s = s["(Recommended)".Length..].TrimStart(' ', '—', '-');
        var dash = s.IndexOf(" — ", StringComparison.Ordinal);
        return dash < 0
            ? (s, null, recommended)
            : (s[..dash].Trim(), s[(dash + 3)..].Trim(), recommended);
    }

    private string? GetOther(string key) => _otherText.TryGetValue(key, out var v) ? v : null;

    private void SetOther(string key, string? value)
    {
        if (string.IsNullOrEmpty(value)) _otherText.Remove(key);
        else _otherText[key] = value;
    }

    private bool IsQuestionCardActive(int messageIndex)
    {
        if (_messages is null) return false;
        var m = _messages[messageIndex];
        if (m.Id < 0 || _dismissedQuestionCards.Contains(m.Id)) return false;
        // Only the LATEST unanswered card is interactive: a user
        // message after it (typed or composed) means it was answered.
        for (var i = messageIndex + 1; i < _messages.Count; i++)
        {
            if (_messages[i].Role.Equals("User", StringComparison.OrdinalIgnoreCase)) return false;
        }
        return true;
    }

    private void ToggleAnswer(string key, string label, bool multiple)
    {
        if (!_answers.TryGetValue(key, out var cur))
        {
            _answers[key] = new List<string> { label };
            return;
        }
        if (cur.Contains(label))
        {
            cur.Remove(label);
            if (cur.Count == 0) _answers.Remove(key);
            return;
        }
        if (multiple) cur.Add(label);
        else { cur.Clear(); cur.Add(label); }
    }

    private int AnsweredCount(MessageDto m, IReadOnlyList<QuestionDto> qs)
    {
        var n = 0;
        for (var qi = 0; qi < qs.Count; qi++)
        {
            var key = $"{m.Id}:{qi}";
            if ((_answers.TryGetValue(key, out var sel) && sel.Count > 0)
                || (_otherText.TryGetValue(key, out var t) && !string.IsNullOrWhiteSpace(t)))
            {
                n++;
            }
        }
        return n;
    }

    private void DismissQuestionCard(MessageDto m) => _dismissedQuestionCards.Add(m.Id);

    /// <summary>One sidebar card per logical proposal. Proposals are
    /// session drafts keyed by title (no epic id until accepted);
    /// legacy pre-2026-08-14 proposals carried their epic id from
    /// proposal time. A card's EpicId comes from the accept message
    /// (or the legacy link); MessageId is the accept target (the
    /// latest draft message, or the legacy carrier).</summary>
    private List<ProposalCard> Proposals
    {
        get
        {
            if (_messages is null) return new();
            var cards = new List<ProposalCard>();
            foreach (var m in _messages
                .Where(m => m.ProposedEpicTitle is not null)
                .OrderBy(m => m.Id))
            {
                // Title-normalized grouping mirrors the server's
                // IsSameProposal: refinements ("(refined)" suffixes)
                // supersede the SAME card instead of stacking.
                var key = NormalizeProposalTitle(m.ProposedEpicTitle!);
                var isAccept = m.Role.Equals("System", StringComparison.OrdinalIgnoreCase)
                    && m.Content.StartsWith("Operator accepted epic ", StringComparison.Ordinal)
                    && m.ProposedEpicId is not null;
                var card = cards.FirstOrDefault(c => c.KeyEquals(key));
                if (card is null)
                {
                    cards.Add(new ProposalCard(
                        m.ProposedEpicTitle!,
                        m.ProposedEpicDescription,
                        m.Id,
                        m.ProposedEpicId,
                        isAccept,
                        key));
                }
                else
                {
                    card.Title = m.ProposedEpicTitle!;
                    if (m.ProposedEpicDescription is not null)
                    {
                        card.Description = m.ProposedEpicDescription;
                        card.MessageId = m.Id;
                    }
                    if (isAccept)
                    {
                        card.EpicId = m.ProposedEpicId;
                        card.Accepted = true;
                    }
                    else if (card.EpicId is null && m.ProposedEpicId is not null)
                    {
                        card.EpicId = m.ProposedEpicId;
                        if (m.ProposedEpicDescription is null) card.MessageId = m.Id;
                    }
                }
            }
            return cards;
        }
    }

    /// <summary>Mutable card state for the grouping fold above.</summary>
    private sealed class ProposalCard
    {
        public ProposalCard(string title, string? description, long messageId, string? epicId, bool accepted, string key)
        {
            Title = title; Description = description; MessageId = messageId;
            EpicId = epicId; Accepted = accepted; Key = key;
        }
        public string Title { get; set; }
        public string? Description { get; set; }
        public long MessageId { get; set; }
        public string? EpicId { get; set; }
        public bool Accepted { get; set; }
        public string Key { get; }
        public bool KeyEquals(string other) =>
            Key == other || Key.StartsWith(other, StringComparison.Ordinal) || other.StartsWith(Key, StringComparison.Ordinal);
    }

    private static string NormalizeProposalTitle(string title)
    {
        var noParens = System.Text.RegularExpressions.Regex.Replace(title, @"\([^)]*\)", " ");
        var chars = noParens.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : ' ').ToArray();
        return System.Text.RegularExpressions.Regex.Replace(new string(chars), @"\s+", " ").Trim();
    }

    /// <summary>Issue status per proposed epic id (loaded with the
    /// session) — a Closed/reset proposal must not offer an Accept
    /// button (live 2026-08-14: closed duplicate epic-15 showed
    /// "Awaiting review").</summary>
    private readonly Dictionary<string, string> _epicStatuses = new(StringComparer.OrdinalIgnoreCase);

    private bool IsEpicClosed(string epicId)
        => _epicStatuses.TryGetValue(epicId, out var s)
            && s.Equals("Closed", StringComparison.OrdinalIgnoreCase);

    private SessionSpecDto? SpecForProposal(ProposalCard proposal)
        => _sessionSpecs?.FirstOrDefault(s =>
            string.Equals(s.Title, proposal.Title, StringComparison.OrdinalIgnoreCase));

    /// <summary>Session-list badge: 'accepted' when any proposal was
    /// accepted (session complete), 'pending' when a proposal awaits
    /// review, null otherwise. Session DTOs carry their messages, so
    /// this is computed client-side.</summary>
    private static string? SessionProposalState(SessionDto s)
    {
        if (s.Messages is null) return null;
        var proposedIds = s.Messages.Where(m => m.ProposedEpicId is not null)
            .Select(m => m.ProposedEpicId!).Distinct().ToList();
        if (proposedIds.Count == 0) return null;
        var accepted = s.Messages.Any(m =>
            m.Role.Equals("System", StringComparison.OrdinalIgnoreCase)
            && m.Content.StartsWith("Operator accepted epic ", StringComparison.Ordinal));
        return accepted ? "accepted" : "pending";
    }

    private async Task SendAnswers(MessageDto m, IReadOnlyList<QuestionDto> qs)
    {
        var lines = new List<string> { "Answers to your questions:" };
        var unanswered = new List<int>();
        for (var qi = 0; qi < qs.Count; qi++)
        {
            var key = $"{m.Id}:{qi}";
            var label = qs[qi].Header
                ?? Truncate(qs[qi].Question.Replace("**", "").Trim(), 60);
            var parts = new List<string>();
            if (_answers.TryGetValue(key, out var sel)) parts.AddRange(sel);
            if (_otherText.TryGetValue(key, out var t) && !string.IsNullOrWhiteSpace(t))
                parts.Add($"Other: {t.Trim()}");
            if (parts.Count == 0) { unanswered.Add(qi + 1); continue; }
            lines.Add($"{qi + 1}. {label} → {string.Join(", ", parts)}");
        }
        if (lines.Count == 1) return;
        // Unanswered questions stay open — say so explicitly so the
        // agent doesn't assume silence = answered.
        if (unanswered.Count > 0)
            lines.Add($"(questions {string.Join(", ", unanswered)} still open)");
        await PostUserMessage(string.Join("\n", lines));
    }

    private void SelectTab(string tab)
    {
        _activeTab = tab;
        if (tab == "spec") _ = LoadSessionSpecs();
        if (tab == "canvas") _mermaidDirty = true;
    }

    protected override async Task OnInitializedAsync()
    {
        ShellStore.StateChanged += OnShellChanged;
        await ReloadSessions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_streamSubscribed)
        {
            _streamSubscribed = true;
            _selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("forge.intakeStream.subscribe", _selfRef); }
            catch (InvalidOperationException) { /* prerender */ }
        }
        if (_mermaidDirty)
        {
            _mermaidDirty = false;
            try
            {
                await JS.InvokeVoidAsync("forge.intakeMermaid.renderInto", "mmd-map", _canvasMapSource ?? "");
                foreach (var d in _diagrams)
                {
                    await JS.InvokeVoidAsync("forge.intakeMermaid.renderInto", d.ElementId, d.Source);
                }
            }
            catch (InvalidOperationException) { /* prerender: no JS runtime yet */ }
            catch (JSException) { /* mermaid render failure is non-fatal; js falls back to source */ }
        }
    }

    /// <summary>Intake SSE events arrive with the full event JSON
    /// (see intake.js). Drives the live assistant bubble.</summary>
    [JSInvokable]
    public async Task OnIntakeEvent(string kind, string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            var sessionId = root.TryGetProperty("taskId", out var t) && t.ValueKind == System.Text.Json.JsonValueKind.String
                ? t.GetString() : null;
            if (sessionId is null || sessionId != _activeSessionId) return;

            switch (kind)
            {
                case "intake-run-started":
                    _liveActive = true;
                    _liveText = "";
                    _liveTools.Clear();
                    break;
                case "intake-run-delta":
                    if (root.TryGetProperty("data", out var dd)
                        && dd.TryGetProperty("delta", out var delta))
                    {
                        _liveText += delta.GetString();
                    }
                    _liveActive = true;
                    break;
                case "intake-run-tool":
                    if (root.TryGetProperty("data", out var dt)
                        && dt.TryGetProperty("tool", out var tool)
                        && tool.GetString() is { } toolName)
                    {
                        _liveTools.Add(toolName);
                    }
                    break;
                case "intake-run-completed":
                    _liveActive = false;
                    _liveText = "";
                    _liveTools.Clear();
                    await ReloadActive();
                    break;
                case "intake-run-failed":
                    _liveActive = false;
                    _liveText = "";
                    _liveTools.Clear();
                    _actionError = root.TryGetProperty("detail", out var dtl)
                        ? $"Intake run failed: {dtl.GetString()}"
                        : "Intake run failed.";
                    await ReloadActive();
                    break;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // A malformed event must not break the circuit — the next
            // completed/failed event reloads authoritative state anyway.
        }
    }

    private async Task LoadSessionSpecs()
    {
        if (_activeSessionId is null) { _sessionSpecs = null; return; }
        try
        {
            _sessionSpecs = await Http.GetFromJsonAsync<List<SessionSpecDto>>($"/api/intake/sessions/{_activeSessionId}/specs");
        }
        catch { _sessionSpecs = new(); }
        RebuildCanvas();
        StateHasChanged();
    }

    private static string Truncate(string s, int max) =>
        string.IsNullOrEmpty(s) || s.Length <= max ? s : s[..max] + "…";

    private string? _loadedProject;

    private void OnShellChanged(object? sender, EventArgs e)
    {
        if (ShellStore.Value.CurrentProjectId != _loadedProject)
            _ = InvokeAsync(ReloadSessions);
    }

    private async Task ReloadSessions()
    {
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            _loadedProject = projectId;
            _sessions = await Http.GetFromJsonAsync<List<SessionDto>>(
                string.IsNullOrEmpty(projectId) ? "/api/intake/sessions"
                    : $"/api/intake/sessions?project={Uri.EscapeDataString(projectId)}");
            if (_sessions is { Count: > 0 } && _activeSessionId is null)
            {
                await SetActive(_sessions[0].Id);
            }
            else
            {
                StateHasChanged();
            }
        }
        catch { _sessions = new(); }
    }

    private async Task SetActive(string id)
    {
        _activeSessionId = id;
        _sessionSpecs = null;
        _liveActive = false;
        _liveText = "";
        _liveTools.Clear();
        await ReloadActive();
    }

    private async Task ReloadActive()
    {
        if (_activeSessionId is null) return;
        try
        {
            var resp = await Http.GetFromJsonAsync<SessionDto>($"/api/intake/sessions/{_activeSessionId}");
            _messages = resp?.Messages?.ToList() ?? new();
            // Specs feed both the Spec Drafts tab and the canvas (map +
            // proposal panel's spec pill) — always load.
            await LoadSessionSpecs();
            await LoadEpicStatuses(resp?.ProjectId);
        }
        catch { _messages = new(); }
        StateHasChanged();
    }

    private async Task LoadEpicStatuses(string? projectId)
    {
        if (projectId is null) return;
        foreach (var p in Proposals.Where(p => p.EpicId is not null))
        {
            try
            {
                var issue = await Http.GetFromJsonAsync<TaskDto>(
                    $"/api/tasks/{p.EpicId}?projectId={projectId}");
                if (issue is not null) _epicStatuses[p.EpicId!] = issue.Status;
            }
            catch { /* status unknown — proposal renders as awaiting review */ }
        }
    }

    private async Task StartNewSession()
    {
        // The intake session is created for the project selected in
        // the topbar switcher — everything downstream (spec, groomed
        // tasks, dispatch) flows into that project's stores.
        var projectId = ShellStore.Value.CurrentProjectId;
        if (string.IsNullOrEmpty(projectId))
        {
            _actionError = "No project selected in the topbar switcher yet.";
            return;
        }
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/intake/sessions", new { projectId, title = "New session" });
            if (resp.IsSuccessStatusCode)
            {
                _actionError = null;
                var created = await resp.Content.ReadFromJsonAsync<SessionDto>();
                await ReloadSessions();
                // Select the session we just created — ReloadSessions
                // defaults to the first (oldest) one, which strands
                // the operator in a stale thread.
                if (created is not null)
                {
                    await SetActive(created.Id);
                }
            }
            else
            {
                _actionError = $"Create session failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _actionError = ex.Message; }
    }

    private async Task AcceptEpic(long messageId)
    {
        if (_activeSessionId is null) return;
        _accepting = true;
        try
        {
            var resp = await Http.PostAsync(
                $"/api/intake/sessions/{_activeSessionId}/accept-epic/{messageId}", null);
            if (resp.IsSuccessStatusCode)
            {
                _actionError = null;
                // The accept appends an "Operator accepted epic …" system
                // message server-side; reloading flips the sidebar panel
                // + thread card to the Accepted state via IsEpicAccepted.
                await ReloadActive();
            }
            else
            {
                _actionError = $"Accept failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _accepting = false; }
    }

    private async Task SendMessage()
    {
        if (_activeSessionId is null || string.IsNullOrWhiteSpace(_draft)) return;
        var text = _draft;
        _draft = "";
        await PostUserMessage(text);
    }

    private async Task PostUserMessage(string text)
    {
        if (_activeSessionId is null || string.IsNullOrWhiteSpace(text)) return;
        _sending = true;
        // Optimistic: the operator's message appears immediately and
        // the live bubble shows "thinking" — the POST only returns
        // after the whole LLM round, and the SSE channel drives the
        // in-flight UI in the meantime.
        _messages ??= new();
        _messages.Add(new MessageDto(-DateTime.UtcNow.Ticks, "User", text, DateTime.Now, null, null));
        _liveActive = true;
        _liveText = "";
        _liveTools.Clear();
        StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("ForgeApiLongPoll");
            var resp = await http.PostAsJsonAsync($"/api/intake/sessions/{_activeSessionId}/messages", new { text });
            if (!resp.IsSuccessStatusCode)
            {
                _actionError = $"Send failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _actionError = $"Send failed: {ex.Message}"; }
        finally
        {
            _sending = false;
            // Safety net: if the completed event was missed (stream
            // reconnect mid-run), reload authoritative state here.
            if (_liveActive) { _liveActive = false; _liveText = ""; _liveTools.Clear(); }
            await ReloadActive();
        }
    }

    /// <summary>Rebuild the canvas: the auto discussion map (epics →
    /// specs) + the mermaid diagrams the assistant drew in replies.</summary>
    private void RebuildCanvas()
    {
        _diagrams.Clear();
        if (_messages is not null)
        {
            foreach (var m in _messages.OrderByDescending(m => m.Id))
            {
                if (!m.Role.Equals("Assistant", StringComparison.OrdinalIgnoreCase)) continue;
                var idx = 0;
                foreach (var src in ExtractMermaidBlocks(m.Content))
                {
                    _diagrams.Add(new CanvasDiagram(
                        $"mmd-msg-{m.Id}-{idx++}",
                        src,
                        $"reply · {m.Timestamp:MM-dd HH:mm}"));
                }
            }
        }
        _canvasMapSource = BuildDiscussionMap();
        _mermaidDirty = true;
    }

    private string? BuildDiscussionMap()
    {
        if (_messages is null) return null;
        var epics = Proposals;
        if (epics.Count == 0) return null;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("flowchart TD");
        var specNodes = 0;
        for (var i = 0; i < epics.Count; i++)
        {
            var label = MermaidLabel($"{epics[i].EpicId ?? "draft"} — {epics[i].Title}");
            sb.AppendLine($"  e{i}[\"{label}\"]:::{(epics[i].Accepted ? "accepted" : "proposed")}");
        }
        if (_sessionSpecs is not null)
        {
            foreach (var spec in _sessionSpecs)
            {
                var label = MermaidLabel($"{spec.Id} · v{spec.CurrentVersion} · {spec.Status}");
                sb.AppendLine($"  s{specNodes}[\"{label}\"]:::spec");
                // Link epic→spec when the titles line up (specs are
                // created from the epic title at accept time).
                var parentIdx = epics.FindIndex(e =>
                    string.Equals(e.Title, spec.Title, StringComparison.OrdinalIgnoreCase));
                if (parentIdx >= 0) sb.AppendLine($"  e{parentIdx} --> s{specNodes}");
                specNodes++;
            }
        }
        sb.AppendLine("  classDef proposed fill:#1D2230,stroke:#7C9CFF,color:#E6E8EE");
        sb.AppendLine("  classDef accepted fill:#16302a,stroke:#7DDFC1,color:#E6E8EE");
        sb.AppendLine("  classDef spec fill:#2a2416,stroke:#F2B55A,color:#E6E8EE");
        return sb.ToString();
    }

    private static string MermaidLabel(string s) =>
        Truncate(s.Replace('"', '\''), 60);

    private static IEnumerable<string> ExtractMermaidBlocks(string content)
    {
        const string fence = "```mermaid";
        var pos = 0;
        while (true)
        {
            var start = content.IndexOf(fence, pos, StringComparison.OrdinalIgnoreCase);
            if (start < 0) yield break;
            var bodyStart = content.IndexOf('\n', start);
            if (bodyStart < 0) yield break;
            var end = content.IndexOf("```", bodyStart, StringComparison.Ordinal);
            if (end < 0) yield break;
            var block = content[(bodyStart + 1)..end].Trim();
            if (block.Length > 0) yield return block;
            pos = end + 3;
        }
    }

    public async ValueTask DisposeAsync()
    {
        ShellStore.StateChanged -= OnShellChanged;
        if (_streamSubscribed)
        {
            _streamSubscribed = false;
            try { await JS.InvokeVoidAsync("forge.intakeStream.unsubscribe"); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
            catch (InvalidOperationException) { /* prerender */ }
        }
        _selfRef?.Dispose();
    }
}
