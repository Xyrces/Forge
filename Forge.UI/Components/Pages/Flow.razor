@page "/flow"
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable
@using System.Net.Http.Json
@using System.Text

<PageTitle>Flow</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Pipeline flow</h1>
        <div class="page-header__meta">
            @if (_fleet is not null && !EditMode)
            {
                <span>@_fleet.Nodes.Sum(n => n.Count) items in flight · refreshed @_lastFetch?.ToString("HH:mm:ss")</span>
            }
        </div>
        <div class="page-header__actions">
            <button class="btn @(EditMode ? "" : "btn--primary")" @onclick="@(() => SetMode(false))">Live</button>
            <button class="btn @(EditMode ? "btn--primary" : "")" @onclick="@(() => SetMode(true))">Edit</button>
            @if (!EditMode)
            {
                <button class="btn" @onclick="LoadFleetAsync">Refresh</button>
            }
        </div>
    </div>

    @if (EditMode)
    {
        <WorkflowEditor />
    }
    else if (_fleet is null && _loadError is not null)
    {
        <div class="banner banner--error">Failed to load the pipeline flow: @_loadError <button class="btn btn--small" @onclick="LoadFleetAsync">Retry</button></div>
    }
    else if (_fleet is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        @* Issue-first: pick any work item, trace its path. *@
        <div class="picker-bar">
            <span class="picker-bar__label">Trace</span>
            <input list="flow-issues" class="mono picker-bar__select"
                   placeholder="Select an issue (type to filter)…"
                   @bind="_traceInput" @bind:event="oninput" />
            <datalist id="flow-issues">
                @foreach (var i in _fleet.AllIssues)
                {
                    <option value="@i.Id">@i.Title [@i.Status]</option>
                }
            </datalist>
            <button class="btn btn--primary" @onclick="TraceAsync" disabled="@string.IsNullOrWhiteSpace(_traceInput)">Trace</button>
            @if (_journey is not null)
            {
                <button class="btn" @onclick="ClearJourney">Clear</button>
            }
        </div>

        <div class="flow-legend">
            <span class="flow-legend__item">
                <svg width="26" height="14"><rect x="1" y="1" width="24" height="12" rx="3" fill="var(--surface)" stroke="var(--outline-variant)" /></svg>
                stage
            </span>
            <span class="flow-legend__item">
                <svg width="14" height="14"><circle cx="7" cy="7" r="6" fill="var(--primary)" /><text x="7" y="10" text-anchor="middle" font-size="8" fill="var(--on-primary)" font-weight="600">3</text></svg>
                items at stage
            </span>
            <span class="flow-legend__item">
                <svg width="30" height="8"><line x1="0" y1="4" x2="30" y2="4" stroke="var(--outline)" stroke-width="1.4" /></svg>
                flow
            </span>
            <span class="flow-legend__item">
                <svg width="30" height="8"><line x1="0" y1="4" x2="30" y2="4" stroke="var(--warn)" stroke-width="1.4" stroke-dasharray="5 3" /></svg>
                loop / failure path
            </span>
            <span class="flow-legend__item">
                <svg width="30" height="8"><line x1="0" y1="4" x2="30" y2="4" stroke="var(--primary)" stroke-width="2.5" /></svg>
                traced journey
            </span>
        </div>

        <div style="display:flex;gap:16px;align-items:flex-start">
            @* Directed layout, computed server-side
               (DirectedFlowLayout): centered vertical spine with
               straight forward edges, sinks in fixed side columns,
               loops on fixed outer margins — framed by construction. *@
            <div class="flow-canvas">
            <svg viewBox="0 0 @F(_svgWidth) @F(_svgHeight)">
                <defs>
                    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--outline)" />
                    </marker>
                    <marker id="arrow-primary" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--primary)" />
                    </marker>
                </defs>

                @if (_laneDividerY is not null)
                {
                    <line x1="8" y1="@F(_laneDividerY.Value)" x2="@F(_svgWidth - 8)" y2="@F(_laneDividerY.Value)"
                          stroke="var(--outline-variant)" stroke-dasharray="4 4" opacity="0.6" />
                    @SvgText(14, _laneDividerY.Value - 8, "var(--on-surface-variant)", 11, "start", "PLANNING")
                    @SvgText(14, _laneDividerY.Value + 18, "var(--on-surface-variant)", 11, "start", "IMPLEMENTATION")
                }

                @* Edges under nodes *@
                @foreach (var e in LayoutEdges)
                {
                    var visited = _journey is not null && _journey.Visits.Any(v => v.Node == e.From) && _journey.Visits.Any(v => v.Node == e.To);
                    var isLoop = e.Kind is "loop" or "failure";
                    <path d="@SmoothPath(e.Points)" fill="none"
                          stroke="@(visited ? "var(--primary)" : isLoop ? "var(--warn)" : "var(--outline)")"
                          stroke-width="@(visited ? 2.5 : 1.4)"
                          stroke-dasharray="@(isLoop && !visited ? "6 4" : null)"
                          marker-end="url(#@(visited ? "arrow-primary" : "arrow"))"
                          opacity="@(visited ? 1 : 0.75)" />
                    @if (e.Label is not null && e.Points.Count > 0)
                    {
                        var mid = e.Points[e.Points.Count / 2];
                        @SvgEdgeLabel(mid.X, mid.Y - 5, e.Label)
                    }
                }

                @* Nodes *@
                @foreach (var n in _fleet.Nodes)
                {
                    var pos = NodePos(n.Id, n.X, n.Y, n.Label);
                    var (w, h) = (pos.W, pos.H);
                    var selected = _selectedNode == n.Id;
                    var inJourney = _journey?.Visits.Any(v => v.Node == n.Id) == true;
                    var isCurrent = _journey?.CurrentNode == n.Id;
                    <g style="cursor:pointer;outline:none" role="button" tabindex="0" aria-label="@($"Flow node {n.Label}")"
                       @onclick="@(() => SelectNode(n.Id))"
                       @onkeydown="@(e => { if (e.Key is "Enter" or " ") SelectNode(n.Id); })"
                       @onfocus="@(() => _focusedNode = n.Id)" @onblur="@(() => _focusedNode = null)">
                        <rect x="@F(pos.X - w / 2)" y="@F(pos.Y - h / 2)" width="@F(w)" height="@F(h)" rx="9"
                              fill="@(isCurrent ? "var(--primary-container, var(--surface))" : "var(--surface)")"
                              stroke="@(isCurrent ? "var(--primary)" : inJourney ? "var(--primary)" : selected || _focusedNode == n.Id ? "var(--primary)" : "var(--outline-variant)")"
                              stroke-width="@(isCurrent || selected || _focusedNode == n.Id ? 2.5 : inJourney ? 1.8 : 1.2)" />
                        @SvgText(pos.X, pos.Y + 4, "var(--on-surface)", 12, "middle", n.Label)
                        @if (n.Count > 0)
                        {
                            <circle cx="@F(pos.X + w / 2 - 10)" cy="@F(pos.Y - h / 2 + 6)" r="11" fill="var(--primary)" />
                            @SvgText(pos.X + w / 2 - 10, pos.Y - h / 2 + 10, "var(--on-primary, #fff)", 11, "middle", n.Count.ToString(), bold: true)
                        }
                    </g>
                }
            </svg>
            </div>

            <div style="width:380px;flex-shrink:0">
                @if (_selectedNode is not null)
                {
                    var node = _fleet.Nodes.First(n => n.Id == _selectedNode);
                    <h3 style="margin-top:0">@node.Label <span style="color:var(--on-surface-variant)">(@node.Count)</span></h3>
                    @if (node.Issues.Count == 0)
                    {
                        <div class="page-subtitle">Nothing at this stage.</div>
                    }
                    <ul style="list-style:none;padding:0;margin:0">
                        @foreach (var i in node.Issues)
                        {
                            <li style="padding:6px 0;border-bottom:1px solid var(--outline-variant)">
                                <a href="" @onclick:preventDefault @onclick="@(() => LoadJourneyAsync(i.Id))" class="mono">@i.Id</a>
                                <span class="pill pill--@i.Status.ToLowerInvariant()" style="margin-left:6px">@i.Status</span>
                                <div style="font-size:13px">@i.Title</div>
                            </li>
                        }
                    </ul>
                    @if (node.Count > node.Issues.Count)
                    {
                        <div class="page-subtitle">…and @(node.Count - node.Issues.Count) more</div>
                    }
                }
                else
                {
                    <div class="page-subtitle">Select a node to see what's at that stage — or trace any issue above to see its path through the system.</div>
                }
            </div>
        </div>

        @if (_journey is not null)
        {
            <div style="margin-top:18px;max-width:1100px">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <h3 style="margin:0">
                        Journey: <a href="/tasks/@_journey.IssueId" class="mono">@_journey.IssueId</a>
                        <span class="pill pill--@_journey.Status.ToLowerInvariant()" style="margin-left:6px">@_journey.Status</span>
                        @if (_journey.LifecycleState is not null)
                        {
                            <span class="pill pill--primary" style="margin-left:6px" title="Lifecycle state (state machine)@(_journey.LifecycleEvent is not null ? $" — last event: {_journey.LifecycleEvent}" : "")">@_journey.LifecycleState</span>
                        }
                        @if (_journey.LifecycleViolation is not null)
                        {
                            <span class="pill pill--blocked" style="margin-left:6px" title="Illegal transition recorded by the state machine">violation: @_journey.LifecycleViolation</span>
                        }
                    </h3>
                    <span class="page-subtitle">@_journey.Title</span>
                </div>
                <div style="position:relative;padding-left:18px;border-left:2px solid var(--outline-variant);margin:12px 0 0 6px">
                    @foreach (var (v, idx) in _journey.Visits.Select((v, i) => (v, i)))
                    {
                        var label = _fleet?.Nodes.FirstOrDefault(n => n.Id == v.Node)?.Label ?? v.Node;
                        var expanded = _expandedVisit == idx;
                        var isCurrent = idx == _journey.Visits.Count - 1 && v.Note == "current";
                        <div style="position:relative;margin-bottom:4px">
                            <div style="position:absolute;left:-23px;top:8px;width:10px;height:10px;border-radius:50%;background:@(isCurrent ? "var(--primary)" : "var(--outline-variant)")"></div>
                            <div style="cursor:pointer;padding:6px 8px;border-radius:8px;border:1px solid @(expanded ? "var(--primary)" : "transparent");max-width:760px"
                                 @onclick="@(() => ToggleVisit(idx))">
                                <div style="display:flex;justify-content:space-between;align-items:center">
                                    <span>@label@(v.Count > 1 ? $" ×{v.Count}" : "")</span>
                                    <span class="mono" style="color:var(--on-surface-variant);font-size:12px">@v.At.ToString("MM-dd HH:mm:ss")</span>
                                </div>
                                <div style="display:flex;gap:8px;align-items:center;color:var(--on-surface-variant);font-size:12px">
                                    <span>@FormatDuration(v.DurationMs)</span>
                                    @if (v.Note is not null)
                                    {
                                        <span>· @v.Note</span>
                                    }
                                </div>
                                @if (expanded && v.Details.ValueKind == System.Text.Json.JsonValueKind.Object)
                                {
                                    <div style="margin-top:8px;padding-top:8px;border-top:1px solid var(--outline-variant);font-size:13px">
                                        @foreach (var prop in v.Details.EnumerateObject())
                                        {
                                            if (prop.Value.ValueKind is System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined) { continue; }
                                            <div style="display:flex;gap:8px;padding:2px 0">
                                                <span class="mono" style="color:var(--on-surface-variant);min-width:130px">@prop.Name</span>
                                                <span style="word-break:break-word">
                                                    @if (prop.Name == "prNumber" && PrUrl(prop.Value.ToString()) is { } url)
                                                    {
                                                        <a href="@url" target="_blank" rel="noopener">#@prop.Value</a>
                                                    }
                                                    else if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                    {
                                                        @if (prop.Value.GetArrayLength() == 0)
                                                        {
                                                            <text>—</text>
                                                        }
                                                        foreach (var item in prop.Value.EnumerateArray())
                                                        {
                                                            <div class="mono" style="font-size:12px">@FormatJsonScalar(item)</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @FormatJsonScalar(prop.Value)
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "issue")]
    public string? InitialIssue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    private bool EditMode => string.Equals(Mode, "edit", StringComparison.OrdinalIgnoreCase);

    private void SetMode(bool edit)
    {
        // Pause live polling while editing; resume on the way back.
        Nav.NavigateTo(edit ? "/flow?mode=edit" : "/flow", forceLoad: false);
    }

    private FleetDto? _fleet;
    private string? _loadError;
    private string? _focusedNode;
    private JourneyDto? _journey;
    private string? _selectedNode;
    private int? _expandedVisit;
    private string? _traceInput;
    private string? _repoUrl;
    private DateTime? _lastFetch;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(LoadFleetAsync), null,
            TimeSpan.Zero, TimeSpan.FromSeconds(5));
        if (!string.IsNullOrWhiteSpace(InitialIssue))
        {
            _ = LoadJourneyAsync(InitialIssue);
        }
        _ = LoadRepoUrlAsync();
    }

    private async Task LoadRepoUrlAsync()
    {
        try
        {
            using var doc = await Http.GetFromJsonAsync<System.Text.Json.JsonDocument>("/api/projects/");
            var first = doc?.RootElement.EnumerateArray().FirstOrDefault();
            if (first is { } p && p.TryGetProperty("repoUrl", out var ru))
            {
                _repoUrl = ru.GetString()?.TrimEnd('/');
            }
        }
        catch { /* PR links degrade to plain text */ }
    }

    private string? PrUrl(string prNumber)
        => _repoUrl is not null && int.TryParse(prNumber, out var n)
            ? $"{_repoUrl}/pull/{n}" : null;

    private void ToggleVisit(int idx)
        => _expandedVisit = _expandedVisit == idx ? null : idx;

    private static string FormatDuration(long ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        if (ts.TotalDays >= 1) return $"{(int)ts.TotalDays}d {ts.Hours}h";
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalSeconds}s";
    }

    private static string FormatJsonScalar(System.Text.Json.JsonElement el) => el.ValueKind switch
    {
        System.Text.Json.JsonValueKind.String => el.GetString() ?? "",
        System.Text.Json.JsonValueKind.Object => string.Join(", ",
            el.EnumerateObject().Take(6).Select(p => $"{p.Name}={FormatJsonScalar(p.Value)}")),
        System.Text.Json.JsonValueKind.Array => $"[{el.GetArrayLength()} items]",
        _ => el.ToString(),
    };

    private async Task LoadFleetAsync()
    {
        if (EditMode) return;   // editor owns the page; don't poll
        try
        {
            _fleet = await Http.GetFromJsonAsync<FleetDto>("/api/flow");
            _lastFetch = DateTime.Now;
            _loadError = null;
            ApplyLayout();
            StateHasChanged();
        }
        catch (Exception ex) { _loadError = ex.Message; /* keep last good frame */ }
    }

    // ---- Directed layout (computed server-side, rendered as-is) ----

    private LayoutResult? _layout;
    private double _svgWidth = 740;
    private double _svgHeight = 480;
    private double? _laneDividerY;

    private List<LayoutEdgeDto> LayoutEdges => _layout?.Edges ?? new();

    private void ApplyLayout()
    {
        if (_fleet?.Layout is null)
        {
            // Older backend without the layout payload: definition
            // coordinates + formula sizes, straight edges.
            _layout = null;
            _svgWidth = 740;
            _svgHeight = 480;
            _laneDividerY = null;
            return;
        }
        var p = _fleet.Layout;
        _layout = new LayoutResult
        {
            Nodes = p.Nodes.ToDictionary(
                kv => kv.Key,
                kv => new PointDto { X = kv.Value.X, Y = kv.Value.Y, W = kv.Value.W, H = kv.Value.H },
                StringComparer.Ordinal),
            Edges = p.Edges.Select(e => new LayoutEdgeDto
            {
                From = e.From,
                To = e.To,
                Kind = e.Kind ?? "happy",
                Label = e.Label,
                Points = e.Points.Select(pt => new PointDto { X = pt.X, Y = pt.Y }).ToList(),
            }).ToList(),
        };
        _svgWidth = Math.Max(p.Width, 200);
        _svgHeight = Math.Max(p.Height, 200);
        _laneDividerY = p.LaneDividerY;
    }

    private PointDto NodePos(string id, double fallbackX, double fallbackY, string label)
    {
        if (_layout is not null && _layout.Nodes.TryGetValue(id, out var p))
        {
            return p;
        }
        return new PointDto
        {
            X = fallbackX,
            Y = fallbackY,
            W = Math.Clamp(label.Length * 7.5 + 36, 110, 220),
            H = 46,
        };
    }

    // Catmull-Rom -> cubic Bézier: the layout's routed polylines
    // become the smooth arcs the loop edges should read as.
    private static string SmoothPath(IReadOnlyList<PointDto> pts)
    {
        if (pts.Count == 0) return "";
        if (pts.Count < 3)
        {
            return $"M {F(pts[0].X)} {F(pts[0].Y)} " +
                string.Join(" ", pts.Skip(1).Select(p => $"L {F(p.X)} {F(p.Y)}"));
        }
        var sb = new StringBuilder($"M {F(pts[0].X)} {F(pts[0].Y)}");
        for (var i = 0; i < pts.Count - 1; i++)
        {
            var p0 = pts[Math.Max(0, i - 1)];
            var p1 = pts[i];
            var p2 = pts[i + 1];
            var p3 = pts[Math.Min(pts.Count - 1, i + 2)];
            sb.Append($" C {F(p1.X + (p2.X - p0.X) / 6.0)} {F(p1.Y + (p2.Y - p0.Y) / 6.0)}," +
                      $" {F(p2.X - (p3.X - p1.X) / 6.0)} {F(p2.Y - (p3.Y - p1.Y) / 6.0)}," +
                      $" {F(p2.X)} {F(p2.Y)}");
        }
        return sb.ToString();
    }

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private void SelectNode(string id)
    {
        _selectedNode = id;
        _journey = null;
    }

    private async Task LoadJourneyAsync(string issueId)
    {
        try
        {
            _expandedVisit = null;
            _journey = await Http.GetFromJsonAsync<JourneyDto>($"/api/flow/issues/{issueId}");
        }
        catch { /* item may have left the fleet */ }
    }

    private async Task TraceAsync()
    {
        var id = _traceInput?.Trim();
        if (string.IsNullOrEmpty(id)) return;
        // The datalist offers "id" values; tolerate pasted "id — title" forms.
        var space = id.IndexOf(' ');
        if (space > 0) id = id[..space];
        await LoadJourneyAsync(id);
    }

    private void ClearJourney() => _journey = null;

    public void Dispose() => _timer?.Dispose();

    // SVG <text> collides with Razor's <text> tag — emit it raw.
    private static MarkupString SvgText(double x, double y, string fill, int size, string anchor, string content, bool bold = false)
        => new($"<text x=\"{F(x)}\" y=\"{F(y)}\" fill=\"{fill}\" font-size=\"{size}\" text-anchor=\"{anchor}\"" +
               (bold ? " font-weight=\"600\"" : "") + $">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    // Edge labels get a surface-colored halo so they stay readable
    // over the routed paths.
    private static MarkupString SvgEdgeLabel(double x, double y, string content)
        => new($"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"middle\" font-size=\"10\" " +
               "fill=\"var(--on-surface-variant)\" stroke=\"var(--surface)\" stroke-width=\"3\" " +
               $"paint-order=\"stroke\" style=\"pointer-events:none\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    private sealed record FleetDto(
        string[] Lanes, List<NodeDto> Nodes, List<EdgeDto> Edges, string? ActiveSprintId,
        List<IssueSampleDto> AllIssues, LayoutPayload? Layout);
    private sealed class LayoutPayload
    {
        public double Width { get; set; }
        public double Height { get; set; }
        public double? LaneDividerY { get; set; }
        public Dictionary<string, LayoutNodePayload> Nodes { get; set; } = new();
        public List<LayoutEdgePayload> Edges { get; set; } = new();
    }
    private sealed class LayoutNodePayload { public double X { get; set; } public double Y { get; set; } public double W { get; set; } public double H { get; set; } }
    private sealed class LayoutEdgePayload
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public string? Kind { get; set; }
        public string? Label { get; set; }
        public List<LayoutPointPayload> Points { get; set; } = new();
    }
    private sealed class LayoutPointPayload { public double X { get; set; } public double Y { get; set; } }
    private sealed record NodeDto(
        string Id, string Label, string Lane, double X, double Y, int Count, List<IssueSampleDto> Issues);
    private sealed record EdgeDto(string From, string To, string? Kind, string? Label);
    private sealed record IssueSampleDto(string Id, string Title, string Status);

    private sealed class PointDto { public double X { get; set; } public double Y { get; set; } public double W { get; set; } public double H { get; set; } }
    private sealed class LayoutResult
    {
        public double Width { get; set; }
        public double Height { get; set; }
        public Dictionary<string, PointDto> Nodes { get; set; } = new();
        public List<LayoutEdgeDto> Edges { get; set; } = new();
    }
    private sealed class LayoutEdgeDto
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public string Kind { get; set; } = "happy";
        public List<PointDto> Points { get; set; } = new();
        public string? Label { get; set; }
    }
    private sealed record JourneyDto(
        string IssueId, string Title, string Status, string? CurrentNode, int? PrNumber,
        string? LifecycleState, string? LifecycleEvent, string? LifecycleViolation,
        List<VisitDto> Visits);
    private sealed record VisitDto(
        string Node, DateTime At, string? Note, int Count, long DurationMs,
        System.Text.Json.JsonElement Details);
}
