@page "/now"
@inject HttpClient Http
@implements IDisposable
@using System.Net.Http.Json

<PageTitle>Now</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Dashboard</h1>
        <div class="page-header__meta">@(_feed is null ? "loading…" : $"as of {_feed.GeneratedAt.ToLocalTime():HH:mm:ss}")</div>
        <div class="page-header__actions">
            <button class="btn" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (_feed is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        @* ── KPI tiles ── *@
        <div class="dash-grid">
            <a href="/sprints" style="text-decoration:none;color:inherit">
                <div class="dash-tile">
                    <span class="dash-tile__label">Active sprint</span>
                    @if (_feed.Pulse.Sprint is { } s)
                    {
                        <span style="font-weight:600;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@s.Name">@s.Name</span>
                        <div class="dash-tile__bar"><div style="width:@(s.Total == 0 ? 0 : (100 * s.Done / s.Total))%"></div></div>
                        <span class="dash-tile__caption">@s.Done of @s.Total done · @s.Id</span>
                    }
                    else
                    {
                        <span class="dash-tile__value">—</span>
                        <span class="dash-tile__caption">no active sprint</span>
                    }
                </div>
            </a>
            <a href="/runs" style="text-decoration:none;color:inherit">
                <div class="dash-tile">
                    <span class="dash-tile__label">Agent runs</span>
                    <span class="dash-tile__value">@_feed.Live.Count <span style="font-size:13px;font-weight:400;color:var(--on-surface-variant)">running</span></span>
                    <span class="dash-tile__caption">
                        @if (_feed.Live.Count > 0)
                        {
                            @($"{_feed.Live[0].IssueId} · {Fmt(_feed.Live[0].ElapsedMs)}")
                        }
                        else
                        {
                            @:idle
                        }
                    </span>
                </div>
            </a>
            <a href="/backlog" style="text-decoration:none;color:inherit">
                <div class="dash-tile">
                    <span class="dash-tile__label">Waiting</span>
                    <span class="dash-tile__value">@_feed.Waiting.Count</span>
                    <span class="dash-tile__caption">@TopReason()</span>
                </div>
            </a>
            <div class="dash-tile">
                <span class="dash-tile__label">Stage gates</span>
                <span style="display:flex;gap:6px;flex-wrap:wrap;margin-top:4px">
                    @foreach (var (stage, state) in _feed.Pulse.Gates)
                    {
                        <button class="chip @(state == "hold" ? "chip--active" : "")"
                                title="@(state == "hold" ? $"Held — {stage} paused. Click to release." : $"{stage} open. Click to hold.")"
                                @onclick="@(() => ToggleGateAsync(stage))">
                            @stage
                        </button>
                    }
                </span>
                <span class="dash-tile__caption">
                    @{
                        var heldCount = _feed.Pulse.Gates.Values.Count(v => v == "hold");
                    }
                    @(heldCount == 0 ? "all open — pipeline automatic" : $"{heldCount} held")
                </span>
            </div>
        </div>

        @* ── Needs you: the alert inbox, in-line (fetched but never
             rendered until the 2026-07-27 audit — the bell said
             "see /now" and this page showed nothing) ── *@
        @if (_feed.Attention.Count > 0)
        {
            <div class="dash-panel" style="margin-bottom:16px">
                <div class="dash-panel__title">
                    <span>Needs you (@_feed.Attention.Count)</span>
                    <a href="/backlog">backlog →</a>
                </div>
                @foreach (var a in _feed.Attention.Take(10))
                {
                    <a href="@a.Link" class="alert-inbox__row" style="display:flex;text-decoration:none;color:inherit">
                        <span class="alert-inbox__dot" style="background:@SeverityDot(a.Severity)"></span>
                        <span class="alert-inbox__text">
                            <span class="alert-inbox__title">@a.Title</span>
                            @if (a.Detail is not null)
                            {
                                <span class="alert-inbox__detail">@a.Detail</span>
                            }
                        </span>
                        <span class="alert-inbox__chev">›</span>
                    </a>
                }
                @if (_feed.Attention.Count > 10)
                {
                    <div class="alert-inbox__empty">+@(_feed.Attention.Count - 10) more</div>
                }
            </div>
        }

        @* ── Happening now | Waiting & why ── *@
        <div class="dash-panels">
            <div class="dash-panel">
                <div class="dash-panel__title">
                    <span>Happening now</span>
                    <a href="/runs">runs →</a>
                </div>
                @if (_feed.Live.Count == 0)
                {
                    <div class="page-subtitle">Idle — no agent runs in flight.</div>
                }
                @foreach (var l in _feed.Live)
                {
                    <a href="/tasks/@l.IssueId" style="text-decoration:none;color:inherit">
                        <div style="display:flex;gap:10px;align-items:center;padding:7px 4px;border-bottom:1px solid var(--outline-variant)">
                            <span style="width:8px;height:8px;border-radius:50%;background:var(--primary);flex-shrink:0"></span>
                            <span class="mono" style="min-width:84px">@l.IssueId</span>
                            <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px">@l.Title</span>
                            <span style="color:var(--on-surface-variant);font-size:13px">@l.Stage@(l.Phase is { Length: > 0 } lp ? $" · {lp}" : "")</span>
                            <span class="mono" style="font-size:12px;color:var(--on-surface-variant)">@Fmt(l.ElapsedMs)</span>
                        </div>
                    </a>
                }
            </div>
            <div class="dash-panel">
                <div class="dash-panel__title">
                    <span>Waiting — and why</span>
                    <a href="/backlog">backlog →</a>
                </div>
                @if (_feed.Waiting.Count == 0)
                {
                    <div class="page-subtitle">Nothing queued.</div>
                }
                @foreach (var w in _feed.Waiting.Take(8))
                {
                    <a href="/tasks/@w.IssueId" style="text-decoration:none;color:inherit">
                        <div style="display:flex;gap:10px;align-items:center;padding:7px 4px;border-bottom:1px solid var(--outline-variant)">
                            <span class="mono" style="min-width:84px;color:var(--on-surface-variant)">@w.IssueId</span>
                            <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px">@w.Title</span>
                            <span style="font-size:13px;color:var(--on-surface-variant)">@w.Reason</span>
                            <span class="mono" style="font-size:12px;color:var(--on-surface-variant)">@Fmt(w.WaitingMs)</span>
                        </div>
                    </a>
                }
                @if (_feed.Waiting.Count > 8)
                {
                    <div class="page-subtitle" style="margin-top:6px">+@(_feed.Waiting.Count - 8) more</div>
                }
            </div>
        </div>

        @* ── Pipeline flow strip ── *@
        @if (_flow is not null)
        {
            <div class="dash-panel">
                <div class="dash-panel__title">
                    <span>Pipeline flow</span>
                    <a href="/flow">open flow →</a>
                </div>
                @* Horizontal compact variant of the directed layout
                   (spine left → right, sinks above/below) — computed
                   server-side alongside the vertical one. *@
                @if (_flow.LayoutHorizontal is not null)
                {
                    var lh = _flow.LayoutHorizontal;
                    <svg viewBox="0 0 @SvgSmoothing.F(lh.Width) @SvgSmoothing.F(lh.Height)" style="width:100%;max-height:340px">
                        <defs>
                            <marker id="darrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--outline-variant)" />
                            </marker>
                        </defs>
                        @if (lh.LaneDividerY is not null)
                        {
                            <line x1="@SvgSmoothing.F(lh.LaneDividerY.Value)" y1="10" x2="@SvgSmoothing.F(lh.LaneDividerY.Value)" y2="@SvgSmoothing.F(lh.Height - 10)"
                                  stroke="var(--outline-variant)" stroke-dasharray="4 4" opacity="0.6" />
                        }
                        @foreach (var e in lh.Edges)
                        {
                            var isLoop = e.Kind is "loop" or "failure";
                            <path d="@SvgSmoothing.SmoothPath(e.Points.Select(p => (p.X, p.Y)).ToList())" fill="none"
                                  stroke="@(isLoop ? "var(--warn)" : "var(--outline)")"
                                  stroke-width="1.2" stroke-dasharray="@(isLoop ? "5 3" : null)"
                                  marker-end="url(#darrow)" opacity="0.7" />
                        }
                        @foreach (var n in _flow.Nodes)
                        {
                            if (!lh.Nodes.TryGetValue(n.Id, out var p)) continue;
                            <rect x="@SvgSmoothing.F(p.X - p.W / 2)" y="@SvgSmoothing.F(p.Y - p.H / 2)" width="@SvgSmoothing.F(p.W)" height="@SvgSmoothing.F(p.H)" rx="9"
                                  fill="var(--surface)" stroke="@(n.Count > 0 ? "var(--primary)" : "var(--outline-variant)")"
                                  stroke-width="@(n.Count > 0 ? 1.8 : 1)" />
                            @SvgText((int)p.X, (int)(p.Y + 4), "var(--on-surface)", 12, "middle", n.Label)
                            @if (n.Count > 0)
                            {
                                <circle cx="@SvgSmoothing.F(p.X + p.W / 2 - 10)" cy="@SvgSmoothing.F(p.Y - p.H / 2 + 6)" r="11" fill="var(--primary)" />
                                @SvgText((int)(p.X + p.W / 2 - 10), (int)(p.Y - p.H / 2 + 10), "var(--on-primary, #fff)", 11, "middle", n.Count.ToString(), bold: true)
                            }
                        }
                    </svg>
                }
            </div>
        }
        @* ── Run quality gate verdicts ── *@
        <GateVerdictsWidget />
        
    }
</div>

@code {
    private NowFeedDto? _feed;
    private FlowDto? _flow;
    private System.Threading.Timer? _timer;

    private static string SeverityDot(string severity) => severity switch
    {
        "fail" => "#c62828",
        "warn" => "#ef6c00",
        _ => "#1565c0",
    };

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ => InvokeAsync(LoadAsync), null,
            TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    private async Task LoadAsync()
    {
        try
        {
            _feed = await Http.GetFromJsonAsync<NowFeedDto>("/api/now");
            _flow ??= await Http.GetFromJsonAsync<FlowDto>("/api/flow");
            if (_flow is not null)
            {
                // Refresh counts without rebuilding the whole strip.
                var fresh = await Http.GetFromJsonAsync<FlowDto>("/api/flow");
                if (fresh is not null) _flow = fresh;
            }
            StateHasChanged();
        }
        catch { /* keep last good frame */ }
    }

    private string TopReason()
    {
        if (_feed is null || _feed.Waiting.Count == 0) return "nothing queued";
        var groups = _feed.Waiting.GroupBy(w => w.Reason).OrderByDescending(g => g.Count()).ToList();
        var top = groups[0];
        var reason = top.Key.Length > 42 ? top.Key[..42] + "…" : top.Key;
        return groups.Count == 1
            ? $"{top.Count()}× {reason}"
            : $"{top.Count()}× {reason} (+{groups.Count - 1} other)";
    }

    private async Task ToggleGateAsync(string stage)
    {
        var held = _feed?.Pulse.Gates.TryGetValue(stage, out var s) == true && s == "hold";
        var resp = await Http.PostAsync($"/api/gates/{stage}/{(held ? "release" : "hold")}", null);
        if (resp.IsSuccessStatusCode) await LoadAsync();
    }

    private static string Fmt(long ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        if (ts.TotalDays >= 1) return $"{(int)ts.TotalDays}d";
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m";
        return $"{(int)ts.TotalSeconds}s";
    }

    private static MarkupString SvgText(int x, int y, string fill, int size, string anchor, string content, bool bold = false)
        => new($"<text x=\"{x}\" y=\"{y}\" fill=\"{fill}\" font-size=\"{size}\" text-anchor=\"{anchor}\"" +
               (bold ? " font-weight=\"600\"" : "") + $">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    public void Dispose() => _timer?.Dispose();

    private sealed record NowFeedDto(
        DateTime GeneratedAt,
        List<AttentionDto> Attention,
        List<LiveDto> Live,
        List<WaitingDto> Waiting,
        PulseDto Pulse);
    private sealed record AttentionDto(string Severity, string Kind, string Title, string? Detail, string? IssueId, string Link);
    private sealed record LiveDto(string IssueId, string Title, string Stage, long ElapsedMs, string? Phase);
    private sealed record WaitingDto(string IssueId, string Title, string Reason, long WaitingMs);
    private sealed record PulseDto(Dictionary<string, string> Gates, SprintDto? Sprint, DateTime? LastActivityAt);
    private sealed record SprintDto(string Id, string Name, int Done, int Total);

    private sealed record FlowDto(List<FlowNodeDto> Nodes, List<FlowEdgeDto> Edges, FlowLayoutDto? LayoutHorizontal);
    private sealed record FlowNodeDto(string Id, string Label, string Lane, int X, int Y, int Count);
    private sealed record FlowEdgeDto(string From, string To);
    private sealed class FlowLayoutDto
    {
        public double Width { get; set; }
        public double Height { get; set; }
        public double? LaneDividerY { get; set; }
        public Dictionary<string, FlowLayoutNodeDto> Nodes { get; set; } = new();
        public List<FlowLayoutEdgeDto> Edges { get; set; } = new();
    }
    private sealed class FlowLayoutNodeDto { public double X { get; set; } public double Y { get; set; } public double W { get; set; } public double H { get; set; } }
    private sealed class FlowLayoutEdgeDto
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public string? Kind { get; set; }
        public List<FlowLayoutPointDto> Points { get; set; } = new();
    }
    private sealed class FlowLayoutPointDto { public double X { get; set; } public double Y { get; set; } }
}
