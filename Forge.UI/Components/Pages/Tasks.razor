@page "/tasks"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IDispatcher Dispatch
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@implements IDisposable
@using System.Net.Http.Json
@using Forge.Dashboard.Services
<PageTitle>Tasks</PageTitle>
<div class="page task-detail task-list-workspace">
    <div class="page-header"><h1>Tasks</h1><button class="btn" @onclick="() => LoadAsync(false)">Refresh</button></div>
    <div class="task-controls">
        @foreach (var choice in new[] { ("active", "Active work"), ("attention", "Needs attention"), ("history", "History") })
        { <button class="btn @(_view == choice.Item1 ? "btn--primary" : "")" aria-pressed="@((_view == choice.Item1).ToString().ToLowerInvariant())" @onclick="() => SelectView(choice.Item1)">@choice.Item2</button> }
        <label>Find task <input @bind="_search" placeholder="Title, task ID or PR number" /></label><button class="btn" @onclick="() => LoadAsync(false)">Search</button>
    </div>
    @if (_error is not null) { <p class="banner banner--error" role="alert">Couldn’t load tasks: @_error</p> }
    @if (_loading) { <p role="status">Loading…</p> }
    <p class="meta-text">@_items.Count shown · @_total matching tasks</p>
    <div class="task-run-list">@foreach (var task in _items) { <article><div><a href="@($"/tasks/{Uri.EscapeDataString(task.Id)}?project={Uri.EscapeDataString(_loadedProject ?? "")}")">@task.Title</a><strong>@task.Situation.Label</strong></div><p>@task.Situation.Text</p><p class="meta-text">@WorkPresentation.Role(task.Type)@(task.Situation.NextActor is { } actor ? $" · Next: {actor}" : "")@(task.PrNumber is { } pr ? $" · PR #{pr}" : "")</p>@if (task.Situation.HumanReviewRequired) { <p>Human review required before merge</p> }</article> }</div>
    @if (!_loading && _error is null && _items.Count == 0) { <p>No matching tasks.</p> }
    @if (_cursor is not null) { <button class="btn" disabled="@_loading" @onclick="() => LoadAsync(true)">Load more tasks</button> }
</div>
@code {
    [Parameter][SupplyParameterFromQuery(Name = "project")] public string? Project { get; set; }
    private string _view = "active", _search = "";
    private string? _loadedProject, _cursor, _error;
    private bool _loading, _restoreScroll;
    private int _generation, _total, _pages;
    private IJSObjectReference? _browser;
    private sealed record ListLocation(string? View, string? Search, int Pages);
    private List<TaskRow> _items = new();
    protected override void OnInitialized() => ShellStore.StateChanged += ShellChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Project is not null && Project != ShellStore.Value.CurrentProjectId)
                Dispatch.Dispatch(new Forge.Dashboard.Features.AppShell.AppShellActions.SelectProjectAction(Project));
            _browser = await JS.InvokeAsync<IJSObjectReference>("import", "./sprint-board.js"); await RestoreAsync(); StateHasChanged();
        }
        if (!_loading && _browser is not null && _loadedProject is not null)
        {
            await _browser.InvokeVoidAsync("rememberList", "tasks:" + _loadedProject, _view, _search, _pages);
            if (_restoreScroll) { _restoreScroll = false; await _browser.InvokeVoidAsync("restoreScroll", "tasks:" + _loadedProject); }
        }
    }
    protected override async Task OnParametersSetAsync() { if (_browser is not null) await RestoreAsync(); }
    private void ShellChanged(object? sender, EventArgs args)
    {
        if (_browser is null) return;
        if (Project is not null && ShellStore.Value.CurrentProjectId is { } selected && selected != Project)
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("project", selected));
        else if (_loadedProject != (Project ?? ShellStore.Value.CurrentProjectId)) _ = InvokeAsync(async () => { await RestoreAsync(); StateHasChanged(); });
    }
    private async Task RestoreAsync()
    {
        var project = Project ?? ShellStore.Value.CurrentProjectId;
        if (project is null || _browser is null) return;
        var saved = await _browser.InvokeAsync<ListLocation?>("begin", "tasks:" + project);
        _view = saved?.View is "history" or "attention" ? saved.View : "active";
        _search = saved?.Search ?? "";
        await LoadAsync(false);
        for (var page = 1; page < Math.Clamp(saved?.Pages ?? 1, 1, 100) && _cursor is not null && _error is null && project == (Project ?? ShellStore.Value.CurrentProjectId); page++) await LoadAsync(true);
        if (project != (Project ?? ShellStore.Value.CurrentProjectId)) return;
        _restoreScroll = true;
    }
    private async Task SelectView(string view) { _view = view; await LoadAsync(false); }
    private async Task LoadAsync(bool append)
    {
        var project = Project ?? ShellStore.Value.CurrentProjectId;
        var generation = ++_generation;
        if (_loadedProject != project || !append) { _items.Clear(); _cursor = null; _pages = 0; }
        _loadedProject = project; _loading = true; _error = null;
        try
        {
            var query = $"/api/tasks/list?view={_view}&search={Uri.EscapeDataString(_search)}" + (project is null ? "" : "&projectId=" + Uri.EscapeDataString(project)) + (_cursor is null ? "" : "&cursor=" + Uri.EscapeDataString(_cursor));
            var result = await Http.GetFromJsonAsync<TaskPage>(query) ?? throw new InvalidDataException("No task list returned.");
            if (generation != _generation || project != (Project ?? ShellStore.Value.CurrentProjectId)) return;
            _items.AddRange(result.Items); _cursor = result.NextCursor; _total = result.Total; _pages++;
        }
        catch (Exception ex) { if (generation == _generation) _error = ex.Message; }
        finally { if (generation == _generation) _loading = false; }
    }
    public void Dispose() => ShellStore.StateChanged -= ShellChanged;
    private sealed record TaskPage(List<TaskRow> Items, string? NextCursor, int Total);
    private sealed record TaskRow(string Id, string Title, string Type, string Status, string? PrNumber, SituationRow Situation);
    private sealed record SituationRow(string Label, string Text, string? NextActor, bool HumanReviewRequired);
}
