@page "/projects/{Id}/secrets"
@inject HttpClient Http
@inject IState<Forge.Dashboard.Features.Projects.ProjectsState> ProjectsStore
@implements IDisposable
@using System.Net.Http.Json

<PageTitle>Secrets · @Id</PageTitle>
<div class="page secrets-page">
    <div class="page-header">
        <h1>Secrets</h1>
        <div class="page-header__meta">
            <span class="mono">@Id</span>
            <span style="margin:0 6px;color:var(--outline-variant)">|</span>
            <span style="color:var(--on-surface-variant)">encrypted at rest</span>
        </div>
        <div class="page-header__actions">
            <a class="btn btn--ghost" href="@($"/projects/{Id}/overview")">Back</a>
        </div>
    </div>

    @if (ProjectsStore.Value.Loading && _secrets is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (_secrets is null)
    {
        <div class="empty-state">
            <h2>No secrets yet</h2>
            <p>Secrets are encrypted with IDataProtector (AES-256-CBC + HMAC-SHA256) and stored in the project's SQLite database.</p>
        </div>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="banner banner--error">
                <span>@_error</span>
                <button class="btn btn--link" @onclick="() => _error = null">Dismiss</button>
            </div>
        }

        <div class="card">
            <h2>Provider credentials</h2>
            <p class="hint">
                Per-project values override the global <code>appsettings.json</code> / env-var fallback.
                Per-tenant scoping is in place — secrets for project <code>A</code> never leak to project <code>B</code>.
                The DataProtection master keyring lives at <code>~/.aspnet/DataProtection-Keys/</code> on Linux;
                rotating that key invalidates every stored secret.
            </p>
        </div>

        <div class="secret-list">
            @foreach (var secret in _secrets)
            {
                <div class="secret-row">
                    <div class="secret-row__name">
                        @secret.Kind
                        <span class="secret-row__name__sub">@DescribeKind(secret.Kind)</span>
                    </div>
                    <div class="secret-row__status @(secret.Set ? "secret-row__status--set" : "secret-row__status--unset")">
                        @(secret.Set ? $"set · {FormatTime(secret.UpdatedAt)}" : "unset")
                    </div>
                    <div style="display:flex; gap:6px;">
                        <button class="btn btn--small" @onclick="() => OpenEditor(secret)">@(secret.Set ? "Replace" : "Set")</button>
                        @if (secret.Set)
                        {
                            <button class="btn btn--small btn--danger" @onclick="() => DeleteSecret(secret.Kind)">Delete</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_editingKind is not null)
{
    <div class="secret-modal-backdrop" @onclick="() => _editingKind = null">
        <div class="secret-modal" @onclick:stopPropagation="true">
            <h2>@_editingKind</h2>
            <p class="hint">@DescribeKind(_editingKind)</p>
            <label>
                <span>Value</span>
                <input type="@(_showValue ? "text" : "password")" @bind="_editValue" placeholder="paste the secret value" autocomplete="off" />
            </label>
            <label style="flex-direction:row;align-items:center;gap:6px;">
                <input type="checkbox" @bind="_showValue" />
                <span style="font-size:11px;">Show value</span>
            </label>
            <div class="secret-modal__actions">
                <button class="btn btn--ghost" @onclick="() => _editingKind = null">Cancel</button>
                <button class="btn btn--primary" @onclick="SaveSecret" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private List<Forge.Dashboard.Features.Projects.SecretMetadataDto>? _secrets;
    private string? _error;
    private string? _editingKind;
    private string _editValue = string.Empty;
    private bool _showValue;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        ProjectsStore.StateChanged += OnStateChanged;
        await Reload();
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ProjectsStore.StateChanged -= OnStateChanged;
    }

    private async Task Reload()
    {
        try
        {
            var rows = await Http.GetFromJsonAsync<List<Forge.Dashboard.Features.Projects.SecretMetadataDto>>($"/api/projects/{Id}/secrets/");
            _secrets = rows;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load secrets: {ex.Message}";
        }
    }

    private void OpenEditor(Forge.Dashboard.Features.Projects.SecretMetadataDto secret)
    {
        _editingKind = secret.Kind;
        _editValue = string.Empty;
        _showValue = false;
    }

    private async Task SaveSecret()
    {
        if (_editingKind is null || string.IsNullOrEmpty(_editValue)) return;
        _saving = true;
        try
        {
            var body = new Forge.Dashboard.Features.Projects.SetSecretRequestBody(_editingKind, _editValue);
            var resp = await Http.PostAsJsonAsync($"/api/projects/{Id}/secrets/", body);
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                _error = $"Set secret failed: {resp.StatusCode} {err}";
            }
            else
            {
                _editingKind = null;
                _editValue = string.Empty;
                await Reload();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteSecret(string kind)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/projects/{Id}/secrets/{kind}");
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                _error = $"Delete failed: {resp.StatusCode} {err}";
            }
            await Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string DescribeKind(string kind) => kind switch
    {
        "github_token"           => "GitHub PAT (X-OAuth-Bearer to forge. Create via Settings → Developer settings → Personal access tokens.)",
        "kilo_gateway_api_key"   => "Kilo Gateway API key (Bearer token to api.kilo.ai/api/gateway.)",
        "meshy_api_key"          => "Meshy API key (Bearer token to api.meshy.ai for the Designer / Artist agents' 3D asset generation.)",
        _ => "Custom secret (free-form kind; resolve via SecretStore.GetPlaintextAsync in the LLM/GitHub provider paths.)",
    };

    private static string FormatTime(DateTime? t) => t is null ? "" : t.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
