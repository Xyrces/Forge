@page "/projects/{Id}/secrets"
@inject HttpClient Http
@inject IState<Forge.Dashboard.Features.Projects.ProjectsState> ProjectsStore
@implements IDisposable
@using System.Net.Http.Json

<PageTitle>Secrets · @Id</PageTitle>
<div class="page secrets-page">
    <div class="page-header">
        <h1>Secrets</h1>
        <div class="page-header__meta">
            <span class="mono">@Id</span>
            <span style="margin:0 6px;color:var(--outline-variant)">|</span>
            <span style="color:var(--on-surface-variant)">encrypted at rest</span>
        </div>
        <div class="page-header__actions">
            <button class="btn" @onclick="Reload">Refresh</button>
            <a class="btn btn--ghost" href="@($"/projects/{Id}/overview")">Back</a>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="banner banner--error">
            <span>@_error</span>
            <button class="btn btn--link" @onclick="() => _error = null">Dismiss</button>
        </div>
    }

    @if (_secrets is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        @* ===================== UPPER PANEL: supported kinds ===================== *@
        <section class="overview-section">
            <h2>Supported credentials</h2>
            <p class="page-subtitle page-subtitle--meta">
                These are the kinds Forge itself consumes. Per-project values override the global
                <code>appsettings.json</code> / env-var fallback for this project's dispatch runs.
            </p>
            <div class="secret-list">
                @foreach (var secret in KnownSecrets)
                {
                    <div class="secret-row">
                        <div class="secret-row__name">
                            @secret.Kind
                            <span class="secret-row__name__sub">@DescribeKind(secret.Kind)</span>
                        </div>
                        <div class="secret-row__status @(secret.Set ? "secret-row__status--set" : "secret-row__status--unset")">
                            @(secret.Set ? $"set · {FormatTime(secret.UpdatedAt)}" : "unset")
                        </div>
                        <div style="display:flex; gap:6px;">
                            <button class="btn btn--small" @onclick="() => OpenEditor(secret.Kind)">@(secret.Set ? "Replace" : "Set")</button>
                            @if (secret.Set)
                            {
                                <button class="btn btn--small btn--danger" @onclick="() => _confirmDelete = secret.Kind">Delete</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ===================== LOWER PANEL: custom kinds ===================== *@
        <section class="overview-section">
            <h2>Custom secrets</h2>
            <p class="page-subtitle page-subtitle--meta">
                Any other credential the project's agents may need (npm tokens, deploy keys, service
                URLs, ...). Custom secrets are injected into the agent's <code>bash</code> tool as
                environment variables named <code>FORGE_SECRET_&lt;KIND&gt;</code> (kind uppercased,
                <code>-</code> → <code>_</code>). Agents reference them by name —
                e.g. <code>curl -H "Authorization: Bearer $FORGE_SECRET_NPM_TOKEN" …</code> —
                the value never enters the model's context.
            </p>

            @if (CustomSecrets.Count == 0)
            {
                <div class="page-subtitle">No custom secrets yet.</div>
            }
            else
            {
                <div class="secret-list">
                    @foreach (var secret in CustomSecrets)
                    {
                        <div class="secret-row">
                            <div class="secret-row__name">
                                @secret.Kind
                                <span class="secret-row__name__sub mono">$@EnvNameFor(secret.Kind)</span>
                            </div>
                            <div class="secret-row__status @(secret.Set ? "secret-row__status--set" : "secret-row__status--unset")">
                                @(secret.Set ? $"set · {FormatTime(secret.UpdatedAt)}" : "unset")
                            </div>
                            <div style="display:flex; gap:6px;">
                                <button class="btn btn--small" @onclick="() => OpenEditor(secret.Kind)">Replace</button>
                                <button class="btn btn--small btn--danger" @onclick="() => _confirmDelete = secret.Kind">Delete</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="card" style="margin-top:12px">
                <h2>Add custom secret</h2>
                <form class="form-grid" @onsubmit="AddCustomAsync" @onsubmit:preventDefault="true">
                    <label>
                        <span>Kind <small>(lowercase slug: [a-z0-9][a-z0-9_-]*)</small></span>
                        <input type="text" placeholder="npm_token" @bind="_newKind" maxlength="64" autocomplete="off" />
                    </label>
                    <label>
                        <span>Value</span>
                        <input type="password" placeholder="the secret value" @bind="_newValue" autocomplete="off" />
                    </label>
                    <div class="form-grid__actions">
                        <button type="submit" class="btn btn--primary" disabled="@_saving">@(_saving ? "Saving…" : "Add secret")</button>
                    </div>
                </form>
                @if (!string.IsNullOrWhiteSpace(_newKind))
                {
                    <p class="hint" style="margin-top:8px">
                        Agents will reference this as <code>$@EnvNameFor(_newKind)</code>.
                    </p>
                }
            </div>
        </section>

        <div class="page-subtitle page-subtitle--meta">
            Secrets are encrypted with IDataProtector (AES-256-CBC + HMAC-SHA256) and stored in the
            project's SQLite database. The DataProtection keyring lives at
            <code>~/.aspnet/DataProtection-Keys/</code>; rotating it invalidates every stored secret.
        </div>
    }

    <ConfirmDialog Visible="_confirmDelete is not null"
                   Title="Delete secret?"
                   Body="@($"Permanently delete '{_confirmDelete}' for project {Id}? Anything resolving it (clone/push, LLM auth) fails until it's set again.")"
                   ConfirmLabel="Delete"
                   OnConfirm="ConfirmDeleteAsync"
                   OnCancel="() => _confirmDelete = null" />
</div>

@if (_editingKind is not null)
{
    <div class="secret-modal-backdrop" @onclick="() => _editingKind = null">
        <div class="secret-modal" @onclick:stopPropagation="true">
            <h2>@_editingKind</h2>
            <p class="hint">@DescribeKind(_editingKind)</p>
            <label>
                <span>Value</span>
                <input type="@(_showValue ? "text" : "password")" @bind="_editValue" placeholder="paste the secret value" autocomplete="off" />
            </label>
            <label style="flex-direction:row;align-items:center;gap:6px;">
                <input type="checkbox" @bind="_showValue" />
                <span style="font-size:11px;">Show value</span>
            </label>
            <div class="secret-modal__actions">
                <button class="btn btn--ghost" @onclick="() => _editingKind = null">Cancel</button>
                <button class="btn btn--primary" @onclick="SaveSecret" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private List<Forge.Dashboard.Features.Projects.SecretMetadataDto>? _secrets;
    private string? _error;
    private string? _editingKind;
    private string _editValue = string.Empty;
    private bool _showValue;
    private bool _saving;
    private string _newKind = string.Empty;
    private string _newValue = string.Empty;

    private static readonly HashSet<string> KnownKinds = new(StringComparer.OrdinalIgnoreCase)
    {
        "github_token", "kilo_gateway_api_key", "meshy_api_key",
    };

    private IEnumerable<Forge.Dashboard.Features.Projects.SecretMetadataDto> KnownSecrets =>
        (_secrets ?? new()).Where(s => KnownKinds.Contains(s.Kind));

    private List<Forge.Dashboard.Features.Projects.SecretMetadataDto> CustomSecrets =>
        (_secrets ?? new()).Where(s => !KnownKinds.Contains(s.Kind)).ToList();

    protected override async Task OnInitializedAsync()
    {
        ProjectsStore.StateChanged += OnStateChanged;
        await Reload();
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ProjectsStore.StateChanged -= OnStateChanged;
    }

    private async Task Reload()
    {
        try
        {
            _secrets = await Http.GetFromJsonAsync<List<Forge.Dashboard.Features.Projects.SecretMetadataDto>>($"/api/projects/{Id}/secrets/");
        }
        catch (Exception ex)
        {
            _error = $"Failed to load secrets: {ex.Message}";
            _secrets ??= new();
        }
    }

    private void OpenEditor(string kind)
    {
        _editingKind = kind;
        _editValue = string.Empty;
        _showValue = false;
    }

    private async Task SaveSecret()
    {
        if (_editingKind is null || string.IsNullOrEmpty(_editValue)) return;
        _saving = true;
        try
        {
            await PostSecret(_editingKind, _editValue);
            _editingKind = null;
            _editValue = string.Empty;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AddCustomAsync()
    {
        if (string.IsNullOrWhiteSpace(_newKind) || string.IsNullOrEmpty(_newValue)) return;
        _saving = true;
        try
        {
            await PostSecret(_newKind.Trim(), _newValue);
            _newKind = string.Empty;
            _newValue = string.Empty;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PostSecret(string kind, string value)
    {
        var body = new Forge.Dashboard.Features.Projects.SetSecretRequestBody(kind, value);
        var resp = await Http.PostAsJsonAsync($"/api/projects/{Id}/secrets/", body);
        if (!resp.IsSuccessStatusCode)
        {
            var err = await resp.Content.ReadAsStringAsync();
            _error = $"Set secret failed: {resp.StatusCode} {err}";
            return;
        }
        _error = null;
        await Reload();
    }

    private async Task DeleteSecret(string kind)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/projects/{Id}/secrets/{kind}");
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                _error = $"Delete failed: {resp.StatusCode} {err}";
            }
            await Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string? _confirmDelete;

    private async Task ConfirmDeleteAsync()
    {
        if (_confirmDelete is not null)
        {
            await DeleteSecret(_confirmDelete);
        }
        _confirmDelete = null;
    }

    private static string EnvNameFor(string kind) =>
        "FORGE_SECRET_" + kind.Replace('-', '_').ToUpperInvariant();

    private static string DescribeKind(string kind) => kind switch
    {
        "github_token"           => "GitHub PAT. Used for clone/push and PR operations on this project's repo (overrides the global GITHUB_TOKEN).",
        "kilo_gateway_api_key"   => "Kilo Gateway API key. Bearer token for the LLM provider this project's agents run on.",
        "meshy_api_key"          => "Meshy API key. Bearer token to api.meshy.ai for the Designer / Artist agents' 3D asset generation.",
        _ => $"Custom secret. Available to agents as ${EnvNameFor(kind)} in the bash tool.",
    };

    private static string FormatTime(DateTime? t) => t is null ? "" : t.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
