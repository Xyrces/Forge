@page "/designs"
@inject IState<Forge.Dashboard.Features.Designs.DesignsState> DesignsStore
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject Fluxor.IDispatcher Dispatch
@implements IDisposable

<PageTitle>Designs</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Designs</h1>
        <div class="page-header__meta">@DesignsStore.Value.Rows.Count designs</div>
    </div>

    @if (DesignsStore.Value.Loading)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (DesignsStore.Value.Error is not null)
    {
        <div class="page-subtitle">Error: @DesignsStore.Value.Error</div>
    }
    else
    {
        <div class="filter-bar">
            @foreach (var f in new[] { "All", "ReadyForDesign", "NeedsRevision", "Designed" })
            {
                <button class="chip @(_filter == f ? "chip--active" : "")" @onclick="() => _filter = f">@f</button>
            }
        </div>

        <div class="design-grid">
            @foreach (var row in DesignsStore.Value.Rows.Where(r => _filter == "All" || r.Status == _filter))
            {
                <div class="design-card">
                    <div class="design-card__thumb"></div>
                    <div class="design-card__id mono"><a href="/specs/@row.SpecId">@row.SpecId</a></div>
                    <div class="design-card__title">@row.Title</div>
                    <div class="design-card__meta">
                        <span class="pill pill--@row.Status.ToLowerInvariant()">@row.Status</span>
                        <span class="mono">@row.Kind</span>
                    </div>
                </div>
            }
            @if (DesignsStore.Value.Rows.Count == 0)
            {
                <div class="page-subtitle">No designs yet. Run the Designer agent on a spec to populate this board.</div>
            }
        </div>
    }
</div>

@code {
    private string? _loadedProject;
    private string _filter = "All";

    protected override void OnInitialized()
    {
        DesignsStore.StateChanged += OnStateChanged;
        ShellStore.StateChanged += OnShellChanged;
        LoadForCurrentProject();
    }

    private void OnStateChanged(object? s, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnShellChanged(object? s, EventArgs e)
    {
        if (ShellStore.Value.CurrentProjectId != _loadedProject)
        {
            InvokeAsync(LoadForCurrentProject);
        }
    }

    private void LoadForCurrentProject()
    {
        _loadedProject = ShellStore.Value.CurrentProjectId;
        if (_loadedProject is not null)
        {
            Dispatch.Dispatch(new Forge.Dashboard.Features.Designs.DesignsActions.LoadDesignsAction(_loadedProject));
        }
    }

    public void Dispose()
    {
        DesignsStore.StateChanged -= OnStateChanged;
        ShellStore.StateChanged -= OnShellChanged;
    }
}