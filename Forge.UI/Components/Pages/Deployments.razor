@page "/deployments"
@inject IState<Forge.Dashboard.Features.Deployments.DeploymentsState> DeployStore
@inject IState<Forge.Dashboard.Features.Projects.ProjectsState> ProjectsStore
@inject IDispatcher Dispatch
@inject HttpClient Http
@implements IDisposable
@using Forge.Dashboard.Features.Deployments
@using Forge.Dashboard.Features.Projects

<PageTitle>Deployments</PageTitle>
<div class="page">
    <div class="page-header"><h1>Deployments</h1><div class="page-header__actions"><button class="btn" @onclick="RefreshAsync">Refresh</button></div></div>
    <p class="page-subtitle">Sprints deliver to their configured completion environment. Promote a successful release below to deploy the same artifact to another environment.</p>
    <label class="environment-field"><span>Project</span>
        <select aria-label="Deployment project" @bind="_projectId" @bind:after="LoadPolicyAsync">
            <option value="">All projects</option>
            @foreach (var project in ProjectsStore.Value.Projects) { <option value="@project.Id">@project.Name</option> }
        </select>
    </label>
    @if (_policyLoading) { <p role="status">Loading environment policy…</p> }
    @if (_policyError is not null) { <p role="alert" class="banner banner--warn">@_policyError Promotion actions are unavailable until policy is loaded.</p> }
    @if (_policy is { Environments.Count: > 0 })
    {
        <section class="card overview-section" aria-label="Delivery policy">
            @if (_policy.SprintEnvironment is null) { <p>No deployment required for sprint completion. Sprints close after required engineering verification.</p> }
            else
            {
                <p>Sprint completion: <strong>@(_policy.Environments.FirstOrDefault(e => e.Name == _policy.SprintEnvironment)?.DisplayName ?? "Not configured")</strong> · build, tests and deployment health checks required.</p>
                <p>@(_policy.Environments.FirstOrDefault(e => e.Name == _policy.SprintEnvironment)?.RequireApproval == true ? "Explicit human deployment approval is required on the sprint." : "No human deployment approval gate on the sprint target.")</p>
            }
            <a href="@($"/projects/{Uri.EscapeDataString(_projectId)}/overview#project-environments-title")">Configure environments &amp; gates</a>
        </section>
    }
    @if (DeployStore.Value.Error is not null)
    {
        <p role="alert" class="banner banner--warn">Could not refresh release history. @DeployStore.Value.Error @if (DeployStore.Value.LastFetchedAt is { } fetched) { <span>Last updated @fetched.ToLocalTime().ToString("g").</span> }</p>
    }
    @if (DeployStore.Value.ActionError is not null) { <p role="alert" class="banner banner--warn">@DeployStore.Value.ActionError</p> }
    @if (_policy is { Environments.Count: 0 } && _projectId.Length > 0)
    {
        <details class="card overview-section"><summary>Legacy deployment request</summary>
            <p>This project has no named environments. Existing single-target deployment controls apply.</p>
            <label class="environment-field"><span>Source commit</span><select @bind="_commitSha"><option value="">Choose a commit…</option>
                @foreach (var commit in DeployStore.Value.Commits.Where(_ => DeployStore.Value.CommitsForProjectId == _projectId)) { <option value="@commit.Sha">@commit.ShortSha @commit.Subject</option> }
            </select></label>
            @if (DeployStore.Value.CommitsError is { } error) { <p role="alert">@error</p> }
            <button class="btn" disabled="@string.IsNullOrEmpty(_commitSha)" @onclick="RequestLegacy">Request deployment</button>
        </details>
    }
    <h2>Release history</h2>
    @if (DeployStore.Value.Loading && DeployStore.Value.LastFetchedAt is null) { <p role="status">Loading releases…</p> }
    else if (!Rows.Any()) { <p>No releases recorded for this selection.</p> }
    <div class="release-list">
        @foreach (var release in Rows)
        {
            <article class="card release-card" @key="release.Id" id="@($"release-{release.Id}")">
                <header class="release-header"><div><h3>@(release.CommitSummary ?? $"Release {Short(release.CommitSha)}")</h3>
                    <p>@ProjectName(release.ProjectId) · <strong>@EnvironmentLabel(release)</strong> · <code title="@release.CommitSha">@Short(release.CommitSha)</code></p></div>
                    <span class="dpill dpill--@release.Status.ToLowerInvariant()">@StatusLabel(release)</span>
                </header>
                <p class="muted">Requested @release.RequestedAt.ToLocalTime().ToString("g") @if (release.DeployedAt is { } deployed) { <span> · Deployed @deployed.ToLocalTime().ToString("g")</span> }</p>
                @if (release.EnvironmentName is null) { <p class="muted">Historical or single-target release. No named environment was recorded.</p> }
                @if (release.SourceCandidateId is { } source)
                {
                    <p>Promotion of <a href="@($"#release-{source}")">@SourceLabel(source)</a>. The artifact is reused without rebuilding.</p>
                }
                @if (release.RetryOfCandidateId is { } retrySource) { <p>Retry of <a href="@($"#release-{retrySource}")">@SourceLabel(retrySource)</a>. Earlier evidence is retained.</p> }
                @if (release.CompletionId is not null && release.Status is "Pending" or "BuildPassed")
                {
                    <p>Automatic sprint delivery · <a href="/sprints">View sprint checks &amp; explicit gates</a></p>
                }
                <ReleasePromotion Release="release" Policy="@(release.ProjectId == _projectId && DeployStore.Value.Error is null ? _policy : null)" OnPromoted="RefreshAsync" />
                <ReleaseRecovery Release="release" Enabled="@(DeployStore.Value.Error is null)" OnChanged="RefreshAsync" />
                @if (_projectId.Length == 0 && release.Status == "Deployed" && release.EnvironmentName is not null && string.IsNullOrEmpty(release.PromotionUnavailableReason)) { <button class="btn btn--small" @onclick="() => SelectProjectAsync(release.ProjectId)">Select project to promote</button> }
                @if (!string.IsNullOrEmpty(release.BuildLog) || !string.IsNullOrEmpty(release.DeployLog))
                {
                    <details class="release-evidence"><summary>@(release.Status is "Failed" or "BuildFailed" or "DeployFailed" ? "Failure details" : "Deployment evidence & logs")</summary>
                        @if (!string.IsNullOrEmpty(release.BuildLog)) { <h4>Build &amp; qualification</h4><pre class="release-log">@release.BuildLog</pre> }
                        @if (!string.IsNullOrEmpty(release.DeployLog)) { <h4>Deployment</h4><pre class="release-log">@release.DeployLog</pre> }
                    </details>
                }
                @if (_policy is { Environments.Count: 0 } && release.ProjectId == _projectId && release.CompletionId is null && release.Status is "Pending" or "BuildPassed")
                {
                    <button class="btn" @onclick="() => Dispatch.Dispatch(new DeploymentsActions.ApproveDeploymentAction(release.Id, release.ProjectId))">Approve legacy deployment</button>
                }
                @if (DeployStore.Value.PendingInFlightWarning is { } warning && warning.DeploymentId == release.Id) { <p role="alert" class="banner banner--warn">@warning.Message</p> }
            </article>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "project")] public string? QueryProject { get; set; }
    private string? _queryLoaded;
    private string _projectId = "", _commitSha = "";
    private EnvironmentPolicy? _policy;
    private string? _policyError;
    private bool _policyLoading;
    private CancellationTokenSource _policyRequest = new();
    private IEnumerable<DeploymentRow> Rows => DeployStore.Value.Candidates.Where(r => _projectId.Length == 0 || r.ProjectId == _projectId);
    private static string Short(string sha) => sha[..Math.Min(8, sha.Length)];
    private string ProjectName(string id) => ProjectsStore.Value.Projects.FirstOrDefault(p => p.Id == id)?.Name ?? id;
    private string EnvironmentLabel(DeploymentRow row) => (row.ProjectId == _projectId ? _policy?.Environments.FirstOrDefault(e => e.Name == row.EnvironmentName)?.DisplayName : null) ?? row.EnvironmentName ?? "Environment unspecified";
    private string SourceLabel(string id) => DeployStore.Value.Candidates.FirstOrDefault(r => r.Id == id) is { } row ? $"{EnvironmentLabel(row)} · {Short(row.CommitSha)}" : "source release (outside loaded history)";
    private static string StatusLabel(DeploymentRow row) => row.Status switch { "Deployed" => "Deployment passed", "BuildPassed" => "Checks passed · awaiting delivery", "Pending" when row.CompletionId is not null => "Awaiting qualification / gate", "Deploying" => "Deploying · checks pending", _ => row.Status };
    protected override void OnInitialized()
    {
        DeployStore.StateChanged += OnStateChanged; ProjectsStore.StateChanged += OnStateChanged;
        Dispatch.Dispatch(new ProjectsActions.LoadProjectsAction()); Dispatch.Dispatch(new DeploymentsActions.LoadDeploymentsAction());
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_queryLoaded == QueryProject) return;
        _queryLoaded = QueryProject; _projectId = QueryProject ?? "";
        await LoadPolicyAsync();
    }
    private async Task SelectProjectAsync(string project) { _projectId = project; await LoadPolicyAsync(); }
    private async Task LoadPolicyAsync()
    {
        _policyRequest.Cancel(); _policyRequest.Dispose(); _policyRequest = new();
        var ct = _policyRequest.Token; var project = _projectId;
        _policy = null; _policyError = null; _commitSha = ""; _policyLoading = project.Length > 0;
        if (project.Length == 0) return;
        try
        {
            var policy = await EnvironmentPolicyClient.LoadAsync(Http, project, ct);
            if (ct.IsCancellationRequested || project != _projectId) return;
            _policy = policy;
            if (policy.Environments.Count == 0) Dispatch.Dispatch(new DeploymentsActions.LoadCommitsAction(project));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { if (!ct.IsCancellationRequested && project == _projectId) _policyError = ex.Message; }
        finally { if (!ct.IsCancellationRequested && project == _projectId) _policyLoading = false; }
    }
    private async Task RefreshAsync() { Dispatch.Dispatch(new DeploymentsActions.LoadDeploymentsAction()); await LoadPolicyAsync(); }
    private void RequestLegacy()
    {
        if (_policy?.Environments.Count != 0 || _projectId.Length == 0 || _commitSha.Length == 0) return;
        Dispatch.Dispatch(new DeploymentsActions.RequestDeploymentAction(_projectId, _commitSha, "operator")); _commitSha = "";
    }
    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() { _policyRequest.Cancel(); _policyRequest.Dispose(); DeployStore.StateChanged -= OnStateChanged; ProjectsStore.StateChanged -= OnStateChanged; }
}
