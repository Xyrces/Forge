@page "/projects"
@inject IState<Forge.Dashboard.Features.Projects.ProjectsState> ProjectsStore
@inject Fluxor.IDispatcher Dispatch
@inject Forge.Dashboard.Features.Projects.ProjectsClient ProjectsClient
@implements IDisposable
@using Forge.Dashboard.Features.Projects

<PageTitle>Projects</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Projects</h1>
        <div class="page-header__meta">
            @ProjectsStore.Value.Projects.Count registered
            <span style="margin:0 6px;color:var(--outline-variant)">|</span>
            <span style="color:var(--tertiary)">
                @ProjectsStore.Value.Projects.Sum(p => p.InProgress) in flight
            </span>
        </div>
        <div class="page-header__actions">
            <button class="btn" @onclick="@(() => Dispatch.Dispatch(new ProjectsActions.LoadProjectsAction()))">Refresh</button>
            <button class="btn btn--primary" @onclick="ToggleForm">@(_formOpen ? "Cancel" : "Add Project")</button>
        </div>
    </div>

    @if (ProjectsStore.Value.Loading && ProjectsStore.Value.LastFetchedAt is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (ProjectsStore.Value.Error is not null && ProjectsStore.Value.LastFetchedAt is null)
    {
        <div class="page-subtitle">Error: @ProjectsStore.Value.Error</div>
        @if (ProjectsStore.Value.Error?.Contains("SSL", StringComparison.OrdinalIgnoreCase) == true
            || ProjectsStore.Value.Error?.Contains("certificate", StringComparison.OrdinalIgnoreCase) == true
            || ProjectsStore.Value.Error?.Contains("HTTPS", StringComparison.OrdinalIgnoreCase) == true)
        {
            <div class="banner banner--warn" style="margin-top:12px">
                <span>
                    Looks like a TLS / certificate error. The dashboard ships with a self-signed
                    cert — install it as a trusted root on this machine with the matching command:
                </span>
                <CertTrustHelp />
            </div>
        }
    }
    else
    {
        @if (_formOpen)
        {
            <div class="card add-project-card">
                <h2>Add Project</h2>
                <p class="add-project-hint">
                    Enter a git token, fetch the repos it can see, pick one — Forge detects the
                    default branch (override it if you like) and clones on submit. The token is
                    stored encrypted as the project's <code>github_token</code> secret; leave it
                    blank to use an existing token.
                </p>

                @if (ProjectsStore.Value.AddError is not null)
                {
                    <div class="banner banner--warn">
                        <span>@ProjectsStore.Value.AddError</span>
                        <button class="btn btn--link" @onclick="@(() => Dispatch.Dispatch(new ProjectsActions.AddProjectDismissErrorAction()))">Dismiss</button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ProjectsStore.Value.LastAdded))
                {
                    <div class="banner banner--ok">
                        Registered <code>@ProjectsStore.Value.LastAdded</code>. Refreshing project list…
                    </div>
                }

                <form class="form-grid" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                    <label class="form-grid__full">
                        <span>Git token <small>(stored encrypted; never shown again)</small></span>
                        <input type="password" placeholder="github_pat_… (blank = use existing token)" @bind="_gitToken" autocomplete="off" maxlength="256" />
                    </label>
                    <div class="form-grid__full add-project-pathelp">
                        <a href="@FineGrainedPatUrl" target="_blank" rel="noopener noreferrer">Create a fine-grained token on GitHub (recommended — permissions pre-filled)</a>
                        &nbsp;·&nbsp;
                        <a href="@ClassicPatUrl" target="_blank" rel="noopener noreferrer">classic token</a>
                        <small>
                            Required access: <strong>Contents</strong> read+write (clone/push),
                            <strong>Pull requests</strong> read+write (open/manage PRs),
                            <strong>Issues</strong> read+write (review comments),
                            <strong>Checks</strong> read (CI status). Metadata read is granted automatically.
                            Classic tokens: the <code>repo</code> scope covers all of it.
                            Grant the token access to the repository you pick below.
                        </small>
                    </div>
                    <div class="form-grid__full">
                        <button type="button" class="btn" @onclick="FetchReposAsync" disabled="@_fetchingRepos">
                            @(_fetchingRepos ? "Fetching repositories…" : "Fetch repositories")
                        </button>
                        @if (_repoFetchError is not null)
                        {
                            <span class="banner banner--warn">@_repoFetchError</span>
                        }
                    </div>
                    @if (_repos is not null && _repos.Count > 0)
                    {
                        <label class="form-grid__full">
                            <span>Repository <small>(@_repos.Count visible to this token)</small></span>
                            <select @onchange="OnRepoSelected">
                                <option value="">— pick a repository —</option>
                                @foreach (var r in _repos)
                                {
                                    <option value="@r.Url">@r.FullName@(r.Private ? " (private)" : "")</option>
                                }
                            </select>
                        </label>
                    }
                    <label>
                        <span>ID <small>(lowercase, [a-z0-9_-]{1..32}, becomes the dispatch key)</small></span>
                        <input type="text" placeholder="forge" @bind="_model.Id" required pattern="[a-z0-9][a-z0-9_-]*" maxlength="32" autocomplete="off" />
                    </label>
                    <label>
                        <span>Name <small>(display label)</small></span>
                        <input type="text" placeholder="Forge" @bind="_model.Name" required maxlength="64" autocomplete="off" />
                    </label>
                    <label class="form-grid__full">
                        <span>Repository URL <small>(auto-filled by the picker, or enter manually)</small></span>
                        <input type="url" placeholder="https://github.com/Xyrces/Forge.git" @bind="_model.RepoUrl" required autocomplete="off" />
                    </label>
                    <label>
                        <span>Default branch <small>(detected; override if needed)</small></span>
                        <input type="text" placeholder="main" list="add-project-branches" @bind="_model.DefaultBranch" autocomplete="off" maxlength="64" />
                        <datalist id="add-project-branches">
                            @foreach (var b in _branches)
                            {
                                <option value="@b"></option>
                            }
                        </datalist>
                    </label>
                    <div class="form-grid__full add-project-secrets">
                        <span>Project secrets <small>(optional — stored encrypted, like the Secrets page; editable there later)</small></span>
                        @foreach (var row in _secrets)
                        {
                            <div class="add-project-secret-row" @key="row">
                                <input type="text" placeholder="kind (e.g. kimi_api_key)" list="add-project-secret-kinds"
                                       @bind="row.Kind" maxlength="64" autocomplete="off"
                                       pattern="[a-z0-9][a-z0-9_-]*" />
                                <input type="password" placeholder="value" @bind="row.Value" maxlength="8192" autocomplete="off" />
                                <button type="button" class="btn btn--link" @onclick="@(() => _secrets.Remove(row))">remove</button>
                            </div>
                        }
                        <datalist id="add-project-secret-kinds">
                            <option value="minimax_api_key"></option>
                            <option value="kimi_api_key"></option>
                            <option value="kilo_gateway_api_key"></option>
                            <option value="meshy_api_key"></option>
                        </datalist>
                        <button type="button" class="btn" @onclick="@(() => _secrets.Add(new SecretRow()))">Add secret</button>
                    </div>
                    <div class="form-grid__actions">
                        <button type="submit" class="btn btn--primary" disabled="@ProjectsStore.Value.Submitting">
                            @(ProjectsStore.Value.Submitting ? "Registering…" : "Register")
                        </button>
                        <button type="button" class="btn" @onclick="ToggleForm" disabled="@ProjectsStore.Value.Submitting">Cancel</button>
                    </div>
                </form>
            </div>
        }

        @if (ProjectsStore.Value.Projects.Count == 0)
        {
            <div class="page-subtitle">
                No projects registered. Click <strong>Add Project</strong> to register one — Forge clones the repo
                into a managed directory under <code>&lt;dataRoot&gt;/projects/&lt;id&gt;</code> and exposes it on the next dispatch cycle.
            </div>
        }
        else
        {
            <div class="project-grid">
                @foreach (var p in ProjectsStore.Value.Projects)
                {
                    <a class="project-card" href="@($"/projects/{p.Id}/overview")">
                        <div class="project-card__head">
                            <span class="project-card__id">@p.Id</span>
                            <span class="project-card__name">@p.Name</span>
                        </div>
                        <div class="project-card__root" title="@p.RepoUrl">@p.RepoUrl</div>
                        @if (!string.IsNullOrEmpty(p.Root))
                        {
                            <div class="project-card__local" title="@p.Root">workdir: @p.Root</div>
                        }
                        <div class="project-card__counters">
                            <span class="pill pill--pending">@p.Pending pending</span>
                            <span class="pill pill--inprogress">@p.InProgress in flight</span>
                            <span class="pill pill--completed">@p.Completed done</span>
                            @if (p.Failed > 0)
                            {
                                <span class="pill pill--failed">@p.Failed failed</span>
                            }
                        </div>
                        <div class="project-card__slots">
                            @foreach (var s in p.Slots)
                            {
                                <span class="slot-chip @(s.InFlight >= s.Max ? "slot-chip--full" : "")">
                                    @s.Role @s.InFlight/@s.Max
                                </span>
                            }
                        </div>
                    </a>
                }
            </div>

            <div class="page-subtitle page-subtitle--meta">
                Dispatch currently routes to the first registered project on restart.
                Add more here and restart <code>forge</code> to pick them up as dispatch targets.
            </div>
        }
    }
</div>

@code {
    private bool _formOpen;
    private AddProjectForm _model = new();
    private string _gitToken = string.Empty;
    private bool _fetchingRepos;
    private string? _repoFetchError;
    private IReadOnlyList<RepoLookupRow>? _repos;
    private IReadOnlyList<string> _branches = Array.Empty<string>();
    private readonly List<SecretRow> _secrets = new();

    private string PatDescription =>
        $"Forge orchestrator access for {_model.RepoUrl} — clone/push, PRs, CI checks";

    private string FineGrainedPatUrl =>
        "https://github.com/settings/personal-access-tokens/new"
        + "?name=" + Uri.EscapeDataString(
            string.IsNullOrWhiteSpace(_model.Id) ? "forge-project" : $"forge-{_model.Id.Trim()}")
        + "&description=" + Uri.EscapeDataString(PatDescription)
        + "&contents=write&pull_requests=write&issues=write&checks=read";

    private string ClassicPatUrl =>
        "https://github.com/settings/tokens/new?scopes=repo&description="
        + Uri.EscapeDataString(PatDescription);

    protected override void OnInitialized()
    {
        ProjectsStore.StateChanged += OnStateChanged;
        if (ProjectsStore.Value.LastFetchedAt is null)
        {
            Dispatch.Dispatch(new ProjectsActions.LoadProjectsAction());
        }
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void ToggleForm()
    {
        _formOpen = !_formOpen;
        if (!_formOpen)
        {
            _model = new();
            _gitToken = string.Empty;
            _repos = null;
            _repoFetchError = null;
            _branches = Array.Empty<string>();
            _secrets.Clear();
            Dispatch.Dispatch(new ProjectsActions.AddProjectDismissErrorAction());
        }
    }

    private async Task FetchReposAsync()
    {
        _fetchingRepos = true;
        _repoFetchError = null;
        try
        {
            var resp = await ProjectsClient.LookupReposAsync(
                string.IsNullOrWhiteSpace(_gitToken) ? null : _gitToken.Trim(),
                id: null, CancellationToken.None);
            _repos = resp.Repos;
            if (_repos.Count == 0) _repoFetchError = "The token can see no repositories.";
        }
        catch (Exception ex)
        {
            _repos = null;
            _repoFetchError = ex.Message;
        }
        finally
        {
            _fetchingRepos = false;
        }
    }

    private async Task OnRepoSelected(ChangeEventArgs e)
    {
        var url = e.Value?.ToString();
        var repo = _repos?.FirstOrDefault(r => r.Url == url);
        if (repo is null) return;
        _model.RepoUrl = repo.Url;
        if (string.IsNullOrWhiteSpace(_model.Name)) _model.Name = repo.Name;
        if (string.IsNullOrWhiteSpace(_model.Id))
        {
            _model.Id = repo.Name.ToLowerInvariant();
        }
        await FetchBranchesAsync(repo.Url, repo.DefaultBranch);
    }

    private async Task FetchBranchesAsync(string repoUrl, string? detected)
    {
        try
        {
            var resp = await ProjectsClient.LookupBranchesAsync(
                string.IsNullOrWhiteSpace(_gitToken) ? null : _gitToken.Trim(),
                id: null, repoUrl, CancellationToken.None);
            _branches = resp.Branches;
            _model.DefaultBranch = resp.DefaultBranch ?? detected ?? _model.DefaultBranch;
        }
        catch
        {
            _branches = Array.Empty<string>();
            if (!string.IsNullOrEmpty(detected)) _model.DefaultBranch = detected;
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Id) ||
            string.IsNullOrWhiteSpace(_model.Name) ||
            string.IsNullOrWhiteSpace(_model.RepoUrl))
        {
            return;
        }
        var secrets = _secrets
            .Where(r => !string.IsNullOrWhiteSpace(r.Kind) && !string.IsNullOrEmpty(r.Value))
            .GroupBy(r => r.Kind.Trim(), StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.Last().Value, StringComparer.Ordinal);
        Dispatch.Dispatch(new ProjectsActions.AddProjectAction(
            _model.Id.Trim(),
            _model.Name.Trim(),
            _model.RepoUrl.Trim(),
            string.IsNullOrWhiteSpace(_model.DefaultBranch) ? null : _model.DefaultBranch.Trim(),
            string.IsNullOrWhiteSpace(_gitToken) ? null : _gitToken.Trim(),
            secrets.Count > 0 ? secrets : null));
        _gitToken = string.Empty;
        _secrets.Clear();
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        ProjectsStore.StateChanged -= OnStateChanged;
    }

    private sealed class AddProjectForm
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string RepoUrl { get; set; } = string.Empty;
        public string DefaultBranch { get; set; } = string.Empty;
    }

    private sealed class SecretRow
    {
        public string Kind { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }
}
