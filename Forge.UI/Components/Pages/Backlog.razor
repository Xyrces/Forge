@page "/backlog"
@inject IState<Forge.Dashboard.Features.View.ViewState> ViewStore
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject Fluxor.IDispatcher Dispatch
@inject HttpClient Http
@implements IDisposable
@using Forge.Dashboard.Features.View
@using System.Net.Http.Json

<PageTitle>Backlog</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Backlog</h1>
        <div class="page-header__meta">
            @BacklogRows.Count issues
            <span style="margin:0 6px; color:var(--outline-variant)">|</span>
            <span style="color:var(--tertiary)">@BacklogRows.Count(x => x.Status == "Completed") done</span>
            <span style="margin:0 6px; color:var(--outline-variant)">|</span>
            <span style="color:var(--error)">@BacklogRows.Count(x => x.Status == "Failed") failed</span>
        </div>
        <div class="page-header__actions">
            <button class="btn" @onclick="() => _showNewTask = !_showNewTask">@(_showNewTask ? "Cancel" : "New task")</button>
            <button class="btn btn--primary" @onclick="@(() => Dispatch.Dispatch(new ViewActions.LoadViewAction(ShellStore.Value.CurrentProjectId)))">Refresh</button>
        </div>
    </div>

    @if (_showNewTask)
    {
        @* Dev-task creation — the path for features too small for
           the epic pipeline (intake refuses those by design). *@
        <div class="card" style="margin-bottom:14px">
            <h2>New dev task</h2>
            <form class="form-grid" @onsubmit="CreateTaskAsync" @onsubmit:preventDefault="true">
                <label>
                    <span>Title</span>
                    <input type="text" @bind="_newTitle" placeholder="Add GET /api/health/uptime endpoint" maxlength="200" />
                </label>
                <label>
                    <span>Description</span>
                    <textarea rows="4" @bind="_newDescription" placeholder="File: Dashboard/AppShellEndpoints.cs. Returns { uptimeMs, at }. Verify with dotnet build + dotnet test."></textarea>
                </label>
                <div class="form-grid__actions">
                    <button type="submit" class="btn btn--primary" disabled="@(_creating || string.IsNullOrWhiteSpace(_newTitle))">
                        @(_creating ? "Creating…" : "Create task")
                    </button>
                </div>
            </form>
            @if (_createError is not null)
            {
                <div class="banner banner--error"><span>@_createError</span></div>
            }
            <p class="hint" style="margin-top:8px">
                Created as type <code>task</code> for <strong>@ShellStore.Value.CurrentProjectId</strong> — the dispatch loop claims it next cycle.
            </p>
        </div>
    }

    <div class="filter-bar">
        @foreach (var f in Filters)
        {
            <button class="chip @(_filter == f ? "chip--active" : "")"
                    @onclick="@(() => _filter = f)">@f</button>
        }
    </div>

    @if (ViewStore.Value.Loading)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (ViewStore.Value.Error is not null)
    {
        <div class="page-subtitle">Error: @ViewStore.Value.Error</div>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Parent</th>
                    <th>Priority</th>
                    <th>Assignee</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in BacklogRows.Take(50))
                {
                    <tr>
                        <td class="mono">@row.Id</td>
                        <td>
                            @row.Title
                            @if (row.PrNumber is not null && PrUrl(row.PrNumber) is { } url)
                            {
                                <a href="@url" target="_blank" rel="noopener" title="Open PR #@row.PrNumber">PR #@row.PrNumber</a>
                            }
                            @if (row.ReworkAttempts is not null)
                            {
                                <span class="pill pill--blocked" title="In the review/rework loop — queued for or working through a rework round. The PR stays open; the watch keeps it.">R@row.ReworkAttempts</span>
                            }
                        </td>
                        <td class="mono">@row.Type</td>
                        <td><span class="pill pill--@row.Status.ToLowerInvariant()">@row.Status</span></td>
                        <td class="mono">@(row.ParentIssueId ?? "—")</td>
                        <td>@row.Priority</td>
                        <td>@(row.Assignee ?? "—")</td>
                        <td class="mono">@row.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (BacklogRows.Count > 50)
        {
            <div class="page-subtitle">(Showing first 50 of @BacklogRows.Count; pagination deferred.)</div>
        }
    }
</div>

@code {
    // Default "Open": the queue's historical mass-closed dups (183
    // from the 2026-07-22 dedupe) stay one chip away but out of the
    // default view.
    private static readonly string[] Filters = { "Open", "Pending", "InProgress", "Blocked", "Completed", "Failed", "Closed", "All" };
    private string _filter = "Open";

    private IReadOnlyList<Forge.Dashboard.Features.View.ViewTask> BacklogRows
    {
        get
        {
            var all = ViewStore.Value.Tasks;
            return _filter switch
            {
                "Open" => all.Where(t => t.Status is "Pending" or "InProgress" or "Blocked").ToArray(),
                "Pending" => all.Where(t => t.Status == "Pending").ToArray(),
                "InProgress" => all.Where(t => t.Status == "InProgress").ToArray(),
                "Blocked" => all.Where(t => t.Status == "Blocked").ToArray(),
                "Completed" => all.Where(t => t.Status == "Completed").ToArray(),
                "Failed" => all.Where(t => t.Status == "Failed").ToArray(),
                "Closed" => all.Where(t => t.Status == "Closed").ToArray(),
                _ => all,
            };
        }
    }

    private string? _repoUrl;

    private string? PrUrl(string prNumber) =>
        _repoUrl is null ? null : $"{_repoUrl}/pull/{prNumber}";

    private async Task LoadRepoUrlAsync()
    {
        // PR links derive from the registered project's repo — never
        // hardcoded.
        var projectId = ShellStore.Value.CurrentProjectId;
        if (string.IsNullOrEmpty(projectId)) return;
        try
        {
            var projects = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("/api/projects");
            foreach (var p in projects.EnumerateArray())
            {
                if (p.TryGetProperty("id", out var id) && string.Equals(id.GetString(), projectId, StringComparison.OrdinalIgnoreCase)
                    && p.TryGetProperty("repoUrl", out var url))
                {
                    _repoUrl = url.GetString()?.TrimEnd('/');
                    break;
                }
            }
        }
        catch { /* PR links are best-effort */ }
    }

    private string? _loadedProject;
    private bool _showNewTask;
    private bool _creating;
    private string _newTitle = "";
    private string _newDescription = "";
    private string? _createError;

    private async Task CreateTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;
        var projectId = ShellStore.Value.CurrentProjectId;
        if (string.IsNullOrEmpty(projectId))
        {
            _createError = "No project selected in the topbar switcher.";
            return;
        }
        _creating = true;
        _createError = null;
        try
        {
            var resp = await Http.PostAsJsonAsync(
                $"/api/state/issues?projectId={Uri.EscapeDataString(projectId)}",
                new { type = "task", title = _newTitle.Trim(), description = _newDescription });
            if (!resp.IsSuccessStatusCode)
            {
                _createError = $"Create failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            _newTitle = "";
            _newDescription = "";
            _showNewTask = false;
            Dispatch.Dispatch(new ViewActions.LoadViewAction(projectId));
        }
        catch (Exception ex) { _createError = ex.Message; }
        finally { _creating = false; }
    }

    protected override void OnInitialized()
    {
        ViewStore.StateChanged += OnStateChanged;
        ShellStore.StateChanged += OnShellChanged;
        if (ViewStore.Value.LastFetchedAt is null)
        {
            LoadForCurrentProject();
        }
        _ = LoadRepoUrlAsync();
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnShellChanged(object? sender, EventArgs e)
    {
        if (ShellStore.Value.CurrentProjectId != _loadedProject)
        {
            _repoUrl = null;
            InvokeAsync(LoadForCurrentProject);
            _ = LoadRepoUrlAsync();
        }
    }

    private void LoadForCurrentProject()
    {
        _loadedProject = ShellStore.Value.CurrentProjectId;
        Dispatch.Dispatch(new ViewActions.LoadViewAction(_loadedProject));
    }

    public void Dispose()
    {
        ViewStore.StateChanged -= OnStateChanged;
        ShellStore.StateChanged -= OnShellChanged;
    }
}
