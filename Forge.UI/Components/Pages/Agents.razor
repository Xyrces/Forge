@page "/agents"
@inject HttpClient Http
@implements IDisposable
@using System.Net.Http.Json

<PageTitle>Agents</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Agents</h1>
        <div class="page-header__meta">@(_data?.Roles.Count ?? 0) roles · live status refreshes every 5s</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="banner banner--error"><span>@_error</span></div>
    }
    else if (_data is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        @foreach (var role in _data.Roles)
        {
            <div class="card overview-section">
                <div class="role-head">
                    <span class="role-head__name">@role.Name</span>
                    <span class="pill">@role.AgentType</span>
                    @if (role.CurrentRun is not null)
                    {
                        <a href="/runs/@role.CurrentRun.Id" class="pill pill--inprogress" style="text-decoration:none;">
                            RUNNING · @(role.CurrentRun.TaskId ?? "—") · @Elapsed(role.CurrentRun.StartedAt)
                        </a>
                        <span class="meta-text">@ProgressText(role.CurrentRun)</span>
                        @if (role.CurrentRun.TaskId is not null)
                        {
                            <a href="/tasks/@role.CurrentRun.TaskId" class="meta-text">view task</a>
                        }
                    }
                    else
                    {
                        <span class="pill">idle</span>
                    }
                    <span style="width:180px; margin-left:auto;">
                        <RoleSlotMeter Role="@role.Name" InFlight="@role.Slot.InFlight" Max="@role.Slot.Max" />
                    </span>
                </div>

                <table class="data-grid">
                    <tbody>
                        <tr>
                            <td style="width:130px;" class="meta-text">Model</td>
                            <td>
                                @if (_editingRole == role.Name)
                                {
                                    <div class="role-model-edit">
                                        <select class="mono" @bind="_editProvider">
                                            @foreach (var p in _data.Providers)
                                            {
                                                <option value="@p">@p</option>
                                            }
                                        </select>
                                        <input type="text" class="mono" @bind="_editModel" placeholder="model (e.g. kimi-k3)" />
                                        <button class="btn btn--primary" @onclick="() => SaveModelAsync(role.Name)">Save</button>
                                        <button class="btn" @onclick="() => _editingRole = null">Cancel</button>
                                        @if (_editError is not null)
                                        {
                                            <span class="error-text">@_editError</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="mono">@role.Model.Provider / @role.Model.Model</span>
                                    <span class="pill @(role.Model.Source == "override" ? "pill--primary" : "")" style="margin-left:8px; font-size:11px;">@role.Model.Source</span>
                                    @if (_data.OverridesEditable)
                                    {
                                        <button class="btn" style="margin-left:8px; padding:2px 10px; font-size:12px;" @onclick="() => BeginEdit(role)">Edit</button>
                                        @if (role.Model.Source == "override")
                                        {
                                            <button class="btn" style="margin-left:4px; padding:2px 10px; font-size:12px;" @onclick="() => ClearModelAsync(role.Name)">Clear override</button>
                                        }
                                    }
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-text">Territory</td>
                            <td class="mono meta-text">@(string.IsNullOrWhiteSpace(role.Territory) ? "(whole repo)" : role.Territory)</td>
                        </tr>
                        <tr>
                            <td class="meta-text">Tools</td>
                            <td>
                                @foreach (var t in role.Tools)
                                {
                                    <span class="pill" style="margin-right:4px; font-size:11px;">@t</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-text">Concurrency</td>
                            <td class="meta-text">
                                @role.Slot.InFlight in flight · cap @role.Slot.Max
                                <a href="/projects/forge/overview" style="margin-left:8px;">edit caps</a>
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-text">Last run</td>
                            <td class="meta-text">
                                @if (role.LastRun is null)
                                {
                                    <span>none yet</span>
                                }
                                else
                                {
                                    <a href="/runs/@role.LastRun.Id">
                                        <span class="pill @(role.LastRun.Status == "succeeded" ? "pill--completed" : "pill--failed")">@role.LastRun.Status</span>
                                    </a>
                                    <span class="mono" style="margin-left:6px;">@(role.LastRun.TaskId ?? "—")</span>
                                    <span style="margin-left:6px;">@FormatWhen(role.LastRun.FinishedAt) · @FormatDuration(role.LastRun.DurationMs)</span>
                                    @if (!string.IsNullOrEmpty(role.LastRun.Error))
                                    {
                                        <div class="error-text mono">@Truncate(role.LastRun.Error, 160)</div>
                                    }
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="meta-text" style="vertical-align:top;">Role prompt</td>
                            <td>
                                <details>
                                    <summary style="cursor:pointer;" class="meta-text">
                                        <span class="pill" style="font-size:11px;">@role.Prompt.Source</span>
                                        <span class="mono" style="margin-left:6px;">@role.Prompt.Path</span>
                                    </summary>
                                    @if (role.Prompt.Content is null)
                                    {
                                        <div class="page-subtitle">prompt file not found</div>
                                    }
                                    else
                                    {
                                        <pre class="prompt-block">@role.Prompt.Content</pre>
                                    }
                                </details>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private RolesResponse? _data;
    private string? _error;
    private string? _editingRole;
    private string _editProvider = "";
    private string _editModel = "";
    private string? _editError;
    private readonly CancellationTokenSource _pollCts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = PollLoopAsync();
    }

    private async Task PollLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_pollCts.Token))
                await LoadAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<RolesResponse>("/api/agents/roles?projectId=forge");
            _error = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void BeginEdit(RoleDto role)
    {
        _editingRole = role.Name;
        _editProvider = role.Model.Provider ?? (_data?.Providers.FirstOrDefault() ?? "");
        _editModel = role.Model.Model ?? "";
        _editError = null;
    }

    private async Task SaveModelAsync(string roleName)
    {
        _editError = null;
        var resp = await Http.PutAsJsonAsync($"/api/agents/roles/{roleName}/model",
            new { provider = _editProvider, model = _editModel });
        if (!resp.IsSuccessStatusCode)
        {
            _editError = await resp.Content.ReadAsStringAsync();
            return;
        }
        _editingRole = null;
        await LoadAsync();
    }

    private async Task ClearModelAsync(string roleName)
    {
        await Http.DeleteAsync($"/api/agents/roles/{roleName}/model");
        await LoadAsync();
    }

    private static string Elapsed(DateTime since)
    {
        var e = DateTime.UtcNow - since;
        return e.TotalMinutes >= 1 ? $"{(int)e.TotalMinutes}m{e.Seconds:D2}s" : $"{(int)e.TotalSeconds}s";
    }

    private static string ProgressText(CurrentRunDto run)
    {
        var msgs = run.MessageCount ?? 0;
        var tools = run.ToolCallCount ?? 0;
        if (msgs == 0 && tools == 0)
        {
            var waiting = run.LastActivityAt is null ? Elapsed(run.StartedAt) : Elapsed(run.LastActivityAt.Value);
            return $"no model output yet — waiting {waiting} (provider may be hanging)";
        }
        var ago = run.LastActivityAt is null ? "" : $" · active {Elapsed(run.LastActivityAt.Value)} ago";
        return $"{msgs} messages · {tools} tool calls{ago}";
    }

    private static string FormatWhen(DateTime? when)
        => when is null ? "—" : when.Value.ToString("MM-dd HH:mm:ss");

    private static string FormatDuration(long? ms)
        => ms is null ? "" : TimeSpan.FromMilliseconds(ms.Value).TotalMinutes >= 1
            ? $"{TimeSpan.FromMilliseconds(ms.Value).TotalMinutes:F1}m"
            : $"{TimeSpan.FromMilliseconds(ms.Value).TotalSeconds:F0}s";

    private static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "…";

    public void Dispose()
    {
        _pollCts.Cancel();
        _pollCts.Dispose();
    }

    private sealed record RolesResponse(List<RoleDto> Roles, string[] Providers, bool OverridesEditable);
    private sealed record RoleDto(
        string Name, string AgentType, string Territory, string[] Tools,
        ModelDto Model, SlotDto Slot, PromptDto Prompt,
        CurrentRunDto? CurrentRun, LastRunDto? LastRun);
    private sealed record ModelDto(string? Provider, string? Model, string Source);
    private sealed record SlotDto(int InFlight, int Max);
    private sealed record PromptDto(string Source, string? Path, string? Content);
    private sealed record CurrentRunDto(string Id, string? TaskId, DateTime StartedAt,
        DateTime? LastActivityAt, int? MessageCount, int? ToolCallCount);
    private sealed record LastRunDto(string Id, string? TaskId, string Status,
        DateTime? FinishedAt, long? DurationMs, string? Error);
}
