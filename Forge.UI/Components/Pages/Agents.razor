@page "/agents"
@inject HttpClient Http
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@implements IDisposable
@using System.Net.Http.Json

<PageTitle>Agents</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Agents</h1>
        <div class="page-header__meta">@((_data?.Roles.Count ?? 0) + (_data?.Pipeline.Count ?? 0)) roles · live status refreshes every 5s</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="banner banner--error"><span>@_error</span></div>
    }
    else if (_data is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        <section class="overview-section">
            <h2>Engineering roles <span class="meta-text">· @_data.Roles.Count total</span></h2>
            <p class="page-subtitle page-subtitle--meta">Dispatched per task by the sprint loop. Click a row for tools, prompt, run history, and the model editor.</p>
            <div style="display:flex; flex-direction:column; gap:12px; margin-top:12px;">
                @foreach (var role in _data.Roles)
                {
                    <AgentRoleRow Name="@role.Name"
                                  Kind="@role.AgentType"
                                  Model="@(new AgentRoleRow.ModelInfo(role.Model.Provider, role.Model.Model, role.Model.Source))"
                                  Slot="@(new AgentRoleRow.SlotInfo(role.Slot.InFlight, role.Slot.Max))"
                                  CurrentRun="@(role.CurrentRun is null ? null : new AgentRoleRow.RunInfo(role.CurrentRun.Id, role.CurrentRun.TaskId, role.CurrentRun.StartedAt, role.CurrentRun.LastActivityAt, role.CurrentRun.MessageCount, role.CurrentRun.ToolCallCount))"
                                  LastRun="@(role.LastRun is null ? null : new AgentRoleRow.LastRunInfo(role.LastRun.Id, role.LastRun.TaskId, role.LastRun.Status, role.LastRun.FinishedAt, role.LastRun.DurationMs, role.LastRun.Error))"
                                  Territory="@role.Territory"
                                  Tools="@role.Tools"
                                  Prompt="@(new AgentRoleRow.PromptInfo(role.Prompt.Source, role.Prompt.Path, role.Prompt.Content))"
                                  ModelEditable="true"
                                  OverridesEditable="@_data.OverridesEditable"
                                  Providers="@_data.Providers"
                                  Editing="@(_editingRole == role.Name)"
                                  EditError="@(_editingRole == role.Name ? _editError : null)"
                                  OnBeginEdit="@(name => _editingRole = name)"
                                  OnCancelEdit="@(_ => _editingRole = null)"
                                  OnSaveModel="SaveModelAsync"
                                  OnClearModel="ClearModelAsync" />
                }
            </div>
        </section>

        <section class="overview-section">
            <h2>Pipeline roles <span class="meta-text">· @_data.Pipeline.Count total</span></h2>
            <p class="page-subtitle page-subtitle--meta">Scheduler-side agents plus the dispatch loop. Instructions live in code; designer/groomer/artist borrow coredev's model.</p>
            <div style="display:flex; flex-direction:column; gap:12px; margin-top:12px;">
                @foreach (var role in _data.Pipeline)
                {
                    <AgentRoleRow Name="@role.Name"
                                  Kind="pipeline"
                                  Model="@(new AgentRoleRow.ModelInfo(role.Model.Provider, role.Model.Model, role.Model.Source))"
                                  Slot="@(new AgentRoleRow.SlotInfo(role.Slot.InFlight, role.Slot.Max))"
                                  Surface="@role.Surface"
                                  ModelEditable="@role.ModelEditable"
                                  OverridesEditable="@_data.OverridesEditable"
                                  Providers="@_data.Providers"
                                  Editing="@(_editingRole == role.Name)"
                                  EditError="@(_editingRole == role.Name ? _editError : null)"
                                  OnBeginEdit="@(name => _editingRole = name)"
                                  OnCancelEdit="@(_ => _editingRole = null)"
                                  OnSaveModel="SaveModelAsync"
                                  OnClearModel="ClearModelAsync" />
                }
            </div>
        </section>
    }
</div>

@code {
    private RolesResponse? _data;
    private string? _error;
    private string? _editingRole;
    private string? _editError;
    private readonly CancellationTokenSource _pollCts = new();

    protected override async Task OnInitializedAsync()
    {
        ShellStore.StateChanged += OnShellChanged;
        await LoadAsync();
        _ = PollLoopAsync();
    }

    private string? _loadedProject;

    private void OnShellChanged(object? sender, EventArgs e)
    {
        if (ShellStore.Value.CurrentProjectId != _loadedProject)
            _ = InvokeAsync(LoadAsync);
    }

    private async Task PollLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_pollCts.Token))
                await LoadAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId ?? "forge";
            _loadedProject = projectId;
            _data = await Http.GetFromJsonAsync<RolesResponse>($"/api/agents/roles?projectId={Uri.EscapeDataString(projectId)}");
            _error = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveModelAsync((string Role, string Provider, string Model) edit)
    {
        _editError = null;
        var resp = await Http.PutAsJsonAsync($"/api/agents/roles/{edit.Role}/model",
            new { provider = edit.Provider, model = edit.Model });
        if (!resp.IsSuccessStatusCode)
        {
            _editError = await resp.Content.ReadAsStringAsync();
            return;
        }
        _editingRole = null;
        await LoadAsync();
    }

    private async Task ClearModelAsync(string roleName)
    {
        await Http.DeleteAsync($"/api/agents/roles/{roleName}/model");
        await LoadAsync();
    }

    public void Dispose()
    {
        ShellStore.StateChanged -= OnShellChanged;
        _pollCts.Cancel();
        _pollCts.Dispose();
    }

    private sealed record RolesResponse(List<RoleDto> Roles, List<PipelineRoleDto> Pipeline, string[] Providers, bool OverridesEditable);
    private sealed record RoleDto(
        string Name, string AgentType, string Territory, string[] Tools,
        ModelDto Model, SlotDto Slot, PromptDto Prompt,
        CurrentRunDto? CurrentRun, LastRunDto? LastRun);
    private sealed record PipelineRoleDto(
        string Name, string Description, string Surface,
        ModelDto Model, bool ModelEditable, SlotDto Slot);
    private sealed record ModelDto(string? Provider, string? Model, string Source);
    private sealed record SlotDto(int InFlight, int Max);
    private sealed record PromptDto(string Source, string? Path, string? Content);
    private sealed record CurrentRunDto(string Id, string? TaskId, DateTime StartedAt,
        DateTime? LastActivityAt, int? MessageCount, int? ToolCallCount);
    private sealed record LastRunDto(string Id, string? TaskId, string Status,
        DateTime? FinishedAt, long? DurationMs, string? Error);
}
