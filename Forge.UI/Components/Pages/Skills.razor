@page "/skills"
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>Skills</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Skills</h1>
        <div class="page-header__meta">@(_skills?.Count ?? 0) skills · @(_skills?.Count(s => s.Enabled) ?? 0) enabled</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="LoadAsync">Refresh</button>
            <button class="btn btn--primary" @onclick="BeginAdd">Add skill</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="banner banner--error"><span>@_error</span></div>
    }

    @if (_editing is not null)
    {
        <div class="card" style="margin-bottom:16px">
            <h2>@(_editing.Id is null ? "New skill" : $"Edit {_editing.Name}")</h2>
            <table class="data-grid">
                <tbody>
                    <tr>
                        <td style="width:130px" class="meta-text">Name</td>
                        <td><input type="text" class="mono" style="width:100%" @bind="_editing.Name" placeholder="forge-my-skill" /></td>
                    </tr>
                    <tr>
                        <td class="meta-text">Applies to</td>
                        <td>
                            <div class="chip-row">
                                @foreach (var r in _assignableRoles)
                                {
                                    <button type="button" class="chip @(_editing.Roles.Contains(r) ? "chip--active" : "")"
                                            @onclick="() => ToggleRole(r)">@r</button>
                                }
                                @if (_editing.Roles.Count == 0)
                                {
                                    <span class="chip-row__hint">none selected — global, every role loads this skill</span>
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="meta-text">Description</td>
                        <td><input type="text" style="width:100%" @bind="_editing.Description" placeholder="What this skill is for (one line)" /></td>
                    </tr>
                    <tr>
                        <td class="meta-text" style="vertical-align:top">Body</td>
                        <td>
                            <textarea class="mono" style="width:100%; min-height:220px" @bind="_editing.Body"
                                      placeholder="Markdown instructions injected into the agent's system context."></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td class="meta-text">Enabled</td>
                        <td><input type="checkbox" @bind="_editing.Enabled" /></td>
                    </tr>
                </tbody>
            </table>
            <div style="margin-top:10px; display:flex; gap:8px; align-items:center">
                <button class="btn btn--primary" @onclick="SaveAsync" disabled="@string.IsNullOrWhiteSpace(_editing.Name)">Save</button>
                <button class="btn" @onclick="() => _editing = null">Cancel</button>
                @if (_editError is not null)
                {
                    <span class="error-text">@_editError</span>
                }
            </div>
        </div>
    }

    @if (_skills is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (_skills.Count == 0)
    {
        <div class="page-subtitle">No skills yet. Startup seeds the pipeline-behavior skills and the repo's .kilo/skills; add your own above.</div>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Applies to</th>
                    <th>Description</th>
                    <th>Enabled</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _skills)
                {
                    <tr>
                        <td class="mono">@row.Name</td>
                        <td>
                            <div class="chip-row">
                                @if (row.Roles is null || row.Roles.Length == 0)
                                {
                                    <span class="pill">global</span>
                                }
                                else
                                {
                                    @foreach (var r in row.Roles)
                                    {
                                        <span class="pill pill--primary">@r</span>
                                    }
                                }
                            </div>
                        </td>
                        <td class="meta-text">@(row.Description ?? "—")</td>
                        <td>
                            @if (row.Enabled)
                            {
                                <span class="pill pill--completed">on</span>
                            }
                            else
                            {
                                <span class="pill pill--failed">off</span>
                            }
                        </td>
                        <td class="mono meta-text">@row.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="white-space:nowrap">
                            <button class="btn" style="padding:2px 10px; font-size:12px" @onclick="() => BeginEdit(row)">Edit</button>
                            <button class="btn" style="padding:2px 10px; font-size:12px" @onclick="() => DeleteAsync(row)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private static readonly string[] _assignableRoles = { "coredev", "clientdev", "qa", "reviewer", "intake" };

    private List<SkillDto>? _skills;
    private string? _error;
    private EditModel? _editing;
    private string? _editError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _skills = await Http.GetFromJsonAsync<List<SkillDto>>("/api/skills");
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void BeginAdd()
    {
        _editing = new EditModel { Enabled = true };
        _editError = null;
    }

    private void BeginEdit(SkillDto row)
    {
        _editing = new EditModel
        {
            Id = row.Id,
            Name = row.Name,
            Description = row.Description ?? "",
            Body = row.Body,
            Roles = (row.Roles ?? []).ToList(),
            Enabled = row.Enabled,
        };
        _editError = null;
    }

    private void ToggleRole(string role)
    {
        if (_editing is null) return;
        if (!_editing.Roles.Remove(role)) _editing.Roles.Add(role);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _editError = null;
        var payload = new
        {
            name = _editing.Name.Trim(),
            description = string.IsNullOrWhiteSpace(_editing.Description) ? null : _editing.Description.Trim(),
            body = _editing.Body,
            roles = _editing.Roles.Count == 0 ? null : _editing.Roles.ToArray(),
            enabled = _editing.Enabled,
        };
        HttpResponseMessage resp = _editing.Id is null
            ? await Http.PostAsJsonAsync("/api/skills", payload)
            : await Http.PatchAsJsonAsync($"/api/skills/{_editing.Id}", payload);
        if (!resp.IsSuccessStatusCode)
        {
            _editError = await resp.Content.ReadAsStringAsync();
            return;
        }
        _editing = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(SkillDto row)
    {
        await Http.DeleteAsync($"/api/skills/{row.Id}");
        await LoadAsync();
    }

    private sealed record SkillDto(string Id, string Name, string? Description, string Body,
        string? AgentId, string[]? Roles, bool Enabled, DateTime CreatedAt, DateTime UpdatedAt);

    private sealed class EditModel
    {
        public string? Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Body { get; set; } = "";
        public List<string> Roles { get; set; } = new();
        public bool Enabled { get; set; } = true;
    }
}
