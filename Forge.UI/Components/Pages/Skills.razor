@page "/skills"
@inject IState<Forge.Dashboard.Features.View.ViewState> ViewStore
@inject Fluxor.IDispatcher Dispatch
@implements IDisposable
@using Forge.Dashboard.Features.View

<PageTitle>Skills</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Skills</h1>
        <div class="page-header__meta">@ViewStore.Value.Skills.Count loaded · @ViewStore.Value.Skills.Count(s => s.Enabled) enabled</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="@(() => Dispatch.Dispatch(new ViewActions.LoadViewAction()))">Refresh</button>
        </div>
    </div>

    @if (ViewStore.Value.Loading)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (ViewStore.Value.Error is not null)
    {
        <div class="page-subtitle">Error: @ViewStore.Value.Error</div>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Agent</th>
                    <th>Enabled</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in ViewStore.Value.Skills)
                {
                    <tr>
                        <td class="mono">@row.Name</td>
                        <td>@(row.Description ?? "—")</td>
                        <td class="mono">@(row.AgentId ?? "—")</td>
                        <td>
                            @if (row.Enabled)
                            {
                                <span class="pill pill--completed">on</span>
                            }
                            else
                            {
                                <span class="pill pill--failed">off</span>
                            }
                        </td>
                        <td class="mono">@row.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                @if (ViewStore.Value.Skills.Count == 0)
                {
                    <tr><td colspan="5"><div class="page-subtitle">No skills loaded yet. Run SkillBootstrap to seed defaults.</div></td></tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ViewStore.StateChanged += OnStateChanged;
        if (ViewStore.Value.LastFetchedAt is null)
        {
            Dispatch.Dispatch(new ViewActions.LoadViewAction());
        }
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ViewStore.StateChanged -= OnStateChanged;
    }
}
