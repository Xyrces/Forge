@page "/runs/{RunId}"
@inject HttpClient Http
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@implements IDisposable
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Run @RunId</PageTitle>
<div class="page">
    <a href="/runs" class="meta-text">← All runs</a>
    @if (_notFound)
    {
        <div class="banner banner--error">Run not found: @RunId</div>
    }
    else if (_run is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        var v = _run.View;
        <div class="page-header">
            <h1>@v.Role <span style="font-weight:400;color:var(--on-surface-variant)">run</span></h1>
            <div class="page-header__meta">
                <span class="pill @(v.Status == "succeeded" ? "pill--completed" : v.Status == "running" ? "pill--inprogress" : "pill--failed")">@v.Status</span>
                <span class="pill">@(v.ProjectId ?? "legacy")</span>
                @if (v.ResumedSession == true)
                {
                    <span class="pill pill--info">resumed session</span>
                }
                @if (!string.IsNullOrEmpty(v.Phase))
                {
                    <span class="pill pill--primary">@v.Phase</span>
                }
                @v.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                · @(v.DurationMs is null ? "…" : Fmt(v.DurationMs.Value))
                · @v.MessageCount msgs · @v.ToolCallCount tool calls
                @if (v.Status == "running" && v.LastActivityAt is not null)
                {
                    <span class="pill pill--inprogress" style="margin-left:6px">LIVE · active @Ago(v.LastActivityAt.Value) ago</span>
                }
                else if (v.Status == "running")
                {
                    <span class="pill pill--warn" style="margin-left:6px">no activity yet</span>
                }
            </div>
            <div class="page-header__actions">
                @if (v.TaskId is not null)
                {
                    <a class="btn" href="@($"/tasks/{v.TaskId}{ProjectQuery(v.ProjectId)}")">Task @v.TaskId</a>
                }
                <button class="btn btn--primary" @onclick="LoadAsync">Refresh</button>
            </div>
        </div>
        @if (v.Error is not null)
        {
            <div class="banner banner--error" style="margin-bottom:12px">
                <strong>Error:</strong> @v.Error
            </div>
        }

        @if (_run.Transcript.ValueKind != JsonValueKind.Array || _run.Transcript.GetArrayLength() == 0)
        {
            <div class="page-subtitle">@(v.Status == "running" ? "Run in flight — waiting for the first model response…" : "No transcript recorded.")</div>
        }
        else
        {
            @if (v.Status == "running")
            {
                <div class="page-subtitle" style="margin-bottom:8px">Streaming live — the conversation updates as the agent works (3s refresh).</div>
            }
            <div style="display:flex;flex-direction:column;gap:8px;max-width:980px">
                @foreach (var (msg, idx) in Messages().Select((m, i) => (m, i)))
                {
                    @switch (msg.Kind)
                    {
                        case "user":
                            <details class="run-msg">
                                <summary class="run-msg__summary">
                                    <span class="pill">user</span>
                                    <span class="meta-text" style="margin-left:8px">task prompt (@msg.Text.Length chars — expand to read)</span>
                                </summary>
                                <pre class="run-msg__pre">@msg.Text</pre>
                            </details>
                            break;
                        case "thinking":
                            <details class="run-msg run-msg--thinking">
                                <summary class="run-msg__summary--muted">
                                    <span class="pill" style="font-size:11px">thinking</span>
                                    <span class="meta-text" style="margin-left:8px">model reasoning (@msg.Text.Length chars)</span>
                                </summary>
                                <pre class="run-msg__pre--muted">@msg.Text</pre>
                            </details>
                            break;
                        case "assistant":
                            <div class="run-msg run-msg--assistant">
                                <span class="pill pill--primary" style="font-size:11px">assistant</span>
                                @foreach (var block in MarkdownBlocks(msg.Text))
                                {
                                    if (block.IsCode)
                                    {
                                        <pre class="run-msg__code">@block.Text</pre>
                                    }
                                    else
                                    {
                                        <div class="run-msg__text">@block.Text</div>
                                    }
                                }
                            </div>
                            break;
                        case "tools":
                            <details class="run-msg">
                                <summary class="run-msg__summary--muted">
                                    🔧 @msg.Calls.Count tool call@(msg.Calls.Count == 1 ? "" : "s"): @string.Join(", ", msg.Calls.Select(c => c.Name).Distinct())
                                </summary>
                                <div class="run-msg__tools">
                                    @foreach (var call in msg.Calls)
                                    {
                                        <div class="run-msg__tool">
                                            <div class="mono run-msg__tool-name">@call.Name</div>
                                            <pre class="run-msg__tool-args">@call.Args</pre>
                                            @if (call.Result is not null)
                                            {
                                                <pre class="run-msg__tool-result">@call.Result</pre>
                                            }
                                        </div>
                                    }
                                </div>
                            </details>
                            break;
                    }
                }
            </div>
        }
    }
</div>

@code {
    private static string ProjectQuery(string? projectId) =>
        projectId is null ? "" : $"?project={Uri.EscapeDataString(projectId)}";

    [Parameter] public string RunId { get; set; } = "";
    [Parameter][SupplyParameterFromQuery(Name = "project")] public string? Project { get; set; }

    private RunDto? _run;
    private readonly CancellationTokenSource _pollCts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = PollLoopAsync();
    }

    private async Task PollLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_pollCts.Token))
                await LoadAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        try
        {
            // Run rows live in the OWNING project's store — read
            // through the active-project lens (legacy rows pre-dating
            // the per-project writers are in the primary store).
            // ?project= deep-link wins over the shell lens — run rows
            // are per-project, and a link from another project's
            // surface must not resolve against the wrong store.
            var effectiveProject = Project ?? ShellStore.Value.CurrentProjectId;
            var lens = effectiveProject is { } pid
                ? $"?projectId={Uri.EscapeDataString(pid)}"
                : string.Empty;
            var resp = await Http.GetAsync($"/api/agent-runs/{RunId}" + lens);
            if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _notFound = true;
                _pollCts.Cancel();
                await InvokeAsync(StateHasChanged);
                return;
            }
            resp.EnsureSuccessStatusCode();
            _run = await resp.Content.ReadFromJsonAsync<RunDto>();
            // Terminal runs don't need the 3s poll loop anymore.
            if (_run?.View.Status is "succeeded" or "failed")
            {
                _pollCts.Cancel();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { throw; }
        catch { /* transient */ }
    }

    private bool _notFound;

    public void Dispose()
    {
        _pollCts.Cancel();
        _pollCts.Dispose();
    }

    private static string Ago(DateTime when)
    {
        var e = DateTime.UtcNow - when;
        return e.TotalMinutes >= 1 ? $"{(int)e.TotalMinutes}m{e.Seconds:D2}s" : $"{(int)e.TotalSeconds}s";
    }

    private sealed record RunDto(RunViewDto View, JsonElement Transcript);
    private sealed record RunViewDto(
        string Id, string? TaskId, string Role, string? Model, string Status,
        DateTime StartedAt, DateTime? FinishedAt, long? DurationMs,
        int? MessageCount, int? ToolCallCount, int? TextChars,
        string? Error, bool HasTranscript, DateTime? LastActivityAt,
        string? Phase, bool? ResumedSession, string? ProjectId);

    private sealed record ChatMsg(string Kind, string Text, List<ToolCall> Calls);
    private sealed record ToolCall(string Name, string Args, string? Result);

    private List<ChatMsg> Messages()
    {
        var resultsByCallId = new Dictionary<string, string>();
        var raw = new List<(string role, List<JsonElement> contents)>();
        foreach (var m in _run!.Transcript.EnumerateArray())
        {
            var role = m.GetProperty("role").GetString() ?? "?";
            var contents = m.GetProperty("contents").EnumerateArray().ToList();
            raw.Add((role, contents));
            foreach (var c in contents)
            {
                if (c.TryGetProperty("type", out var t) && t.GetString() == "tool_result")
                {
                    resultsByCallId[c.GetProperty("callId").GetString() ?? ""] =
                        c.GetProperty("result").GetString() ?? "";
                }
            }
        }

        var msgs = new List<ChatMsg>();
        foreach (var (role, contents) in raw)
        {
            var thinking = string.Concat(contents
                .Where(c => c.TryGetProperty("type", out var t) && t.GetString() == "thinking")
                .Select(c => c.GetProperty("text").GetString()));
            var text = string.Concat(contents
                .Where(c => c.TryGetProperty("type", out var t) && t.GetString() == "text")
                .Select(c => c.GetProperty("text").GetString()));
            var calls = contents
                .Where(c => c.TryGetProperty("type", out var t) && t.GetString() == "tool_call")
                .Select(c => new ToolCall(
                    c.GetProperty("name").GetString() ?? "?",
                    PrettyArgs(c.GetProperty("args").GetString()),
                    resultsByCallId.GetValueOrDefault(c.GetProperty("callId").GetString() ?? "")))
                .ToList();

            if (!string.IsNullOrWhiteSpace(thinking))
            {
                msgs.Add(new ChatMsg("thinking", thinking, new()));
            }
            if (calls.Count > 0)
            {
                msgs.Add(new ChatMsg("tools", "", calls));
            }
            if (!string.IsNullOrWhiteSpace(text))
            {
                msgs.Add(new ChatMsg(role == "user" ? "user" : "assistant", text, new()));
            }
        }
        return msgs;
    }

    private static string PrettyArgs(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        try
        {
            using var doc = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch { return raw; }
    }

    private static List<(bool IsCode, string Text)> MarkdownBlocks(string text)
    {
        var blocks = new List<(bool, string)>();
        var parts = text.Split("```", StringSplitOptions.None);
        for (var i = 0; i < parts.Length; i++)
        {
            var p = parts[i];
            if (string.IsNullOrWhiteSpace(p)) continue;
            if (i % 2 == 1)
            {
                var nl = p.IndexOf('\n');
                blocks.Add((true, nl > 0 ? p[(nl + 1)..] : p));
            }
            else
            {
                blocks.Add((false, p.Trim()));
            }
        }
        return blocks;
    }

    private static string Fmt(long ms)
    {
        var ts = TimeSpan.FromMilliseconds(ms);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
        return $"{(int)ts.TotalSeconds}s";
    }
}
