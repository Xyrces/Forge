@page "/projects/{Id}/overview"
@inject IState<Forge.Dashboard.Features.Projects.ProjectsState> ProjectsStore
@inject Fluxor.IDispatcher Dispatch
@implements IDisposable
@using Forge.Dashboard.Features.Projects
@inject NavigationManager Nav

<PageTitle>Project · @Id</PageTitle>
<div class="page">
    @{
        var proj = ProjectsStore.Value.Projects.FirstOrDefault(p => string.Equals(p.Id, Id, StringComparison.OrdinalIgnoreCase));
    }

    <div class="page-header">
        <h1>@(proj?.Name ?? Id)</h1>
        <div class="page-header__meta">
            <span class="mono">@Id</span>
            <span style="margin:0 6px;color:var(--outline-variant)">|</span>
            <span title="@proj?.Root" class="mono">@proj?.Root</span>
        </div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="@(() => Dispatch.Dispatch(new ProjectsActions.LoadProjectsAction()))">Refresh</button>
        </div>
    </div>

    @if (proj is null)
    {
        <div class="page-subtitle">
            Project <code>@Id</code> not found. <a href="/projects">Back to projects index</a>.
        </div>
    }
    else
    {
        <div class="filter-bar">
            <button class="chip chip--active">Overview</button>
            <button class="chip" @onclick='() => GoTo("/backlog")'>Backlog</button>
            <button class="chip" @onclick='() => GoTo("/sprints")'>Sprints</button>
            <button class="chip" @onclick='() => GoTo("/tasks")'>Tasks</button>
            <a class="chip" href="@($"/projects/{Id}/secrets")">Secrets</a>
        </div>

        <section class="overview-section">
            <h2>Counters</h2>
            <div class="metric-row">
                <div class="metric">
                    <div class="metric__label">Pending</div>
                    <div class="metric__value">@proj.Pending</div>
                </div>
                <div class="metric">
                    <div class="metric__label">In Progress</div>
                    <div class="metric__value">@proj.InProgress</div>
                </div>
                <div class="metric">
                    <div class="metric__label">Completed</div>
                    <div class="metric__value">@proj.Completed</div>
                </div>
                <div class="metric">
                    <div class="metric__label">Failed</div>
                    <div class="metric__value">
                        @if (proj.Failed > 0)
                        {
                            <span class="pill pill--failed">@proj.Failed needs you</span>
                        }
                        else
                        {
                            @proj.Failed
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="overview-section">
            <h2>Concurrency slots</h2>
            <p class="page-subtitle page-subtitle--meta">Per-project in-process semaphores. Adjust via <code>PATCH /api/projects/@Id/slots/{role}</code> with body <code>{ "max": N }</code>.</p>
            <div class="slot-grid">
                @foreach (var s in proj.Slots)
                {
                    <RoleSlotMeter Role="@s.Role" InFlight="@s.InFlight" Max="@s.Max" />
                }
            </div>
        </section>

        <section class="overview-section">
            <h2>Role caps (persisted)</h2>
            <p class="page-subtitle page-subtitle--meta">
                Saved to the project row in SQLite and applied to the live slot table immediately.
                Values equal to the built-in default are stored as "no override".
                Per-role <strong>models &amp; prompts</strong> are configured on the <a href="/agents">Agents page</a>.
            </p>

            @if (ProjectsStore.Value.RolesSaveError is not null)
            {
                <div class="banner banner--error"><span>@ProjectsStore.Value.RolesSaveError</span></div>
            }
            @if (ProjectsStore.Value.RolesSavedFor == Id)
            {
                <div class="banner banner--ok"><span>Role caps saved and applied to live slots.</span></div>
            }

            <table class="data-grid">
                <thead>
                    <tr><th>Role</th><th style="width:110px">Max</th><th>Source</th></tr>
                </thead>
                <tbody>
                    @foreach (var role in AllRoles(proj))
                    {
                        var isOverride = _roleEdits.ContainsKey(role);
                        var effective = isOverride ? _roleEdits[role] : DefaultsFor(proj).GetValueOrDefault(role, 1);
                        <tr>
                            <td class="mono">@role</td>
                            <td>
                                <input type="number" min="1" max="32" class="role-cap-input"
                                       value="@effective"
                                       @onchange="@(e => OnRoleCapChanged(role, e))" />
                            </td>
                            <td>
                                <span class="pill @(isOverride ? "pill--primary" : "")">@(isOverride ? "override" : "default")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="form-grid__actions" style="margin-top:10px">
                <button class="btn btn--primary" @onclick="SaveRoles" disabled="@ProjectsStore.Value.RolesSaving">
                    @(ProjectsStore.Value.RolesSaving ? "Saving…" : "Save role caps")
                </button>
                <button class="btn" @onclick="ResetRoleEdits" disabled="@ProjectsStore.Value.RolesSaving" title="Discard unsaved edits and reload the current values">Discard edits</button>
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    // Tab chips: there are no per-project routes for these boards —
    // select THIS project in the shell store and go to the global
    // page (was: hrefs to /projects/{id}/backlog|sprints|tasks that
    // 404'd — found in the 2026-07-27 UI audit).
    private void GoTo(string route)
    {
        Dispatch.Dispatch(new Forge.Dashboard.Features.AppShell.AppShellActions.SelectProjectAction(Id));
        Nav.NavigateTo(route);
    }

    // Server-provided defaults (ProjectDto.DefaultRoleCaps) with a
    // last-resort mirror for older servers (audit: silent drift risk).
    private IReadOnlyDictionary<string, int> DefaultsFor(Forge.Dashboard.Features.Projects.ProjectsEndpointRow proj) =>
        proj.DefaultRoleCaps ?? DefaultRoleCapsFallback;

    private static readonly Dictionary<string, int> DefaultRoleCapsFallback = new(StringComparer.OrdinalIgnoreCase)
    {
        ["coredev"] = 2,
        ["clientdev"] = 2,
        ["reviewer"] = 2,
        ["intake"] = 1,
        ["designer"] = 1,
        ["artist"] = 1,
        ["groomer"] = 1,
        ["orchestrator"] = 1,
    };

    private readonly Dictionary<string, int> _roleEdits = new(StringComparer.OrdinalIgnoreCase);
    private string? _editsInitializedFor;

    protected override void OnInitialized()
    {
        ProjectsStore.StateChanged += OnStateChanged;
        if (ProjectsStore.Value.LastFetchedAt is null)
        {
            Dispatch.Dispatch(new ProjectsActions.LoadProjectsAction());
        }
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        // (Re)seed the edit grid from the freshly loaded project once
        // per project id; don't clobber in-flight edits on refresh.
        var proj = ProjectsStore.Value.Projects.FirstOrDefault(p =>
            string.Equals(p.Id, Id, StringComparison.OrdinalIgnoreCase));
        if (proj is not null && !string.Equals(_editsInitializedFor, proj.Id, StringComparison.OrdinalIgnoreCase))
        {
            _roleEdits.Clear();
            foreach (var kv in proj.Roles) _roleEdits[kv.Key] = kv.Value;
            _editsInitializedFor = proj.Id;
        }
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<string> AllRoles(ProjectsEndpointRow proj) =>
        DefaultsFor(proj).Keys
            .Concat(proj.Roles.Keys)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(r => r, StringComparer.OrdinalIgnoreCase);

    private void OnRoleCapChanged(string role, ChangeEventArgs e)
    {
        if (e.Value is string s && int.TryParse(s, out var n))
        {
            n = Math.Clamp(n, 1, 32);
            var proj = ProjectsStore.Value.Projects.FirstOrDefault(p => string.Equals(p.Id, Id, StringComparison.OrdinalIgnoreCase));
            if (proj is not null && DefaultsFor(proj).TryGetValue(role, out var d) && d == n)
                _roleEdits.Remove(role); // same as default → no override
            else
                _roleEdits[role] = n;
        }
    }

    private void SaveRoles()
    {
        var roles = new Dictionary<string, int>(_roleEdits, StringComparer.OrdinalIgnoreCase);
        Dispatch.Dispatch(new ProjectsActions.UpdateProjectRolesAction(Id, roles));
    }

    private void ResetRoleEdits()
    {
        _roleEdits.Clear();
    }

    public void Dispose()
    {
        ProjectsStore.StateChanged -= OnStateChanged;
    }
}
