    private static string PhaseDuration(DateTimeOffset? start, DateTimeOffset? end, string? outcome)
    {
        if (start is null) return "Start time not recorded";
        if (end is null) return "Started · finish time not recorded";
        if (end < start) return "Timing unavailable";

        var duration = Duration(start.Value, end.Value);
        return outcome switch
        {
            "failed" => $"Failed after {duration}",
            "cancelled" => $"Cancelled after {duration}",
            "timed-out" => $"Timed out after {duration}",
            _ => duration
        };
    }
    private static string Duration(DateTimeOffset start, DateTimeOffset end)
    {
        var elapsed = end - start;
        if (elapsed < TimeSpan.Zero) return "Timing unavailable";
        if (elapsed > TimeSpan.Zero && elapsed < TimeSpan.FromMilliseconds(1)) return "Under 1 ms";
        if (elapsed > TimeSpan.Zero && elapsed < TimeSpan.FromSeconds(1)) return $"{elapsed.TotalMilliseconds:0} ms";
        return $"{elapsed.TotalSeconds:0.#}s";
    }
