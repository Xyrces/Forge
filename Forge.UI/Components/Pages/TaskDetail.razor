    // Collapse runs of identical events (kind + detail) into one row
    // with a ×N badge — a 429 storm otherwise renders as an
    // unreadable wall of duplicates (observed live on task-156).
    private IEnumerable<EventGroup> GroupedEvents()
    {
        EventGroup? cur = null;
        foreach (var e in _events)
        {
            if (cur is not null && cur.Kind == e.Kind && cur.Detail == e.Detail && cur.Actor == e.Actor)
            {
                cur = cur with { At = e.At, Count = cur.Count + 1 };
                continue;
            }
            if (cur is not null) yield return cur;
            cur = new EventGroup(e.At, e.At, e.Kind, e.Detail, 1, e.Actor);
        }
        if (cur is not null) yield return cur;
    }

    private sealed record EventGroup(string FirstAt, string At, string Kind, string Detail, int Count, string Actor);

    protected override async Task OnParametersSetAsync()
    {
        if (_requestedRecoveryTarget == RecoveryTarget)
        {
            _section = Section is "Review" or "Plan & checks" or "History & runs" ? Section : "Overview";
            if (_section == "History & runs") await LoadActivityAsync();
            else if (_section == "Review" && !_legacyLoaded && !_legacyLoading) await LoadLegacyReviewsAsync();
            return;
        }
        _requestedRecoveryTarget = RecoveryTarget;
        ++_retryGeneration; _resetting = false; _retryError = null;
        InvalidateActivity();
        _section = Section is "Review" or "Plan & checks" or "History & runs" ? Section : "Overview"; _delivery = null; _repoUrl = null;
        _task = null; _state = null; _sprint = null; _runs.Clear(); _events.Clear(); _workers.Clear();
        _historyCursor = null; _historyError = null; _workerError = null; _runsError = null; _holdError = null;
        _holdLoaded = false;
        ++_legacyGeneration; _legacyLoading = false; _legacyLoaded = false; _legacyReviews.Clear(); _nativeReviews.Clear(); _legacyNotes.Clear(); _legacyError = null;
        _closeOpen = false; _closeReason = ""; _closeResult = null;
        if (PersistentState.TryTakeFromJson<OverviewSnapshot>("forge-task-overview:" + RecoveryTarget, out var snapshot) && snapshot is not null)
        {
            _task = snapshot.Task; _repoUrl = snapshot.Repository;
            _holdLoaded = snapshot.HoldLoaded; _explicitHumanHold = snapshot.ExplicitHold;
            _humanPolicy = snapshot.HumanPolicy; _holdError = snapshot.HoldError;
            _delivery = snapshot.Task.TryGetProperty("delivery", out var delivery) && delivery.ValueKind == JsonValueKind.Object
                ? delivery.Deserialize<TaskDeliveryRead>(JsonSerializerOptions.Web) : null;
            _sprint = snapshot.Task.TryGetProperty("sprint", out var sprint) && sprint.ValueKind == JsonValueKind.Object ? sprint : null;
            _loadedRecoveryTarget = RecoveryTarget;
            if (snapshot.Review is { } review)
            {
                _legacyReviews = review.Legacy; _nativeReviews = review.Native; _legacyNotes = review.Notes;
                _legacyError = review.Error; _legacyLoaded = true;
            }
            if (snapshot.Activity is { } activity)
            {
                _events = activity.Events; _workers = activity.Workers; _runs = activity.Runs; _state = activity.State;
                _historyCursor = activity.Cursor; _historyError = activity.HistoryError;
                _workerError = activity.WorkerError; _runsError = activity.RunsError; _activityLoaded = true;
            }
            if (_section == "History & runs") await LoadActivityAsync();
            else if (_section == "Review" && !_legacyLoaded && !_legacyLoading) await LoadLegacyReviewsAsync();
            return;
        }
        await LoadAsync();
    }

    private PersistingComponentStateSubscription _persisting;
    private sealed record OverviewSnapshot(JsonElement Task, string? Repository, bool HoldLoaded,
        bool ExplicitHold, string? HumanPolicy, string? HoldError, ReviewSnapshot? Review = null, ActivitySnapshot? Activity = null);
    private sealed record ReviewSnapshot(List<LegacyReview> Legacy, List<NativeReview> Native, List<string> Notes, string? Error);
    private sealed record ActivitySnapshot(List<EventVm> Events, List<WorkerSummary> Workers, List<RunVm> Runs,
        StateVm? State, string? Cursor, string? HistoryError, string? WorkerError, string? RunsError);
    private OverviewSnapshot CaptureOverviewSnapshot(JsonElement task) => new(task, _repoUrl, _holdLoaded, _explicitHumanHold,
        _humanPolicy, _holdError,
        !_legacyLoading && (_legacyLoaded || _legacyError is not null)
            ? new(_legacyReviews, _nativeReviews, _legacyNotes, _legacyError) : null,
        _activityLoaded && !_activityLoading
            ? new(_events, _workers, _runs, _state, _historyCursor, _historyError, _workerError, _runsError) : null);
    protected override void OnInitialized() => _persisting = PersistentState.RegisterOnPersisting(() =>
    {
        if (_task is { } task && _loadedRecoveryTarget == RecoveryTarget && _error is null)
        {
            var snapshot = CaptureOverviewSnapshot(task);
            // Persisted prerender state travels back in the initial circuit-start message.
            // Large review/history payloads must use normal interactive reads instead of
            // disconnecting the entire page. Keep room for framework encoding/other state;
            // do not truncate task data or increase the global transport limit.
            if (JsonSerializer.SerializeToUtf8Bytes(snapshot).Length <= 8 * 1024)
                PersistentState.PersistAsJson("forge-task-overview:" + RecoveryTarget, snapshot);
        }
        return Task.CompletedTask;
    });
    public void Dispose() { _persisting.Dispose(); ++_recoveryLoadGeneration; ++_legacyGeneration; InvalidateActivity(); }
    private bool _activityLoaded, _activityLoading;
    private int _activityGeneration;
    private CancellationTokenSource? _activityRequest;
    private void InvalidateActivity()
    {
        ++_activityGeneration;
        _activityRequest?.Cancel(); _activityRequest?.Dispose(); _activityRequest = null;
        _activityLoaded = false; _activityLoading = false; _historyLoading = false;
    }
    private async Task LoadActivityAsync()
    {
        if (_activityLoading || _activityLoaded || _task is null) return;
        var generation = ++_activityGeneration;
        var target = RecoveryTarget;
        _activityRequest = new();
        var token = _activityRequest.Token;
        _activityLoading = true;
        try
        {
            await Task.WhenAll(LoadHistoryAsync(false),
                LoadWorkersAsync(target, generation, TaskId, EffectiveProject, token),
                LoadStateAsync(target, generation, TaskId, EffectiveProject, token),
                LoadRunsAsync(target, generation, TaskId, EffectiveProject, token));
            if (generation == _activityGeneration && target == RecoveryTarget) _activityLoaded = true;
        }
        finally { if (generation == _activityGeneration && target == RecoveryTarget) _activityLoading = false; }
    }
    private async Task LoadWorkersAsync(string recoveryTarget, int recoveryGeneration, string taskId, string? projectId, CancellationToken token)
    {
            try
            {
                var workers = await Http.GetFromJsonAsync<WorkerPage>($"/api/tasks/{Uri.EscapeDataString(taskId)}/workers?projectId={Uri.EscapeDataString(projectId ?? "")}", token);
                if (recoveryTarget != RecoveryTarget || recoveryGeneration != _activityGeneration) return;
                _workers = workers?.Attempts ?? []; _workerError = null;
            }
            catch (Exception ex) { if (recoveryTarget == RecoveryTarget && recoveryGeneration == _activityGeneration) _workerError = ex.Message; }


    }
    private async Task LoadStateAsync(string recoveryTarget, int recoveryGeneration, string taskId, string? projectId, CancellationToken token)
    {
            // Derived lifecycle state (what it's doing + waiting on).
            try
            {
                var stateUrl = string.IsNullOrEmpty(projectId)
                    ? $"/api/tasks/{taskId}/state"
                    : $"/api/tasks/{taskId}/state?projectId={Uri.EscapeDataString(projectId)}";
                var sd = await Http.GetFromJsonAsync<JsonElement>(stateUrl, token);
                if (recoveryTarget != RecoveryTarget || recoveryGeneration != _activityGeneration) return;
                _state = new StateVm(
                    Prop(sd, "state") ?? "", Prop(sd, "substate"), Prop(sd, "waitingOn") ?? "",
                    sd.TryGetProperty("strikes", out var st) && st.TryGetInt32(out var si) ? si : 0,
                    sd.TryGetProperty("maxStrikes", out var ms) && ms.TryGetInt32(out var msi) ? msi : 3);
            }
            catch { if (recoveryTarget == RecoveryTarget && recoveryGeneration == _activityGeneration) _state = null; /* state is additive */ }


    }
    private async Task LoadRunsAsync(string recoveryTarget, int recoveryGeneration, string taskId, string? projectId, CancellationToken token)
    {
            // Agent runs for this task (the "who worked on this and
            // what did they actually do" trail). Same shape as /runs.
            try
            {
                var runsUrl = string.IsNullOrEmpty(projectId)
                    ? $"/api/agent-runs?taskId={Uri.EscapeDataString(taskId)}"
                    : $"/api/agent-runs?taskId={Uri.EscapeDataString(taskId)}&projectId={Uri.EscapeDataString(projectId)}";
                var runsDoc = await Http.GetFromJsonAsync<JsonElement>(runsUrl, token);
                if (recoveryTarget != RecoveryTarget || recoveryGeneration != _activityGeneration) return;
                var runs = new List<RunVm>();
                foreach (var bucket in new[] { "active", "recent" })
                {
                    if (runsDoc.TryGetProperty(bucket, out var arr))
                    {
                        foreach (var r in arr.EnumerateArray())
                        {
                            runs.Add(new RunVm(
                                Id: Prop(r, "id") ?? "",
                                Role: Prop(r, "role") ?? "",
                                ProjectId: Prop(r, "projectId"),
                                Status: Prop(r, "status") ?? "",
                                StartedAt: DateTime.TryParse(Prop(r, "startedAt"), out var sa) ? sa : DateTime.MinValue,
                                FinishedAt: DateTime.TryParse(Prop(r, "finishedAt"), out var fa) ? fa : null,
                                LastActivityAt: DateTime.TryParse(Prop(r, "lastActivityAt"), out var la) ? la : null,
                                DurationMs: long.TryParse(Prop(r, "durationMs"), out var dm) ? dm : null,
                                MessageCount: int.TryParse(Prop(r, "messageCount"), out var mc) ? mc : null,
                                ToolCallCount: int.TryParse(Prop(r, "toolCallCount"), out var tc) ? tc : null,
                                Error: Prop(r, "error"),
                                Phase: Prop(r, "phase"),
                                ResumedSession: r.TryGetProperty("resumedSession", out var rs) && rs.ValueKind == JsonValueKind.True));
                        }
                    }
                }
                // "Last run" = latest OUTCOME, not latest start — a
                // review that started before a dev run but failed
                // after it succeeded is the more recent event.
                _runs = runs.OrderByDescending(r => r.FinishedAt ?? r.LastActivityAt ?? r.StartedAt).ToList();
                _runsError = null;
            }
            catch (Exception ex) { if (recoveryTarget == RecoveryTarget && recoveryGeneration == _activityGeneration) _runsError = ex.Message; }

    }

    private async Task LoadAsync()
    {
        var recoveryTarget = RecoveryTarget;
        var taskId = TaskId;
        var recoveryGeneration = ++_recoveryLoadGeneration;
        InvalidateActivity();
        ++_legacyGeneration; _legacyLoaded = false; _legacyLoading = false;
        _loadedRecoveryTarget = null;
        _error = null;
        try
        {
            var projectId = Project ?? ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/tasks/{Uri.EscapeDataString(taskId)}?includeEvents=false"
                : $"/api/tasks/{Uri.EscapeDataString(taskId)}?includeEvents=false&projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url);
            if (recoveryTarget != RecoveryTarget || recoveryGeneration != _recoveryLoadGeneration) return;
            _task = doc;
            _delivery = doc.TryGetProperty("delivery", out var delivery) && delivery.ValueKind == JsonValueKind.Object
                ? delivery.Deserialize<TaskDeliveryRead>(JsonSerializerOptions.Web) : null;
            try
            {
                var hold = await Http.GetFromJsonAsync<JsonElement>($"/api/tasks/{Uri.EscapeDataString(taskId)}/human-review?projectId={Uri.EscapeDataString(projectId ?? "")}");
                if (recoveryTarget != RecoveryTarget || recoveryGeneration != _recoveryLoadGeneration) return;
                _explicitHumanHold = hold.TryGetProperty("required", out var required) && required.ValueKind == JsonValueKind.True;
                _humanPolicy = Prop(hold, "mode"); _holdLoaded = true; _holdError = null;
            }
            catch (Exception ex) { if (recoveryTarget == RecoveryTarget && recoveryGeneration == _recoveryLoadGeneration) { _holdLoaded = false; _holdError = "Couldn’t load the review requirement: " + ex.Message; } }
            _sprint = doc.ValueKind == JsonValueKind.Object && doc.TryGetProperty("sprint", out var sp) && sp.ValueKind == JsonValueKind.Object
                ? sp : null;
            if (recoveryTarget != RecoveryTarget || recoveryGeneration != _recoveryLoadGeneration) return;
            _repoUrl = null;
            if (!string.IsNullOrEmpty(projectId))
            {
                var projects = await Http.GetFromJsonAsync<JsonElement>("/api/projects");
                if (recoveryTarget != RecoveryTarget || recoveryGeneration != _recoveryLoadGeneration) return;
                foreach (var p in projects.EnumerateArray())
                {
                    if (string.Equals(Prop(p, "id"), projectId, StringComparison.OrdinalIgnoreCase))
                    {
                        if (projectId == (Project ?? ShellStore.Value.CurrentProjectId))
                            _repoUrl = RepositoryLinks.WebUrl(Prop(p, "repoUrl"));
                        break;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            if (recoveryTarget == RecoveryTarget && recoveryGeneration == _recoveryLoadGeneration) _error = ex.Message;
        }
        if (_error is null && recoveryTarget == RecoveryTarget && recoveryGeneration == _recoveryLoadGeneration)
        {
            _loadedRecoveryTarget = recoveryTarget;
            if (_section == "History & runs") await LoadActivityAsync();
            else if (_section == "Review" && !_legacyLoaded && !_legacyLoading) await LoadLegacyReviewsAsync();
        }
    }

