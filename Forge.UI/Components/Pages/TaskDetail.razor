@page "/tasks/{TaskId}"
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject HttpClient Http
@inject NavigationManager Nav
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Task @TaskId</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>
            <button class="btn btn--link" @onclick="@(() => Nav.NavigateTo("/backlog"))">← Backlog</button>
            @(Prop(_task, "title") ?? TaskId)
        </h1>
        <div class="page-header__actions">
            <a class="btn" href="/flow?issue=@TaskId">View in flow</a>
            <button class="btn btn--primary" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="banner banner--error"><span>@_error</span></div>
    }
    @if (_task is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        <div class="card" style="margin-bottom:14px">
            <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap">
                <span class="pill pill--@StatusCss">@Prop(_task, "status")</span>
                <span class="mono">@Prop(_task, "type")</span>
                <span class="mono">@TaskId</span>
                <span class="mono">priority @Prop(_task, "priority")</span>
                @if (Prop(_task, "assignee") is { } assignee)
                {
                    <span class="mono">@assignee</span>
                }
                @if (Prop(_task, "dispatchCheckpoint") is { } cp)
                {
                    <span class="mono">checkpoint: @cp</span>
                }
                @if (Prop(_task, "parentIssueId") is { } parent)
                {
                    <a href="/tasks/@parent" class="mono">parent: @parent</a>
                }
            </div>
        </div>

        <div class="card" style="margin-bottom:14px">
            <h2>Links & state</h2>
            <table class="data-grid">
                <tbody>
                    @if (Meta("prNumber") is { } pr && PrUrl(pr) is { } url)
                    {
                        <tr><td>Pull request</td><td><a href="@url" target="_blank" rel="noopener">PR #@pr</a></td></tr>
                    }
                    @if (Meta("branch") is { } branch)
                    {
                        <tr><td>Branch</td><td class="mono">@branch</td></tr>
                    }
                    @if (Meta("worktreePath") is { } wt)
                    {
                        <tr><td>Worktree</td><td class="mono">@wt</td></tr>
                    }
                    @if (Meta("reworkAttempts") is { } attempts)
                    {
                        <tr><td>Rework</td><td><span class="pill pill--blocked">R@(attempts)</span> @(Meta("reworkReason") ?? "")</td></tr>
                    }
                    @if (Meta("reworkContext") is { } reworkCtx)
                    {
                        <tr><td>Rework context</td><td><pre class="mono" style="white-space:pre-wrap; max-height:160px; overflow:auto">@reworkCtx</pre></td></tr>
                    }
                    @if (_sprint is not null)
                    {
                        <tr>
                            <td>Sprint</td>
                            <td>
                                <a href="/sprints">@Prop(_sprint, "name")</a>
                                <span class="pill pill--@Prop(_sprint, "status")?.ToLowerInvariant()">@Prop(_sprint, "status")</span>
                            </td>
                        </tr>
                    }
                    <tr><td>Created</td><td class="mono">@Prop(_task, "createdAt")</td></tr>
                    <tr><td>Updated</td><td class="mono">@Prop(_task, "updatedAt")</td></tr>
                    @if (Prop(_task, "closedAt") is { } closed)
                    {
                        <tr><td>Closed</td><td class="mono">@closed</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Prop(_task, "description") is { Length: > 0 } desc)
        {
            <div class="card" style="margin-bottom:14px">
                <h2>Description</h2>
                <pre class="mono" style="white-space:pre-wrap; max-height:240px; overflow:auto">@desc</pre>
            </div>
        }

        <div class="card" style="margin-bottom:14px">
            <h2>Agent runs (@_runs.Count)</h2>
            @if (_runs.Count == 0)
            {
                <p class="hint">No agent runs recorded for this task yet.</p>
            }
            else
            {
                <table class="data-grid">
                    <thead>
                        <tr><th>Status</th><th>Started</th><th>Duration</th><th>Progress</th><th>Error</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _runs)
                        {
                            <tr>
                                <td>
                                    <a href="/runs/@r.Id">
                                        <span class="pill @(r.Status == "succeeded" ? "pill--completed" : r.Status == "running" ? "pill--inprogress" : "pill--failed")">@r.Status</span>
                                    </a>
                                </td>
                                <td class="mono">@r.StartedAt.ToString("MM-dd HH:mm:ss")</td>
                                <td class="mono">@(r.DurationMs is null ? "…" : $"{TimeSpan.FromMilliseconds(r.DurationMs.Value).TotalSeconds:F0}s")</td>
                                <td class="mono">@(r.MessageCount ?? 0) msgs · @(r.ToolCallCount ?? 0) tools</td>
                                <td class="mono" style="font-size:11px; max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@r.Error">@(r.Error ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card">
            <h2>Timeline (@_events.Count events)</h2>
            @if (_events.Count == 0)
            {
                <p class="hint">No events recorded for this task yet.</p>
            }
            <table class="data-grid">
                <thead>
                    <tr><th>When</th><th>Kind</th><th>Detail</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in GroupedEvents())
                    {
                        <tr>
                            <td class="mono">@g.At</td>
                            <td class="mono">@g.Kind</td>
                            <td>
                                @g.Detail
                                @if (g.Count > 1)
                                {
                                    <span class="pill pill--blocked" title="@($"{g.Count} identical events, {g.FirstAt} → {g.At}")">×@g.Count</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public string TaskId { get; set; } = "";

    private JsonElement? _task;
    private JsonElement? _sprint;
    private List<EventVm> _events = new();
    private List<RunVm> _runs = new();
    private string? _repoUrl;
    private string? _error;

    private string StatusCss => Prop(_task, "status")?.ToLowerInvariant() ?? "unknown";

    // Collapse runs of identical events (kind + detail) into one row
    // with a ×N badge — a 429 storm otherwise renders as an
    // unreadable wall of duplicates (observed live on task-156).
    private IEnumerable<EventGroup> GroupedEvents()
    {
        EventGroup? cur = null;
        foreach (var e in _events)
        {
            if (cur is not null && cur.Kind == e.Kind && cur.Detail == e.Detail)
            {
                cur = cur with { At = e.At, Count = cur.Count + 1 };
                continue;
            }
            if (cur is not null) yield return cur;
            cur = new EventGroup(e.At, e.At, e.Kind, e.Detail, 1);
        }
        if (cur is not null) yield return cur;
    }

    private sealed record EventGroup(string FirstAt, string At, string Kind, string Detail, int Count);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/tasks/{TaskId}"
                : $"/api/tasks/{TaskId}?projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url);
            _task = doc;
            _sprint = doc.ValueKind == JsonValueKind.Object && doc.TryGetProperty("sprint", out var sp) && sp.ValueKind == JsonValueKind.Object
                ? sp : null;
            _events = doc.TryGetProperty("events", out var evs)
                ? evs.EnumerateArray().Select(e => new EventVm(
                    Prop(e, "at") ?? "", Prop(e, "kind") ?? "", Prop(e, "detail") ?? "")).ToList()
                : new List<EventVm>();
            _events.Reverse(); // API returns newest-first; show oldest-first

            // Agent runs for this task (the "who worked on this and
            // what did they actually do" trail). Same shape as /runs.
            try
            {
                var runsDoc = await Http.GetFromJsonAsync<JsonElement>($"/api/agent-runs?taskId={Uri.EscapeDataString(TaskId)}");
                var runs = new List<RunVm>();
                foreach (var bucket in new[] { "active", "recent" })
                {
                    if (runsDoc.TryGetProperty(bucket, out var arr))
                    {
                        foreach (var r in arr.EnumerateArray())
                        {
                            runs.Add(new RunVm(
                                Id: Prop(r, "id") ?? "",
                                Status: Prop(r, "status") ?? "",
                                StartedAt: DateTime.TryParse(Prop(r, "startedAt"), out var sa) ? sa : DateTime.MinValue,
                                DurationMs: long.TryParse(Prop(r, "durationMs"), out var dm) ? dm : null,
                                MessageCount: int.TryParse(Prop(r, "messageCount"), out var mc) ? mc : null,
                                ToolCallCount: int.TryParse(Prop(r, "toolCallCount"), out var tc) ? tc : null,
                                Error: Prop(r, "error")));
                        }
                    }
                }
                _runs = runs.OrderByDescending(r => r.StartedAt).ToList();
            }
            catch { /* runs are additive — never break the task page */ }
            if (_repoUrl is null && !string.IsNullOrEmpty(projectId))
            {
                var projects = await Http.GetFromJsonAsync<JsonElement>("/api/projects");
                foreach (var p in projects.EnumerateArray())
                {
                    if (string.Equals(Prop(p, "id"), projectId, StringComparison.OrdinalIgnoreCase))
                    {
                        _repoUrl = Prop(p, "repoUrl")?.TrimEnd('/');
                        break;
                    }
                }
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private string? Meta(string key)
    {
        if (_task is null || _task.Value.ValueKind != JsonValueKind.Object) return null;
        if (!_task.Value.TryGetProperty("metadata", out var m) || m.ValueKind != JsonValueKind.Object) return null;
        return Prop(m, key);
    }

    private string? PrUrl(string prNumber) =>
        _repoUrl is null ? null : $"{_repoUrl}/pull/{prNumber}";

    private static string? Prop(JsonElement? e, string name)
    {
        if (e is null || e.Value.ValueKind != JsonValueKind.Object) return null;
        if (!e.Value.TryGetProperty(name, out var v)) return null;
        return v.ValueKind switch
        {
            JsonValueKind.String => v.GetString(),
            JsonValueKind.Null => null,
            _ => v.ToString(),
        };
    }

    private sealed record EventVm(string At, string Kind, string Detail);

    private sealed record RunVm(string Id, string Status, DateTime StartedAt,
        long? DurationMs, int? MessageCount, int? ToolCallCount, string? Error);
}
