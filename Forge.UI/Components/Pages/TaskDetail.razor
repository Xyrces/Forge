@using Forge.Dashboard.Services
@using Forge.Dashboard.Features.Tasks
@page "/tasks/{TaskId}"
@implements IDisposable
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject HttpClient Http
@inject PersistentComponentState PersistentState
@inject NavigationManager Nav
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>@(Prop(_task, "title") ?? "Task")</PageTitle>
<div class="page task-detail">
    <nav class="task-breadcrumb" aria-label="Breadcrumb"><a href="@SprintLink">Sprints</a><span>/</span><a href="@($"/tasks{ProjectQuery(EffectiveProject)}")">Tasks</a></nav>
    <div class="page-header page-header--wrapping">
        <h1>@(Prop(_task, "title") ?? TaskId)</h1>
        <div class="page-header__actions">
            @if (Meta("prNumber") is { } pr && PrUrl(pr) is { } url)
            { <a class="btn" href="@url" target="_blank" rel="noopener">Open PR #@pr ↗</a> }
            <button class="btn" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>
    @if (_error is not null) { <div class="banner banner--error" role="alert">Couldn’t refresh task: @_error. The previous view may be out of date.</div> }
    @if (_retryError is not null) { <div class="banner banner--error" role="alert">@_retryError</div> }
    @if (_task is null) { <p>Loading task…</p> }
    else
    {
        <div class="task-outcome"><strong>@Situation("label")</strong><span>@Situation("text")</span>
            @if (Situation("nextActor") is { Length: > 0 } actor) { <span>Next: @actor</span> }
        </div>
        @if (HumanReviewRequired) { <p class="banner banner--info">@(NominatedHuman is null ? "Human review required before merge." : $"Review by @{NominatedHuman} required before merge.")@(Meta("humanReviewSyncPending")?.Equals("true", StringComparison.OrdinalIgnoreCase) == true ? " Synchronizing with GitHub; merge remains held." : "")</p> }
        @if (Meta("reviewGateError") is { Length: > 0 } gateError) { <p class="banner banner--error" role="alert"><strong>Review gate unavailable.</strong> @gateError</p> }
        @if (Meta("reviewIntegrationError") is { Length: > 0 } publicationError && (Meta("reviewBudgetDeniedHead") is not { Length: > 0 } budgetHead || budgetHead != Meta("reviewSha")))
        {
            <p class="banner banner--error" role="alert"><strong>Review publication needs attention.</strong> @publicationError</p>
        }
        <div class="task-controls">
            @foreach (var section in new[] { "Overview", "Review", "Plan & checks", "History & runs" })
            { <button class="btn @(_section == section ? "btn--primary" : "")" aria-pressed="@(_section == section)" @onclick="() => SelectSectionAsync(section)">@section</button> }
            @if (CanActOnLoadedTask && Prop(_task, "status") is not ("Completed" or "Closed"))
            {
                <details class="task-actions"><summary>Task actions</summary>
                    <button class="btn" disabled="@(_holdSaving || !_holdLoaded)" @onclick="ToggleHumanReviewAsync">@(_explicitHumanHold ? "Release task review hold" : NominatedHuman is null ? "Require human review for this task" : $"Require review by @{NominatedHuman} for this task")</button>
                    @if (_humanPolicy is "Human" or "Both") { <p class="meta-text">Project policy requires human review. Releasing a task hold does not waive that policy.</p> }
                    @if (Prop(_task, "status") is "Failed" or "Blocked") { <button class="btn" disabled="@_resetting" @onclick="RetryAsync">@(Meta("blockedKind") == "review-integration" ? "Retry review" : "Retry work")</button> }
                    <button class="btn" @onclick="() => _closeOpen = !_closeOpen">Close task…</button>
                </details>
            }
        </div>
        @if (_holdError is not null) { <p class="banner banner--error" role="alert">@_holdError</p> }
        @if (_closeOpen && CanActOnLoadedTask)
        {
            <section class="card"><h2>Close task</h2><label>Reason<input class="task-reason" @bind="_closeReason" /></label><label><input type="checkbox" @bind="_closePr" /> Also close the linked PR unmerged</label>
                <button class="btn" disabled="@(_closing || string.IsNullOrWhiteSpace(_closeReason))" @onclick="CloseTaskAsync">Confirm close</button><button class="btn" @onclick="() => _closeOpen = false">Cancel</button><p role="status">@_closeResult</p>
            </section>
        }
        @if (_section == "Overview")
        {
            <div class="task-detail-grid">
                <section class="card"><TaskDeliverySummary Data="@_delivery" Description="@Prop(_task, "description")"
                    Repository="@_repoUrl" SprintUrl="@(_sprint is null ? null : SprintLink)" />
                    @if (Meta("lastError") is { Length: > 0 } error) { <details><summary>Earlier interruption</summary><RecordedMarkdown Text="@error" /></details> }
                </section>
                <aside class="card"><h2>Task context</h2><dl class="task-facts"><dt>Role</dt><dd>@WorkPresentation.Role(Prop(_task, "type"))</dd>
                    @if (_sprint is not null) { <dt>Sprint</dt><dd><a href="@SprintLink">@Prop(_sprint, "name")</a><p class="meta-text">Deployment and browser acceptance are recorded with the sprint.</p></dd> }
                    <dt>Updated</dt><dd>@FmtDate(Prop(_task, "updatedAt"))</dd>
                    @if (Prop(_task, "parentIssueId") is { } parent) { <dt>Parent</dt><dd><a href="@($"/tasks/{Uri.EscapeDataString(parent)}{ProjectQuery(EffectiveProject)}")">Open parent work</a></dd> }
                </dl><details><summary>Technical identifiers</summary><dl class="task-facts"><dt>Task</dt><dd><code>@TaskId</code></dd><dt>Branch</dt><dd><code>@Meta("branch")</code></dd><dt>Workspace</dt><dd><code>@Meta("worktreePath")</code></dd><dt>State</dt><dd>@(_state?.State ?? Meta("state") ?? Prop(_task, "status"))</dd><dt>Recovery counter</dt><dd>@(_state?.Strikes.ToString() ?? "Open History & runs to load")</dd></dl></details></aside>
            </div>
            @if (CanActOnLoadedTask && Prop(_task, "status") == "Pending" && !string.IsNullOrWhiteSpace(EffectiveProject))
            { <TaskRegroom @key="RecoveryTarget" TaskId="@TaskId" ProjectId="@(EffectiveProject!)" Requested="RegroomRequestedAsync" /> }
            @if (_regroomNotice is not null && _regroomNoticeTarget == RecoveryTarget) { <p role="status">@_regroomNotice</p> }
        }
        else if (_section == "Review")
        {
            @if (_legacyLoading) { <p role="status">Loading original review sources…</p> }
            @if (_legacyError is not null) { <p class="banner banner--warn">@_legacyError <button class="btn" @onclick="LoadLegacyReviewsAsync">Retry source history</button></p> }
            @if (_nativeReviews.Count > 0)
            {
                <section class="card"><h2>GitHub reviews and inline discussions</h2><p class="meta-text">Recorded decisions, not a new merge decision. Eligibility and outstanding objections are checked separately before merge. Later approval does not prove each earlier discussion was resolved.</p>
                @foreach (var native in _nativeReviews)
                {
                    <article class="task-finding"><h3>@NativeDecisionLabel(native.Verdict) · @native.Reviewer</h3>
                        <p class="meta-text">@native.Role · @FmtDate(native.SubmittedAt) · revision <RevisionLink Sha="@native.HeadSha" Repository="@_repoUrl" />@(native.HeadSha != Meta("branchSha") ? " · Earlier or unconfirmed revision" : " · Current recorded revision")</p>
                        <RecordedMarkdown Text="@ReviewProse.Format(native.Summary, native.Role == "Forge reviewer App")" />
                        @foreach (var comment in native.Comments)
                        {
                            <details><summary>@comment.Path · @comment.Author@(comment.InReplyToId is null ? " · Inline comment" : " · Discussion reply")</summary>
                                <RecordedMarkdown Text="@comment.Body" /><p class="meta-text">Original commented revision: <RevisionLink Sha="@comment.OriginalHead" Repository="@_repoUrl" />. The excerpt is GitHub’s recorded diff context; no correction is inferred.</p>
                                <pre class="task-source" tabindex="0" aria-label="Recorded diff context; scroll horizontally for long lines"><code>@comment.DiffHunk</code></pre>
                                @if (SafeReviewUrl(comment.Url) is { } commentUrl) { <a href="@commentUrl" target="_blank" rel="noopener">Open exact GitHub discussion ↗</a> }
                            </details>
                        }
                        @if (SafeReviewUrl(native.Url) is { } nativeUrl) { <a href="@nativeUrl" target="_blank" rel="noopener">Original GitHub review ↗</a> }
                    </article>
                }
                </section>
            }
            @foreach (var sourceNote in _legacyNotes) { <p class="meta-text">@sourceNote</p> }
            @if (_legacyReviews.Count > 0)
            {
                var review = _legacyReviews[Math.Clamp(_legacyIndex, 0, _legacyReviews.Count - 1)];
                <section class="card"><label>Review decision <select @bind="_legacyIndex" @bind:after="ResetLegacyCode">@for (var i = 0; i < _legacyReviews.Count; i++) { <option value="@i">Review @_legacyReviews[i].Round · @DecisionLabel(_legacyReviews[i].Verdict)</option> }</select></label>
                    <div class="task-review-heading"><h2>@DecisionLabel(review.Verdict)</h2><span>Published by @review.Reviewer · @FmtDate(review.SubmittedAt)</span></div>
                    <p class="meta-text">Historical assessment from a PR comment. Its author is shown above; this was not a formal GitHub review.</p>
                    <p>Reviewed revision: <RevisionLink Sha="@review.HeadSha" Repository="@_repoUrl" /></p>
                    <RecordedMarkdown Text="@ReviewProse.Legacy(review.Summary, review.Round, review.Verdict)" />
                    @foreach (var finding in review.Findings)
                    {
                        var excerpt = _laterCode ? finding.LaterCode : finding.ReportedCode;
                        <article class="task-finding"><h3>@finding.Path · lines @finding.Line–@finding.EndLine</h3><p class="meta-text">@finding.VerificationNote</p>
                            <div class="task-controls"><button class="btn @(!_laterCode ? "btn--primary" : "")" @onclick="() => _laterCode = false">Reported code</button>
                                @if (finding.LaterCode is not null) { <button class="btn @(_laterCode ? "btn--primary" : "")" @onclick="() => _laterCode = true">Later reviewed revision</button> }
                            </div>
                            @if (excerpt is not null) { <p class="meta-text"><RevisionLink Sha="@excerpt.HeadSha" Repository="@_repoUrl" /> · excerpt lines @excerpt.Line–@excerpt.EndLine</p><pre class="task-source" tabindex="0" aria-label="Verified source excerpt; scroll horizontally for long lines"><code>@CodeLines(excerpt)</code></pre><a href="@excerpt.Url" target="_blank" rel="noopener">Open verified source ↗</a> }
                            else { <p>Source excerpt unavailable.</p> }
                        </article>
                    }
                    <a href="@review.Url" target="_blank" rel="noopener">Original PR comment ↗</a>
                </section>
            }
            @if (ReviewHistory.Count > 0)
            {
                var history = ReviewHistory;
                var selected = history[Math.Clamp(_reviewIndex, 0, history.Count - 1)];
                <section class="card"><label>Review decision <select @bind="_reviewIndex">@for (var i = 0; i < history.Count; i++) { <option value="@i">Review @history[i].Round · @DecisionLabel(history[i].Verdict)</option> }</select></label>
                    <div class="task-review-heading"><h2>@DecisionLabel(selected.Verdict)</h2><span>@(selected.Reviewer ?? "Reviewer not recorded") · @FmtDate(selected.SubmittedAt)</span></div>
                    <p class="meta-text">Reviewed revision <RevisionLink Sha="@selected.HeadSha" Repository="@_repoUrl" /></p><RecordedMarkdown Text="@ReviewProse.Format(selected.Summary, true)" />
                    @foreach (var finding in selected.Findings ?? [])
                    {
                        <article class="task-finding"><h3>@finding.Path · line @finding.Line</h3><RecordedMarkdown Text="@finding.Body" />
                            @if (FindingUrl(selected.HeadSha, finding.Path, finding.Line, finding.Side) is { } location) { <a href="@location" target="_blank" rel="noopener">Open code at reviewed revision ↗</a> }
                            else { <p class="meta-text">Use the original review to inspect this diff location.</p> }
                        </article>
                    }
                    @if (SafeReviewUrl(selected.Url) is { } reviewUrl) { <a href="@reviewUrl" target="_blank" rel="noopener">Original GitHub review ↗</a> }
                    <p class="meta-text">Decisions apply to the recorded revision. A later approval does not establish the resolution of each earlier finding.</p>
                </section>
            }
            else if (_legacyReviews.Count == 0 && _nativeReviews.Count == 0)
            {
            <section class="card"><div class="task-review-heading"><h2>@ReviewLabel</h2><span class="meta-text">Forge reviewer · @(Meta("reviewRound") is { } round ? $"Review {round}" : "Review number not recorded")</span></div>
                <dl class="task-facts"><dt>Revision</dt><dd><RevisionLink Sha="@Meta("reviewSha")" Repository="@_repoUrl" /></dd><dt>Source</dt><dd>Forge’s recorded verdict. See the PR for formal GitHub decisions and inline discussions.</dd></dl>
                @if (Meta("reviewSha") is { } reviewed && Meta("branchSha") is { } head && reviewed != head) { <p class="banner banner--warn">This decision applies to an earlier revision. The current revision needs its own review.</p> }
                @if (Meta("reviewNotes") is { Length: > 0 } notes) { <RecordedMarkdown Text="@ReviewProse.Format(notes, true)" /> }
                else { <p class="meta-text">No reviewer notes recorded.</p> }
                @if (Meta("reworkContext") is { Length: > 0 } feedback) { <details><summary>Requested change and worker context</summary><RecordedMarkdown Text="@feedback" /></details> }
                <p class="meta-text">Earlier decisions and run outcomes are retained in History &amp; runs. Missing file anchors are not inferred from prose.</p>
            </section>
            }
        }
        else if (_section == "Plan & checks")
        {
            <section class="card"><h2>Recorded implementation plan</h2>
                @if (Prop(_task, "status") is "Completed" or "Closed") { <p class="meta-text">This is the historical planning decision. It does not describe a current run or establish delivery.</p> }
                @if (_delivery?.ExistingSource is not null) { <p>Existing code satisfied the approved criteria through independent verification and review. No new implementation is implied by this plan record.</p> }
                @if (PlanGate is { } pg)
                {
                    <p>@(pg.Approved ? "Execution allowed" : pg.Failed ? "Plan rejected" : "Plan awaiting decision") · @pg.Revisions revision(s)</p>
                    <div class="task-checks">@foreach (var v in pg.Verdicts) { <div><strong>@WorkPresentation.GateName(v.Gate)</strong><span class="@(WorkPresentation.GateWarning(v.Feedback) ? "task-warning" : "")">@(WorkPresentation.GateWarning(v.Feedback) ? "Allowed with warning" : v.Outcome == "Approve" ? "Passed" : v.Outcome)</span><p>@v.Feedback</p></div> }</div>
                    <div class="task-plan-sections">@foreach (var part in WorkPresentation.PlanSections(pg.Plan)) { <section><h3>@part.Heading</h3><RecordedMarkdown Text="@part.Body" /></section> }</div>
                    @if (pg.Plan is { Length: > 0 }) { <details><summary>Original plan</summary><pre class="task-source">@pg.Plan</pre></details> }
                }
                else { <p class="meta-text">No signed-off plan recorded.</p> }
                @if (Meta("qaVerdict") is { } qa) { <h3>QA verification · @qa</h3><RecordedMarkdown Text="@Meta("qaNotes")" /> }
            </section>
        }
        else
        {
            <section class="card"><h2>Worker and agent runs</h2>@if (_activityLoading) { <p role="status">Loading task activity…</p> }<p class="meta-text">Agent completion is a model-run outcome. Verification, publication and delivery are separate recorded events.</p>
                @if (_workerError is not null) { <p class="banner banner--error">Couldn’t load worker attempts: @_workerError</p> }
                @if (_workers.Count > 0)
                {
                    <h3>Worker attempts</h3><p class="meta-text">Latest 100 attempts. Earlier agent runs without an attempt association remain below.</p>
                    <div class="task-run-list">@foreach (var worker in _workers) { <article><div><strong>@worker.Outcome</strong><span>@WorkPresentation.Role(worker.Role)</span></div><p class="meta-text">@FmtDate(worker.CreatedAt) → @FmtDate(worker.UpdatedAt)</p><p>@(worker.VerificationRecorded ? "Verification receipt recorded" : "No verification receipt recorded")</p>
                        @if (worker.Phases is { } timing)
                        {
                            <dl class="task-facts">
                                @if (timing.QueueWakeup is { } queue)
                                {
                                    <dt>@queue.Label</dt>
                                    <dd>@Duration(queue.EventAt, queue.ObservedAdmissionAt) <span class="meta-text">Can include time waiting for dependencies or holds.</span></dd>
                                }
                                <dt>Dispatch admission to worker start</dt>
                                <dd>@(timing.EligibleAt is { } admitted && timing.WorkerStartedAt is { } started ? Duration(admitted, started) : "Not recorded")</dd>
                                <dt>Model &amp; tools</dt>
                                <dd>@PhaseDuration(timing.ModelStartedAt, timing.ModelCompletedAt, timing.ModelOutcome)</dd>
                                <dt>Verification</dt>
                                <dd>@PhaseDuration(timing.VerificationStartedAt, timing.VerificationCompletedAt, timing.VerificationOutcome)</dd>
                            </dl>
                        }
                        else { <p class="meta-text">Phase timings were not recorded for this attempt.</p> }
                        <details><summary>Attempt identifier</summary><code>@worker.Id</code></details></article> }</div>
                }
                @if (WaitDuration("humanReviewWait") is { } humanWait) { <dl class="task-facts"><dt>Human review wait</dt><dd>@humanWait <span class="meta-text">Measured from review-gate observations.</span></dd></dl> }
                @if (WaitDuration("reviewExternalWait") is { } externalWait) { <dl class="task-facts"><dt>GitHub merge requirement wait</dt><dd>@externalWait</dd></dl> }
                <h3>Agent runs</h3>
                @if (_runsError is not null) { <p class="banner banner--error" role="alert">Couldn’t load run history: @_runsError <button class="btn" @onclick="LoadAsync">Retry</button></p> }
                else if (!_activityLoading && _runs.Count == 0) { <p>No agent runs recorded.</p> }
                <div class="task-run-list">@foreach (var run in _runs) { <article><div><a href="@($"/runs/{Uri.EscapeDataString(run.Id)}{ProjectQuery(EffectiveProject)}")">@WorkPresentation.Role(run.Role)</a><strong>@WorkPresentation.RunOutcome(run.Status, run.Role)</strong></div><p class="meta-text">@run.StartedAt.ToLocalTime().ToString("MMM d, HH:mm:ss") · @(run.DurationMs is { } ms ? $"{TimeSpan.FromMilliseconds(ms).TotalSeconds:0}s model run" : "Duration not recorded")</p>@if (run.Error is { Length: > 0 }) { <details><summary>Run diagnostic</summary><RecordedMarkdown Text="@run.Error" /></details> }</article> }</div>
            </section>
            <section class="card"><h2>Task timeline</h2><p class="meta-text">Repeated identical observations are grouped; they are not separate fix attempts.</p>
                @if (_historyError is not null) { <p class="banner banner--error">Couldn’t load task history: @_historyError <button class="btn" @onclick="() => LoadHistoryAsync(false)">Retry</button></p> }
                @if (_historyCursor is not null) { <button class="btn" disabled="@_historyLoading" @onclick="() => LoadHistoryAsync(true)">Load earlier events</button> }
                <ol class="task-timeline">
                    @foreach (var g in GroupedEvents())
                    {
                        <li>
                            <div class="task-timeline-head"><strong>@WorkPresentation.EventName(g.Kind)</strong><time>@FmtDate(g.At)</time></div>
                            <p class="meta-text">@g.Actor</p>
                            @if (g.Kind == "sprint_activated" && !string.IsNullOrEmpty(g.Detail))
                            {
                                <a href="@SprintLinkFor(g.Detail)">@(g.Detail == Prop(_sprint, "id") ? Prop(_sprint, "name") ?? "Open sprint" : "Open sprint")</a>
                            }
                            else
                            {
                                <TaskEventDetail Detail="@g.Detail" />
                            }
                            @if (g.Count > 1) { <p class="meta-text">@g.Count observations · @FmtDate(g.FirstAt) to @FmtDate(g.At)</p> }
                            <details><summary>Event source</summary><code>@g.Kind</code></details>
                        </li>
                    }
                </ol>
                @if (!_historyLoading && _events.Count == 0) { <p>No events recorded.</p> }
            </section>
        }
    }
</div>
@code {
    private string? WaitDuration(string prefix)
    {
        var recorded = double.TryParse(Meta(prefix + "Seconds"), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var seconds) && double.IsFinite(seconds) && seconds >= 0;
        var active = DateTimeOffset.TryParse(Meta(prefix + "StartedAt"), out var start) && string.IsNullOrEmpty(Meta(prefix + "EndedAt"));
        if (!recorded && !active) return null;
        var total = (recorded ? seconds : 0) + (active ? Math.Max(0, (DateTimeOffset.UtcNow - start).TotalSeconds) : 0);
        return $"{total:0}s{(active ? " · still waiting at this refresh" : "")}";
    }

    private bool _legacyLoaded, _legacyLoading, _laterCode;
    private int _legacyIndex, _legacyGeneration;
    private string? _legacyError;
    private List<LegacyReview> _legacyReviews = [];
    private List<string> _legacyNotes = [];
    private sealed record CodeExcerpt(string HeadSha, string Path, int Line, int EndLine, string Code, string Url);
    private sealed record LegacyFinding(string Path, int Line, int EndLine, string Body, CodeExcerpt? ReportedCode, CodeExcerpt? LaterCode, string? VerificationNote);
    private sealed record LegacyReview(int Round, string? HeadSha, string Verdict, string Summary, string Reviewer, string Url, string SubmittedAt, List<LegacyFinding> Findings);
    private sealed record NativeComment(long Id, string Author, string Path, string Body, string DiffHunk, string Url, string? OriginalHead, long? InReplyToId);
    private sealed record NativeReview(long Id, string? HeadSha, string Verdict, string Summary, string Reviewer, string? Url, string? SubmittedAt, string Role, List<NativeComment> Comments);
    private List<NativeReview> _nativeReviews = [];
    private static string NativeDecisionLabel(string verdict) => verdict switch { "Approved" => "Approval recorded", "ChangesRequested" => "Changes requested at this review", "Dismissed" => "Dismissed review", "Commented" => "Advisory comments", "Pending" => "Pending review", _ => verdict };
    private sealed record LegacyPage(List<LegacyReview> Reviews, bool Limited, List<string> Notes, List<NativeReview>? NativeReviews = null);
    private static string CodeLines(CodeExcerpt excerpt) => string.Join('\n', excerpt.Code.Split('\n').Select((line, i) => $"{excerpt.Line + i,4}  {line}"));
    private void ResetLegacyCode() => _laterCode = false;
    private async Task SelectSectionAsync(string section)
    {
        _section = section;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("section", section), replace: true);
        if (section == "History & runs") await LoadActivityAsync();
        if (section == "Review" && !_legacyLoaded && !_legacyLoading) await LoadLegacyReviewsAsync();
    }
    private async Task LoadLegacyReviewsAsync()
    {
        var target = RecoveryTarget;
        var generation = ++_legacyGeneration;
        _legacyLoading = true; _legacyError = null;
        try
        {
            var data = await Http.GetFromJsonAsync<LegacyPage>($"/api/tasks/{Uri.EscapeDataString(TaskId)}/review-history?projectId={Uri.EscapeDataString(EffectiveProject ?? "")}");
            if (target != RecoveryTarget || generation != _legacyGeneration) return;
            _legacyReviews = data?.Reviews.OrderByDescending(r => r.Round).ToList() ?? [];
            _nativeReviews = data?.NativeReviews ?? [];
            _legacyNotes = data?.Notes ?? []; _legacyLoaded = true; _legacyIndex = 0;
        }
        catch (Exception ex) { if (target == RecoveryTarget && generation == _legacyGeneration) _legacyError = "Original review history could not be loaded: " + ex.Message; }
        finally { if (generation == _legacyGeneration) _legacyLoading = false; }
    }
    private int _reviewIndex;
    private static string DecisionLabel(string verdict) => verdict switch { "Approve" => "Approved", "RequestChanges" => "Changes requested", _ => verdict };
    private List<ReviewRecord> ReviewHistory
    {
        get
        {
            try { return JsonSerializer.Deserialize<List<ReviewRecord>>(Meta("reviewHistory") ?? "[]", new JsonSerializerOptions(JsonSerializerDefaults.Web))?.Where(r => !_nativeReviews.Any(n => SamePublishedReview(n.Url, r.Url))).OrderByDescending(r => r.Round).ToList() ?? []; }
            catch (JsonException) { return []; }
        }
    }
    private static bool SamePublishedReview(string? first, string? second) => !string.IsNullOrWhiteSpace(first) && !string.IsNullOrWhiteSpace(second) && string.Equals(first.TrimEnd('/'), second.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
    private string? FindingUrl(string? sha, string? path, int line, string? side)
    {
        if (_repoUrl is null || side == "LEFT" || line < 1 || string.IsNullOrWhiteSpace(path)
            || !System.Text.RegularExpressions.Regex.IsMatch(sha ?? "", "^[a-fA-F0-9]{40}$")) return null;
        return _repoUrl.TrimEnd('/') + "/blob/" + sha + "/" + string.Join('/', path.Split('/').Select(Uri.EscapeDataString)) + "#L" + line;
    }
    private static string? SafeReviewUrl(string? url) => Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme == "https" ? url : null;
    private sealed record ReviewRecord(int Round, string? HeadSha, string Verdict, string? Summary, string? Reviewer, string? Url, string? SubmittedAt, List<FindingRecord>? Findings);
    private sealed record FindingRecord(string? Path, int Line, string? Side, string? Body);
    private string _section = "Overview";
    private string? _runsError, _holdError;
    private bool _holdSaving, _historyLoading;
    private bool _explicitHumanHold, _holdLoaded;
    private string? _humanPolicy;
    private string? _historyCursor, _historyError;
    private string? _workerError;
    private List<WorkerSummary> _workers = [];
    private sealed record WorkerSummary(string Id, string Role, string State, string CreatedAt, string UpdatedAt, bool VerificationRecorded, string? Outcome, PhaseTimes? Phases);
    private sealed record PhaseTimes(
        DateTimeOffset? ModelStartedAt,
        DateTimeOffset? ModelCompletedAt,
        DateTimeOffset? VerificationStartedAt,
        DateTimeOffset? VerificationCompletedAt,
        DateTimeOffset? EligibleAt = null,
        DateTimeOffset? WorkerStartedAt = null,
        string? ModelOutcome = null,
        string? VerificationOutcome = null,
        QueueObservation? QueueWakeup = null);

    private sealed record QueueObservation(string Cause, DateTimeOffset EventAt, DateTimeOffset ObservedAdmissionAt)
    {
        public string Label => Cause switch
        {
