            if (earlier) _events.InsertRange(0, events); else _events = events;
            _historyCursor = Prop(data, "nextCursor"); _historyError = null;
        }
        catch (Exception ex) { if (target == RecoveryTarget && generation == _activityGeneration) _historyError = ex.Message; }
        finally { if (generation == _activityGeneration) _historyLoading = false; }
