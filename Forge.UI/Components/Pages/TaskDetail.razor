@page "/tasks/{TaskId}"
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject HttpClient Http
@inject NavigationManager Nav
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Task @TaskId</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>
            <button class="btn btn--link" @onclick="@(() => Nav.NavigateTo("/sprints"))">← Sprints</button>
            <button class="btn btn--link" @onclick="@(() => Nav.NavigateTo("/backlog"))">Backlog</button>
            @(Prop(_task, "title") ?? TaskId)
        </h1>
        <div class="page-header__actions">
            <a class="btn" href="/flow?issue=@TaskId">View in flow</a>
            @if (Prop(_task, "status") is "Failed" or "Blocked" or "InProgress")
            {
                <button class="btn" disabled="@_resetting" @onclick="ResetStrikesAsync"
                        title="Clear all strike counters (rework, review, no-progress, auto-resume), refresh the stale window, and requeue if Failed/Blocked">
                    @(_resetting ? "Resetting…" : "Clear strikes & requeue")
                </button>
            }
            @if (Prop(_task, "status") is not ("Completed" or "Closed") && Prop(_task, "status") is not null)
            {
                <button class="btn" disabled="@_closing" @onclick="@(() => _closeOpen = !_closeOpen)"
                        title="Retire this task outright — work already on main via another task, superseded, won't-fix. Optionally closes the linked PR unmerged.">
                    Close task…
                </button>
            }
            <button class="btn btn--primary" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (_closeOpen)
    {
        <div class="card" style="margin-bottom:14px">
            <div class="page-subtitle" style="margin-bottom:8px">Close task as obsolete / won't-fix</div>
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap">
                <input class="mono" style="flex:1; min-width:280px; background:var(--surface-1); border:1px solid var(--outline); color:var(--on-surface); padding:6px 8px; border-radius:var(--radius-md)"
                       placeholder="Reason (audit trail) — e.g. obsolete: task-351's 1939d2e on main already carries the fix"
                       @bind="_closeReason" />
                <label style="display:flex; gap:6px; align-items:center">
                    <input type="checkbox" @bind="_closePr" />
                    <span class="meta-text">also close linked PR unmerged</span>
                </label>
                <button class="btn btn--primary" disabled="@(_closing || string.IsNullOrWhiteSpace(_closeReason))" @onclick="CloseTaskAsync">
                    @(_closing ? "Closing…" : "Confirm close")
                </button>
                <button class="btn" @onclick="@(() => _closeOpen = false)">Cancel</button>
            </div>
            @if (_closeResult is not null)
            {
                <div class="meta-text" style="margin-top:8px">@_closeResult</div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="banner banner--error"><span>@_error</span></div>
    }
    @if (_task is null && _error is null)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else
    {
        <div class="card" style="margin-bottom:14px">
            <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap">
                <span class="pill pill--@StatusCss">@Prop(_task, "status")</span>
                @if (_state is not null)
                {
                    <span class="pill pill--primary">@_state.State@(_state.Substate is not null ? $" · {_state.Substate}" : "")</span>
                    <span class="meta-text">waiting on: @_state.WaitingOn</span>
                    @if (_state.Strikes > 0)
                    {
                        <span class="pill pill--blocked">@_state.Strikes/@_state.MaxStrikes strikes</span>
                    }
                }
                @if (Meta("reviewStartedAt") is not null)
                {
                    <span class="pill pill--info">reviewing…</span>
                }
                else if (IsReviewPending)
                {
                    <span class="pill pill--info">review pending</span>
                }
                <span class="mono">@Prop(_task, "type")</span>
                <span class="mono">@TaskId</span>
                <span class="mono">priority @Prop(_task, "priority")</span>
                @if (Prop(_task, "assignee") is { } assignee)
                {
                    <span class="mono">@assignee</span>
                }
                @if (Prop(_task, "dispatchCheckpoint") is { } cp)
                {
                    <span class="mono">checkpoint: @cp</span>
                }
                @if (Prop(_task, "parentIssueId") is { } parent)
                {
                    <a href="/tasks/@parent" class="mono">parent: @parent</a>
                }
            </div>
        </div>

        <div class="card" style="margin-bottom:14px">
            <h2>Links & state</h2>
            <table class="data-grid">
                <tbody>
                    @if (Meta("prNumber") is { } pr && PrUrl(pr) is { } url)
                    {
                        <tr><td>Pull request</td><td><a href="@url" target="_blank" rel="noopener">PR #@pr</a></td></tr>
                    }
                    @if (Meta("branch") is { } branch)
                    {
                        <tr><td>Branch</td><td class="mono">@branch</td></tr>
                    }
                    @if (Meta("worktreePath") is { } wt)
                    {
                        <tr><td>Worktree</td><td class="mono">@wt</td></tr>
                    }
                    @if (Meta("reworkAttempts") is { } attempts)
                    {
                        <tr><td>Rework</td><td><span class="pill pill--blocked">R@(attempts)</span> @(Meta("reworkReason") ?? "")</td></tr>
                    }
                    @if (Meta("reworkContext") is { } reworkCtx)
                    {
                        <tr><td>Rework context</td><td><pre class="mono" style="white-space:pre-wrap; max-height:160px; overflow:auto">@reworkCtx</pre></td></tr>
                    }
                    @if (Meta("reviewVerdict") is not null || Meta("reviewSha") is not null)
                    {
                        var reviewVerdict = Meta("reviewVerdict");
                        <tr>
                            <td>Review</td>
                            <td>
                                @if (reviewVerdict is not null)
                                {
                                    <span class="pill pill--@(reviewVerdict == "Approve" ? "success" : reviewVerdict == "RequestChanges" ? "blocked" : "warn")">
                                        @(reviewVerdict == "Approve" ? "approved" : reviewVerdict == "RequestChanges" ? "changes requested" : reviewVerdict.ToLowerInvariant())
                                    </span>
                                }
                                else
                                {
                                    <span class="pill">pending</span>
                                }
                                @if (Meta("reviewRound") is { } reviewRound)
                                {
                                    <span class="pill pill--blocked">R@(reviewRound)</span>
                                }
                                @if (Meta("reviewSha") is { } reviewSha)
                                {
                                    <span class="mono meta-text">@("@")@reviewSha.Substring(0, Math.Min(7, reviewSha.Length))</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Meta("reviewNotes") is { Length: > 0 } reviewNotes)
                    {
                        <tr><td>Review notes</td><td><pre class="mono" style="white-space:pre-wrap; max-height:160px; overflow:auto">@reviewNotes</pre></td></tr>
                    }
                    @if (PlanGate is { } pg)
                    {
                        <tr>
                            <td>Plan gate</td>
                            <td>
                                @if (pg.Approved)
                                {
                                    <span class="pill pill--success">approved</span>
                                }
                                else if (pg.Failed)
                                {
                                    <span class="pill pill--blocked">rejected</span>
                                }
                                else
                                {
                                    <span class="pill">pending</span>
                                }
                                @if (pg.FastPath) { <span class="pill">fast-path</span> }
                                <span class="meta-text"> @pg.Revisions revision(s)</span>
                            </td>
                        </tr>
                        @foreach (var v in pg.Verdicts)
                        {
                            <tr>
                                <td class="meta-text">gate: @v.Gate</td>
                                <td><span class="pill pill--@(v.Outcome == "Approve" ? "success" : "blocked")">@v.Outcome</span> <span class="meta-text">@v.Feedback</span></td>
                            </tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(pg.Plan))
                        {
                            <tr><td>Plan</td><td><pre class="mono" style="white-space:pre-wrap; max-height:220px; overflow:auto">@pg.Plan</pre></td></tr>
                        }
                    }
                    @if (Meta("triageAction") is { Length: > 0 } triageAction)
                    {
                        <tr>
                            <td>Triage</td>
                            <td>
                                <span class="pill pill--@TriageTone(triageAction)">@triageAction</span>
                                @if (Meta("triageActionAt") is { Length: > 0 } at)
                                {
                                    <span class="meta-text"> @at</span>
                                }
                            </td>
                        </tr>
                        @if (Meta("triageNote") is { Length: > 0 } triageNote)
                        {
                            <tr><td class="meta-text">triage note</td><td><pre class="mono" style="white-space:pre-wrap; max-height:160px; overflow:auto">@triageNote</pre></td></tr>
                        }
                    }
                    @if (_sprint is not null)
                    {
                        <tr>
                            <td>Sprint</td>
                            <td>
                                <a href="/sprints">@Prop(_sprint, "name")</a>
                                <span class="pill pill--@Prop(_sprint, "status")?.ToLowerInvariant()">@Prop(_sprint, "status")</span>
                            </td>
                        </tr>
                    }
                    <tr><td>Created</td><td class="mono">@FmtDate(Prop(_task, "createdAt"))</td></tr>
                    <tr><td>Updated</td><td class="mono">@FmtDate(Prop(_task, "updatedAt"))</td></tr>
                    @if (Prop(_task, "closedAt") is { } closed)
                    {
                        <tr><td>Closed</td><td class="mono">@FmtDate(closed)</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Prop(_task, "description") is { Length: > 0 } desc)
        {
            <div class="card" style="margin-bottom:14px">
                <h2>Description</h2>
                <pre class="mono" style="white-space:pre-wrap; max-height:240px; overflow:auto">@desc</pre>
            </div>
        }

        <div class="card" style="margin-bottom:14px">
            <h2>Agent runs (@_runs.Count)</h2>
            @if (_runs.Count == 0)
            {
                <p class="hint">No agent runs recorded for this task yet.</p>
            }
            else
            {
                <table class="data-grid">
                    <thead>
                        <tr><th>Status</th><th>Started</th><th>Duration</th><th>Progress</th><th>Error</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _runs)
                        {
                            <tr>
                                <td>
                                    <span class="pill role-@r.Role.ToLowerInvariant()">@r.Role</span>
                                    <a href="@($"/runs/{r.Id}{ProjectQuery(r.ProjectId)}")">
                                        <span class="pill @(r.Status == "succeeded" ? "pill--completed" : r.Status == "running" ? "pill--inprogress" : "pill--failed")">@r.Status</span>
                                    </a>
                                    @if (r.ResumedSession == true)
                                    {
                                        <span class="pill pill--info">resumed</span>
                                    }
                                </td>
                                <td class="mono">@r.StartedAt.ToString("MM-dd HH:mm:ss")</td>
                                <td class="mono">@(r.DurationMs is null ? "…" : $"{TimeSpan.FromMilliseconds(r.DurationMs.Value).TotalSeconds:F0}s")</td>
                                <td class="mono">@(r.Phase is { Length: > 0 } p ? p + " · " : "")@(r.MessageCount ?? 0) msgs · @(r.ToolCallCount ?? 0) tools</td>
                                <td class="mono" style="font-size:11px; max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@r.Error">@(r.Error ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card">
            <h2>Timeline (@_events.Count events)</h2>
            @if (_events.Count == 0)
            {
                <p class="hint">No events recorded for this task yet.</p>
            }
            <table class="data-grid">
                <thead>
                    <tr><th>When</th><th>Kind</th><th>Detail</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in GroupedEvents())
                    {
                        <tr>
                            <td class="mono">@g.At</td>
                            <td class="mono">@g.Kind</td>
                            <td>
                                @g.Detail
                                @if (g.Count > 1)
                                {
                                    <span class="pill pill--blocked" title="@($"{g.Count} identical events, {g.FirstAt} → {g.At}")">×@g.Count</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static string FmtDate(string? iso) =>
        DateTime.TryParse(iso, out var d) ? d.ToString("yyyy-MM-dd HH:mm") : iso ?? "—";

    [Parameter] public string TaskId { get; set; } = "";
    // Cross-project links (the unified /now feed, alert inbox) carry
    // the item's OWNING project — it wins over the topbar lens (task
    // ids collide across projects).
    [Parameter][SupplyParameterFromQuery(Name = "project")] public string? Project { get; set; }

    private JsonElement? _task;
    private StateVm? _state;
    private JsonElement? _sprint;
    private List<EventVm> _events = new();
    private List<RunVm> _runs = new();
    private string? _repoUrl;
    private string? _error;

    private string StatusCss => Prop(_task, "status")?.ToLowerInvariant() ?? "unknown";

    // Collapse runs of identical events (kind + detail) into one row
    // with a ×N badge — a 429 storm otherwise renders as an
    // unreadable wall of duplicates (observed live on task-156).
    private IEnumerable<EventGroup> GroupedEvents()
    {
        EventGroup? cur = null;
        foreach (var e in _events)
        {
            if (cur is not null && cur.Kind == e.Kind && cur.Detail == e.Detail)
            {
                cur = cur with { At = e.At, Count = cur.Count + 1 };
                continue;
            }
            if (cur is not null) yield return cur;
            cur = new EventGroup(e.At, e.At, e.Kind, e.Detail, 1);
        }
        if (cur is not null) yield return cur;
    }

    private sealed record EventGroup(string FirstAt, string At, string Kind, string Detail, int Count);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var projectId = Project ?? ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/tasks/{TaskId}"
                : $"/api/tasks/{TaskId}?projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url);
            _task = doc;
            _sprint = doc.ValueKind == JsonValueKind.Object && doc.TryGetProperty("sprint", out var sp) && sp.ValueKind == JsonValueKind.Object
                ? sp : null;
            _events = doc.TryGetProperty("events", out var evs)
                ? evs.EnumerateArray().Select(e => new EventVm(
                    Prop(e, "at") ?? "", Prop(e, "kind") ?? "", Prop(e, "detail") ?? "")).ToList()
                : new List<EventVm>();
            _events.Reverse(); // API returns newest-first; show oldest-first

            // Derived lifecycle state (what it's doing + waiting on).
            try
            {
                var stateUrl = string.IsNullOrEmpty(projectId)
                    ? $"/api/tasks/{TaskId}/state"
                    : $"/api/tasks/{TaskId}/state?projectId={Uri.EscapeDataString(projectId)}";
                var sd = await Http.GetFromJsonAsync<JsonElement>(stateUrl);
                _state = new StateVm(
                    Prop(sd, "state") ?? "", Prop(sd, "substate"), Prop(sd, "waitingOn") ?? "",
                    sd.TryGetProperty("strikes", out var st) && st.TryGetInt32(out var si) ? si : 0,
                    sd.TryGetProperty("maxStrikes", out var ms) && ms.TryGetInt32(out var msi) ? msi : 3);
            }
            catch { _state = null; /* state is additive */ }

            // Agent runs for this task (the "who worked on this and
            // what did they actually do" trail). Same shape as /runs.
            try
            {
                var runsUrl = string.IsNullOrEmpty(projectId)
                    ? $"/api/agent-runs?taskId={Uri.EscapeDataString(TaskId)}"
                    : $"/api/agent-runs?taskId={Uri.EscapeDataString(TaskId)}&projectId={Uri.EscapeDataString(projectId)}";
                var runsDoc = await Http.GetFromJsonAsync<JsonElement>(runsUrl);
                var runs = new List<RunVm>();
                foreach (var bucket in new[] { "active", "recent" })
                {
                    if (runsDoc.TryGetProperty(bucket, out var arr))
                    {
                        foreach (var r in arr.EnumerateArray())
                        {
                            runs.Add(new RunVm(
                                Id: Prop(r, "id") ?? "",
                                Role: Prop(r, "role") ?? "",
                                ProjectId: Prop(r, "projectId"),
                                Status: Prop(r, "status") ?? "",
                                StartedAt: DateTime.TryParse(Prop(r, "startedAt"), out var sa) ? sa : DateTime.MinValue,
                                FinishedAt: DateTime.TryParse(Prop(r, "finishedAt"), out var fa) ? fa : null,
                                LastActivityAt: DateTime.TryParse(Prop(r, "lastActivityAt"), out var la) ? la : null,
                                DurationMs: long.TryParse(Prop(r, "durationMs"), out var dm) ? dm : null,
                                MessageCount: int.TryParse(Prop(r, "messageCount"), out var mc) ? mc : null,
                                ToolCallCount: int.TryParse(Prop(r, "toolCallCount"), out var tc) ? tc : null,
                                Error: Prop(r, "error"),
                                Phase: Prop(r, "phase"),
                                ResumedSession: r.TryGetProperty("resumedSession", out var rs) && rs.ValueKind == JsonValueKind.True));
                        }
                    }
                }
                // "Last run" = latest OUTCOME, not latest start — a
                // review that started before a dev run but failed
                // after it succeeded is the more recent event.
                _runs = runs.OrderByDescending(r => r.FinishedAt ?? r.LastActivityAt ?? r.StartedAt).ToList();
            }
            catch { /* runs are additive — never break the task page */ }
            if (_repoUrl is null && !string.IsNullOrEmpty(projectId))
            {
                var projects = await Http.GetFromJsonAsync<JsonElement>("/api/projects");
                foreach (var p in projects.EnumerateArray())
                {
                    if (string.Equals(Prop(p, "id"), projectId, StringComparison.OrdinalIgnoreCase))
                    {
                        _repoUrl = Prop(p, "repoUrl")?.TrimEnd('/');
                        break;
                    }
                }
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string ProjectQuery(string? projectId) =>
        projectId is null ? "" : $"?project={Uri.EscapeDataString(projectId)}";

    private bool _resetting;

    /// <summary>Operator recovery nudge: clear every strike counter
    /// and requeue (POST /api/tasks/{id}/reset-strikes).</summary>
    private async Task ResetStrikesAsync()
    {
        _resetting = true;
        try
        {
            var projectId = Project ?? ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/tasks/{TaskId}/reset-strikes"
                : $"/api/tasks/{TaskId}/reset-strikes?projectId={Uri.EscapeDataString(projectId)}";
            var resp = await Http.PostAsync(url, content: null);
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"strike reset failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _resetting = false; }
        await LoadAsync();
    }

    private bool _closeOpen;
    private bool _closing;
    private bool _closePr = true;
    private string? _closeReason;
    private string? _closeResult;

    /// <summary>Operator close-obsolete (POST /api/tasks/{id}/close):
    /// retires the task; optionally closes the linked PR unmerged.</summary>
    private async Task CloseTaskAsync()
    {
        _closing = true;
        _closeResult = null;
        try
        {
            var projectId = Project ?? ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/tasks/{TaskId}/close"
                : $"/api/tasks/{TaskId}/close?projectId={Uri.EscapeDataString(projectId)}";
            var resp = await Http.PostAsJsonAsync(url, new { reason = _closeReason, closePr = _closePr });
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
                var prClosed = body.TryGetProperty("prClosed", out var pc) && pc.ValueKind == JsonValueKind.True;
                var prErr = body.TryGetProperty("prCloseError", out var pe) && pe.ValueKind == JsonValueKind.String ? pe.GetString() : null;
                _closeResult = prClosed ? "Task closed; PR closed unmerged."
                    : prErr is not null ? $"Task closed; PR close failed: {prErr}"
                    : "Task closed.";
                _closeOpen = false;
            }
            else
            {
                _closeResult = $"close failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _closeResult = ex.Message; }
        finally { _closing = false; }
        await LoadAsync();
    }

    private string? Meta(string key)
    {
        if (_task is null || _task.Value.ValueKind != JsonValueKind.Object) return null;
        if (!_task.Value.TryGetProperty("metadata", out var m) || m.ValueKind != JsonValueKind.Object) return null;
        return Prop(m, key);
    }

    private string? PrUrl(string prNumber) =>
        _repoUrl is null ? null : $"{_repoUrl}/pull/{prNumber}";

    private static string TriageTone(string action) => action switch
    {
        "requeue" => "success",
        "parked" => "blocked",
        "flag-bug" => "warn",
        _ => "outline",
    };

    private PlanGateVm? PlanGate
    {
        get
        {
            var raw = Meta("planGate");
            if (string.IsNullOrWhiteSpace(raw)) return null;
            try
            {
                using var doc = JsonDocument.Parse(raw);
                var r = doc.RootElement;
                var verdicts = new List<PlanGateVerdictVm>();
                if (r.TryGetProperty("verdicts", out var vs) && vs.ValueKind == JsonValueKind.Array)
                {
                    foreach (var v in vs.EnumerateArray())
                    {
                        verdicts.Add(new PlanGateVerdictVm(
                            Prop(v, "gate") ?? "", Prop(v, "outcome") ?? "", Prop(v, "feedback") ?? ""));
                    }
                }
                return new PlanGateVm(
                    Approved: r.TryGetProperty("approved", out var ap) && ap.GetBoolean(),
                    Failed: r.TryGetProperty("failed", out var f) && f.GetBoolean(),
                    FastPath: r.TryGetProperty("fastPath", out var fp) && fp.GetBoolean(),
                    Revisions: r.TryGetProperty("revisions", out var rv) ? rv.GetInt32() : 0,
                    Plan: Prop(r, "plan"),
                    Verdicts: verdicts);
            }
            catch { return null; }
        }
    }

    private sealed record PlanGateVerdictVm(string Gate, string Outcome, string Feedback);
    private sealed record PlanGateVm(bool Approved, bool Failed, bool FastPath, int Revisions, string? Plan, List<PlanGateVerdictVm> Verdicts);

    private static string? Prop(JsonElement? e, string name)
    {
        if (e is null || e.Value.ValueKind != JsonValueKind.Object) return null;
        if (!e.Value.TryGetProperty(name, out var v)) return null;
        return v.ValueKind switch
        {
            JsonValueKind.String => v.GetString(),
            JsonValueKind.Null => null,
            _ => v.ToString(),
        };
    }

    private sealed record EventVm(string At, string Kind, string Detail);

    private sealed record StateVm(string State, string? Substate, string WaitingOn, int Strikes, int MaxStrikes);

    private sealed record RunVm(string Id, string Role, string? ProjectId, string Status, DateTime StartedAt,
        DateTime? FinishedAt, DateTime? LastActivityAt,
        long? DurationMs, int? MessageCount, int? ToolCallCount, string? Error,
        string? Phase, bool? ResumedSession);

    /// <summary>"Awaiting review": the task has an open PR but no
    /// verdict against the current pushed head (branchSha) yet. The
    /// "reviewing…" marker (reviewStartedAt) takes precedence and is
    /// rendered separately.</summary>
    private bool IsReviewPending
    {
        get
        {
            var status = Prop(_task, "status");
            if (status is not ("InProgress" or "Pending")) return false;
            if (Meta("prNumber") is null) return false;
            var verdict = Meta("reviewVerdict");
            var reviewedSha = Meta("reviewSha");
            var headSha = Meta("branchSha");
            if (string.IsNullOrEmpty(verdict)) return true;
            return headSha is not null && !string.Equals(reviewedSha, headSha, StringComparison.Ordinal);
        }
    }
}
