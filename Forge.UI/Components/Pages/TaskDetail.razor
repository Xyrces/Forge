    private bool _resetting;
    private int _retryGeneration;
    private string? _retryError;
    private sealed record RetryFailure(string? Error, string? Detail);
    private async Task RetryAsync()
    {
        if (!CanActOnLoadedTask || _resetting) return;
        var generation = ++_retryGeneration;
        _resetting = true;
        _retryError = null;
        try
        {
            var projectId = Project ?? ShellStore.Value.CurrentProjectId;
            var retryAction = Meta("blockedKind") == "review-integration" ? "requeue" : "reset-strikes";
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/tasks/{TaskId}/{retryAction}"
                : $"/api/tasks/{TaskId}/{retryAction}?projectId={Uri.EscapeDataString(projectId)}";
            using var resp = await Http.PostAsync(url, content: null);
            if (!resp.IsSuccessStatusCode)
            {
                var message = $"Retry failed (HTTP {(int)resp.StatusCode}).";
                if (resp.Content.Headers.ContentType?.MediaType?.Contains("json", StringComparison.OrdinalIgnoreCase) is true)
                {
                    var reason = await resp.Content.ReadFromJsonAsync<RetryFailure>();
                    message = $"Retry failed. {reason?.Error ?? reason?.Detail ?? resp.ReasonPhrase}";
                }
                if (generation == _retryGeneration) _retryError = message;
            }
        }
        catch (Exception ex)
        {
            if (generation == _retryGeneration) _retryError = "Couldn’t confirm the retry. " + ex.Message;
        }
        finally { if (generation == _retryGeneration) _resetting = false; }
        if (generation == _retryGeneration) await LoadAsync();
    }

    private bool _closeOpen;
    private bool _closing;
    private bool _closePr = true;
    private string? _closeReason;
    private string? _closeResult;

    /// <summary>Operator close-obsolete (POST /api/tasks/{id}/close):
    /// retires the task; optionally closes the linked PR unmerged.</summary>
    private async Task CloseTaskAsync()
    {
        if (!CanActOnLoadedTask) return;
        _closing = true;
        _closeResult = null;
        try
        {
            var projectId = Project ?? ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/tasks/{TaskId}/close"
                : $"/api/tasks/{TaskId}/close?projectId={Uri.EscapeDataString(projectId)}";
            var resp = await Http.PostAsJsonAsync(url, new { reason = _closeReason, closePr = _closePr });
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<JsonElement>();
                var prClosed = body.TryGetProperty("prClosed", out var pc) && pc.ValueKind == JsonValueKind.True;
                var prErr = body.TryGetProperty("prCloseError", out var pe) && pe.ValueKind == JsonValueKind.String ? pe.GetString() : null;
                _closeResult = prClosed ? "Task closed; PR closed unmerged."
                    : prErr is not null ? $"Task closed; PR close failed: {prErr}"
                    : "Task closed.";
                _closeOpen = false;
            }
            else
            {
                _closeResult = $"close failed: {(int)resp.StatusCode} {await resp.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex) { _closeResult = ex.Message; }
        finally { _closing = false; }
        await LoadAsync();
    }

