        {
            var url = $"/api/tasks/{Uri.EscapeDataString(TaskId)}/history?projectId={Uri.EscapeDataString(EffectiveProject ?? "")}" + (earlier && _historyCursor is not null ? "&cursor=" + Uri.EscapeDataString(_historyCursor) : "");
            var data = await Http.GetFromJsonAsync<JsonElement>(url, token);
