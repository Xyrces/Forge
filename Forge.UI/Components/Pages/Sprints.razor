@page "/sprints"
@inject IState<Forge.Dashboard.Features.View.ViewState> ViewStore
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject Fluxor.IDispatcher Dispatch
@inject HttpClient Http
@inject NavigationManager Nav
@inject Forge.Dashboard.Services.DashboardEventStream Events
@using System.Net.Http.Json
@using System.Text.Json
@implements IDisposable
@using Forge.Dashboard.Features.View

<PageTitle>Sprints</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Sprints</h1>
        <div class="page-header__meta">@ViewStore.Value.Sprints.Count total · @ViewStore.Value.Sprints.Count(s => s.Status == "Active") active@(ViewStore.Value.Refreshing ? " · updating…" : "")</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="@(() => Dispatch.Dispatch(new ViewActions.LoadViewAction(ShellStore.Value.CurrentProjectId, Background: true)))">Refresh</button>
        </div>
    </div>

    @* Operator stage gates: read-only status here — the canonical
       editing surface is the Flow page Edit mode (one setting, one
       place; operator rule 2026-07-24). *@
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
        <span class="page-subtitle" style="margin-right:4px">Stage gates:</span>
        @foreach (var stage in _gateStages)
        {
            var held = _gates.TryGetValue(stage, out var s) && s == "hold";
            <span class="chip @(held ? "chip--active" : "")"
                  title="@(held ? $"Held — {stage} transitions are paused." : $"Open — {stage} runs automatically.")">
                @stage: @(held ? "held" : "open")
            </span>
        }
        <a href="/flow?mode=edit" class="page-subtitle">Edit on the Flow page →</a>
    </div>

    @if (ViewStore.Value.Loading)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (ViewStore.Value.Error is not null)
    {
        <div class="page-subtitle">Error: @ViewStore.Value.Error</div>
    }
    else if (ViewStore.Value.Sprints.Count == 0)
    {
        @* Sprint flow: there is intentionally NO create button — the
           SprintAssembler builds each sprint automatically when the
           previous one completes, from groomed (or ad-hoc) work. *@
        <div class="page-subtitle">No sprints yet. Sprints assemble automatically when groomed work becomes eligible.</div>
    }
    else
    {
        var sprints = ViewStore.Value.Sprints
            .OrderByDescending(s => s.Status == "Active")
            .ThenByDescending(s => s.StartDate)
            .ToList();
        var selected = SelectedSprint(sprints);

        @* Sprint picker: a proper dropdown — scales past a handful
           of sprints, type-ahead built in. (The old chip-per-sprint
           row wrapped forever; operator 2026-07-25: 'tags/pills as
           selectors is weird.') Active pinned first, then newest. *@
        <div class="picker-bar">
            <label class="picker-bar__label" for="sprint-picker">Sprint</label>
            <select id="sprint-picker" class="picker-bar__select"
                    value="@(selected?.Id ?? "")"
                    @onchange="@((ChangeEventArgs e) => _selectedSprintId = e.Value?.ToString())">
                @foreach (var sp in sprints)
                {
                    <option value="@sp.Id" selected="@(selected?.Id == sp.Id)">
                        @(sp.Status == "Active" ? "● " : "")@sp.Name — @sp.Status.ToLowerInvariant()@Dates(sp)
                    </option>
                }
            </select>
            <span class="meta-text">@sprints.Count total</span>
        </div>

        @* Inter-sprint build state (operator request 2026-08-06):
           between sprint.completed and the next sprint.started the
           assembler triages + materializes follow-ups and the groomer
           works through them — previously invisible, so a completed
           sprint looked stuck. The assembler snapshots the phase to
           the project store every tick; this panel renders it. *@
        @if (_build is { Phase: "awaiting-groom" or "held" or "idle" })
        {
            <div class="card" style="margin-bottom:14px">
                <div class="page-subtitle" style="margin-bottom:8px">
                    Next sprint — @BuildPhaseLabel(_build.Phase)
                </div>
                @if (_build.CompletedSprintName is not null)
                {
                    <div class="meta-text" style="padding:2px 0">Completed: @_build.CompletedSprintName</div>
                }
                <div class="meta-text" style="padding:2px 0">@_build.Reason</div>
                @if (_build.PendingGroom.Count > 0)
                {
                    <div class="page-subtitle" style="margin:8px 0 4px">In grooming (@_build.PendingGroom.Count):</div>
                    @foreach (var p in _build.PendingGroom)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0;cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/tasks/{p.Id}"))">
                            <span class="mono">@p.Id</span>
                            <span>@p.Title</span>
                            <span class="pill pill--pending">awaiting groom</span>
                        </div>
                    }
                }
                @if (_build.Groups.Count > 0)
                {
                    <div class="page-subtitle" style="margin:8px 0 4px">Up next once clear:</div>
                    @foreach (var g in _build.Groups)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0">
                            <span class="mono">P@(g.MinPriority)</span>
                            <span>@g.Name</span>
                            <span class="meta-text">@(g.Key == "Ad-hoc work" ? $"{g.TaskCount} solo sprint(s)" : $"{g.TaskCount} task(s)")</span>
                        </div>
                    }
                }
            </div>
        }

        @if (selected is not null)
        {
            var members = EnrichMembers(selected);
            var done = members.Count(m => Bucket(m) == "done");
            var pct = members.Count == 0 ? 0 : (int)Math.Round(100.0 * done / members.Count);

            <div class="sprint-hero">
                <div class="sprint-hero__top">
                    <span class="pill pill--@selected.Status.ToLowerInvariant()">@selected.Status</span>
                    <strong class="sprint-hero__name">@selected.Name</strong>
                    <span class="mono sprint-hero__dates">
                        @(selected.StartDate?.ToString("MMM d") ?? "")
                        @(selected.EndDate is not null ? $" → {selected.EndDate.Value:MMM d}" : "")
                    </span>
                    <span class="mono">@done/@members.Count tasks · @pct%</span>
                </div>
            @if (!string.IsNullOrEmpty(selected.Goal))
            {
                <div class="sprint-hero__goal">@selected.Goal</div>
            }
            <div class="sprint-progress"><div class="sprint-progress__fill" style="width:@pct%"></div></div>
        </div>

        @* Dispatch queue: the ready sprint members in claim order
           (blocker boost → priority → FIFO — the same ordering the
           dispatch loop consumes), with why each is or isn't running.
           Blocked tasks are absent by construction. *@
        @if (selected.Status == "Active")
        {
            <div class="card" style="margin-bottom:14px">
                <div class="page-subtitle" style="margin-bottom:8px">
                    Dispatch queue (@_queueTotal waiting) — claim order:
                </div>
                @if (_queueTotal == 0 && _blocked.Count == 0)
                {
                    <div class="meta-text" style="padding:2px 0">Nothing waiting to claim — every member is in flight, in review, or blocked.</div>
                }
                @if (_queueTotal == 0 && _blocked.Count > 0)
                {
                    <div class="meta-text" style="padding:2px 0">Nothing claimable right now — the remaining queued tasks are blocked (below).</div>
                }
                @foreach (var q in _queue)
                {
                    <div class="kanban__card-meta" style="padding:2px 0;cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/tasks/{q.Id}"))">
                        <span class="mono">#@q.Position</span>
                        <span class="mono">@q.Id</span>
                        <span class="mono">P@(q.Priority)</span>
                        <span class="mono meta-text">@q.Role</span>
                        @if (q.Boosted)
                        {
                            <span class="pill pill--blocked" title="Blocks open work — boosted to the front of the queue">blocker</span>
                        }
                        <span>@q.Title</span>
                        <span class="pill @WaitPill(q.Wait)" title="@q.Detail">@q.Wait</span>
                    </div>
                }
                @if (_queueTotal > _queue.Count)
                {
                    <div class="meta-text" style="padding:2px 0">+@(_queueTotal - _queue.Count) more</div>
                }
                @if (_blocked.Count > 0)
                {
                    <div class="page-subtitle" style="margin:8px 0 4px">Blocked — enters the queue when these land:</div>
                    @foreach (var b in _blocked)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0;cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/tasks/{b.Id}"))">
                            <span class="mono">@b.Id</span>
                            <span class="mono">P@(b.Priority)</span>
                            <span>@b.Title</span>
                            <span class="pill pill--blocked">blocked by @string.Join(", ", b.BlockedBy)</span>
                        </div>
                    }
                }
            </div>
        }

        @* Tracked follow-ups (operator model 2026-07-31): findings
           filed during the sprint — they materialize into tasks at
           completion, then groom before the next sprint. Read-only.
           Collapsible; collapsed by default. *@
        @if (selected.Status == "Active" && _drafts.Count > 0)
        {
            <div class="card" style="margin-bottom:14px">
                <div class="page-subtitle" style="margin-bottom:@(_draftsOpen ? "8px" : "0");cursor:pointer;user-select:none"
                     @onclick="@(() => _draftsOpen = !_draftsOpen)">
                    @(_draftsOpen ? "▾" : "▸") Tracked follow-ups (@_drafts.Count) — materialize when this sprint completes
                </div>
                @if (_draftsOpen)
                {
                    @foreach (var d in _drafts)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0">
                            <span class="mono">P@(d.Priority)</span>
                            <span>@d.Title</span>
                            <span class="meta-text">from @d.SourceIssueId (@d.SourceRole)</span>
                        </div>
                    }
                }
            </div>
        }

            @if (selected.Status != "Active")
            {
                <div class="page-subtitle" style="margin:8px 0">Viewing a past sprint (read-only).</div>
            }

            @* Scrum board: every task in the sprint, grouped by state. *@
            <div class="kanban">
                @foreach (var col in Columns)
                {
                    @* Active cards first in every lane; the Queued lane
                       additionally mirrors the dispatch claim order
                       (blockers of open work → priority → FIFO, blocked
                       cards last — they can't claim until their
                       blockers land). @key keeps DOM identity stable
                       so background store updates diff in place. *@
                    var cards = members.Where(col.Match)
                        .OrderByDescending(c => c.Active)
                        .ThenBy(c => col.Title == "Queued" && c.IsBlocked ? 1 : 0)
                        .ThenByDescending(c => col.Title == "Queued" && c.Boosted)
                        .ThenBy(c => col.Title == "Queued" ? c.Priority : 3)
                        .ThenBy(c => c.Id, StringComparer.Ordinal)
                        .ToList();
                    <div class="kanban__col">
                        <div class="kanban__col-header">
                            <span>@col.Title</span>
                            <span class="mono kanban__col-count">@cards.Count</span>
                        </div>
                        @if (cards.Count == 0)
                        {
                            <div class="kanban__empty">—</div>
                        }
                        @foreach (var card in cards)
                        {
                            <div @key="card.Id" class="kanban__card @(card.Active ? "kanban__card--active" : "")" style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/tasks/{card.Id}"))">
                                <div class="kanban__card-top">
                                    <span class="mono kanban__card-id">@card.Id</span>
                                    <span style="display:flex;gap:6px;align-items:center">
                                        @if (card.Active)
                                        {
                                            <span class="kanban__card-live" title="A run is live on this task right now">@card.Role live</span>
                                        }
                                        @if (card.ReworkAttempts is not null)
                                        {
                                            <span class="pill pill--blocked" title="Rework round @card.ReworkAttempts in the review loop">R@(card.ReworkAttempts)</span>
                                        }
                                        @if (card.PrNumber is not null && PrUrl(card.PrNumber) is { } url)
                                        {
                                            <a href="@url" target="_blank" rel="noopener" @onclick:stopPropagation="true">PR #@card.PrNumber</a>
                                        }
                                    </span>
                                </div>
                                <div class="kanban__card-title">@card.Title</div>
                                @if (!string.IsNullOrEmpty(card.Situation))
                                {
                                    <div class="kanban__card-meta">
                                        <span class="situation situation--@card.SituationTone">@card.Situation</span>
                                    </div>
                                }
                                @if (card.Boosted && !card.Active)
                                {
                                    <div class="kanban__card-meta">
                                        <span class="pill pill--primary" title="Blocks open work — claims ahead of non-blockers">blocks work</span>
                                    </div>
                                }
                                @if (card.BlockedBy is { Count: > 0 } blockers)
                                {
                                    <div class="kanban__card-meta">
                                        <span class="pill pill--blocked" title="Cannot proceed until these land (injected into this sprint)">
                                            blocked by @string.Join(", ", blockers)
                                        </span>
                                    </div>
                                }
                                <div class="kanban__card-meta">
                                    @if (card.State is not null && card.Status is not ("Completed" or "Closed" or "Failed" or "Blocked"))
                                    {
                                        <span class="pill pill--primary" title="Lifecycle state (state machine)">@card.State</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill--@card.Status.ToLowerInvariant()">@card.Status</span>
                                    }
                                    @if (card.Assignee is not null)
                                    {
                                        <span class="mono">@card.Assignee</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string? _loadedProject;
    private string? _selectedSprintId;
    private string? _repoUrl;

    private static readonly string[] _gateStages = { "design", "groom", "sprint", "merge" };
    private Dictionary<string, string> _gates = new();
    private System.Threading.Timer? _gateTimer;

    private async Task LoadGatesAsync()
    {
        try
        {
            _gates = await Http.GetFromJsonAsync<Dictionary<string, string>>("/api/gates") ?? new();
            StateHasChanged();
        }
        catch { /* gates endpoint absent on older backends */ }
    }

    private sealed record Column(string Title, Func<Card, bool> Match);
    // Kanban columns follow the lifecycle state machine — but the
    // DB status is authoritative for TERMINAL rows: an operator
    // close, breaker trip, or plan-gate failure doesn't always
    // record a machine event, leaving a stale intermediate state
    // (observed live 2026-07-27: task-210, Closed, sat in the
    // Running column forever because its record said StalledRework).
    private static string Bucket(Card c) => c.Status switch
    {
        "Completed" or "Closed" => "done",
        "Failed" => "failed",
        "Blocked" => "blocked",
        _ => c.State switch
        {
            "Pending" or "ReworkQueued" => "queued",
            "Dispatching" or "AgentRunning" or "ReworkRunning" or "StalledRework" => "running",
            "PROpen" or "MergeReady" or "ParkedInfra" => "review",
            "Failed" or "BlockedOperator" => "failed",
            "Merged" or "Completed" or "Closed" => "done",
            _ => c.Status == "InProgress" ? "running" : "queued",
        },
    };
    private static readonly Column[] Columns =
    {
        new("Queued", c => Bucket(c) == "queued"),
        new("Running", c => Bucket(c) == "running"),
        new("Review", c => Bucket(c) == "review"),
        new("Needs you", c => Bucket(c) is "failed" or "blocked"),
        new("Done", c => Bucket(c) == "done"),
    };

    private sealed record Card(string Id, string Title, string Status, string? State, string? Assignee, string? PrNumber, string? ReworkAttempts, IReadOnlyList<string>? BlockedBy, string? Situation, string? SituationTone, bool Active, string? Role, int Priority, bool IsBlocked, bool Boosted);

    /// <summary>Task type → owning role. Mirrors
    /// Agents/RoleAgentRegistry.FromTaskType — duplicated client-side
    /// because the WASM/Server UI has no reference to the Agents
    /// assembly; keep the two in sync.</summary>
    private static string? RoleFor(string? taskType) => taskType?.ToLowerInvariant() switch
    {
        "ecs" or "systems" or "pathfinding" or "atmospherics" or "mcp" => "coredev",
        "client" or "ui" or "godot" or "syncbridge" => "clientdev",
        "test" or "playtest" or "qa" => "qa",
        "review" => "reviewer",
        null => null,
        _ => "coredev",
    };

    private sealed record DraftVm(long Id, string Title, int Priority, string SourceIssueId, string SourceRole);
    private List<DraftVm> _drafts = new();
    private bool _draftsOpen;

    private sealed record QueueVm(int Position, string Id, string Title, int Priority, string Role, bool Boosted, string Wait, string? Detail);
    private List<QueueVm> _queue = new();
    private int _queueTotal;

    private sealed record PendingGroomVm(string Id, string Title);
    private sealed record BuildGroupVm(string Key, string Name, int TaskCount, int MinPriority);
    private sealed record BuildVm(string Phase, string Reason, string? CompletedSprintName, List<PendingGroomVm> PendingGroom, List<BuildGroupVm> Groups);
    private BuildVm? _build;

    private static string BuildPhaseLabel(string phase) => phase switch
    {
        "awaiting-groom" => "grooming follow-ups",
        "held" => "held by operator gate",
        "idle" => "nothing eligible in the backlog",
        _ => phase,
    };

    private async Task LoadBuildStateAsync()
    {
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? "/api/sprints/building"
                : $"/api/sprints/building?projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url);
            if (!doc.TryGetProperty("phase", out var phaseEl))
            {
                _build = null;
                return;
            }
            var pending = doc.TryGetProperty("pendingGroom", out var pg) && pg.ValueKind == JsonValueKind.Array
                ? pg.EnumerateArray().Select(p => new PendingGroomVm(
                    p.GetProperty("id").GetString() ?? "",
                    p.GetProperty("title").GetString() ?? "")).ToList()
                : new List<PendingGroomVm>();
            var groups = doc.TryGetProperty("eligibleGroups", out var eg) && eg.ValueKind == JsonValueKind.Array
                ? eg.EnumerateArray().Select(g => new BuildGroupVm(
                    g.GetProperty("key").GetString() ?? "",
                    g.GetProperty("name").GetString() ?? "",
                    g.GetProperty("taskCount").GetInt32(),
                    g.GetProperty("minPriority").GetInt32())).ToList()
                : new List<BuildGroupVm>();
            _build = new BuildVm(
                phaseEl.GetString() ?? "unknown",
                doc.TryGetProperty("reason", out var r) ? r.GetString() ?? "" : "",
                doc.TryGetProperty("completedSprintName", out var cs) && cs.ValueKind == JsonValueKind.String ? cs.GetString() : null,
                pending, groups);
        }
        catch { _build = null; }
    }

    private sealed record BlockedVm(string Id, string Title, int Priority, IReadOnlyList<string> BlockedBy);
    private List<BlockedVm> _blocked = new();

    private static string WaitPill(string wait) => wait switch
    {
        "ready" => "pill--active",
        "slot-full" => "pill--pending",
        "model-cooling" => "pill--blocked",
        _ => "pill--primary",
    };

    private async Task LoadQueueAsync()
    {
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? "/api/queue"
                : $"/api/queue?projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url);
            if (!doc.TryGetProperty("items", out var items))
            {
                _queue = new();
                _queueTotal = 0;
                _blocked = new();
                return;
            }
            var all = items.EnumerateArray().Select(q => new QueueVm(
                q.GetProperty("position").GetInt32(),
                q.GetProperty("issueId").GetString() ?? "",
                q.GetProperty("title").GetString() ?? "",
                q.GetProperty("priority").GetInt32(),
                q.GetProperty("role").GetString() ?? "",
                q.GetProperty("boosted").GetBoolean(),
                q.GetProperty("wait").GetString() ?? "ready",
                q.TryGetProperty("detail", out var d) ? d.GetString() : null)).ToList();
            _queueTotal = all.Count;
            _queue = all.Take(8).ToList();
            _blocked = doc.TryGetProperty("blocked", out var bl)
                ? bl.EnumerateArray().Select(b => new BlockedVm(
                    b.GetProperty("issueId").GetString() ?? "",
                    b.GetProperty("title").GetString() ?? "",
                    b.GetProperty("priority").GetInt32(),
                    b.GetProperty("blockedBy").EnumerateArray().Select(x => x.GetString() ?? "").ToList())).ToList()
                : new();
        }
        catch { _queue = new(); _queueTotal = 0; _blocked = new(); }
    }

    private async Task LoadDraftsAsync(string sprintId)
    {
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/sprints/{sprintId}/followup-drafts"
                : $"/api/sprints/{sprintId}/followup-drafts?projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url);
            _drafts = doc.EnumerateArray().Select(d => new DraftVm(
                d.GetProperty("id").GetInt64(),
                d.GetProperty("title").GetString() ?? "",
                d.GetProperty("priority").GetInt32(),
                d.GetProperty("sourceIssueId").GetString() ?? "",
                d.GetProperty("sourceRole").GetString() ?? "")).ToList();
        }
        catch { _drafts = new(); }
    }

    private ViewSprint? SelectedSprint(List<ViewSprint> sprints)
    {
        // Default: the Active sprint; fall back to the newest.
        if (_selectedSprintId is not null)
        {
            var hit = sprints.FirstOrDefault(s => s.Id == _selectedSprintId);
            if (hit is not null) return hit;
        }
        return sprints.FirstOrDefault(s => s.Status == "Active") ?? sprints.FirstOrDefault();
    }

    /// <summary>
    /// Sprint member rows carry id/title/status; enrich with the full
    /// task view (assignee, prNumber from metadata) by cross-joining
    /// the /api/state task list already in the store.
    /// </summary>
    private List<Card> EnrichMembers(ViewSprint sprint)
    {
        var byId = ViewStore.Value.Tasks.ToDictionary(t => t.Id);
        var memberList = sprint.Members ?? (IReadOnlyList<ViewSprintMember>)Array.Empty<ViewSprintMember>();
        // A card is a queue booster when another member's open
        // blockers list names it (mirrors the ReadyAsync boost).
        var boostedIds = new HashSet<string>(
            memberList.SelectMany(m => m.BlockedBy ?? (IReadOnlyList<string>)Array.Empty<string>()),
            StringComparer.Ordinal);
        return memberList
            .Select(m =>
            {
                byId.TryGetValue(m.Id, out var t);
                // Active = a run is live RIGHT NOW: claimed AND in an
                // engineering run-phase state. PR-phase states
                // (PROpen/MergeReady/ParkedInfra) are watch-owned —
                // the run ended when it pushed; the assignee chip
                // stays as attribution but nothing is live (operator
                // 2026-08-01: "running sessions in Review/Needs you").
                // StalledRework is a dead round, also not live.
                var active = t is not null
                    && t.Status == "InProgress"
                    && t.Assignee is not null
                    && t.LifecycleState is null
                        or "Dispatching" or "AgentRunning" or "ReworkRunning";
                return new Card(m.Id, m.Title, m.Status, t?.LifecycleState, t?.Assignee, t?.PrNumber, t?.ReworkAttempts, m.BlockedBy, m.Situation, m.SituationTone, active, RoleFor(t?.Type),
                    t?.Priority ?? 3,
                    m.BlockedBy is { Count: > 0 },
                    boostedIds.Contains(m.Id));
            })
            .ToList();
    }

    private string? PrUrl(string prNumber) =>
        _repoUrl is null ? null : $"{_repoUrl}/pull/{prNumber}";

    private static string Dates(ViewSprint s)
    {
        var start = s.StartDate?.ToString("MMM d");
        var end = s.EndDate?.ToString("MMM d");
        return start is null ? "" : $" · {start}{(end is null ? "" : $" → {end}")}";
    }

    private async Task LoadRepoUrlAsync()
    {
        // Repo URL from the current project registration (never
        // hardcoded); re-resolved on project switch.
        var projectId = ShellStore.Value.CurrentProjectId;
        if (string.IsNullOrEmpty(projectId)) return;
        try
        {
            var projects = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("/api/projects");
            foreach (var p in projects.EnumerateArray())
            {
                if (p.TryGetProperty("id", out var id) && string.Equals(id.GetString(), projectId, StringComparison.OrdinalIgnoreCase)
                    && p.TryGetProperty("repoUrl", out var url))
                {
                    _repoUrl = url.GetString()?.TrimEnd('/');
                    break;
                }
            }
        }
        catch { /* PR links are best-effort */ }
    }

    protected override void OnInitialized()
    {
        ViewStore.StateChanged += OnStateChanged;
        ShellStore.StateChanged += OnShellChanged;
        if (ViewStore.Value.LastFetchedAt is null)
        {
            LoadForCurrentProject();
        }
        _ = LoadRepoUrlAsync();
        // Safety net only: 30s slow poll for drift. Live updates are
        // server-push (SSE) via the DashboardEventStream subscription
        // in OnAfterRenderAsync — the board is event-driven, not
        // polled (operator direction 2026-07-31).
        _gateTimer = new System.Threading.Timer(_ => InvokeAsync(async () =>
        {
            await LoadGatesAsync();
            await LoadQueueAsync();
            await LoadBuildStateAsync();
            Dispatch.Dispatch(new ViewActions.LoadViewAction(ShellStore.Value.CurrentProjectId, Background: true));
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(30));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Events.Received += OnServerEvent;
            await Events.StartAsync();
        }
    }

    // Server-push → reload. Debounced (400ms trailing): a rework
    // storm or sprint completion publishes a burst of events, and
    // one coalesced BACKGROUND reload (no Loading placeholder — the
    // board diffs in place) reflects them all.
    private CancellationTokenSource? _reloadDebounce;

    private void OnServerEvent(string kind)
    {
        var cts = Interlocked.Exchange(ref _reloadDebounce, new CancellationTokenSource());
        cts?.Cancel();
        cts?.Dispose();
        var token = _reloadDebounce.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(ReloadAllAsync);
            }
            catch (TaskCanceledException) { }
        });
    }

    private async Task ReloadAllAsync()
    {
        Dispatch.Dispatch(new ViewActions.LoadViewAction(ShellStore.Value.CurrentProjectId, Background: true));
        await LoadQueueAsync();
        await LoadBuildStateAsync();
        var selected = ViewStore.Value.Sprints.FirstOrDefault(s => s.Status == "Active")
            ?? ViewStore.Value.Sprints.FirstOrDefault();
        if (selected?.Id is not null)
        {
            _draftsSprintId = selected.Id;
            await LoadDraftsAsync(selected.Id);
        }
        StateHasChanged();
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(async () =>
    {
        var selected = ViewStore.Value.Sprints.FirstOrDefault(s => s.Status == "Active")
            ?? ViewStore.Value.Sprints.FirstOrDefault();
        if (selected?.Id is not null && selected.Id != _draftsSprintId)
        {
            _draftsSprintId = selected.Id;
            await LoadDraftsAsync(selected.Id);
        }
        StateHasChanged();
    });

    private string? _draftsSprintId;

    private void OnShellChanged(object? sender, EventArgs e)
    {
        if (ShellStore.Value.CurrentProjectId != _loadedProject)
        {
            _repoUrl = null;
            _selectedSprintId = null;
            InvokeAsync(LoadForCurrentProject);
            _ = LoadRepoUrlAsync();
        }
    }

    private void LoadForCurrentProject()
    {
        _loadedProject = ShellStore.Value.CurrentProjectId;
        Dispatch.Dispatch(new ViewActions.LoadViewAction(_loadedProject));
    }

    public void Dispose()
    {
        _gateTimer?.Dispose();
        _reloadDebounce?.Cancel();
        _reloadDebounce?.Dispose();
        Events.Received -= OnServerEvent;
        ViewStore.StateChanged -= OnStateChanged;
        ShellStore.StateChanged -= OnShellChanged;
    }
}
