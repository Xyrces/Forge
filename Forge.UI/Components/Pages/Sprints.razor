@using Forge.Dashboard.Services
@page "/sprints"
@using Forge.Dashboard.Features.Sprints
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject HttpClient Http
@inject IJSRuntime JS
@inject ILogger<Sprints> Logger
@inject NavigationManager Nav
@inject IDispatcher Dispatch
@inject Forge.Dashboard.Services.DashboardEventStream Events
@using System.Net.Http.Json
@using System.Text.Json
@implements IDisposable
@using Forge.Dashboard.Features.View

<PageTitle>Sprints</PageTitle>
<div class="page sprint-workspace">
    <div class="page-header">
        <h1>Sprints</h1>
        <div class="page-header__meta">@(_summary is null ? "Sprint totals not loaded" : $"{_summary.Total} total · {(_summary.Active is null ? 0 : 1)} active")@(_refreshing ? " · updating…" : "")</div>
        <div class="page-header__actions">
            <a class="btn" href="#sprint-tasks">Jump to task cards</a>
            <button class="btn btn--primary" @onclick="RefreshAsync">Refresh</button>
        </div>
    </div>

    @* Operator stage gates: read-only status here — the canonical
       editing surface is the Flow page Edit mode (one setting, one
       place; operator rule 2026-07-24). *@
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
        <span class="page-subtitle" style="margin-right:4px">Stage gates:</span>
        @foreach (var stage in _gateStages)
        {
            var label = GatePresentation.Label(_gates, stage, _gatesLoading);
            var held = label == "held";
            <span class="chip @(held ? "chip--active" : "")"
                  title="@(held ? $"Held — {stage} transitions are paused." : label == "open" ? $"Open — {stage} runs automatically." : "Gate status has not been confirmed.")">
                @stage: @label
            </span>
        }
        <a href="/flow?mode=edit" class="page-subtitle">Edit on the Flow page →</a>
    </div>

    @if (_loadedProject is not null)
    {
        <CompletionWaitingList ProjectId="@_loadedProject" RefreshAt="@(_board?.GeneratedAt ?? DateTime.MinValue)" OnSelect="ReviewCompletionAsync" />
    }

    @if (_error is not null && _board is not null)
    {
        <p class="banner banner--warn">@_error Showing the last successful update from @_board.GeneratedAt.ToLocalTime().ToString("g").</p>
    }
    @if (_queueError is not null)
    {
        <p class="banner banner--warn">@_queueError</p>
    }
    @if (_loading)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (_error is not null && _board is null)
    {
        <div class="page-subtitle">Error: @_error</div>
        <button class="btn" @onclick="ShowActiveAsync">Show active sprint</button>
    }
    else if (_board is null)
    {
        <div class="page-subtitle">@(ShellStore.Value.CurrentProjectId is null ? "Waiting for a project selection…" : "Loading sprints…")</div>
    }
    else if (_board.Sprint is null)
    {
        @* Sprint flow: there is intentionally NO create button — the
           SprintAssembler builds each sprint automatically when the
           previous one completes, from groomed (or ad-hoc) work. *@
        <div class="page-subtitle">No sprints yet. Sprints assemble automatically when groomed work becomes eligible.</div>
    }
    else
    {
        var sprints = SprintHeaders
            .OrderByDescending(s => s.Status == "Active")
            .ThenByDescending(s => s.StartDate)
            .ToList();
        var selected = SelectedSprint(sprints);

        @* Sprint picker: a proper dropdown — scales past a handful
           of sprints, type-ahead built in. (The old chip-per-sprint
           row wrapped forever; operator 2026-07-25: 'tags/pills as
           selectors is weird.') Active pinned first, then newest. *@
        <div class="picker-bar">
            <label class="picker-bar__label" for="sprint-picker">Sprint</label>
            <select id="sprint-picker" class="picker-bar__select"
                    value="@(selected?.Id ?? "")"
                    @onchange="SelectSprintAsync">
                @foreach (var sp in sprints)
                {
                    <option value="@sp.Id" selected="@(selected?.Id == sp.Id)">
                        @(sp.Status == "Active" ? "● " : "")@SprintHeading.Picker(selected is not null && selected.Id == sp.Id ? selected : sp) — @sp.Status.ToLowerInvariant()@Dates(sp)
                    </option>
                }
            </select>
            <span class="meta-text">@(_summary?.Total ?? 0) total</span>
            <button class="btn" disabled="@(_historyPages.Count == 0 || _refreshing)" @onclick="PreviousHistoryAsync">Newer sprints</button>
            <button class="btn" disabled="@(_summary?.NextCursor is null || _refreshing)" @onclick="NextHistoryAsync">Older sprints</button>
        </div>

        @* Inter-sprint build state (operator request 2026-08-06):
           between sprint.completed and the next sprint.started the
           assembler triages + materializes follow-ups and the groomer
           works through them — previously invisible, so a completed
           sprint looked stuck. The assembler snapshots the phase to
           the project store every tick; this panel renders it. *@
        @if (_build is { Phase: "awaiting-groom" or "held" or "idle" or "starved" })
        {
            <div class="card" style="margin-bottom:14px">
                <div class="page-subtitle" style="margin-bottom:8px">
                    Next sprint — @BuildPhaseLabel(_build.Phase)
                </div>
                @if (_build.CompletedSprintName is not null)
                {
                    <div class="meta-text" style="padding:2px 0">Completed: @_build.CompletedSprintName</div>
                }
                <div class="meta-text" style="padding:2px 0">@_build.Reason</div>
                @if (_build.PendingGroom.Count > 0)
                {
                    <div class="page-subtitle" style="margin:8px 0 4px">In grooming (@_build.PendingGroom.Count):</div>
                    @foreach (var p in _build.PendingGroom)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0;cursor:pointer" @onclick="@(() => Nav.NavigateTo(TaskUrl(p.Id)))">
                            <span class="mono">@p.Id</span>
                            <span>@p.Title</span>
                            <span class="pill pill--pending">awaiting groom</span>
                        </div>
                    }
                }
                @if (_build.HeldWork.Count > 0)
                {
                    <div class="page-subtitle" style="margin:8px 0 4px">Holding the backlog (@_build.HeldWork.Count):</div>
                    @foreach (var h in _build.HeldWork)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0;cursor:pointer" @onclick="@(() => Nav.NavigateTo(TaskUrl(h.Id)))">
                            <span class="mono">@h.Id</span>
                            <span>@h.Title</span>
                            <span class="pill pill--failed">failed · @h.AgeDays d</span>
                        </div>
                    }
                }
                @if (_build.Groups.Count > 0)
                {
                    <div class="page-subtitle" style="margin:8px 0 4px">Up next once clear:</div>
                    @foreach (var g in _build.Groups)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0">
                            <span class="mono">P@(g.MinPriority)</span>
                            <span>@g.Name</span>
                            <span class="meta-text">@(g.Key == "Ad-hoc work" ? $"{g.TaskCount} solo sprint(s)" : $"{g.TaskCount} task(s)")</span>
                        </div>
                    }
                }
            </div>
        }

        @if (selected is not null)
        {


            var members = EnrichMembers(selected);
            var done = _board?.Done ?? 0;
            var total = _board?.Total ?? 0;
            var pct = total == 0 ? 0 : (int)Math.Round(100.0 * done / total);

            <div class="sprint-hero">
                <div class="sprint-hero__top">
                    <span class="pill pill--@selected.Status.ToLowerInvariant()">@selected.Status</span>
                    <strong class="sprint-hero__name">@SprintHeading.Title(selected)</strong>
                    <span class="mono sprint-hero__dates">
                        @(selected.StartDate?.ToString("MMM d") ?? "")
                        @(selected.EndDate is not null ? $" → {selected.EndDate.Value:MMM d}" : "")
                    </span>
                    <span class="mono">@done/@total tasks completed or closed · @pct%</span>
                </div>
            @if (!string.IsNullOrEmpty(selected.Goal))
            {
                <SprintGoal Goal="@selected.Goal" @key="selected.Id" />
            }
            <div class="sprint-progress"><div class="sprint-progress__fill" style="width:@pct%"></div></div>
        </div>

        <SprintCompletionPanel ProjectId="@_loadedProject" SprintId="@selected.Id" RefreshAt="@(_board?.GeneratedAt ?? DateTime.MinValue)" OnLayoutReady="CompletionLayoutReady" Expanded="@_completionExpanded" ExpandedChanged="SetCompletionExpandedAsync" />
        <div class="picker-bar">
            <span>Showing @members.Count of @total tasks. Column counts cover this page.</span>
            <button class="btn" disabled="@(_memberPages.Count == 0 || _refreshing)" @onclick="PreviousMembersAsync">Previous tasks</button>
            <button class="btn" disabled="@(_board?.NextCursor is null || _refreshing)" @onclick="NextMembersAsync">Next tasks</button>
        </div>
        @* Dispatch queue: the ready sprint members in claim order
           (blocker boost → priority → FIFO — the same ordering the
           dispatch loop consumes), with why each is or isn't running.
           Blocked tasks are absent by construction. *@
        @if (selected.Status == "Active")
        {
            <details class="sprint-operations"><summary>Dispatch queue · @_queueTotal waiting</summary>
                @if (_queueError is null && _queueTotal == 0 && _blocked.Count == 0)
                {
                    <div class="meta-text" style="padding:2px 0">Nothing waiting to claim — every member is in flight, in review, or blocked.</div>
                }
                @if (_queueError is null && _queueTotal == 0 && _blocked.Count > 0)
                {
                    <div class="meta-text" style="padding:2px 0">Nothing claimable right now — the remaining queued tasks are blocked (below).</div>
                }
                @foreach (var q in _queue)
                {
                    <div class="kanban__card-meta" style="padding:2px 0;cursor:pointer" @onclick="@(() => Nav.NavigateTo(TaskUrl(q.Id)))">
                        <span class="mono">#@q.Position</span>
                        <span class="mono">@q.Id</span>
                        <span class="mono">P@(q.Priority)</span>
                        <span class="mono meta-text">@q.Role</span>
                        @if (q.Boosted)
                        {
                            <span class="pill pill--blocked" title="Blocks open work — boosted to the front of the queue">blocker</span>
                        }
                        <span>@q.Title</span>
                        <span class="pill @WaitPill(q.Wait)" title="@q.Detail">@q.Wait</span>
                    </div>
                }
                @if (_queueTotal > _queue.Count)
                {
                    <div class="meta-text" style="padding:2px 0">+@(_queueTotal - _queue.Count) more</div>
                }
                @if (_blocked.Count > 0)
                {
                    <div class="page-subtitle" style="margin:8px 0 4px">Blocked (@_blockedTotal total, showing @_blocked.Count) — enters the queue when these land:</div>
                    @foreach (var b in _blocked)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0;cursor:pointer" @onclick="@(() => Nav.NavigateTo(TaskUrl(b.Id)))">
                            <span class="mono">@b.Id</span>
                            <span class="mono">P@(b.Priority)</span>
                            <span>@b.Title</span>
                            <span class="pill pill--blocked">blocked by @string.Join(", ", b.BlockedBy)@(b.BlockerCount > b.BlockedBy.Count ? $" (+{b.BlockerCount - b.BlockedBy.Count} more)" : "")</span>
                        </div>
                    }
                }
            </details>
        }

        @* Tracked follow-ups (operator model 2026-07-31): findings
           filed during the sprint — they materialize into tasks at
           completion, then groom before the next sprint. Read-only.
           Collapsible; collapsed by default. *@
        @if (selected.Status == "Active" && _drafts.Count > 0)
        {
            <div class="card" style="margin-bottom:14px">
                <div class="page-subtitle" style="margin-bottom:@(_draftsOpen ? "8px" : "0");cursor:pointer;user-select:none"
                     @onclick="@(() => _draftsOpen = !_draftsOpen)">
                    @(_draftsOpen ? "▾" : "▸") Tracked follow-ups (@_drafts.Count) — materialize when this sprint completes
                </div>
                @if (_draftsOpen)
                {
                    @foreach (var d in _drafts)
                    {
                        <div class="kanban__card-meta" style="padding:2px 0">
                            <span class="mono">P@(d.Priority)</span>
                            <span>@d.Title</span>
                            <span class="meta-text">from @d.SourceIssueId (@d.SourceRole)</span>
                        </div>
                    }
                }
            </div>
        }

            @if (selected.Status != "Active")
            {
                <div class="page-subtitle" style="margin:8px 0">Viewing a past sprint. The task board is read-only; completion review actions remain available.</div>
            }

            <div class="sprint-lane-picker">
                <label for="sprint-lane">Task lane</label>
                <select id="sprint-lane" value="@_lane" @onchange="SelectLaneAsync">
                    @foreach (var col in Columns)
                    { <option value="@col.Title">@col.Title (@members.Count(col.Match))</option> }
                </select>
            </div>
            @if (_holdError is not null) { <p role="alert">@_holdError</p> }
            @if (_holdNotice is not null) { <p role="status">@_holdNotice</p> }
            <div id="sprint-tasks" class="sprint-board" aria-label="Sprint task board">
                @foreach (var col in Columns)
                {
                    var cards = members.Where(col.Match).OrderByDescending(c => c.Active)
                        .ThenBy(c => col.Title == "Queued" && c.IsBlocked ? 1 : 0)
                        .ThenByDescending(c => col.Title == "Queued" && c.Boosted)
                        .ThenBy(c => c.Priority).ThenBy(c => c.Id, StringComparer.Ordinal).ToList();
                    <section class="sprint-lane @(col.Title == _lane ? "sprint-lane--selected" : "")" aria-label="@col.Title">
                        <h2>@col.Title <span>@cards.Count</span></h2>
                        @if (cards.Count == 0) { <p class="sprint-empty">No tasks in this lane</p> }
                        @foreach (var card in cards)
                        {
                            <article @key="(_loadedProject, card.Id)" class="sprint-task @(card.Active ? "sprint-task--active" : "")">
                                <h3><a href="@TaskUrl(card.Id)">@card.Title</a></h3>
                                <p class="sprint-task__status">@(card.Label ?? card.Situation ?? "Status evidence unavailable")</p>
                                @if (card.Situation is not null && card.Situation != card.Label) { <p>@card.Situation</p> }
                                @if (card.NextActor is not null) { <p class="sprint-task__actor">Next: @card.NextActor</p> }
                                <TaskHumanReview Required="@card.HumanReviewRequired" Status="@card.Status" Nominee="@card.NominatedHuman"
                                                 Summary="@card.HumanReviewSummary" Class="sprint-task__requirement" />
                                @if (card.IsBlocked) { <p>Waiting for @card.BlockerCount prerequisite task(s). <a href="@TaskUrl(card.Id)">View dependencies</a></p> }
                                @if (card.PrNumber is not null && PrUrl(card.PrNumber) is { } url)
                                { <a href="@url" target="_blank" rel="noopener">@(card.AwaitingHumanReview ? "Review" : "Open") PR #@card.PrNumber ↗</a> }
                                @if (selected.Status == "Active" && card.Status is not ("Completed" or "Closed"))
                                {
                                    <details class="sprint-task__actions"><summary>Task actions</summary>
                                        <button class="btn" disabled="@(_holdBusy is not null)" @onclick="() => SetReviewHoldAsync(card)">@(card.HumanReviewTaskHold ? "Release additional review hold" : card.NominatedHuman is null ? "Require human review" : $"Require review by @{card.NominatedHuman}")</button>
                                        <a href="@TaskUrl(card.Id)">Open task history</a>
                                    </details>
                                }
                            </article>
                        }
                    </section>
                }
            </div>
        }
    }
</div>

@code {
    private string _lane = "Queued";
    [Parameter][SupplyParameterFromQuery(Name = "project")] public string? Project { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "sprint")] public string? Sprint { get; set; }
    private IJSObjectReference? _boardBrowser;
    private bool _restoreBoard, _chooseLane, _restoringLocation, _locationReadFailed;
    private bool _completionLayoutReady, _completionExpanded;
    private string? _completionSprintId;
    private int _restoreGeneration;
    private string? _holdBusy, _holdError, _holdNotice;
    private sealed record BoardLocation(string? SprintId, string? Lane, string? MemberCursor, string? HistoryCursor, string?[]? MemberPages, string?[]? HistoryPages, bool CompletionExpanded = false);
    private string TaskUrl(string id) => $"/tasks/{Uri.EscapeDataString(id)}?project={Uri.EscapeDataString(_loadedProject ?? "")}";
    private async Task SetReviewHoldAsync(Card card)
    {
        if (_holdBusy is not null || _loadedProject is null) return;
        var project = _loadedProject;
        _holdBusy = card.Id; _holdError = null; _holdNotice = null;
        try
        {
            using var response = await Http.PutAsJsonAsync($"/api/tasks/{Uri.EscapeDataString(card.Id)}/human-review?projectId={Uri.EscapeDataString(project)}", new { required = !card.HumanReviewTaskHold });
            response.EnsureSuccessStatusCode();
            if (project != _loadedProject) return;
            _holdNotice = card.HumanReviewTaskHold ? "Additional hold released. Project review requirements and formal objections still apply." : "Human review required before merge. Engineering and checks may continue.";
            await RefreshAsync();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Task review requirement could not be saved"); if (project == _loadedProject) _holdError = "Could not confirm the review requirement. Refresh and retry."; }
        finally { _holdBusy = null; }
    }
    private async Task SelectLaneAsync(ChangeEventArgs e)
    {
        if (_disposed) return;
        ++_restoreGeneration;
        await CancelBoardRestoreAsync();
        var lane = e.Value?.ToString();
        if (Columns.Any(c => c.Title == lane))
        {
            _lane = lane!;
            _chooseLane = false;
        }
        await SaveBoardLocationAsync();
        if (_loading) await RefreshAsync();
    }
    private async Task SaveBoardLocationAsync()
    {
        if (!_restoringLocation && !_locationReadFailed && _boardBrowser is not null && _loadedProject is not null)
            await _boardBrowser.InvokeVoidAsync("remember", _loadedProject, _selectedSprintId ?? _board?.Sprint?.Id, _lane, _memberCursor, _historyCursor, _memberPages.ToArray(), _historyPages.ToArray(), _completionExpanded);
    }
    private async Task SetCompletionExpandedAsync(bool expanded)
    {
        await CancelBoardRestoreAsync();
        _completionExpanded = expanded;
        _completionSprintId = _selectedSprintId ?? _board?.Sprint?.Id;
        await SaveBoardLocationAsync();
    }
    private async Task CancelBoardRestoreAsync()
    {
        _restoringLocation = false;
        _locationReadFailed = false;
        _restoreBoard = false;
        if (_boardBrowser is not null) await _boardBrowser.InvokeVoidAsync("cancelRestore");
    }
    private string? _loadedProject;
    private string? _selectedSprintId;
    private SprintHistoryResponse? _summary;
    private SprintBoardResponse? _board;
    private readonly SprintSelection _selection = new();
    private readonly Stack<string?> _historyPages = new();
    private readonly Stack<string?> _memberPages = new();
    private string? _historyCursor, _memberCursor;
    private bool _loading, _refreshing, _refreshRequested, _disposed;
    private string? _error, _queueError;
    private List<ViewSprint> SprintHeaders => (_summary?.History ?? [])
        .Concat(_summary?.Active is { } active ? [active] : [])
        .Concat(_board?.Sprint is { } selected ? [selected] : [])
        .DistinctBy(s => s.Id).ToList();
    private string? _repoUrl;

    private static readonly string[] _gateStages = { "design", "groom", "sprint", "merge", "deploy" };
    private Dictionary<string, string> _gates = new();
    private bool _gatesLoading = true;
    private System.Threading.Timer? _gateTimer;

    private async Task LoadGatesAsync()
    {
        try
        {
            _gates = await Http.GetFromJsonAsync<Dictionary<string, string>>("/api/gates") ?? new();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Stage gate status could not be loaded");
            _gates = new();
        }
        finally { _gatesLoading = false; StateHasChanged(); }
    }

    private sealed record Column(string Title, Func<Card, bool> Match);
    // Kanban columns follow the lifecycle state machine — but the
    // DB status is authoritative for TERMINAL rows: an operator
    // close, breaker trip, or plan-gate failure doesn't always
    // record a machine event, leaving a stale intermediate state
    // (observed live 2026-07-27: task-210, Closed, sat in the
    // Running column forever because its record said StalledRework).
    private static string Bucket(Card c) => c.AwaitingHumanReview && c.Status is not ("Completed" or "Closed") && c.State is not ("Dispatching" or "AgentRunning" or "ReworkRunning" or "StalledRework") ? "blocked" : c.Status switch
    {
        "Completed" or "Closed" => "done",
        "Failed" => "failed",
        "Blocked" => "blocked",
        _ => c.State switch
        {
            "Pending" or "ReworkQueued" => "queued",
            "Dispatching" or "AgentRunning" or "ReworkRunning" or "StalledRework" => "running",
            "PROpen" or "MergeReady" or "ParkedInfra" => "review",
            "Failed" or "BlockedOperator" => "failed",
            "Merged" or "Completed" or "Closed" => "done",
            _ => c.Status == "InProgress" ? "running" : "queued",
        },
    };
    private static readonly Column[] Columns =
    {
        new("Queued", c => Bucket(c) == "queued"),
        new("Running", c => Bucket(c) == "running"),
        new("Review", c => Bucket(c) == "review"),
        new("Needs you", c => Bucket(c) is "failed" or "blocked"),
        new("Completed / closed", c => Bucket(c) == "done"),
    };

    private sealed record Card(string Id, string Title, string Status, string? State, string? Assignee, string? PrNumber, string? ReworkAttempts, IReadOnlyList<string>? BlockedBy, string? Situation, string? SituationTone, bool Active, string? Role, int Priority, bool IsBlocked, bool Boosted, long BlockerCount, string? Label, string? NextActor, bool HumanReviewRequired, bool AwaitingHumanReview, string? NominatedHuman, bool HumanReviewTaskHold, string? HumanReviewSummary);

    /// <summary>Task type → owning role. Mirrors
    /// Agents/RoleAgentRegistry.FromTaskType — duplicated client-side
    /// because the WASM/Server UI has no reference to the Agents
    /// assembly; keep the two in sync.</summary>
    private static string? RoleFor(string? taskType) => taskType?.ToLowerInvariant() switch
    {
        "ecs" or "systems" or "pathfinding" or "atmospherics" or "mcp" => "coredev",
        "client" or "ui" or "godot" or "syncbridge" => "clientdev",
        "test" or "playtest" or "qa" => "qa",
        "review" => "reviewer",
        null => null,
        _ => "coredev",
    };

    private sealed record DraftVm(long Id, string Title, int Priority, string SourceIssueId, string SourceRole);
    private List<DraftVm> _drafts = new();
    private bool _draftsOpen;

    private sealed record QueueVm(int Position, string Id, string Title, int Priority, string Role, bool Boosted, string Wait, string? Detail);
    private List<QueueVm> _queue = new();
    private int _queueTotal;
    private int _blockedTotal;

    private sealed record PendingGroomVm(string Id, string Title);
    private sealed record BuildGroupVm(string Key, string Name, int TaskCount, int MinPriority);
    private sealed record HeldWorkVm(string Id, string Title, int AgeDays);
    private sealed record BuildVm(string Phase, string Reason, string? CompletedSprintName, List<PendingGroomVm> PendingGroom, List<BuildGroupVm> Groups, List<HeldWorkVm> HeldWork);
    private BuildVm? _build;

    private static string BuildPhaseLabel(string phase) => phase switch
    {
        "awaiting-groom" => "grooming follow-ups",
        "held" => "held by operator gate",
        "idle" => "nothing eligible in the backlog",
        "starved" => "blocked by failed work",
        _ => phase,
    };

    private async Task LoadBuildStateAsync()
    {
        var generation = _selection.Generation;
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? "/api/sprints/building"
                : $"/api/sprints/building?projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url, _selection.Token);
            if (!_selection.IsCurrent(generation)) return;
            if (!doc.TryGetProperty("phase", out var phaseEl))
            {
                _build = null;
                return;
            }
            var pending = doc.TryGetProperty("pendingGroom", out var pg) && pg.ValueKind == JsonValueKind.Array
                ? pg.EnumerateArray().Select(p => new PendingGroomVm(
                    p.GetProperty("id").GetString() ?? "",
                    p.GetProperty("title").GetString() ?? "")).ToList()
                : new List<PendingGroomVm>();
            var groups = doc.TryGetProperty("eligibleGroups", out var eg) && eg.ValueKind == JsonValueKind.Array
                ? eg.EnumerateArray().Select(g => new BuildGroupVm(
                    g.GetProperty("key").GetString() ?? "",
                    g.GetProperty("name").GetString() ?? "",
                    g.GetProperty("taskCount").GetInt32(),
                    g.GetProperty("minPriority").GetInt32())).ToList()
                : new List<BuildGroupVm>();
            var held = doc.TryGetProperty("heldWork", out var hw) && hw.ValueKind == JsonValueKind.Array
                ? hw.EnumerateArray().Select(h => new HeldWorkVm(
                    h.GetProperty("id").GetString() ?? "",
                    h.GetProperty("title").GetString() ?? "",
                    h.TryGetProperty("ageDays", out var ad) ? ad.GetInt32() : 0)).ToList()
                : new List<HeldWorkVm>();
            _build = new BuildVm(
                phaseEl.GetString() ?? "unknown",
                doc.TryGetProperty("reason", out var r) ? r.GetString() ?? "" : "",
                doc.TryGetProperty("completedSprintName", out var cs) && cs.ValueKind == JsonValueKind.String ? cs.GetString() : null,
                pending, groups, held);
        }
        catch (Exception ex) { if (!_selection.IsCurrent(generation)) return; Logger.LogWarning(ex, "Sprint build snapshot unavailable"); _build = null; }
    }

    private sealed record BlockedVm(string Id, string Title, int Priority, IReadOnlyList<string> BlockedBy, long BlockerCount);
    private List<BlockedVm> _blocked = new();

    private static string WaitPill(string wait) => wait switch
    {
        "ready" => "pill--active",
        "slot-full" => "pill--pending",
        "model-cooling" => "pill--blocked",
        _ => "pill--primary",
    };

    private async Task LoadQueueAsync()
    {
        var generation = _selection.Generation;
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            var url = $"/api/queue?limit=8&projectId={Uri.EscapeDataString(projectId ?? "")}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url, _selection.Token);
            if (!_selection.IsCurrent(generation)) return;
            if (doc.TryGetProperty("sprintId", out var queueSprint) && queueSprint.GetString() != _board?.Sprint?.Id)
            {
                _queue.Clear(); _blocked.Clear(); _queueTotal = 0; _blockedTotal = 0;
                _queueError = "The active sprint changed. Refresh to load its queue.";
                return;
            }
            if (!doc.TryGetProperty("items", out var items))
            {
                _queue = new();
                _queueTotal = 0;
                _blocked = new();
                return;
            }
            var all = items.EnumerateArray().Select(q => new QueueVm(
                q.GetProperty("position").GetInt32(),
                q.GetProperty("issueId").GetString() ?? "",
                q.GetProperty("title").GetString() ?? "",
                q.GetProperty("priority").GetInt32(),
                q.GetProperty("role").GetString() ?? "",
                q.GetProperty("boosted").GetBoolean(),
                q.GetProperty("wait").GetString() ?? "ready",
                q.TryGetProperty("detail", out var d) ? d.GetString() : null)).ToList();
            _queueTotal = doc.GetProperty("total").GetInt32();
            _blockedTotal = doc.GetProperty("blockedTotal").GetInt32();
            _queueError = null;
            _queue = all.Take(8).ToList();
            _blocked = doc.TryGetProperty("blocked", out var bl)
                ? bl.EnumerateArray().Select(b => new BlockedVm(
                    b.GetProperty("issueId").GetString() ?? "",
                    b.GetProperty("title").GetString() ?? "",
                    b.GetProperty("priority").GetInt32(),
                    b.GetProperty("blockedBy").EnumerateArray().Select(x => x.GetString() ?? "").ToList(),
                    b.GetProperty("blockerCount").GetInt64())).ToList()
                : new();
        }
        catch (Exception ex) { if (!_selection.IsCurrent(generation)) return; Logger.LogWarning(ex, "Sprint queue refresh failed"); _queueError = "Queue could not be refreshed; displayed entries may be stale."; }
    }

    private async Task LoadDraftsAsync(string sprintId)
    {
        var generation = _selection.Generation;
        try
        {
            var projectId = ShellStore.Value.CurrentProjectId;
            var url = string.IsNullOrEmpty(projectId)
                ? $"/api/sprints/{sprintId}/followup-drafts"
                : $"/api/sprints/{sprintId}/followup-drafts?projectId={Uri.EscapeDataString(projectId)}";
            var doc = await Http.GetFromJsonAsync<JsonElement>(url, _selection.Token);
            if (!_selection.IsCurrent(generation)) return;
            _drafts = doc.EnumerateArray().Select(d => new DraftVm(
                d.GetProperty("id").GetInt64(),
                d.GetProperty("title").GetString() ?? "",
                d.GetProperty("priority").GetInt32(),
                d.GetProperty("sourceIssueId").GetString() ?? "",
                d.GetProperty("sourceRole").GetString() ?? "")).ToList();
        }
        catch (Exception ex) { if (!_selection.IsCurrent(generation)) return; Logger.LogWarning(ex, "Sprint draft preview unavailable"); _drafts = new(); }
    }

    private ViewSprint? SelectedSprint(List<ViewSprint> sprints) => _board?.Sprint;

    /// <summary>
    /// Cards are self-contained selected-page projections; no all-task export is needed.
    /// </summary>
    private List<Card> EnrichMembers(ViewSprint sprint) => (_board?.Members ?? [])
        .Select(m => new Card(m.Id, m.Title, m.Status, m.State, m.Assignee, m.PrNumber, m.ReworkAttempts,
            m.BlockedBy, m.Situation, m.SituationTone,
            m.Status == "InProgress" && m.Assignee is not null && m.State is null or "Dispatching" or "AgentRunning" or "ReworkRunning",
            RoleFor(m.Type), m.Priority, m.BlockerCount > 0, m.Boosted, m.BlockerCount, m.Label, m.NextActor, m.HumanReviewRequired,
            m.Status is not ("Completed" or "Closed") && m.AwaitingHumanReview, m.NominatedHuman, m.HumanReviewTaskHold, m.HumanReviewSummary)).ToList();

    private string? PrUrl(string prNumber) =>
        RepositoryLinks.PullRequest(_repoUrl, prNumber);

    private static string Dates(ViewSprint s)
    {
        var start = s.StartDate?.ToString("MMM d");
        var end = s.EndDate?.ToString("MMM d");
        return start is null ? "" : $" · {start}{(end is null ? "" : $" → {end}")}";
    }

    private async Task LoadRepoUrlAsync()
    {
        // Repo URL from the current project registration (never
        // hardcoded); re-resolved on project switch.
        var projectId = _selection.ProjectId;
        var generation = _selection.Generation;
        var token = _selection.Token;
        if (string.IsNullOrEmpty(projectId)) return;
        try
        {
            var projects = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("/api/projects", token);
            if (!_selection.IsCurrent(generation)) return;
            foreach (var p in projects.EnumerateArray())
            {
                if (p.TryGetProperty("id", out var id) && string.Equals(id.GetString(), projectId, StringComparison.OrdinalIgnoreCase)
                    && p.TryGetProperty("repoUrl", out var url))
                {
                    _repoUrl = RepositoryLinks.WebUrl(url.GetString());
                    break;
                }
            }
        }
        catch (OperationCanceledException) when (!_selection.IsCurrent(generation)) { }
        catch (Exception ex) { Logger.LogWarning(ex, "Sprint repository links unavailable"); }
    }

    protected override void OnInitialized()
    {
        ShellStore.StateChanged += OnShellChanged;

        _gateTimer = new System.Threading.Timer(_ => InvokeAsync(RefreshAsync), null,
            TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _boardBrowser = await JS.InvokeAsync<IJSObjectReference>("import", "./sprint-board.js");
            if (Project is not null && Project != ShellStore.Value.CurrentProjectId)
                Dispatch.Dispatch(new Forge.Dashboard.Features.AppShell.AppShellActions.SelectProjectAction(Project));
            Events.Received += OnServerEvent;
            await Events.StartAsync();
            await ChangeProjectAsync();
        }
        if (!_loading && !_refreshing && _board?.Sprint is not null && _boardBrowser is not null)
        {
            await SaveBoardLocationAsync();
            // The completion panel loads independently above the board. Restoring against its
            // placeholder clamps scrollTop to the shorter page and loses the saved position.
            if (_restoreBoard && _completionLayoutReady) { _restoreBoard = false; await _boardBrowser.InvokeVoidAsync("restoreScroll", _loadedProject); }
        }
    }
    private CancellationTokenSource? _reloadDebounce;
    private void CompletionLayoutReady((string? ProjectId, string? SprintId) location)
    {
        if (!_disposed && location.ProjectId == _loadedProject && location.SprintId == _board?.Sprint?.Id)
            _completionLayoutReady = true;
    }
    private void OnServerEvent(string kind)
    {
        var previous = Interlocked.Exchange(ref _reloadDebounce, new CancellationTokenSource());
        previous?.Cancel(); previous?.Dispose();
        _ = DebouncedRefreshAsync(_reloadDebounce.Token);
    }
    private async Task DebouncedRefreshAsync(CancellationToken ct)
    {
        try { await Task.Delay(400, ct); await InvokeAsync(RefreshAsync); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task RefreshAsync()
    {
        if (_disposed || _boardBrowser is null || _restoringLocation) return;
        if (_locationReadFailed) { await ChangeProjectAsync(); return; }
        if (_refreshing) { _refreshRequested = true; return; }
        if (_selection.ProjectId is null) { _loading = false; return; }
        _refreshing = true;
        try
        {
            do
            {
                if (_restoringLocation || _locationReadFailed) break;
                _refreshRequested = false;
                var generation = _selection.Generation;
                var projectId = _selection.ProjectId;
                var sprintId = _selectedSprintId;
                var historyCursor = _historyCursor;
                var memberCursor = _memberCursor;
                var token = _selection.Token;
                if (projectId is null) break;
                _loading = _board is null;
                StateHasChanged();
                try
                {
                    var client = new SprintReadClient(Http);
                    var history = await client.HistoryAsync(projectId, historyCursor, token);
                    if (!_selection.IsCurrent(generation)) continue;
                    var board = await client.BoardAsync(projectId, sprintId, memberCursor, token);
                    if (!_selection.IsCurrent(generation)) continue;
                    _summary = history; _board = board; _error = null;
                    if (_completionSprintId != board.Sprint?.Id)
                    {
                        _completionExpanded = false;
                        _completionSprintId = board.Sprint?.Id;
                    }
                    if (_chooseLane && board.Sprint is not null)
                    {
                        var cards = EnrichMembers(board.Sprint);
                        _lane = Columns.FirstOrDefault(c => cards.Any(c.Match))?.Title ?? "Queued";
                        _chooseLane = false;
                    }
                    await LoadGatesAsync();
                    if (!_selection.IsCurrent(generation)) continue;
                    if (board.Sprint?.Status == "Active") await LoadQueueAsync();
                    if (!_selection.IsCurrent(generation)) continue;
                    await LoadBuildStateAsync();
                    if (!_selection.IsCurrent(generation)) continue;
                    _drafts = new();
                    if (board.Sprint?.Id is { } id) await LoadDraftsAsync(id);
                }
                catch (OperationCanceledException) when (!_selection.IsCurrent(generation)) { }
                catch (Exception ex)
                {
                    if (_selection.IsCurrent(generation))
                    {
                        Logger.LogWarning(ex, "Sprint read failed");
                        _error = "Sprint information could not be loaded. Retry with Refresh.";
                    }
                }
                finally { if (_selection.IsCurrent(generation)) _loading = false; }
            } while (_refreshRequested && !_disposed);
        }
        finally { _refreshing = false; if (!_disposed) StateHasChanged(); }
    }
    private async Task ChangeProjectAsync()
    {
        // Shell selection can precede JS initialization. Wait until browser
        // navigation state is available before loading or saving a default lane.
        if (_boardBrowser is null) return;
        if (!await RestoreProjectLocationAsync()) return;
        StateHasChanged();
        var generation = _restoreGeneration;
        await LoadRepoUrlAsync();
        if (_disposed || generation != _restoreGeneration) return;
        await RefreshAsync();
    }
    private async Task<bool> RestoreProjectLocationAsync()
    {
        if (_disposed) return false;
        var generation = ++_restoreGeneration;
        _restoringLocation = true;
        _locationReadFailed = false;
        var project = ShellStore.Value.CurrentProjectId;
        _loading = true;
        _loadedProject = project;
        _selectedSprintId = null;
        _historyCursor = null; _memberCursor = null;
        _historyPages.Clear(); _memberPages.Clear();
        _restoreBoard = false;
        _completionLayoutReady = false;
        _completionExpanded = false; _completionSprintId = null;
        _selection.Select(project, null);
        _summary = null; _board = null; _repoUrl = null;
        _queue.Clear(); _blocked.Clear(); _drafts.Clear(); _build = null;
        BoardLocation? remembered;
        try
        {
            remembered = _boardBrowser is null || _loadedProject is null ? null
                : await _boardBrowser.InvokeAsync<BoardLocation?>("begin", project);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not read saved sprint navigation");
            if (_disposed || generation != _restoreGeneration || project != ShellStore.Value.CurrentProjectId) return false;
            _restoringLocation = false; _locationReadFailed = true; _loading = false;
            _error = "Saved sprint navigation could not be loaded. Retry with Refresh.";
            StateHasChanged();
            return false;
        }
        if (_disposed || generation != _restoreGeneration || project != ShellStore.Value.CurrentProjectId)
            return false;
        _selectedSprintId = Project == _loadedProject && !string.IsNullOrEmpty(Sprint) ? Sprint : remembered?.SprintId;
        _completionExpanded = remembered?.SprintId == _selectedSprintId && remembered?.CompletionExpanded == true;
        _completionSprintId = _selectedSprintId;
        _lane = Columns.Any(c => c.Title == remembered?.Lane) ? remembered!.Lane! : "Queued";
        _restoreBoard = true; _chooseLane = remembered is null;
        _holdError = null; _holdNotice = null;
        _selection.Select(_loadedProject, _selectedSprintId); _historyCursor = remembered?.HistoryCursor; _memberCursor = remembered?.MemberCursor;
        _historyPages.Clear(); _memberPages.Clear();
        foreach (var cursor in (remembered?.HistoryPages ?? []).Reverse()) _historyPages.Push(cursor);
        foreach (var cursor in (remembered?.MemberPages ?? []).Reverse()) _memberPages.Push(cursor); _summary = null; _board = null; _repoUrl = null;
        _queue.Clear(); _blocked.Clear(); _drafts.Clear(); _build = null; _queueTotal = 0; _error = null; _queueError = null;
        _restoringLocation = false;
        return true;
    }
    private void OnShellChanged(object? sender, EventArgs e)
    {
        if (Project is not null && ShellStore.Value.CurrentProjectId is { } selected && selected != Project)
            Nav.NavigateTo("/sprints?project=" + Uri.EscapeDataString(selected));
        if (ShellStore.Value.CurrentProjectId != _loadedProject) _ = InvokeAsync(ChangeProjectAsync);
    }
    private async Task SelectSprintAsync(ChangeEventArgs e)
    {
        if (_disposed) return;
        ++_restoreGeneration;
        await CancelBoardRestoreAsync();
        _selectedSprintId = e.Value?.ToString(); _memberCursor = null; _memberPages.Clear();
        _completionExpanded = false; _completionSprintId = _selectedSprintId;
        _selection.Select(_loadedProject, _selectedSprintId); _board = null; _drafts.Clear();
        await SaveBoardLocationAsync();
        await RefreshAsync();
    }
    private Task ShowActiveAsync() => SelectSprintAsync(new ChangeEventArgs { Value = null });
    private async Task ReviewCompletionAsync(string sprintId)
    {
        await SelectSprintAsync(new ChangeEventArgs { Value = sprintId });
        if (_disposed || _selectedSprintId != sprintId) return;
        await SetCompletionExpandedAsync(true);
    }

    private async Task NextHistoryAsync() { _historyPages.Push(_historyCursor); _historyCursor = _summary?.NextCursor; await RefreshSelectionAsync(); }
    private async Task PreviousHistoryAsync() { _historyCursor = _historyPages.Pop(); await RefreshSelectionAsync(); }
    private async Task NextMembersAsync()
    {
        _selectedSprintId ??= _board?.Sprint?.Id;
        _memberPages.Push(_memberCursor); _memberCursor = _board?.NextCursor; await RefreshSelectionAsync();
    }
    private async Task PreviousMembersAsync() { _memberCursor = _memberPages.Pop(); await RefreshSelectionAsync(); }
    private async Task RefreshSelectionAsync()
    {
        ++_restoreGeneration;
        await CancelBoardRestoreAsync();
        _selection.Select(_loadedProject, _selectedSprintId);
        await RefreshAsync();
    }
    public void Dispose()
    {
        _disposed = true;
        ++_restoreGeneration;
        _gateTimer?.Dispose(); _selection.Dispose();
        _reloadDebounce?.Cancel(); _reloadDebounce?.Dispose();
        Events.Received -= OnServerEvent; ShellStore.StateChanged -= OnShellChanged;
    }
}
