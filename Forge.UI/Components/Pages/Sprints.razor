@page "/sprints"
@inject IState<Forge.Dashboard.Features.View.ViewState> ViewStore
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject Fluxor.IDispatcher Dispatch
@implements IDisposable
@using Forge.Dashboard.Features.View

<PageTitle>Sprints</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Sprints</h1>
        <div class="page-header__meta">@ViewStore.Value.Sprints.Count total · @ViewStore.Value.Sprints.Count(s => s.Status == "Active") active</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="@(() => Dispatch.Dispatch(new ViewActions.LoadViewAction(ShellStore.Value.CurrentProjectId)))">Refresh</button>
        </div>
    </div>

    @if (ViewStore.Value.Loading)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (ViewStore.Value.Error is not null)
    {
        <div class="page-subtitle">Error: @ViewStore.Value.Error</div>
    }
    else
    {
        var active = ViewStore.Value.Sprints.FirstOrDefault(s => s.Status == "Active");
        var past = ViewStore.Value.Sprints.Where(s => s.Status != "Active").ToList();
        <div class="sprint-grid">
            @if (active is not null)
            {
                <div class="sprint-card sprint-card--active">
                    <div class="sprint-card__header">
                        <span class="mono sprint-card__id">@active.Id</span>
                        <span class="pill pill--active">@active.Status</span>
                        <span class="sprint-card__progress mono">@active.DoneCount/@active.IssueCount tasks done</span>
                    </div>
                    <div class="sprint-card__name">@active.Name</div>
                    <div class="sprint-card__goal">@(active.Goal ?? "(no goal)")</div>
                    <div class="sprint-card__dates">
                        @if (active.StartDate is not null)
                        {
                            <span>@active.StartDate.Value.ToString("MMM d")</span>
                            @if (active.EndDate is not null)
                            {
                                <span> → </span>
                                <span>@active.EndDate.Value.ToString("MMM d")</span>
                            }
                        }
                    </div>
                    @if (active.Members is { Count: > 0 })
                    {
                        <ul class="sprint-card__members">
                            @foreach (var m in active.Members)
                            {
                                <li>
                                    <span class="pill pill--@m.Status.ToLowerInvariant()">@m.Status</span>
                                    <span class="mono">@m.Id</span>
                                    <span>@m.Title</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            @foreach (var sp in past)
            {
                <div class="sprint-card">
                    <div class="sprint-card__header">
                        <span class="mono sprint-card__id">@sp.Id</span>
                        <span class="pill pill--@sp.Status.ToLowerInvariant()">@sp.Status</span>
                        <span class="sprint-card__progress mono">@sp.DoneCount/@sp.IssueCount</span>
                    </div>
                    <div class="sprint-card__name">@sp.Name</div>
                    <div class="sprint-card__goal">@(sp.Goal ?? "(no goal)")</div>
                    <div class="sprint-card__dates">
                        @if (sp.StartDate is not null)
                        {
                            <span>@sp.StartDate.Value.ToString("MMM d")</span>
                            @if (sp.EndDate is not null)
                            {
                                <span> → </span>
                                <span>@sp.EndDate.Value.ToString("MMM d")</span>
                            }
                        }
                    </div>
                </div>
            }
            @if (ViewStore.Value.Sprints.Count == 0)
            {
                @* Sprint flow: there is intentionally NO create button —
                   the SprintAssembler builds each sprint automatically
                   when the previous one completes, from groomed (or
                   ad-hoc) eligible work. *@
                <div class="page-subtitle">No sprints yet. Sprints assemble automatically when groomed work becomes eligible.</div>
            }
        </div>
    }
</div>

@code {
    private string? _loadedProject;

    protected override void OnInitialized()
    {
        ViewStore.StateChanged += OnStateChanged;
        ShellStore.StateChanged += OnShellChanged;
        if (ViewStore.Value.LastFetchedAt is null)
        {
            LoadForCurrentProject();
        }
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnShellChanged(object? sender, EventArgs e)
    {
        if (ShellStore.Value.CurrentProjectId != _loadedProject)
        {
            InvokeAsync(LoadForCurrentProject);
        }
    }

    private void LoadForCurrentProject()
    {
        _loadedProject = ShellStore.Value.CurrentProjectId;
        Dispatch.Dispatch(new ViewActions.LoadViewAction(_loadedProject));
    }

    public void Dispose()
    {
        ViewStore.StateChanged -= OnStateChanged;
        ShellStore.StateChanged -= OnShellChanged;
    }
}
