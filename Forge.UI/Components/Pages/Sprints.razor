@page "/sprints"
@inject IState<Forge.Dashboard.Features.View.ViewState> ViewStore
@inject IState<Forge.Dashboard.Features.AppShell.AppShellState> ShellStore
@inject Fluxor.IDispatcher Dispatch
@inject HttpClient Http
@inject NavigationManager Nav
@using System.Net.Http.Json
@implements IDisposable
@using Forge.Dashboard.Features.View

<PageTitle>Sprints</PageTitle>
<div class="page">
    <div class="page-header">
        <h1>Sprints</h1>
        <div class="page-header__meta">@ViewStore.Value.Sprints.Count total · @ViewStore.Value.Sprints.Count(s => s.Status == "Active") active</div>
        <div class="page-header__actions">
            <button class="btn btn--primary" @onclick="@(() => Dispatch.Dispatch(new ViewActions.LoadViewAction(ShellStore.Value.CurrentProjectId)))">Refresh</button>
        </div>
    </div>

    @if (ViewStore.Value.Loading)
    {
        <div class="page-subtitle">Loading…</div>
    }
    else if (ViewStore.Value.Error is not null)
    {
        <div class="page-subtitle">Error: @ViewStore.Value.Error</div>
    }
    else if (ViewStore.Value.Sprints.Count == 0)
    {
        @* Sprint flow: there is intentionally NO create button — the
           SprintAssembler builds each sprint automatically when the
           previous one completes, from groomed (or ad-hoc) work. *@
        <div class="page-subtitle">No sprints yet. Sprints assemble automatically when groomed work becomes eligible.</div>
    }
    else
    {
        var sprints = ViewStore.Value.Sprints
            .OrderByDescending(s => s.Status == "Active")
            .ThenByDescending(s => s.StartDate)
            .ToList();
        var selected = SelectedSprint(sprints);

        @* Sprint switcher: Active pinned first, then newest. *@
        <div class="filter-bar">
            @foreach (var sp in sprints)
            {
                <button class="chip @(selected?.Id == sp.Id ? "chip--active" : "")"
                        @onclick="@(() => _selectedSprintId = sp.Id)">
                    @sp.Name @(sp.Status == "Active" ? "●" : "")
                </button>
            }
        </div>

        @if (selected is not null)
        {
            var members = EnrichMembers(selected);
            var done = members.Count(m => m.Status is "Completed" or "Closed");
            var pct = members.Count == 0 ? 0 : (int)Math.Round(100.0 * done / members.Count);

            <div class="sprint-hero">
                <div class="sprint-hero__top">
                    <span class="pill pill--@selected.Status.ToLowerInvariant()">@selected.Status</span>
                    <strong class="sprint-hero__name">@selected.Name</strong>
                    <span class="mono sprint-hero__dates">
                        @(selected.StartDate?.ToString("MMM d") ?? "")
                        @(selected.EndDate is not null ? $" → {selected.EndDate.Value:MMM d}" : "")
                    </span>
                    <span class="mono">@done/@members.Count tasks · @pct%</span>
                </div>
                @if (!string.IsNullOrEmpty(selected.Goal))
                {
                    <div class="sprint-hero__goal">@selected.Goal</div>
                }
                <div class="sprint-progress"><div class="sprint-progress__fill" style="width:@pct%"></div></div>
            </div>

            @if (selected.Status != "Active")
            {
                <div class="page-subtitle" style="margin:8px 0">Viewing a past sprint (read-only).</div>
            }

            @* Scrum board: every task in the sprint, grouped by state. *@
            <div class="kanban">
                @foreach (var col in Columns)
                {
                    var cards = members.Where(m => col.Match(m.Status)).ToList();
                    <div class="kanban__col">
                        <div class="kanban__col-header">
                            <span>@col.Title</span>
                            <span class="mono kanban__col-count">@cards.Count</span>
                        </div>
                        @if (cards.Count == 0)
                        {
                            <div class="kanban__empty">—</div>
                        }
                        @foreach (var card in cards)
                        {
                            <div class="kanban__card" style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/tasks/{card.Id}"))">
                                <div class="kanban__card-top">
                                    <span class="mono kanban__card-id">@card.Id</span>
                                    <span style="display:flex;gap:6px;align-items:center">
                                        @if (card.ReworkAttempts is not null)
                                        {
                                            <span class="pill pill--blocked" title="Rework round @card.ReworkAttempts in the review loop">R@(card.ReworkAttempts)</span>
                                        }
                                        @if (card.PrNumber is not null && PrUrl(card.PrNumber) is { } url)
                                        {
                                            <a href="@url" target="_blank" rel="noopener" @onclick:stopPropagation="true">PR #@card.PrNumber</a>
                                        }
                                    </span>
                                </div>
                                <div class="kanban__card-title">@card.Title</div>
                                <div class="kanban__card-meta">
                                    <span class="pill pill--@card.Status.ToLowerInvariant()">@card.Status</span>
                                    @if (card.Assignee is not null)
                                    {
                                        <span class="mono">@card.Assignee</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string? _loadedProject;
    private string? _selectedSprintId;
    private string? _repoUrl;

    private sealed record Column(string Title, Func<string, bool> Match);
    private static readonly Column[] Columns =
    {
        new("To do", s => s == "Pending"),
        new("In progress", s => s == "InProgress"),
        new("Blocked", s => s == "Blocked"),
        new("Failed", s => s == "Failed"),
        new("Done", s => s is "Completed" or "Closed"),
    };

    private sealed record Card(string Id, string Title, string Status, string? Assignee, string? PrNumber, string? ReworkAttempts);

    private ViewSprint? SelectedSprint(List<ViewSprint> sprints)
    {
        // Default: the Active sprint; fall back to the newest.
        if (_selectedSprintId is not null)
        {
            var hit = sprints.FirstOrDefault(s => s.Id == _selectedSprintId);
            if (hit is not null) return hit;
        }
        return sprints.FirstOrDefault(s => s.Status == "Active") ?? sprints.FirstOrDefault();
    }

    /// <summary>
    /// Sprint member rows carry id/title/status; enrich with the full
    /// task view (assignee, prNumber from metadata) by cross-joining
    /// the /api/state task list already in the store.
    /// </summary>
    private List<Card> EnrichMembers(ViewSprint sprint)
    {
        var byId = ViewStore.Value.Tasks.ToDictionary(t => t.Id);
        return (sprint.Members ?? (IReadOnlyList<ViewSprintMember>)Array.Empty<ViewSprintMember>())
            .Select(m =>
            {
                byId.TryGetValue(m.Id, out var t);
                return new Card(m.Id, m.Title, m.Status, t?.Assignee, t?.PrNumber, t?.ReworkAttempts);
            })
            .ToList();
    }

    private string? PrUrl(string prNumber) =>
        _repoUrl is null ? null : $"{_repoUrl}/pull/{prNumber}";

    private async Task LoadRepoUrlAsync()
    {
        // Repo URL from the current project registration (never
        // hardcoded); re-resolved on project switch.
        var projectId = ShellStore.Value.CurrentProjectId;
        if (string.IsNullOrEmpty(projectId)) return;
        try
        {
            var projects = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>("/api/projects");
            foreach (var p in projects.EnumerateArray())
            {
                if (p.TryGetProperty("id", out var id) && string.Equals(id.GetString(), projectId, StringComparison.OrdinalIgnoreCase)
                    && p.TryGetProperty("repoUrl", out var url))
                {
                    _repoUrl = url.GetString()?.TrimEnd('/');
                    break;
                }
            }
        }
        catch { /* PR links are best-effort */ }
    }

    protected override void OnInitialized()
    {
        ViewStore.StateChanged += OnStateChanged;
        ShellStore.StateChanged += OnShellChanged;
        if (ViewStore.Value.LastFetchedAt is null)
        {
            LoadForCurrentProject();
        }
        _ = LoadRepoUrlAsync();
    }

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnShellChanged(object? sender, EventArgs e)
    {
        if (ShellStore.Value.CurrentProjectId != _loadedProject)
        {
            _repoUrl = null;
            _selectedSprintId = null;
            InvokeAsync(LoadForCurrentProject);
            _ = LoadRepoUrlAsync();
        }
    }

    private void LoadForCurrentProject()
    {
        _loadedProject = ShellStore.Value.CurrentProjectId;
        Dispatch.Dispatch(new ViewActions.LoadViewAction(_loadedProject));
    }

    public void Dispose()
    {
        ViewStore.StateChanged -= OnStateChanged;
        ShellStore.StateChanged -= OnShellChanged;
    }
}
