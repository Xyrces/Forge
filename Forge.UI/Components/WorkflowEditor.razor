@inject HttpClient Http
@using System.Net.Http.Json
@using System.Text.Json

@* Editable workflow (pass 2): Zapier-style vertical step editor for
   the pipeline definition. Gate attach/detach edits accumulate
   locally -> Save draft persists -> Publish validates server-side
   and flips the live definition (previous live snapshotted).
   Hold/release is operational and applies immediately; definition
   edits only take effect at publish. *@

@if (_loading)
{
    <div class="page-subtitle">Loading workflow…</div>
}
else if (_working is not null)
{
    <div class="picker-bar">
        @if (_hasDraft || _dirty)
        {
            <span class="pill pill--warn">Draft</span>
        }
        else
        {
            <span class="pill pill--success">Live</span>
        }
        @if (_dirty)
        {
            <span class="page-subtitle">unsaved changes</span>
        }
        <span style="flex:1"></span>
        <button class="btn" @onclick="SaveDraftAsync" disabled="@(!_dirty || _busy)">Save draft</button>
        @if (_confirming == "publish")
        {
            <button class="btn btn--primary" @onclick="PublishAsync" disabled="@_busy">Confirm publish</button>
            <button class="btn" @onclick="@(() => _confirming = null)">Cancel</button>
        }
        else
        {
            <button class="btn btn--primary" @onclick="@(() => _confirming = "publish")" disabled="@_busy">Publish</button>
        }
        @if (_hasDraft || _dirty)
        {
            @if (_confirming == "discard")
            {
                <button class="btn" @onclick="DiscardAsync" disabled="@_busy">Confirm discard</button>
            }
            else
            {
                <button class="btn" @onclick="@(() => _confirming = "discard")" disabled="@_busy">Discard</button>
            }
        }
        @if (_confirming == "reset")
        {
            <button class="btn" @onclick="ResetToDefaultAsync" disabled="@_busy">Confirm reset to default</button>
        }
        else
        {
            <button class="btn" @onclick="@(() => _confirming = "reset")" disabled="@_busy">Reset to default</button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="banner banner--error">@_error</div>
    }
    @if (_publishErrors.Count > 0)
    {
        <div class="banner banner--error">
            <strong>Publish rejected — the definition failed validation:</strong>
            <ul style="margin:6px 0 0 18px">
                @foreach (var e in _publishErrors)
                {
                    <li>@e</li>
                }
            </ul>
        </div>
    }
    @if (_notice is not null)
    {
        <div class="banner banner--ok">@_notice</div>
    }

    @if (_diff.Count > 0)
    {
        <div class="banner banner--warn">
            <strong>Unpublished changes vs live:</strong>
            <ul style="margin:6px 0 0 18px">
                @foreach (var line in _diff)
                {
                    <li>@line</li>
                }
            </ul>
        </div>
    }

    <div style="max-width:640px;margin:0 auto">
        @foreach (var (step, i) in Spine.Select((s, i) => (s, i)))
        {
            @if (i > 0)
            {
                <div class="wf-connector">+</div>
            }
            @StepCard(step, i + 1, expandableChips: true)
        }
    </div>

    <div style="max-width:640px;margin:24px auto 0">
        <h3>Policies</h3>
        <div class="page-subtitle">Policy editing lands in pass 3 — shown here for context.</div>
        <div class="chip-row">
            @foreach (var (k, v) in _working.Policies.OrderBy(kv => kv.Key))
            {
                <span class="pill pill--outline">@k = @v</span>
            }
        </div>
        <div class="page-subtitle" style="margin-top:6px">
            Run-quality gates (plan-schema / plan-territory / plan-llm-review) are edited on the
            <a href="/gates">quality gates page</a>.
        </div>
    </div>

    <div style="max-width:640px;margin:24px auto 0">
        <h3>Published versions</h3>
        @if (_versions.Count == 0)
        {
            <div class="page-subtitle">No snapshots yet — the first publish creates one.</div>
        }
        else
        {
            <ul style="list-style:none;padding:0;margin:0">
                @foreach (var v in _versions)
                {
                    <li style="display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--outline-variant)">
                        <span class="mono">@v.PublishedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        <span class="page-subtitle">@(v.IsDefaultSnapshot ? "built-in default" : $"{v.StepCount} steps")</span>
                        <span style="flex:1"></span>
                        @if (_confirming == v.Key)
                        {
                            <button class="btn btn--small" @onclick="@(() => RestoreAsync(v.Key))" disabled="@_busy">Confirm restore</button>
                            <button class="btn btn--small" @onclick="@(() => _confirming = null)">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn--small" @onclick="@(() => _confirming = v.Key)" disabled="@_busy">Restore</button>
                        }
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    private static readonly string[] KnownGates = { "design", "groom", "sprint", "merge" };

    private bool _loading = true;
    private bool _busy;
    private bool _dirty;
    private bool _hasDraft;
    private string? _error;
    private string? _notice;
    private string? _confirming;
    private DefinitionDto? _working;
    private List<string> _diff = new();
    private List<string> _publishErrors = new();
    private Dictionary<string, string> _gateStates = new();
    private List<VersionDto> _versions = new();
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private List<StepDto> Spine { get; set; } = new();
    private readonly Dictionary<string, string> _spineEdge = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var wf = await Http.GetFromJsonAsync<WorkflowResponse>("/api/workflow");
            _working = wf?.Draft ?? wf?.Live;
            _hasDraft = wf?.HasDraft == true;
            _dirty = false;
            _diff = wf?.Diff?.ToList() ?? new();
            RebuildSpine();
            _gateStates = await Http.GetFromJsonAsync<Dictionary<string, string>>("/api/gates") ?? new();
            _versions = (await Http.GetFromJsonAsync<List<VersionDto>>("/api/workflow/versions")) ?? new();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load the workflow: {ex.Message}";
        }
        _loading = false;
    }

    private void RebuildSpine()
    {
        Spine = new();
        _spineEdge.Clear();
        if (_working is null) return;
        var byId = _working.Steps.ToDictionary(s => s.Id, StringComparer.Ordinal);
        var visited = new HashSet<string>(StringComparer.Ordinal);
        string? cur = byId.ContainsKey("intake") ? "intake" : _working.Steps.FirstOrDefault(s => s.Kind == "stage")?.Id;
        while (cur is not null && visited.Add(cur))
        {
            Spine.Add(byId[cur]);
            var next = _working.Edges
                .Where(e => e.From == cur && byId.TryGetValue(e.To, out var t) && t.Kind == "stage" && !visited.Contains(e.To))
                .OrderBy(e => e.Kind == "happy" ? 0 : 1)
                .FirstOrDefault();
            if (next is not null)
            {
                _spineEdge[cur] = next.To;
            }
            cur = next?.To;
        }
        foreach (var s in _working.Steps.Where(s => s.Kind == "stage" && !visited.Contains(s.Id)))
        {
            Spine.Add(s);
        }
    }

    private IEnumerable<EdgeDto> BranchEdges(StepDto step)
        => _working!.Edges.Where(e => e.From == step.Id
            && (!_spineEdge.TryGetValue(step.Id, out var spineTo) || e.To != spineTo));

    private RenderFragment StepCard(StepDto step, int number, bool expandableChips) => __builder =>
    {
        var branches = BranchEdges(step).ToList();
        <div class="wf-step">
            <div class="wf-step__header">
                <span class="wf-step__number mono">@number</span>
                <strong>@step.Label</strong>
                <span class="mono page-subtitle">@step.Id</span>
                @if (!step.Enabled)
                {
                    <span class="pill pill--blocked">disabled</span>
                }
                <span style="flex:1"></span>
                <span class="pill pill--outline">@step.Lane</span>
            </div>

            <div class="chip-row" style="margin-top:8px">
                @foreach (var gate in step.Gates)
                {
                    var held = _gateStates.TryGetValue(gate, out var s) && s == "hold";
                    <span class="pill @(held ? "pill--blocked" : "pill--pending")" title="Stage gate — click to @(held ? "release" : "hold") (applies immediately)">
                        gate: @gate (@(held ? "held" : "open"))
                    </span>
                    <button class="btn btn--small" @onclick="@(() => ToggleGateHoldAsync(gate, held))" disabled="@_busy">@(held ? "Release" : "Hold")</button>
                    <button class="btn btn--small" @onclick="@(() => DetachGate(step, gate))" disabled="@_busy" title="Detach from this step (draft — takes effect at publish). A gate attached nowhere is disabled.">Detach</button>
                }
                @{ var attachable = KnownGates.Except(step.Gates, StringComparer.Ordinal).ToList(); }
                @if (attachable.Count > 0)
                {
                    @foreach (var g in attachable)
                    {
                        <button class="btn btn--small" @onclick="@(() => AttachGate(step, g))" disabled="@_busy" title="Attach this gate here (draft — takes effect at publish)">+ @g gate</button>
                    }
                }
            </div>

            @foreach (var edge in branches)
            {
                var key = $"{edge.From}>{edge.To}";
                var target = _working!.Steps.FirstOrDefault(s => s.Id == edge.To);
                <div class="wf-branch">
                    <button class="btn btn--small wf-branch__chip"
                            @onclick="@(() => { if (expandableChips) ToggleExpanded(key); })">
                        @(edge.Label ?? edge.Kind) → @(target?.Label ?? edge.To)
                    </button>
                    @if (expandableChips && _expanded.Contains(key) && target is not null)
                    {
                        <div class="wf-branch__nested">
                            @StepCard(target, 0, expandableChips: false)
                        </div>
                    }
                </div>
            }
        </div>
    };

    private void ToggleExpanded(string key)
    {
        if (!_expanded.Remove(key)) _expanded.Add(key);
    }

    private void AttachGate(StepDto step, string gate)
    {
        step.Gates.Add(gate);
        _dirty = true;
    }

    private void DetachGate(StepDto step, string gate)
    {
        step.Gates.Remove(gate);
        _dirty = true;
    }

    private async Task ToggleGateHoldAsync(string gate, bool held)
    {
        _busy = true;
        _error = null;
        try
        {
            var resp = await Http.PostAsync($"/api/gates/{gate}/{(held ? "release" : "hold")}", null);
            resp.EnsureSuccessStatusCode();
            _gateStates = await Http.GetFromJsonAsync<Dictionary<string, string>>("/api/gates") ?? new();
            _notice = $"Gate '{gate}' {(held ? "released" : "held")} — applies immediately.";
        }
        catch (Exception ex) { _error = $"Gate toggle failed: {ex.Message}"; }
        _busy = false;
    }

    private static readonly JsonSerializerOptions PutJson = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };

    private async Task SaveDraftAsync()
    {
        _busy = true;
        _error = null;
        _publishErrors = new();
        try
        {
            var resp = await Http.PutAsync("/api/workflow/draft",
                new StringContent(JsonSerializer.Serialize(_working, PutJson), System.Text.Encoding.UTF8, "application/json"));
            if (!resp.IsSuccessStatusCode)
            {
                _error = $"Draft save rejected: {await resp.Content.ReadAsStringAsync()}";
            }
            else
            {
                var result = await resp.Content.ReadFromJsonAsync<SaveDraftResponse>();
                _diff = result?.Diff?.ToList() ?? new();
                _hasDraft = true;
                _dirty = false;
                _notice = "Draft saved — nothing is live until you publish.";
            }
        }
        catch (Exception ex) { _error = $"Draft save failed: {ex.Message}"; }
        _busy = false;
    }

    private async Task PublishAsync()
    {
        _confirming = null;
        if (_dirty)
        {
            await SaveDraftAsync();
            if (_dirty) return;   // save failed — banner already shown
        }
        _busy = true;
        _error = null;
        _publishErrors = new();
        try
        {
            var resp = await Http.PostAsync("/api/workflow/publish", null);
            if (!resp.IsSuccessStatusCode)
            {
                var failure = await resp.Content.ReadFromJsonAsync<PublishFailure>();
                _publishErrors = failure?.Errors?.ToList() ?? new() { await resp.Content.ReadAsStringAsync() };
            }
            else
            {
                _notice = "Published — the live definition flipped. Machinery picks it up at its next evaluation; no restart.";
                await LoadAllAsync();
            }
        }
        catch (Exception ex) { _error = $"Publish failed: {ex.Message}"; }
        _busy = false;
    }

    private async Task DiscardAsync()
    {
        _confirming = null;
        _busy = true;
        try
        {
            await Http.DeleteAsync("/api/workflow/draft");
            _notice = "Draft discarded — editing the live definition again.";
            await LoadAllAsync();
        }
        catch (Exception ex) { _error = $"Discard failed: {ex.Message}"; }
        _busy = false;
    }

    private async Task ResetToDefaultAsync()
    {
        _confirming = null;
        _busy = true;
        _error = null;
        try
        {
            var def = await Http.GetFromJsonAsync<DefinitionDto>("/api/workflow/default");
            var put = await Http.PutAsync("/api/workflow/draft",
                new StringContent(JsonSerializer.Serialize(def, PutJson), System.Text.Encoding.UTF8, "application/json"));
            put.EnsureSuccessStatusCode();
            _dirty = false;
            await PublishAsync();
        }
        catch (Exception ex) { _error = $"Reset failed: {ex.Message}"; }
        _busy = false;
    }

    private async Task RestoreAsync(string key)
    {
        _confirming = null;
        _busy = true;
        _error = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/workflow/versions/restore", new { key });
            resp.EnsureSuccessStatusCode();
            _notice = "Restored — the live definition was replaced (the previous live was snapshotted first).";
            await LoadAllAsync();
        }
        catch (Exception ex) { _error = $"Restore failed: {ex.Message}"; }
        _busy = false;
    }

    private sealed class WorkflowResponse
    {
        public DefinitionDto? Live { get; set; }
        public DefinitionDto? Draft { get; set; }
        public bool HasDraft { get; set; }
        public string[]? Diff { get; set; }
    }

    private sealed class SaveDraftResponse
    {
        public string[]? Diff { get; set; }
    }

    private sealed class PublishFailure
    {
        public string? Error { get; set; }
        public string[]? Errors { get; set; }
    }

    private sealed class VersionDto
    {
        public string Key { get; set; } = "";
        public DateTime PublishedAt { get; set; }
        public bool IsDefaultSnapshot { get; set; }
        public DefinitionDto? Definition { get; set; }
        public int StepCount => Definition?.Steps.Count ?? 0;
    }

    private sealed class DefinitionDto
    {
        public int Version { get; set; }
        public List<StepDto> Steps { get; set; } = new();
        public List<EdgeDto> Edges { get; set; } = new();
        public Dictionary<string, string> Policies { get; set; } = new();
    }

    private sealed class StepDto
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Lane { get; set; } = "";
        public string Kind { get; set; } = "";
        public bool Optional { get; set; }
        public bool Enabled { get; set; }
        public int X { get; set; }
        public int Y { get; set; }
        public List<string> Gates { get; set; } = new();
    }

    private sealed class EdgeDto
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public string Kind { get; set; } = "";
        public string? Label { get; set; }
        public string? Condition { get; set; }
    }
}
