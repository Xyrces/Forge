@if (Required)
{
    <p class="@Class">@Message</p>
}

@code {
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public string? Nominee { get; set; }
    [Parameter] public string? Summary { get; set; }
    [Parameter] public bool SyncPending { get; set; }
    [Parameter] public string? Class { get; set; }

    private string Message
    {
        get
        {
            if (Status is "Completed" or "Closed")
                return Summary ?? "No further review action.";
            var requirement = string.IsNullOrWhiteSpace(Nominee) ? "Human review required before merge."
                : $"Review by @{Nominee} required before merge.";
            return SyncPending ? requirement + " Synchronizing with GitHub; merge remains held." : requirement;
        }
    }
}
