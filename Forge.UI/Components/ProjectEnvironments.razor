@using System.Net.Http.Json
@using Forge.Dashboard.Features.Deployments
@inject HttpClient Http
@implements IDisposable

<section class="card overview-section" aria-labelledby="project-environments-title">
    <h2 id="project-environments-title">Environments &amp; delivery gates</h2>
    <p>A sprint finishes when its selected environment passes deployment checks. Later promotions are separate releases of that same artifact.</p>
    @if (_loading) { <p role="status">Loading environments…</p> }
    else if (_policy is null)
    {
        <p class="banner banner--warn" role="alert">@_error</p>
        <button class="btn" @onclick="LoadAsync">Retry loading environments</button>
    }
    else if (_policy.Environments.Count == 0)
    {
        <p class="banner banner--warn">No environment targets are provisioned. Ask the host administrator to provision isolated targets before configuring delivery.</p>
    }
    else
    {
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
            <label class="environment-field"><span>Sprint completion environment</span>
                <select @bind="_sprintEnvironment" disabled="@_saving">
                    <option value="">No environment selected</option>
                    @foreach (var target in _policy.Environments) { <option value="@target.Name">@target.DisplayName</option> }
                </select>
            </label>
            <p>Build, tests and target health checks are required. Human approval is required only where explicitly selected below. Existing releases retain their recorded target.</p>
            <div class="environment-grid">
                @foreach (var target in _policy.Environments)
                {
                    var index = _policy.Environments.IndexOf(target);
                    <fieldset class="environment-card" disabled="@_saving" @key="target.Name">
                        <legend>@target.Name</legend>
                        <label class="environment-field"><span>Display name for @target.Name</span>
                            <input value="@target.DisplayName" maxlength="80" @onchange="e => Update(index, target with { DisplayName = e.Value?.ToString() ?? target.Name })" />
                        </label>
                        <label class="environment-check"><input type="checkbox" checked="@target.RequireApproval" @onchange="e => Update(index, target with { RequireApproval = (bool)(e.Value ?? false) })" /> Require human approval before automatic deployment to @target.DisplayName</label>
                        <p class="muted">@(target.RequireApproval ? "Automatic delivery pauses for explicit approval. A promotion confirmation supplies approval for that release." : "Automatic delivery proceeds when checks pass. Promotions still require your confirmation.")</p>
                        <strong>Allow promotion from here to</strong>
                        @foreach (var destination in _policy.Environments.Where(e => e.Name != target.Name))
                        {
                            <label class="environment-check"><input type="checkbox" checked="@target.PromoteTo.Contains(destination.Name)" @onchange="e => SetRoute(index, destination.Name, (bool)(e.Value ?? false))" /> @destination.DisplayName</label>
                        }
                        <details><summary>Provisioned target</summary><dl class="release-facts"><dt>Namespace</dt><dd>@target.KubernetesNamespace</dd><dt>Dataset</dt><dd><code>@target.KubernetesDatasetId</code></dd></dl><p>Target bindings are host-managed and cannot be changed here.</p></details>
                    </fieldset>
                }
            </div>
            <button class="btn btn--primary" type="submit" disabled="@(_saving || string.IsNullOrEmpty(_sprintEnvironment))">@(_saving ? "Saving…" : "Save environment policy")</button>
            <a class="btn" href="/deployments">View releases &amp; promote</a>
        </form>
        @if (_error is not null) { <p class="banner banner--warn" role="alert">@_error</p><button class="btn" disabled="@_saving" @onclick="LoadAsync">Reload saved policy</button> }
        @if (_notice is not null) { <p class="banner banner--ok" role="status">@_notice</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    private EnvironmentPolicy? _policy;
    private string? _project, _error, _notice;
    private string _sprintEnvironment = "";
    private bool _loading, _saving;
    private CancellationTokenSource _lifetime = new();
    protected override async Task OnParametersSetAsync()
    {
        if (_project == ProjectId) return;
        _lifetime.Cancel(); _lifetime.Dispose(); _lifetime = new();
        _project = ProjectId; _policy = null; _notice = null; _saving = false;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var project = ProjectId; var ct = _lifetime.Token;
        _loading = true; _error = null;
        try
        {
            var policy = await EnvironmentPolicyClient.LoadAsync(Http, project, ct);
            if (ct.IsCancellationRequested || project != ProjectId) return;
            _policy = policy; _sprintEnvironment = policy.SprintEnvironment ?? "";
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { if (!ct.IsCancellationRequested && project == ProjectId) _error = ex.Message; }
        finally { if (!ct.IsCancellationRequested && project == ProjectId) _loading = false; }
    }
    private void Update(int index, EnvironmentTarget target) { _policy!.Environments[index] = target; _notice = null; }
    private void SetRoute(int index, string destination, bool enabled)
    {
        var target = _policy!.Environments[index];
        Update(index, target with { PromoteTo = enabled ? target.PromoteTo.Append(destination).Distinct().ToList() : target.PromoteTo.Where(p => p != destination).ToList() });
    }
    private async Task SaveAsync()
    {
        if (_saving || _policy is null) return;
        var project = ProjectId; var ct = _lifetime.Token;
        _saving = true; _error = null; _notice = null;
        try
        {
            using var response = await Http.PutAsJsonAsync($"/api/projects/{Uri.EscapeDataString(project)}/environments", _policy with { SprintEnvironment = _sprintEnvironment }, ct);
            await EnvironmentPolicyClient.EnsureSuccessAsync(response, ct);
            var saved = await response.Content.ReadFromJsonAsync<EnvironmentPolicy>(ct) ?? throw new InvalidDataException("No policy was returned. Reload to confirm the saved policy.");
            if (ct.IsCancellationRequested || project != ProjectId) return;
            _policy = saved; _sprintEnvironment = saved.SprintEnvironment ?? ""; _notice = "Environment policy saved.";
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { if (!ct.IsCancellationRequested && project == ProjectId) _error = ex.Message; }
        finally { if (!ct.IsCancellationRequested && project == ProjectId) _saving = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
