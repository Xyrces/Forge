@if (!string.IsNullOrWhiteSpace(Goal))
{
    <section class="sprint-objective" aria-label="Sprint objective">
        <h2>Sprint objective</h2>
        <div class="md">@((MarkupString)Forge.Dashboard.Services.MarkdownRenderer.ToHtml(DisplayGoal))</div>
    </section>
}
@code {
    [Parameter] public string? Goal { get; set; }
    private string? DisplayGoal => Goal is null ? null : System.Text.RegularExpressions.Regex.Replace(Goal,
        @"\A\s*#{1,6}\s+(?:Goal|Sprint goal|Sprint objective)\s*\r?\n", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

}
